+#if defined(__APPLE__) && !defined(ENABLE_BROWSER_LEGACY)
+#include <CoreFoundation/CoreFoundation.h>
+
+/* A standalone plugin bundle (LiveHime's optional add-on) carries CEF and the
+ * helper apps in its own Contents/Frameworks instead of the app bundle's. */
+static std::string OwnFrameworksDir()
+{
+	std::string path = obs_get_module_binary_path(obs_current_module());
+	for (int i = 0; i < 2; i++) /* Contents/MacOS/obs-browser -> Contents */
+		path = path.substr(0, path.find_last_of('/'));
+	return path + "/Frameworks";
+}
+
+static std::string OwnCefFramework()
+{
+	std::string framework = OwnFrameworksDir() + "/Chromium Embedded Framework.framework";
+	return os_file_exists((framework + "/Chromium Embedded Framework").c_str()) ? framework : std::string();
+}
+#endif
+
 /* ========================================================================= */
 
 #ifdef ENABLE_BROWSER_QT_LOOP
@@ -345,6 +366,31 @@ static void BrowserInit(void)
 	char *abs_path = os_get_abs_path_ptr(path.c_str());
 	CefString(&settings.browser_subprocess_path) = abs_path;
 	bfree(abs_path);
+#else
+	std::string own_framework = OwnCefFramework();
+	if (!own_framework.empty()) {
+		/* Without this, CEF would take the bundle around the framework (the
+		 * plugin) as the main bundle in child processes, and they could not
+		 * find the browser process. */
+		char app_path[PATH_MAX] = "";
+		CFURLRef app_url = CFBundleCopyBundleURL(CFBundleGetMainBundle());
+		CFURLGetFileSystemRepresentation(app_url, true, (UInt8 *)app_path, sizeof(app_path));
+		CFRelease(app_url);
+		CefString(&settings.main_bundle_path) = app_path;
+		CefString(&settings.framework_dir_path) = own_framework;
+		CefString(&settings.browser_subprocess_path) = OwnFrameworksDir() +
+							       "/OBS Helper.app/Contents/MacOS/OBS Helper";
+
+		/* The add-on ships only some of CEF's locales; use English when
+		 * the interface language is not among them. */
+		std::string lproj = obs_get_locale();
+		std::replace(lproj.begin(), lproj.end(), '-', '_');
+		std::string language = lproj.substr(0, lproj.find('_'));
+		std::string resources = own_framework + "/Resources/";
+		if (!os_file_exists((resources + lproj + ".lproj").c_str()) &&
+		    !os_file_exists((resources + language + ".lproj").c_str()))
+			CefString(&settings.locale) = "en-US";
+	}
 #endif
 
