 void obs_module_post_load(void)
 {
+#if defined(__APPLE__) && !defined(ENABLE_BROWSER_LEGACY)
+	/* The OBS frontend starts CEF on the main thread when it is built with
+	 * the browser. A frontend built without it never does, and a source
+	 * created later may be created on another thread (obs-websocket), where
+	 * CEF cannot start on macOS. Post-load runs on the main thread. */
+	if (!OwnCefFramework().empty())
+		obs_browser_initialize();
+#endif
+
 	auto vendor = obs_websocket_register_vendor("obs-browser");
 	if (!vendor)
 		return;
