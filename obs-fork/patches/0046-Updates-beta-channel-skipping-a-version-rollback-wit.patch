+/// Puts the previous version back once LiveHime quits and reopens it (the
+/// caller then quits). Returns 1 when arranged; otherwise emits "failed".
+@_cdecl("livehime_core_update_rollback")
+public func livehime_core_update_rollback() -> Int32 {
+    guard Thread.isMainThread else { return 0 }
+    return MainActor.assumeIsolated {
+        let state = UpdateState.shared
+        guard !state.busy else { return 0 }
+        do {
+            try AppUpdater.scheduleRollback()
+            state.staged = nil
+            return 1
+        } catch {
+            state.failed(error)
+            return 0
+        }
+    }
+}
