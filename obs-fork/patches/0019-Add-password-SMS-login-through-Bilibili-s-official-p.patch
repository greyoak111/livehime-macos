diff --git a/plugins/livehime/core/Sources/LiveHimeCore/WebLoginWindow.swift b/plugins/livehime/core/Sources/LiveHimeCore/WebLoginWindow.swift
new file mode 100644
index 000000000..7cc6af111
--- /dev/null
+++ b/plugins/livehime/core/Sources/LiveHimeCore/WebLoginWindow.swift
@@ -0,0 +1,201 @@
+import AppKit
+import CryptoKit
+import WebKit
+
+/// Password / SMS login through Bilibili's official mini-login page, the
+/// page the Windows client hosts in CEF. The page handles passwords,
+/// captchas (geetest), SMS and secondary verification itself; the window
+/// only provides the host bridge the page expects (`livehime_login` and
+/// `biliBridgePc`, as in v0.1.2) and collects the resulting session cookies.
+///
+/// The page runs in a non-persistent WebKit store. On success the cookies
+/// become SessionCredentials for the Keychain and the page data is dropped.
+@MainActor
+final class WebLoginWindow: NSObject, NSWindowDelegate, WKNavigationDelegate, WKScriptMessageHandler,
+                            WKScriptMessageHandlerWithReply {
+    private static var current: WebLoginWindow?
+    static let loginURL = URL(string: "https://live.bilibili.com/p/html/live-pc-blink/mini-login-v2/")!
+
+    private let window: NSWindow
+    private let webView: WKWebView
+    private let bridge = AuthWebViewBridge()
+    private let onComplete: (SessionCredentials) -> Void
+    private var refreshToken = ""
+    private var completed = false
+
+    static func present(onComplete: @escaping (SessionCredentials) -> Void) {
+        if let current {
+            current.window.makeKeyAndOrderFront(nil)
+            return
+        }
+        current = WebLoginWindow(onComplete: onComplete)
+    }
+
+    static func close() {
+        current?.window.close()
+    }
+
+    private init(onComplete: @escaping (SessionCredentials) -> Void) {
+        self.onComplete = onComplete
+        let content = WKUserContentController()
+        let configuration = WKWebViewConfiguration()
+        configuration.userContentController = content
+        configuration.websiteDataStore = .nonPersistent()
+        webView = WKWebView(frame: .zero, configuration: configuration)
+        window = NSWindow(contentRect: NSRect(x: 0, y: 0, width: 820, height: 520),
+                          styleMask: [.titled, .closable, .miniaturizable], backing: .buffered, defer: false)
+        super.init()
+
+        // The Windows host defines `window.browser` before the page loads;
+        // the page copies it into cookies and checks it after verification.
+        content.addUserScript(WKUserScript(source: Self.browserContextScript(), injectionTime: .atDocumentStart,
+                                           forMainFrameOnly: true))
+        content.addUserScript(WKUserScript(source: AuthWebViewBridge.wkWebViewShim, injectionTime: .atDocumentStart,
+                                           forMainFrameOnly: true))
+        content.add(self, name: "livehime_login")
+        content.addScriptMessageHandler(self, contentWorld: .page, name: "livehime_native")
+        bridge.onEvent = { [weak self] event in self?.handle(event) }
+
+        webView.navigationDelegate = self
+        window.title = "哔哩哔哩登录"
+        window.contentMinSize = NSSize(width: 820, height: 460)
+        window.contentView = webView
+        window.isReleasedWhenClosed = false
+        window.delegate = self
+        window.center()
+        window.makeKeyAndOrderFront(nil)
+        NSApp.activate(ignoringOtherApps: true)
+        webView.load(URLRequest(url: Self.loginURL, cachePolicy: .reloadIgnoringLocalAndRemoteCacheData))
+    }
+
+    /// Same values v0.1.2 used; buvid3 is kept per install.
+    static func browserContextScript() -> String {
+        let key = "livehime.buvid3"
+        let buvid3: String
+        if let saved = UserDefaults.standard.string(forKey: key), !saved.isEmpty {
+            buvid3 = saved
+        } else {
+            buvid3 = UUID().uuidString.replacingOccurrences(of: "-", with: "").lowercased()
+            UserDefaults.standard.set(buvid3, forKey: key)
+        }
+        let context = ["appkey": "aae92bc66f3edfab", "buvid3": buvid3, "device_name": "macOS", "device_platform": "mac"]
+        let json = (try? JSONSerialization.data(withJSONObject: context)).map { String(decoding: $0, as: UTF8.self) } ?? "{}"
+        return "window.browser = Object.assign({}, window.browser || {}, \(json));"
+    }
+
+    // MARK: Bridge
+
+    private func accepts(_ message: WKScriptMessage) -> Bool {
+        let origin = message.frameInfo.securityOrigin
+        return message.webView === webView &&
+            AuthBridgeOriginPolicy.allows(scheme: origin.protocol, host: origin.host, port: origin.port,
+                                          isMainFrame: message.frameInfo.isMainFrame)
+    }
+
+    func userContentController(_ controller: WKUserContentController, didReceive message: WKScriptMessage) {
+        guard accepts(message), message.name == "livehime_login",
+              let body = message.body as? [String: Any], let method = body["method"] as? String else { return }
+        switch method {
+        case "LoginSuccess": bridge.loginSuccess(Self.dictionary(body["data"]))
+        case "Cancel": bridge.cancel()
+        case "SecondaryValidationResult": bridge.secondaryValidationResult()
+        case "SwitchLogin": bridge.switchLogin(width: body["width"] as? Double ?? 0, height: body["height"] as? Double ?? 0)
+        default: break
+        }
+    }
+
+    func userContentController(_ controller: WKUserContentController, didReceive message: WKScriptMessage,
+                               replyHandler: @escaping (Any?, String?) -> Void) {
+        guard accepts(message), message.name == "livehime_native", let body = message.body as? [String: Any] else {
+            replyHandler(nil, AuthBridgeContractError.untrustedOrigin.rawValue)
+            return
+        }
+        do {
+            switch try NativeAuthRequest.parse(action: body["action"] as? String, payload: body["payload"]) {
+            case .login(let result):
+                bridge.loginSuccess(result)
+                replyHandler(["accepted": true], nil)
+            case .cookies(let batch):
+                let store = webView.configuration.websiteDataStore.httpCookieStore
+                Task { @MainActor in
+                    for operation in batch.operations {
+                        if operation.remove { await store.deleteCookie(operation.cookie) } else { await store.setCookie(operation.cookie) }
+                    }
+                    replyHandler(["accepted": true], nil)
+                }
+            }
+        } catch let error as AuthBridgeContractError {
+            replyHandler(nil, error.rawValue)
+        } catch {
+            replyHandler(nil, AuthBridgeContractError.malformedPayload.rawValue)
+        }
+    }
+
+    /// The page may pass the payload as an object or as a JSON string.
+    static func dictionary(_ value: Any?) -> [String: Any] {
+        if let object = value as? [String: Any] { return object }
+        if let text = value as? String, let data = text.data(using: .utf8),
+           let object = try? JSONSerialization.jsonObject(with: data) as? [String: Any] { return object }
+        return [:]
+    }
+
+    private func handle(_ event: AuthWebViewEvent) {
+        switch event {
+        case .succeeded(let result):
+            if let token = result.refreshToken, !token.isEmpty {
+                refreshToken = token
+                if let timestamp = result.timestamp { seedCookies(token: token, timestamp: timestamp) }
+            }
+            collectCookies()
+        case .secondaryValidationReturned:
+            // The page redirects back after verification; the cookie jar is
+            // already authenticated at this point.
+            collectCookies()
+        case .cancelled:
+            window.close()
+        case .resize(let width, let height):
+            window.setContentSize(NSSize(width: max(820, min(width, 1200)), height: max(460, min(height, 900))))
+        }
+    }
+
+    /// The page hands back a refresh token; loading correspond/0 with this
+    /// digest asks Bilibili to set the matching cookies (v0.1.2 behaviour).
+    private func seedCookies(token: String, timestamp: String) {
+        let marker = "set_\(timestamp)_\(token)"
+        let hex = marker.unicodeScalars.map { String($0.value, radix: 16) }.joined()
+        let digest = SHA256.hash(data: Data(hex.utf8)).map { String(format: "%02x", $0) }.joined()
+        guard let literal = try? JSONSerialization.data(withJSONObject: "https://www.bilibili.com/correspond/0/\(digest)",
+                                                         options: .fragmentsAllowed) else { return }
+        let script = "(() => { const f=document.createElement('iframe'); f.style.display='none'; f.src=\(String(decoding: literal, as: UTF8.self)); document.body.appendChild(f); })();"
+        webView.evaluateJavaScript(script, completionHandler: nil)
+    }
+
+    /// Cookies can arrive shortly after the success callback; poll briefly.
+    private func collectCookies(attempt: Int = 0) {
+        guard !completed else { return }
+        webView.configuration.websiteDataStore.httpCookieStore.getAllCookies { [weak self] cookies in
+            guard let self, !self.completed else { return }
+            var jar: [String: String] = [:]
+            for cookie in cookies where cookie.domain.hasSuffix("bilibili.com") { jar[cookie.name] = cookie.value }
+            let credentials = SessionCredentials(cookies: jar, refreshToken: self.refreshToken)
+            if credentials.isComplete {
+                self.completed = true
+                self.onComplete(credentials)
+                self.window.close()
+            } else if attempt < 20 {
+                DispatchQueue.main.asyncAfter(deadline: .now() + 0.3) { self.collectCookies(attempt: attempt + 1) }
+            }
+        }
+    }
+
+    // MARK: WKNavigationDelegate / NSWindowDelegate
+
+    func webView(_ webView: WKWebView, didFinish navigation: WKNavigation!) {
+        webView.evaluateJavaScript(AuthWebViewBridge.nativeAuthBridgeScript, completionHandler: nil)
+    }
+
+    func windowWillClose(_ notification: Notification) {
+        webView.stopLoading()
+        Self.current = nil
+    }
+}
