+/// Opens the official password / SMS login page. On success the session is
+/// saved and verified like a QR login (state events follow as usual).
+@_cdecl("livehime_core_start_web_login")
+public func livehime_core_start_web_login() {
+    onMain {
+        guard CoreBridge.shared != nil else { return }
+        CoreBridge.shared?.coordinator.cancelQRLogin()
+        WebLoginWindow.present { credentials in
+            CoreBridge.shared?.coordinator.completeWebLogin(credentials)
+        }
+    }
+}
