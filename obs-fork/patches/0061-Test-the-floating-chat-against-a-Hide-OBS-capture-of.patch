+// LiveHime's on-screen windows (screen points), found by the websocket port's owner.
+function ownWindows() {
+  const pid = Number(execFileSync('lsof', ['-ti', 'tcp:4466', '-sTCP:LISTEN']).toString().trim().split('\n')[0]);
+  const js = `ObjC.import('CoreGraphics'); JSON.stringify(ObjC.deepUnwrap(ObjC.castRefToObject(
+    $.CGWindowListCopyWindowInfo($.kCGWindowListOptionOnScreenOnly, 0))).filter((w) => w.kCGWindowOwnerPID === ${pid})
+    .map((w) => ({ id: w.kCGWindowNumber, x: w.kCGWindowBounds.X, y: w.kCGWindowBounds.Y, w: w.kCGWindowBounds.Width, h: w.kCGWindowBounds.Height })))`;
+  return JSON.parse(execFileSync('osascript', ['-l', 'JavaScript', '-e', js]).toString());
+}
+// Mean pixel difference over a window, clipped to the screen, leaving out
+// the area of `skip` (the floating chat, which may be in front of it).
+function windowDiff(a, b, r, skip) {
+  const x0 = Math.max(0, r.x), y0 = Math.max(0, r.y), x1 = Math.min(screenW, r.x + r.w), y1 = Math.min(screenH, r.y + r.h);
+  const sx = a.w / screenW, sy = a.h / screenH; let sum = 0, n = 0;
+  for (let y = y0; y < y1; y += 2)
+    for (let x = x0; x < x1; x += 2) {
+      if (skip && x >= skip.x && x < skip.x + skip.w && y >= skip.y && y < skip.y + skip.h) continue;
+      const i = (Math.round(y * sy) * a.w + Math.round(x * sx)) * 4;
+      sum += (Math.abs(a.px[i] - b.px[i]) + Math.abs(a.px[i + 1] - b.px[i + 1]) + Math.abs(a.px[i + 2] - b.px[i + 2])) / 3; n++;
     }
-  return sum / n;
+  return n > 64 ? sum / n : 0;
 }
