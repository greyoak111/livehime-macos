diff --git a/build-aux/livehime/tests/e2e-branding.mjs b/build-aux/livehime/tests/e2e-branding.mjs
new file mode 100644
index 000000000..228474f74
--- /dev/null
+++ b/build-aux/livehime/tests/e2e-branding.mjs
@@ -0,0 +1,16 @@
+import { createHash } from 'node:crypto';
+const sha=(s)=>createHash('sha256').update(s).digest('base64'); const sleep=(ms)=>new Promise(r=>setTimeout(r,ms));
+const ws=new WebSocket('ws://127.0.0.1:4466'); let id=1; const pend=new Map();
+const req=(t,d={})=>new Promise(r=>{const k=String(id++);pend.set(k,r);ws.send(JSON.stringify({op:6,d:{requestType:t,requestId:k,requestData:d}}));});
+ws.onmessage=async(ev)=>{const m=JSON.parse(ev.data);
+ if(m.op===0){const {challenge,salt}=m.d.authentication;ws.send(JSON.stringify({op:1,d:{rpcVersion:1,authentication:sha(sha(process.argv[2]+salt)+challenge),eventSubscriptions:0}}));}
+ else if(m.op===7) pend.get(m.d.requestId)?.(m.d);
+ else if(m.op===2){ for(let i=0;i<40&&!(await req('GetVersion')).requestStatus.result;i++) await sleep(500);
+  let fails=0; const check=(n,ok,i='')=>{if(!ok)fails++;console.log(`${ok?'PASS':'FAIL'}  ${n}${i?'  — '+i:''}`);};
+  for (const key of ['ConfirmExit.Text','MacPermissions.Description','About.Info']) {
+    const r=(await req('CallVendorRequest',{vendorName:'livehime',requestType:'GetBrandingState',requestData:{key}})).responseData.responseData;
+    if(key==='About.Info') check(`${key} keeps OBS credit`, r.text.includes('OBS'), r.text.slice(0,40));
+    else check(`${key} says LiveHime`, r.text.includes('LiveHime') && !r.text.includes('OBS'), r.text.slice(0,40));
+    if(key==='ConfirmExit.Text') for(const it of r.menuItems) check(`menu ${it.name} hidden`, it.found && !it.visible);
+  }
+  console.log(fails?`${fails} failed`:'all passed'); process.exit(fails?1:0);}};
diff --git a/frontend/OBSApp.cpp b/frontend/OBSApp.cpp
index 0d6d0e28e..dbff42548 100644
--- a/frontend/OBSApp.cpp
+++ b/frontend/OBSApp.cpp
@@ -1089,6 +1089,15 @@ void OBSApp::AppInit()
 	if (!InitLocale()) {
 		throw "Failed to load locale";
 	}
+	/* LiveHime: product-name overrides layered over the OBS strings. They
+	 * live in separate files so upstream translation updates never
+	 * conflict; later keys replace earlier ones. */
+	for (const std::string &lang : {std::string(DEFAULT_LANG), locale}) {
+		std::string path;
+		const std::string file = "locale/overrides/" + lang + ".ini";
+		if (!lang.empty() && GetDataFilePath(file.c_str(), path))
+			text_lookup_add(textLookup, path.c_str());
+	}
 	if (!InitTheme()) {
 		throw "Failed to load theme";
 	}
