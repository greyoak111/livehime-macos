 #include <livehime-core.h>
 
+#include <obs-frontend-api.h>
 #include <obs-module.h>
 #include <obs-websocket-api.h>
 
+#include <QAction>
 #include <QJsonDocument>
+#include <QMainWindow>
 #include <QMetaEnum>
 #include <QMetaObject>
 #include <QPointer>
@@ -81,6 +84,27 @@ void getAccountState(obs_data_t *, obs_data_t *response, void *)
 		obs_data_set_string(response, "error", "dock unavailable");
 }
 
+/* Read-only branding check for tests: a frontend string and whether the
+ * upstream menu items are hidden. */
+void getBrandingState(obs_data_t *request, obs_data_t *response, void *)
+{
+	const char *key = obs_data_get_string(request, "key");
+	onUiThread([&] {
+		obs_data_set_string(response, "text", obs_frontend_get_locale_string(*key ? key : "ConfirmExit.Text"));
+		auto *mainWindow = static_cast<QMainWindow *>(obs_frontend_get_main_window());
+		OBSDataArrayAutoRelease hidden = obs_data_array_create();
+		for (const char *name : {"actionCheckForUpdates", "actionUploadCurrentLog", "actionWebsite"}) {
+			auto *action = mainWindow ? mainWindow->findChild<QAction *>(QString::fromLatin1(name)) : nullptr;
+			OBSDataAutoRelease item = obs_data_create();
+			obs_data_set_string(item, "name", name);
+			obs_data_set_bool(item, "found", action != nullptr);
+			obs_data_set_bool(item, "visible", action && action->isVisible());
+			obs_data_array_push_back(hidden, item);
+		}
+		obs_data_set_array(response, "menuItems", hidden);
+	});
+}
