+/* Upstream OBS menu items that do not apply to LiveHime: its updater, repair
+ * and news, OBS community links, and uploading logs to OBS's servers. */
+void hideUpstreamMenuItems()
+{
+	auto *mainWindow = static_cast<QMainWindow *>(obs_frontend_get_main_window());
+	if (!mainWindow)
+		return;
+	for (const char *name : {"actionCheckForUpdates", "actionRepair", "actionShowWhatsNew", "actionReleaseNotes",
+				 "actionDiscord", "actionWebsite", "actionUploadCurrentLog", "actionUploadLastLog",
+				 "actionUploadLastCrashLog"}) {
+		if (auto *action = mainWindow->findChild<QAction *>(QString::fromLatin1(name)))
+			action->setVisible(false);
+	}
+}
+
 void onFrontendEvent(enum obs_frontend_event event, void *)
 {
-	if (event == OBS_FRONTEND_EVENT_FINISHED_LOADING)
+	if (event == OBS_FRONTEND_EVENT_FINISHED_LOADING) {
 		placeDockOnFirstRun();
+		hideUpstreamMenuItems();
+	}
 	/* Still inside the frontend's shutdown with its API alive: close a room
 	 * this app opened so quitting never leaves it live. */
 	if (event == OBS_FRONTEND_EVENT_SCRIPTING_SHUTDOWN && dock)
