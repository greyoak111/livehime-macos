@@ -32,6 +32,11 @@ void livehime_core_load_areas(void);
 void livehime_core_start_live(long long area_id, long long parent_area_id);
 void livehime_core_stop_live(void);
 
+/* Opens Bilibili's pre-live verification page (face verification) for the
