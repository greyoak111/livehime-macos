diff --git a/plugins/livehime/core/Sources/LiveHimeCore/FaceAuthWindow.swift b/plugins/livehime/core/Sources/LiveHimeCore/FaceAuthWindow.swift
new file mode 100644
index 000000000..fc26371a8
--- /dev/null
+++ b/plugins/livehime/core/Sources/LiveHimeCore/FaceAuthWindow.swift
@@ -0,0 +1,132 @@
+import AppKit
+import WebKit
+
+/// Hosts Bilibili's own pre-live verification page (the same entry point the
+/// Windows client and v0.1.2 use). The page hands `v_voucher` to Bilibili's
+/// risk SDK, which shows the face-verification QR code or other checks.
+///
+/// The page needs the logged-in session, so the current cookies are copied
+/// into a non-persistent WebKit store that disappears with the window. The
+/// app never completes or bypasses the verification itself.
+@MainActor
+final class FaceAuthWindowController: NSObject, NSWindowDelegate, WKNavigationDelegate {
+    private static var current: FaceAuthWindowController?
+
+    private let window: NSWindow
+    private let webView: WKWebView
+    private let status: NSTextField
+    private let onRetry: () -> Void
+
+    static func present(voucher: String?, credentials: SessionCredentials, onRetry: @escaping () -> Void) {
+        if let current {
+            current.window.makeKeyAndOrderFront(nil)
+            return
+        }
+        let controller = FaceAuthWindowController(onRetry: onRetry)
+        current = controller
+        controller.load(voucher: voucher, credentials: credentials)
+    }
+
+    static var pageURLBase: URLComponents {
+        var components = URLComponents(string: "https://live.bilibili.com/p/html/bilili-page-face-auth/index.html")!
+        components.queryItems = [
+            URLQueryItem(name: "is_live_webview", value: "1"),
+            URLQueryItem(name: "app_common", value: "open"),
+            URLQueryItem(name: "pc_ui", value: "500,428,17181a,2")
+        ]
+        return components
+    }
+
+    private init(onRetry: @escaping () -> Void) {
+        self.onRetry = onRetry
+        let configuration = WKWebViewConfiguration()
+        configuration.websiteDataStore = .nonPersistent()
+        webView = WKWebView(frame: .zero, configuration: configuration)
+        status = NSTextField(labelWithString: "正在载入哔哩哔哩官方验证页面…")
+        window = NSWindow(contentRect: NSRect(x: 0, y: 0, width: 560, height: 640),
+                          styleMask: [.titled, .closable, .resizable], backing: .buffered, defer: false)
+        super.init()
+
+        let retry = NSButton(title: "验证完成，重试开播", target: self, action: #selector(retryTapped))
+        retry.keyEquivalent = "\r"
+        let close = NSButton(title: "关闭", target: self, action: #selector(closeTapped))
+        let buttons = NSStackView(views: [status, NSView(), close, retry])
+        buttons.orientation = .horizontal
+        let root = NSStackView(views: [webView, buttons])
+        root.orientation = .vertical
+        root.spacing = 10
+        root.edgeInsets = NSEdgeInsets(top: 0, left: 0, bottom: 12, right: 12)
+        webView.translatesAutoresizingMaskIntoConstraints = false
+        webView.widthAnchor.constraint(equalTo: root.widthAnchor).isActive = true
+        webView.heightAnchor.constraint(greaterThanOrEqualToConstant: 480).isActive = true
+        webView.navigationDelegate = self
+
+        window.title = "哔哩哔哩开播身份验证"
+        window.contentView = root
+        window.isReleasedWhenClosed = false
+        window.delegate = self
+        window.center()
+        window.makeKeyAndOrderFront(nil)
+        NSApp.activate(ignoringOtherApps: true)
+    }
+
+    private func load(voucher: String?, credentials: SessionCredentials) {
+        var components = Self.pageURLBase
+        if let voucher, !voucher.isEmpty {
+            components.queryItems?.append(URLQueryItem(name: "v_voucher", value: voucher))
+        }
+        let url = components.url!
+        let store = webView.configuration.websiteDataStore.httpCookieStore
+        Task { @MainActor in
+            for (name, value) in credentials.cookies {
+                if let cookie = HTTPCookie(properties: [.domain: ".bilibili.com", .path: "/", .name: name,
+                                                        .value: value, .secure: "TRUE"]) {
+                    await store.setCookie(cookie)
+                }
+            }
+            webView.load(URLRequest(url: url))
+        }
+    }
+
+    @objc private func retryTapped() {
+        let retry = onRetry
+        window.close()
+        retry()
+    }
+
+    @objc private func closeTapped() {
+        window.close()
+    }
+
+    func windowWillClose(_ notification: Notification) {
+        webView.stopLoading()
+        Self.current = nil
+    }
+
+    func webView(_ webView: WKWebView, didFinish navigation: WKNavigation!) {
+        status.stringValue = "请按页面提示完成验证，然后点击「验证完成，重试开播」"
+    }
+
+    func webView(_ webView: WKWebView, didFail navigation: WKNavigation!, withError error: Error) {
+        status.stringValue = "验证页面加载失败，请关闭后重新开播"
+    }
+
+    func webView(_ webView: WKWebView, didFailProvisionalNavigation navigation: WKNavigation!, withError error: Error) {
+        status.stringValue = "验证页面加载失败，请关闭后重新开播"
+    }
+}
+
+/// Opens the verification window for the ready account. When the user
+/// confirms, emits {"event":"faceAuthRetry"} so the dock retries Go live.
+@_cdecl("livehime_core_open_face_auth")
+public func livehime_core_open_face_auth(_ voucher: UnsafePointer<CChar>?) {
+    let voucherText = voucher.map { String(cString: $0) }
+    DispatchQueue.main.async {
+        MainActor.assumeIsolated {
+            guard let bridge = CoreBridge.shared, let credentials = bridge.coordinator.credentials else { return }
+            FaceAuthWindowController.present(voucher: voucherText, credentials: credentials) {
+                CoreBridge.shared?.emit(["event": "faceAuthRetry"])
+            }
+        }
+    }
+}
