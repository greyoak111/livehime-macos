 {
 	/* Delivered on the main thread by the core. Never log the raw JSON:
@@ -245,6 +265,13 @@ void AccountPanel::onStreamStateChanged(StreamController::State state)
 	const bool roomOpen = state_.value("liveStatus").toInt() == 1;
 	if (state == State::Live && stream_->ownsSession()) {
 		setLiveStatus(text("LiveHime.Live.OnAir"));
+	} else if (state == State::Stopping && ownStream_ && !stopping_) {
+		/* Stopped from OBS's own controls: end the live session like End
+		 * live does, so the Bilibili room does not stay open. */
+		blog(LOG_INFO, "[livehime] OBS stop streaming -> End live");
+		stopping_ = true;
+		setLiveStatus(text("LiveHime.Live.Ending"));
+		livehime_core_stop_live();
 	} else if ((state == State::Idle || state == State::Failed) && ownStream_) {
 		/* Stopped outside End live (OBS's own button, or an output error):
 		 * the Bilibili room is still open. */
