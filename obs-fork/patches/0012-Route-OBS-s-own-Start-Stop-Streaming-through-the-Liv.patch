+/* OBS's own Start Streaming (button, hotkey, tray). With a ready Bilibili
+ * account it becomes Go live, so the stream always carries the room's
+ * current endpoint; signed out, OBS streams with the user's own settings. */
+bool AccountPanel::onStartStreamingRequest(void *context)
+{
+	if (StreamController::isStartingInternally())
+		return false;
+	auto *self = static_cast<AccountPanel *>(context);
+	if (self->state_.value("state").toString() != "ready")
+		return false;
+	if (self->goLive_->isEnabled()) {
+		blog(LOG_INFO, "[livehime] OBS start streaming -> Go live");
+		self->onGoLive();
+	}
+	return true;
+}
