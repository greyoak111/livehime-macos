+#include "plugin-settings.hpp"
+
+#include <obs-module.h>
+#include <util/platform.h>
+#include <util/util.hpp>
+
+OBSDataAutoRelease LoadPluginSettings()
+{
+	BPtr<char> path = obs_module_config_path("features.json");
+	obs_data_t *data = path ? obs_data_create_from_json_file_safe(path, "bak") : nullptr;
+	return OBSDataAutoRelease(data ? data : obs_data_create());
+}
+
+void SavePluginSettings(obs_data_t *changes)
+{
+	BPtr<char> dir = obs_module_config_path("");
+	BPtr<char> path = obs_module_config_path("features.json");
+	if (!dir || !path)
+		return;
+	os_mkdirs(dir);
+	OBSDataAutoRelease data = LoadPluginSettings();
+	obs_data_apply(data, changes);
+	obs_data_save_json_safe(data, path, "tmp", "bak");
+}
