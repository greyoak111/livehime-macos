+/* Asks the host application for per-window capture overrides. Returns a
+ * newly allocated "<visible ids>|<hidden ids>" string, or NULL when no
+ * application provides the "hide_obs_window_exceptions" procedure. */
+static char *query_hide_obs_exceptions(void)
+{
+    char *ids = NULL;
+    calldata_t cd = {0};
+    if (proc_handler_call(obs_get_proc_handler(), "hide_obs_window_exceptions", &cd)) {
+        const char *visible = calldata_string(&cd, "window_ids");
+        const char *hidden = calldata_string(&cd, "hidden_window_ids");
+        struct dstr joined = {0};
+        dstr_printf(&joined, "%s|%s", visible ? visible : "", hidden ? hidden : "");
+        ids = joined.array;
+    }
+    calldata_free(&cd);
+    return ids;
+}
+
+/* Windows from one half ("visible" = 0, "hidden" = 1) of the override list. */
+API_AVAILABLE(macos(12.5)) static NSArray *hide_obs_exception_windows(struct screen_capture *sc, int half)
+{
+    NSMutableArray *windows = [[NSMutableArray alloc] init];
+    if (!sc->hide_obs_exceptions)
+        return windows;
+    NSArray *halves = [[NSString stringWithUTF8String:sc->hide_obs_exceptions] componentsSeparatedByString:@"|"];
+    if ((NSInteger) halves.count <= half)
+        return windows;
+    NSString *list = halves[half];
+    NSMutableSet *ids = [NSMutableSet set];
+    for (NSString *part in [list componentsSeparatedByString:@","])
+        if (part.integerValue > 0)
+            [ids addObject:@(part.integerValue)];
+    for (SCWindow *window in sc->shareable_content.windows) {
+        if ([ids containsObject:@(window.windowID)])
+            [windows addObject:window];
+    }
+    return windows;
+}
