diff --git a/build-aux/livehime/tests/e2e-floating.mjs b/build-aux/livehime/tests/e2e-floating.mjs
new file mode 100644
index 000000000..20f5b3307
--- /dev/null
+++ b/build-aux/livehime/tests/e2e-floating.mjs
@@ -0,0 +1,160 @@
+// Floating chat: options, feed, and whether screen capture sees the window.
+// Usage: node e2e-floating.mjs <ws password> <screen width pt> <screen height pt> <crop dir>
+// Needs an active "macOS 屏幕采集" source in the program scene.
+import { createHash } from 'node:crypto';
+import zlib from 'node:zlib';
+import { writeFileSync } from 'node:fs';
+
+const [password, screenW, screenH] = [process.argv[2], Number(process.argv[3]), Number(process.argv[4])];
+const sha = (s) => createHash('sha256').update(s).digest('base64');
+const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
+const ws = new WebSocket('ws://127.0.0.1:4466');
+let id = 1;
+const pend = new Map();
+const req = (t, d = {}) => new Promise((r) => { const k = String(id++); pend.set(k, r); ws.send(JSON.stringify({ op: 6, d: { requestType: t, requestId: k, requestData: d } })); });
+const vendor = async (t, d = {}) => (await req('CallVendorRequest', { vendorName: 'livehime', requestType: t, requestData: d })).responseData?.responseData;
+let fails = 0;
+const check = (n, ok, i = '') => { if (!ok) fails++; console.log(`${ok ? 'PASS' : 'FAIL'}  ${n}${i ? '  — ' + i : ''}`); };
+
+function decode(png) {
+  let o = 8, w = 0, h = 0; const idat = [];
+  while (o < png.length) {
+    const len = png.readUInt32BE(o), type = png.toString('ascii', o + 4, o + 8), data = png.subarray(o + 8, o + 8 + len);
+    if (type === 'IHDR') { w = data.readUInt32BE(0); h = data.readUInt32BE(4); }
+    if (type === 'IDAT') idat.push(data);
+    o += 12 + len;
+  }
+  const raw = zlib.inflateSync(Buffer.concat(idat)), stride = w * 4, out = Buffer.alloc(w * h * 4); let prev = Buffer.alloc(stride);
+  for (let y = 0; y < h; y++) {
+    const f = raw[y * (stride + 1)], line = Buffer.from(raw.subarray(y * (stride + 1) + 1, (y + 1) * (stride + 1)));
+    for (let x = 0; x < stride; x++) {
+      const a = x >= 4 ? line[x - 4] : 0, b = prev[x], c = x >= 4 ? prev[x - 4] : 0;
+      const p = f === 1 ? a : f === 2 ? b : f === 3 ? (a + b) >> 1 : f === 4 ? (() => { const pa = Math.abs(b - c), pb = Math.abs(a - c), pc = Math.abs(a + b - 2 * c); return pa <= pb && pa <= pc ? a : pb <= pc ? b : c; })() : 0;
+      line[x] = (line[x] + p) & 255;
+    }
+    line.copy(out, y * stride); prev = line;
+  }
+  return { w, h, px: out };
+}
+// Mean per-pixel difference (0-255) between two captures over a rectangle in screen points.
+function pixdiff(a, b, x, y, w, h) {
+  const sx = a.w / screenW, sy = a.h / screenH; let sum = 0, n = 0;
+  for (let py = Math.round(y * sy); py < Math.round((y + h) * sy); py += 2)
+    for (let px = Math.round(x * sx); px < Math.round((x + w) * sx); px += 2) {
+      const i = (py * a.w + px) * 4;
+      sum += (Math.abs(a.px[i] - b.px[i]) + Math.abs(a.px[i + 1] - b.px[i + 1]) + Math.abs(a.px[i + 2] - b.px[i + 2])) / 3; n++;
+    }
+  return sum / n;
+}
+// Mean luminance of a rectangle given in screen points.
+function luma(img, x, y, w, h) {
+  const sx = img.w / screenW, sy = img.h / screenH; let sum = 0, n = 0;
+  for (let py = Math.round(y * sy); py < Math.round((y + h) * sy); py += 2)
+    for (let px = Math.round(x * sx); px < Math.round((x + w) * sx); px += 2) {
+      const i = (py * img.w + px) * 4; sum += 0.2126 * img.px[i] + 0.7152 * img.px[i + 1] + 0.0722 * img.px[i + 2]; n++;
+    }
+  return sum / n;
+}
+async function capture(input) {
+  // Screen capture needs a moment to deliver its first frame.
+  let last;
+  for (let i = 0; i < 20; i++) {
+    const r = await req('GetSourceScreenshot', { sourceName: input, imageFormat: 'png' });
+    if (r.requestStatus.result) return decode(Buffer.from(r.responseData.imageData.split(',')[1], 'base64'));
+    last = r.requestStatus.comment; await sleep(500);
+  }
+  throw new Error('screenshot failed: ' + last);
+}
+
+ws.onmessage = async (ev) => {
+  const m = JSON.parse(ev.data);
+  if (m.op === 0) { const { challenge, salt } = m.d.authentication; ws.send(JSON.stringify({ op: 1, d: { rpcVersion: 1, authentication: sha(sha(password + salt) + challenge), eventSubscriptions: 0 } })); }
+  else if (m.op === 7) pend.get(m.d.requestId)?.(m.d);
+  else if (m.op === 2) {
+    for (let i = 0; i < 40 && !(await req('GetVersion')).requestStatus.result; i++) await sleep(500);
+    const win = { x: 120, y: 140, w: 360, h: 460 };
+    let s = await vendor('FloatingChat', { visible: true, ...win, on_top: true, pinned: false, capturable: false, opacity: 85 });
+    check('floating chat opens at the requested place', s.visible && s.x === win.x && s.w === win.w, JSON.stringify({ x: s.x, y: s.y, w: s.w, h: s.h }));
+    check('opacity 85% applied', Math.abs(s.window_opacity - 0.85) < 0.01, String(s.window_opacity));
+    s = await vendor('FloatingChat', { opacity: 20 });
+    check('opacity clamps to 50%', s.opacity === 50, String(s.opacity));
+    s = await vendor('FloatingChat', { opacity: 85 });
+
+    const before = s.lines;
+    for (const [user, text] of [['观众A', '主播晚上好'], ['观众B', '悬浮窗测试']]) await vendor('InjectOverlayEvent', { kind: 'chat', user, text, uid: 7 });
+    await vendor('InjectOverlayEvent', { kind: 'superChat', user: '观众C', text: '加油', price: 30, seconds: 60 });
+    await sleep(300);
+    s = await vendor('FloatingChat', {});
+    check('floating feed receives room events', s.lines - before === 3, `${s.lines - before} new lines`);
+
+    // Screen capture only delivers frames while active, so use the program
+    // scene's existing screen capture source (read-only screenshots).
+    const inputs = (await req('GetInputList', { inputKind: 'screen_capture' })).responseData.inputs;
+    const inner = { x: win.x + 20, y: win.y + 60, w: win.w - 40, h: win.h - 120 };
+    const L = (img) => luma(img, inner.x, inner.y, inner.w, inner.h);
+    try {
+    if (!inputs.length) throw new Error('no screen capture source in the profile');
+    const input = inputs[0].inputName;
+    check('using active screen capture source', true, input);
+
+    const shots = {};
+    const settle = () => sleep(2500);
+    await vendor('FloatingChat', { visible: false }); await settle();
+    shots.A_closed = await capture(input);
+    await vendor('FloatingChat', { visible: true, capturable: false }); await settle();
+    shots.B_hidden = await capture(input);
+    await vendor('FloatingChat', { capturable: true }); await settle();
+    shots.C_shown = await capture(input);
+    await vendor('FloatingChat', { capturable: false }); await settle();
+    shots.D_hidden = await capture(input);
+    for (const [k, img] of Object.entries(shots)) {
+      // Save the window area (raw RGBA) for inspection.
+      const sx = img.w / screenW, x0 = Math.round(win.x * sx), y0 = Math.round(win.y * sx), w = Math.round(win.w * sx), h = Math.round(win.h * sx);
+      const crop = Buffer.alloc(w * h * 4);
+      for (let y = 0; y < h; y++) img.px.copy(crop, y * w * 4, ((y0 + y) * img.w + x0) * 4, ((y0 + y) * img.w + x0 + w) * 4);
+      writeFileSync(process.argv[5] + '/' + k + '.rgba', crop); writeFileSync(process.argv[5] + '/' + k + '.size', `${w}x${h}`);
+      console.log(k, 'window-area luminance', L(img).toFixed(1));
+    }
+    const d = (a, b) => Math.abs(L(a) - L(b));
+    check('hidden: capture shows the desktop, not the window', d(shots.B_hidden, shots.A_closed) < 12, d(shots.B_hidden, shots.A_closed).toFixed(1));
+    check('allowed: capture shows the window', d(shots.C_shown, shots.A_closed) > 30, d(shots.C_shown, shots.A_closed).toFixed(1));
+    check('hidden again after toggling back', d(shots.D_hidden, shots.A_closed) < 12, d(shots.D_hidden, shots.A_closed).toFixed(1));
+    } catch (e) { check('capture comparison', false, e.message); }
+    finally {}
+
+    // Same check through a capture that does NOT hide LiveHime: the
+    // per-window override must still leave the window out unless allowed.
+    // Temporary source in the program scene, always removed. Whatever lies
+    // behind the window differs from it pixel by pixel, so compare pixels.
+    const scene = (await req('GetCurrentProgramScene')).responseData.currentProgramSceneName;
+    const probe = 'livehime-e2e-nohide';
+    const template = (await req('GetInputSettings', { inputName: inputs[0].inputName })).responseData.inputSettings;
+    try {
+      const made = await req('CreateInput', { sceneName: scene, inputName: probe, inputKind: 'screen_capture', inputSettings: { ...template, hide_obs: false } });
+      check('temporary no-hide capture created', made.requestStatus.result, made.requestStatus.comment);
+      await vendor('FloatingChat', { visible: false }); await sleep(2500);
+      const a = await capture(probe);
+      await vendor('FloatingChat', { visible: true, capturable: false }); await sleep(2500);
+      const b = await capture(probe);
+      await vendor('FloatingChat', { capturable: true }); await sleep(2500);
+      const c = await capture(probe);
+      await vendor('FloatingChat', { capturable: false }); await sleep(2500);
+      const d = await capture(probe);
+      const P = (x, y) => pixdiff(x, y, inner.x, inner.y, inner.w, inner.h);
+      console.log(`no-hide capture pixel diff vs closed: notAllowed=${P(b, a).toFixed(1)} allowed=${P(c, a).toFixed(1)} notAllowedAgain=${P(d, a).toFixed(1)}`);
+      check('no-hide capture: window hidden when not allowed', P(b, a) < 4, P(b, a).toFixed(1));
+      check('no-hide capture: window shown when allowed', P(c, a) > 10, P(c, a).toFixed(1));
+      check('no-hide capture: hidden again after toggling back', P(d, a) < 4, P(d, a).toFixed(1));
+    } catch (e) { check('no-hide capture comparison', false, e.message); }
+    finally { await req('RemoveInput', { inputName: probe }); }
+    let left = [];
+    for (let i = 0; i < 20; i++) { // removal completes asynchronously
+      left = (await req('GetInputList', { inputKind: 'screen_capture' })).responseData.inputs.map((i) => i.inputName);
+      if (!left.includes(probe)) break; await sleep(250);
+    }
+    check('temporary source removed', !left.includes(probe), left.join(','));
+    s = await vendor('FloatingChat', { visible: false });
+    check('floating chat closes', !s.visible);
+    console.log(fails ? `${fails} failed` : 'all passed'); process.exit(fails ? 1 : 0);
+  }
+};
