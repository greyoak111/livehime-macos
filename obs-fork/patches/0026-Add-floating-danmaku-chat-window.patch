diff --git a/plugins/livehime/src/floating-chat.cpp b/plugins/livehime/src/floating-chat.cpp
new file mode 100644
index 000000000..3f6d1b465
--- /dev/null
+++ b/plugins/livehime/src/floating-chat.cpp
@@ -0,0 +1,296 @@
+#include "floating-chat.hpp"
+#include "danmaku-feed.hpp"
+#include "plugin-settings.hpp"
+#include "window-native.hpp"
+
+#include <obs-module.h>
+
+#include <QCheckBox>
+#include <QGuiApplication>
+#include <QHBoxLayout>
+#include <QLabel>
+#include <QMenu>
+#include <QMouseEvent>
+#include <QScreen>
+#include <QSizeGrip>
+#include <QSlider>
+#include <QToolButton>
+#include <QVBoxLayout>
+#include <QWidgetAction>
+
+#include <algorithm>
+
+namespace {
+QString text(const char *key)
+{
+	return QString::fromUtf8(obs_module_text(key));
+}
+
+constexpr int kMinOpacity = 50;
+constexpr int kMaxOpacity = 100;
+
+QToolButton *titleButton(QWidget *parent, const QString &label, const QString &tip, bool checkable)
+{
+	auto *button = new QToolButton(parent);
+	button->setText(label);
+	button->setToolTip(tip);
+	button->setCheckable(checkable);
+	button->setAutoRaise(true);
+	button->setFocusPolicy(Qt::NoFocus);
+	return button;
+}
+} // namespace
+
+FloatingChat::FloatingChat(QWidget *parent) : QWidget(parent, Qt::Tool | Qt::FramelessWindowHint)
+{
+	setObjectName(QStringLiteral("LiveHimeFloatingChat"));
+	setWindowTitle(text("LiveHime.Floating.Title"));
+	setAttribute(Qt::WA_MacAlwaysShowToolWindow);
+	setMinimumSize(260, 220);
+	setStyleSheet(QStringLiteral("#LiveHimeFloatingChat { background: #1d2025; border: 1px solid #3a3f48; border-radius: 6px; }"
+				     "#LiveHimeFloatingTitle { background: #252931; border-top-left-radius: 6px;"
+				     " border-top-right-radius: 6px; }"));
+
+	titleBar_ = new QWidget(this);
+	titleBar_->setObjectName(QStringLiteral("LiveHimeFloatingTitle"));
+	titleBar_->setCursor(Qt::OpenHandCursor);
+	auto *title = new QLabel(text("LiveHime.Floating.Title"), titleBar_);
+	title->setStyleSheet(QStringLiteral("font-weight: 600;"));
+	onTop_ = titleButton(titleBar_, text("LiveHime.Floating.OnTop"), text("LiveHime.Floating.OnTopTip"), true);
+	pin_ = titleButton(titleBar_, text("LiveHime.Floating.Pin"), text("LiveHime.Floating.PinTip"), true);
+	more_ = titleButton(titleBar_, QStringLiteral("⋯"), text("LiveHime.Floating.More"), false);
+	auto *close = titleButton(titleBar_, QStringLiteral("✕"), text("LiveHime.Floating.Close"), false);
+	auto *titleLayout = new QHBoxLayout(titleBar_);
+	titleLayout->setContentsMargins(10, 4, 6, 4);
+	titleLayout->addWidget(title, 1);
+	titleLayout->addWidget(onTop_);
+	titleLayout->addWidget(pin_);
+	titleLayout->addWidget(more_);
+	titleLayout->addWidget(close);
+
+	/* "⋯" menu: opacity and screen-capture visibility. */
+	auto *menu = new QMenu(this);
+	auto *opacityRow = new QWidget(menu);
+	auto *opacityLayout = new QHBoxLayout(opacityRow);
+	opacityLayout->setContentsMargins(12, 6, 12, 6);
+	opacityLayout->addWidget(new QLabel(text("LiveHime.Floating.Opacity"), opacityRow));
+	opacity_ = new QSlider(Qt::Horizontal, opacityRow);
+	opacity_->setRange(kMinOpacity, kMaxOpacity);
+	opacity_->setMinimumWidth(140);
+	opacityValue_ = new QLabel(opacityRow);
+	opacityValue_->setMinimumWidth(38);
+	opacityLayout->addWidget(opacity_, 1);
+	opacityLayout->addWidget(opacityValue_);
+	auto *opacityAction = new QWidgetAction(menu);
+	opacityAction->setDefaultWidget(opacityRow);
+	menu->addAction(opacityAction);
+	auto *captureRow = new QWidget(menu);
+	auto *captureLayout = new QHBoxLayout(captureRow);
+	captureLayout->setContentsMargins(12, 2, 12, 6);
+	capturable_ = new QCheckBox(text("LiveHime.Floating.Capturable"), captureRow);
+	capturable_->setToolTip(text("LiveHime.Floating.CapturableTip"));
+	captureLayout->addWidget(capturable_);
+	auto *captureAction = new QWidgetAction(menu);
+	captureAction->setDefaultWidget(captureRow);
+	menu->addAction(captureAction);
+	connect(more_, &QToolButton::clicked, this,
+		[this, menu] { menu->exec(more_->mapToGlobal(QPoint(0, more_->height()))); });
+
+	feed_ = new DanmakuFeed(true, this);
+	grip_ = new QSizeGrip(this);
+
+	auto *body = new QVBoxLayout;
+	body->setContentsMargins(8, 6, 8, 2);
+	body->addWidget(feed_, 1);
+	auto *gripRow = new QHBoxLayout;
+	gripRow->setContentsMargins(0, 0, 2, 2);
+	gripRow->addStretch(1);
+	gripRow->addWidget(grip_, 0, Qt::AlignBottom | Qt::AlignRight);
+	auto *layout = new QVBoxLayout(this);
+	layout->setContentsMargins(1, 1, 1, 1);
+	layout->setSpacing(0);
+	layout->addWidget(titleBar_);
+	layout->addLayout(body, 1);
+	layout->addLayout(gripRow);
+
+	connect(close, &QToolButton::clicked, this, &QWidget::hide);
+	connect(onTop_, &QToolButton::toggled, this, [this](bool on) {
+		options_.onTop = on;
+		applyOptions();
+		save();
+	});
+	connect(pin_, &QToolButton::toggled, this, [this](bool on) {
+		options_.pinned = on;
+		applyOptions();
+		save();
+	});
+	connect(opacity_, &QSlider::valueChanged, this, [this](int value) {
+		options_.opacity = value;
+		applyOptions();
+	});
+	connect(opacity_, &QSlider::sliderReleased, this, &FloatingChat::save);
+	connect(capturable_, &QCheckBox::toggled, this, [this](bool on) {
+		options_.capturable = on;
+		applyOptions();
+		save();
+	});
+
+	saveTimer_.setSingleShot(true);
+	saveTimer_.setInterval(400);
+	connect(&saveTimer_, &QTimer::timeout, this, &FloatingChat::save);
+
+	load();
+}
+
+void FloatingChat::toggle()
+{
+	if (isVisible()) {
+		hide();
+	} else {
+		show();
+		raise();
+		activateWindow();
+	}
+}
+
+void FloatingChat::setOptions(const Options &options)
+{
+	options_ = options;
+	applyOptions();
+	save();
+}
+
+void FloatingChat::applyOptions()
+{
+	options_.opacity = std::clamp(options_.opacity, kMinOpacity, kMaxOpacity);
+	QSignalBlocker blockTop(onTop_);
+	QSignalBlocker blockPin(pin_);
+	QSignalBlocker blockOpacity(opacity_);
+	QSignalBlocker blockCapture(capturable_);
+	onTop_->setChecked(options_.onTop);
+	pin_->setChecked(options_.pinned);
+	opacity_->setValue(options_.opacity);
+	capturable_->setChecked(options_.capturable);
+	opacityValue_->setText(QStringLiteral("%1%").arg(options_.opacity));
+
+	setWindowOpacity(options_.opacity / 100.0);
+	grip_->setVisible(!options_.pinned);
+	titleBar_->setCursor(options_.pinned ? Qt::ArrowCursor : Qt::OpenHandCursor);
+	if (windowHandle())
+		ApplyNativeWindowOptions(this, options_.onTop, options_.capturable);
+	updateCaptureException();
+}
+
+void FloatingChat::updateCaptureException()
+{
+	/* OBS's screen capture follows the user's choice either way: shown when
+	 * allowed even if the capture hides LiveHime, left out when not allowed
+	 * even if it does not. */
+	const unsigned int id = isVisible() && windowHandle() ? NativeWindowNumber(this) : 0;
+	SetCaptureException("floating_chat", id, options_.capturable);
+}
+
+void FloatingChat::mousePressEvent(QMouseEvent *event)
+{
+	if (!options_.pinned && event->button() == Qt::LeftButton && titleBar_->geometry().contains(event->pos())) {
+		dragging_ = true;
+		dragOffset_ = event->globalPosition().toPoint() - frameGeometry().topLeft();
+		titleBar_->setCursor(Qt::ClosedHandCursor);
+		event->accept();
+		return;
+	}
+	QWidget::mousePressEvent(event);
+}
+
+void FloatingChat::mouseMoveEvent(QMouseEvent *event)
+{
+	if (dragging_) {
+		move(event->globalPosition().toPoint() - dragOffset_);
+		event->accept();
+		return;
+	}
+	QWidget::mouseMoveEvent(event);
+}
+
+void FloatingChat::mouseReleaseEvent(QMouseEvent *event)
+{
+	if (dragging_) {
+		dragging_ = false;
+		titleBar_->setCursor(options_.pinned ? Qt::ArrowCursor : Qt::OpenHandCursor);
+		save();
+		event->accept();
+		return;
+	}
+	QWidget::mouseReleaseEvent(event);
+}
+
+void FloatingChat::showEvent(QShowEvent *event)
+{
+	QWidget::showEvent(event);
+	/* The native window exists once shown; apply level/sharing to it. */
+	applyOptions();
+	save();
+}
+
+void FloatingChat::hideEvent(QHideEvent *event)
+{
+	QWidget::hideEvent(event);
+	updateCaptureException();
+	save();
+}
+
+void FloatingChat::resizeEvent(QResizeEvent *event)
+{
+	QWidget::resizeEvent(event);
+	if (isVisible())
+		saveTimer_.start();
+}
+
+void FloatingChat::load()
+{
+	OBSDataAutoRelease settings = LoadPluginSettings();
+	OBSDataAutoRelease floating = obs_data_get_obj(settings, "floating_chat");
+	if (floating) {
+		options_.onTop = !obs_data_has_user_value(floating, "on_top") || obs_data_get_bool(floating, "on_top");
+		options_.pinned = obs_data_get_bool(floating, "pinned");
+		options_.capturable = obs_data_get_bool(floating, "capturable");
+		if (obs_data_has_user_value(floating, "opacity"))
+			options_.opacity = static_cast<int>(obs_data_get_int(floating, "opacity"));
+	}
+	QRect geometry(0, 0, 340, 460);
+	if (floating && obs_data_has_user_value(floating, "w")) {
+		geometry = QRect(static_cast<int>(obs_data_get_int(floating, "x")),
+				 static_cast<int>(obs_data_get_int(floating, "y")),
+				 static_cast<int>(obs_data_get_int(floating, "w")),
+				 static_cast<int>(obs_data_get_int(floating, "h")));
+	}
+	/* Keep it reachable if the saved screen is gone. */
+	QScreen *screen = QGuiApplication::screenAt(geometry.center());
+	if (!screen) {
+		screen = QGuiApplication::primaryScreen();
+		const QRect area = screen->availableGeometry();
+		geometry.moveTopLeft(QPoint(area.right() - geometry.width() - 40, area.top() + 80));
+	}
+	setGeometry(geometry);
+	applyOptions();
+	loaded_ = true;
+}
+
+void FloatingChat::save()
+{
+	if (!loaded_)
+		return;
+	OBSDataAutoRelease floating = obs_data_create();
+	const QRect geometry = this->geometry();
+	obs_data_set_int(floating, "x", geometry.x());
+	obs_data_set_int(floating, "y", geometry.y());
+	obs_data_set_int(floating, "w", geometry.width());
+	obs_data_set_int(floating, "h", geometry.height());
+	obs_data_set_bool(floating, "on_top", options_.onTop);
+	obs_data_set_bool(floating, "pinned", options_.pinned);
+	obs_data_set_bool(floating, "capturable", options_.capturable);
+	obs_data_set_int(floating, "opacity", options_.opacity);
+	OBSDataAutoRelease changes = obs_data_create();
+	obs_data_set_obj(changes, "floating_chat", floating);
+	SavePluginSettings(changes);
+}
