+#include "window-native.hpp"
+
+#import <AppKit/AppKit.h>
+#include <QWidget>
+
+#include <obs.h>
+
+#include <map>
+#include <mutex>
+#include <string>
+
+void ApplyNativeWindowOptions(QWidget *window, bool floating, bool capturable)
+{
+	NSView *view = (__bridge NSView *)reinterpret_cast<void *>(window->winId());
+	NSWindow *nswindow = view.window;
+	if (!nswindow)
+		return;
+	nswindow.hidesOnDeactivate = NO;
+	nswindow.level = floating ? NSFloatingWindowLevel : NSNormalWindowLevel;
+	NSWindowCollectionBehavior behavior = NSWindowCollectionBehaviorFullScreenAuxiliary;
+	if (floating)
+		behavior |= NSWindowCollectionBehaviorCanJoinAllSpaces;
+	nswindow.collectionBehavior = behavior;
+	nswindow.sharingType = capturable ? NSWindowSharingReadOnly : NSWindowSharingNone;
+}
+
+unsigned int NativeWindowNumber(QWidget *window)
+{
+	NSView *view = (__bridge NSView *)reinterpret_cast<void *>(window->winId());
+	return view.window ? static_cast<unsigned int>(view.window.windowNumber) : 0;
+}
+
+namespace {
+std::mutex exceptionsMutex;
+std::map<std::string, std::pair<unsigned int, bool>> exceptions; /* key -> (id, visible) */
+
+void exceptionProcedure(void *, calldata_t *cd)
+{
+	std::string visible, hidden;
+	{
+		std::lock_guard lock(exceptionsMutex);
+		for (const auto &[key, entry] : exceptions) {
+			std::string &list = entry.second ? visible : hidden;
+			if (!list.empty())
+				list += ",";
+			list += std::to_string(entry.first);
+		}
+	}
+	calldata_set_string(cd, "window_ids", visible.c_str());
+	calldata_set_string(cd, "hidden_window_ids", hidden.c_str());
+}
+} // namespace
+
+void RegisterCaptureExceptionProcedure()
+{
+	proc_handler_add(obs_get_proc_handler(),
+			 "void hide_obs_window_exceptions(out string window_ids, out string hidden_window_ids)",
+			 exceptionProcedure, nullptr);
+}
+
+void SetCaptureException(const char *key, unsigned int id, bool visible)
+{
+	std::lock_guard lock(exceptionsMutex);
+	if (id)
+		exceptions[key] = {id, visible};
+	else
+		exceptions.erase(key);
+}
