diff --git a/plugins/livehime/src/danmaku-feed.cpp b/plugins/livehime/src/danmaku-feed.cpp
new file mode 100644
index 000000000..1c8167913
--- /dev/null
+++ b/plugins/livehime/src/danmaku-feed.cpp
@@ -0,0 +1,205 @@
+#include "danmaku-feed.hpp"
+
+#include <livehime-core.h>
+#include <obs-module.h>
+
+#include <QApplication>
+#include <QClipboard>
+#include <QHBoxLayout>
+#include <QLabel>
+#include <QLineEdit>
+#include <QListWidget>
+#include <QMenu>
+#include <QPushButton>
+#include <QScrollBar>
+#include <QTimer>
+#include <QVBoxLayout>
+
+#include <algorithm>
+
+namespace {
+QString text(const char *key)
+{
+	return QString::fromUtf8(obs_module_text(key));
+}
+
+constexpr int kMaxFeedItems = 300;
+} // namespace
+
+DanmakuFeed::DanmakuFeed(bool compact, QWidget *parent) : QWidget(parent)
+{
+	pinned_ = new QLabel(this);
+	pinned_->setWordWrap(true);
+	pinned_->setStyleSheet(QStringLiteral(
+		"QLabel { background: #3a2226; color: #ffd7da; border-left: 3px solid #fb4d5a; padding: 6px; }"));
+	pinned_->hide();
+	pinnedTimer_ = new QTimer(this);
+	pinnedTimer_->setSingleShot(true);
+	connect(pinnedTimer_, &QTimer::timeout, pinned_, &QLabel::hide);
+
+	list_ = new QListWidget(this);
+	list_->setWordWrap(true);
+	list_->setUniformItemSizes(false);
+	list_->setSelectionMode(QAbstractItemView::ExtendedSelection);
+	list_->setContextMenuPolicy(Qt::CustomContextMenu);
+	connect(list_, &QListWidget::customContextMenuRequested, this, &DanmakuFeed::showMenu);
+	if (compact)
+		list_->setFrameShape(QFrame::NoFrame);
+
+	message_ = new QLineEdit(this);
+	message_->setPlaceholderText(text("LiveHime.Feature.MessagePlaceholder"));
+	message_->setMaxLength(40);
+	send_ = new QPushButton(text("LiveHime.Feature.Send"), this);
+	connect(send_, &QPushButton::clicked, this, &DanmakuFeed::send);
+	connect(message_, &QLineEdit::returnPressed, this, &DanmakuFeed::send);
+	auto *sendRow = new QHBoxLayout;
+	sendRow->addWidget(message_, 1);
+	sendRow->addWidget(send_);
+
+	auto *layout = new QVBoxLayout(this);
+	layout->setContentsMargins(0, 0, 0, 0);
+	layout->setSpacing(compact ? 4 : 6);
+	layout->addWidget(pinned_);
+	layout->addWidget(list_, 1);
+	layout->addLayout(sendRow);
+	setReady(false);
+}
+
+void DanmakuFeed::setFilters(bool showEntries, bool giftsOnly)
+{
+	showEntries_ = showEntries;
+	giftsOnly_ = giftsOnly;
+}
+
+void DanmakuFeed::setReady(bool ready)
+{
+	if (ready_ && !ready) {
+		list_->clear();
+		pinned_->hide();
+	}
+	ready_ = ready;
+	message_->setEnabled(ready);
+	send_->setEnabled(ready && !sending_);
+}
+
+void DanmakuFeed::handleEvent(const QJsonObject &event)
+{
+	const QString name = event.value("event").toString();
+	if (name == "danmakuSent") {
+		/* Only the feed that sent reacts; the other keeps its draft. */
+		if (!sending_)
+			return;
+		sending_ = false;
+		send_->setEnabled(ready_);
+		if (event.value("ok").toBool()) {
+			message_->clear();
+		} else {
+			const QString detail = event.value("message").toString();
+			append(text("LiveHime.Feature.SendFailed") + (detail.isEmpty() ? QString() : QStringLiteral("：") + detail),
+			       QStringLiteral("#e06c75"));
+		}
+		return;
+	}
+	if (name == "userMuted") {
+		const bool ok = event.value("ok").toBool();
+		const QString detail = event.value("message").toString();
+		append(ok ? text("LiveHime.Feature.Muted")
+			  : text("LiveHime.Feature.MuteFailed") + (detail.isEmpty() ? QString() : QStringLiteral("：") + detail),
+		       ok ? QStringLiteral("#9aa0ab") : QStringLiteral("#e06c75"));
+		return;
+	}
+	if (name != "room")
+		return;
+
+	const QString kind = event.value("kind").toString();
+	const QString user = event.value("user").toString();
+	if (kind == "chat") {
+		if (giftsOnly_)
+			return;
+		const QString medal = event.value("medal").toString();
+		append((medal.isEmpty() ? QString() : QStringLiteral("[%1] ").arg(medal)) + user + QStringLiteral("：") +
+			       event.value("text").toString(),
+		       QString(), event.value("uid").toVariant().toLongLong(), user);
+	} else if (kind == "gift") {
+		append(text("LiveHime.Feature.Gift").arg(user, event.value("name").toString()).arg(event.value("count").toInt()),
+		       QStringLiteral("#e0a040"));
+	} else if (kind == "superChat") {
+		const QString line =
+			text("LiveHime.Feature.SuperChat").arg(event.value("price").toInt()).arg(user, event.value("text").toString());
+		append(line, QStringLiteral("#fb4d5a"));
+		pinSuperChat(line, event.value("seconds").toInt());
+	} else if (kind == "guard") {
+		append(text("LiveHime.Feature.Guard").arg(user, event.value("name").toString()), QStringLiteral("#8994ee"));
+	} else if (kind == "enter" || kind == "follow" || kind == "share") {
+		if (!giftsOnly_ && (showEntries_ || kind == "follow")) {
+			const QByteArray key = "LiveHime.Feature.Interact." + kind.toUtf8();
+			append(text(key.constData()).arg(user), QStringLiteral("#6c717b"));
+		}
+	} else if (kind == "liveStarted" || kind == "liveEnded") {
+		append(text(kind == "liveStarted" ? "LiveHime.Feature.LiveStarted" : "LiveHime.Feature.LiveEnded"),
+		       QStringLiteral("#9aa0ab"));
+	}
+}
+
+int DanmakuFeed::lineCount() const
+{
+	return list_->count();
+}
+
+void DanmakuFeed::append(const QString &line, const QString &color, qint64 uid, const QString &user)
+{
+	QScrollBar *bar = list_->verticalScrollBar();
+	const bool atBottom = bar->value() >= bar->maximum() - 4;
+	auto *item = new QListWidgetItem(line);
+	if (!color.isEmpty())
+		item->setForeground(QColor(color));
+	if (uid > 0) {
+		item->setData(Qt::UserRole, uid);
+		item->setData(Qt::UserRole + 1, user);
+	}
+	list_->addItem(item);
+	while (list_->count() > kMaxFeedItems)
+		delete list_->takeItem(0);
+	/* Keep following new messages unless the user scrolled up to read. */
+	if (atBottom)
+		list_->scrollToBottom();
+}
+
+void DanmakuFeed::pinSuperChat(const QString &line, int seconds)
+{
+	/* Keep the latest Super Chat above the feed for its paid duration. */
+	pinned_->setText(line);
+	pinned_->show();
+	pinnedTimer_->start(std::max(seconds, 10) * 1000);
+}
+
+void DanmakuFeed::showMenu(const QPoint &pos)
+{
+	QListWidgetItem *item = list_->itemAt(pos);
+	if (!item)
+		return;
+	QMenu menu(this);
+	const QString line = item->text();
+	menu.addAction(text("LiveHime.Feature.Copy"), this, [line] { QApplication::clipboard()->setText(line); });
+	const qint64 uid = item->data(Qt::UserRole).toLongLong();
+	const QString user = item->data(Qt::UserRole + 1).toString();
+	if (uid > 0) {
+		QMenu *mute = menu.addMenu(text("LiveHime.Feature.MuteUser").arg(user));
+		const std::pair<const char *, int> choices[] = {{"LiveHime.Feature.MuteSession", 0},
+								{"LiveHime.Feature.MuteHour", 1},
+								{"LiveHime.Feature.MuteForever", -1}};
+		for (const auto &[label, hours] : choices)
+			mute->addAction(text(label), this, [uid, hours = hours] { livehime_core_mute_user(uid, hours); });
+	}
+	menu.exec(list_->viewport()->mapToGlobal(pos));
+}
+
+void DanmakuFeed::send()
+{
+	const QByteArray message = message_->text().trimmed().toUtf8();
+	if (!ready_ || sending_ || message.isEmpty())
+		return;
+	sending_ = true;
+	send_->setEnabled(false);
+	livehime_core_send_danmaku(message.constData());
+}
