+/* Floating chat control for tests: optional visible, on_top, pinned,
+ * capturable, opacity, and geometry x/y/w/h (points). Replies with the
+ * resulting state. */
+void floatingChat(obs_data_t *request, obs_data_t *response, void *)
+{
+	onUiThread([&] {
+		FloatingChat *chat = target->features()->floatingChat();
+		FloatingChat::Options options = chat->options();
+		if (obs_data_has_user_value(request, "on_top"))
+			options.onTop = obs_data_get_bool(request, "on_top");
+		if (obs_data_has_user_value(request, "pinned"))
+			options.pinned = obs_data_get_bool(request, "pinned");
+		if (obs_data_has_user_value(request, "capturable"))
+			options.capturable = obs_data_get_bool(request, "capturable");
+		if (obs_data_has_user_value(request, "opacity"))
+			options.opacity = static_cast<int>(obs_data_get_int(request, "opacity"));
+		if (obs_data_has_user_value(request, "w"))
+			chat->setGeometry(static_cast<int>(obs_data_get_int(request, "x")),
+					  static_cast<int>(obs_data_get_int(request, "y")),
+					  static_cast<int>(obs_data_get_int(request, "w")),
+					  static_cast<int>(obs_data_get_int(request, "h")));
+		if (obs_data_has_user_value(request, "visible"))
+			chat->setVisible(obs_data_get_bool(request, "visible"));
+		chat->setOptions(options);
+		options = chat->options();
+		const QRect geometry = chat->geometry();
+		obs_data_set_bool(response, "visible", chat->isVisible());
+		obs_data_set_bool(response, "on_top", options.onTop);
+		obs_data_set_bool(response, "pinned", options.pinned);
