+void onFloatingHotkey(void *, obs_hotkey_id, obs_hotkey_t *, bool pressed)
+{
+	if (!pressed)
+		return;
+	/* Hotkeys fire on OBS's hotkey thread. */
+	QMetaObject::invokeMethod(
+		dock,
+		[] {
+			if (dock)
+				dock->features()->floatingChat()->toggle();
+		},
+		Qt::QueuedConnection);
+}
+
+void registerFloatingHotkey()
+{
+	floatingHotkey = obs_hotkey_register_frontend("livehime.toggle_floating_chat",
+						      obs_module_text("LiveHime.Floating.Hotkey"), onFloatingHotkey,
+						      nullptr);
+	OBSDataAutoRelease settings = LoadPluginSettings();
+	OBSDataArrayAutoRelease bindings = obs_data_get_array(settings, "floating_chat_hotkey");
+	if (bindings)
+		obs_hotkey_load(floatingHotkey, bindings);
+}
+
+void saveFloatingHotkey()
+{
+	if (floatingHotkey == OBS_INVALID_HOTKEY_ID)
+		return;
+	OBSDataArrayAutoRelease bindings = obs_hotkey_save(floatingHotkey);
+	OBSDataAutoRelease changes = obs_data_create();
+	obs_data_set_array(changes, "floating_chat_hotkey", bindings);
+	SavePluginSettings(changes);
+}
