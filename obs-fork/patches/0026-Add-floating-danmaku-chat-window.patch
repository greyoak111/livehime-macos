+	void mouseMoveEvent(QMouseEvent *event) override;
+	void mouseReleaseEvent(QMouseEvent *event) override;
+	void showEvent(QShowEvent *event) override;
+	void hideEvent(QHideEvent *event) override;
+	void resizeEvent(QResizeEvent *event) override;
+
+private:
+	void applyOptions();
+	void updateCaptureException();
+	void load();
+	void save();
+
+	Options options_;
+	DanmakuFeed *feed_;
+	QWidget *titleBar_;
+	QToolButton *onTop_;
+	QToolButton *pin_;
+	QToolButton *more_;
+	QSlider *opacity_;
+	QLabel *opacityValue_;
+	QCheckBox *capturable_;
+	QSizeGrip *grip_;
+	QPoint dragOffset_;
+	bool dragging_ = false;
+	bool loaded_ = false;
+	QTimer saveTimer_; /* debounces geometry saves while resizing */
+};
