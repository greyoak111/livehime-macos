@@ -0,0 +1,46 @@
+#pragma once
+
+#include <QJsonObject>
+#include <QWidget>
+
+class QLabel;
+class QLineEdit;
+class QListWidget;
+class QPushButton;
+class QTimer;
+
+/* The live danmaku feed with its send box: chat, gifts, Super Chats (the
+ * latest one pinned for its paid duration), guards and entries, a right-
+ * click menu to copy or mute, and sending. Used by the dock's danmaku tab
+ * and by the floating chat window, both fed from the same core events. */
+class DanmakuFeed : public QWidget {
+	Q_OBJECT
+
+public:
+	explicit DanmakuFeed(bool compact, QWidget *parent = nullptr);
+
+	void setFilters(bool showEntries, bool giftsOnly);
+	void setReady(bool ready);
+	/* Room events ("room"), and replies to this feed's actions
+	 * ("danmakuSent", "userMuted"). */
+	void handleEvent(const QJsonObject &event);
+	int lineCount() const;
+
+private:
+	void append(const QString &line, const QString &color = QString(), qint64 uid = 0,
+		    const QString &user = QString());
+	void pinSuperChat(const QString &line, int seconds);
+	void showMenu(const QPoint &pos);
+	void send();
+
+	bool showEntries_ = false;
+	bool giftsOnly_ = false;
+	bool ready_ = false;
+	bool sending_ = false;
+
+	QLabel *pinned_;
+	QTimer *pinnedTimer_;
+	QListWidget *list_;
+	QLineEdit *message_;
+	QPushButton *send_;
+};
