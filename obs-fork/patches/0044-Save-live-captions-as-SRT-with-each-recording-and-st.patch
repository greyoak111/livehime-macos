+import CoreMedia
 import XCTest
 @testable import LiveHimeCore
 
@@ -17,4 +18,19 @@ final class CaptionTextTests: XCTestCase {
     func testDropsPunctuationOnlyResults() {
         XCTAssertEqual(CaptionText.clean(" 。"), "")
     }
+
+    func testSpokenTimesComeFromTheAudioTimeline() throws {
+        guard #available(macOS 26, *) else { throw XCTSkip("SpeechAnalyzer needs macOS 26") }
+        let start = Date(timeIntervalSince1970: 1_000)
+        let now = start.addingTimeInterval(20)
+        let range = CMTimeRange(start: CMTime(seconds: 12.5, preferredTimescale: 1000),
+                                duration: CMTime(seconds: 2, preferredTimescale: 1000))
+        let (s, e) = LiveCaptioner.spoken(range, audioStart: start, text: "你好", now: now)
+        XCTAssertEqual(s.timeIntervalSince(start), 12.5, accuracy: 0.001)
+        XCTAssertEqual(e.timeIntervalSince(start), 14.5, accuracy: 0.001)
+        // No usable range: the sentence ends now and lasts about as long as it reads.
+        let (fs, fe) = LiveCaptioner.spoken(.invalid, audioStart: start, text: "一二三四五六七八", now: now)
+        XCTAssertEqual(fe, now)
+        XCTAssertEqual(fe.timeIntervalSince(fs), 2, accuracy: 0.001)
+    }
 }
