diff --git a/plugins/livehime/src/caption-recorder.cpp b/plugins/livehime/src/caption-recorder.cpp
new file mode 100644
index 000000000..23a54b4ee
--- /dev/null
+++ b/plugins/livehime/src/caption-recorder.cpp
@@ -0,0 +1,237 @@
+#include "caption-recorder.hpp"
+
+#include <obs-module.h>
+#include <util/bmem.h>
+
+#include <QDateTime>
+#include <QDir>
+#include <QFile>
+#include <QFileInfo>
+#include <QTimer>
+
+#include <algorithm>
+#include <cmath>
+
+namespace {
+double now()
+{
+	return QDateTime::currentMSecsSinceEpoch() / 1000.0;
+}
+
+QString takeString(char *value)
+{
+	QString result = value ? QString::fromUtf8(value) : QString();
+	bfree(value);
+	return result;
+}
+
+QString timestamp(double seconds)
+{
+	const qint64 ms = std::max<qint64>(0, std::llround(seconds * 1000));
+	return QStringLiteral("%1:%2:%3,%4")
+		.arg(ms / 3600000, 2, 10, QLatin1Char('0'))
+		.arg(ms / 60000 % 60, 2, 10, QLatin1Char('0'))
+		.arg(ms / 1000 % 60, 2, 10, QLatin1Char('0'))
+		.arg(ms % 1000, 3, 10, QLatin1Char('0'));
+}
+
+/* A finished caption arrives about a second after it was spoken; wait that
+ * long after a stop before writing. */
+constexpr int kLateCaptionMs = 2500;
+/* Longest cue line; longer sentences are split at punctuation. */
+constexpr int kMaxCueChars = 24;
+} // namespace
+
+CaptionRecorder::CaptionRecorder(QObject *parent) : QObject(parent)
+{
+	obs_frontend_add_event_callback(frontendEvent, this);
+}
+
+CaptionRecorder::~CaptionRecorder()
+{
+	obs_frontend_remove_event_callback(frontendEvent, this);
+	flush();
+}
+
+void CaptionRecorder::flush()
+{
+	for (Take *take : {&recording_, &stream_})
+		finish(*take);
+	for (const Take &take : finishing_)
+		write(take);
+	finishing_.clear();
+}
+
+void CaptionRecorder::frontendEvent(enum obs_frontend_event event, void *param)
+{
+	auto *self = static_cast<CaptionRecorder *>(param);
+	switch (event) {
+	case OBS_FRONTEND_EVENT_RECORDING_STARTED:
+		self->begin(self->recording_);
+		self->recording_.recording = true;
+		break;
+	case OBS_FRONTEND_EVENT_RECORDING_PAUSED:
+		if (self->recording_.active && !self->recording_.pauseStart)
+			self->recording_.pauseStart = now();
+		break;
+	case OBS_FRONTEND_EVENT_RECORDING_UNPAUSED:
+		if (self->recording_.active && self->recording_.pauseStart) {
+			self->recording_.pauses.emplace_back(self->recording_.pauseStart, now());
+			self->recording_.pauseStart = 0;
+		}
+		break;
+	case OBS_FRONTEND_EVENT_RECORDING_STOPPED:
+		self->finish(self->recording_);
+		break;
+	case OBS_FRONTEND_EVENT_STREAMING_STARTED:
+		self->begin(self->stream_);
+		break;
+	case OBS_FRONTEND_EVENT_STREAMING_STOPPED:
+		self->finish(self->stream_);
+		break;
+	case OBS_FRONTEND_EVENT_EXIT:
+		self->flush();
+		break;
+	default:
+		break;
+	}
+}
+
+void CaptionRecorder::begin(Take &take)
+{
+	take = Take();
+	take.active = true;
+	take.begin = now();
+	take.startLabel = QDateTime::currentDateTime().toString(QStringLiteral("yyyy-MM-dd HH-mm-ss"));
+}
+
+void CaptionRecorder::addCaption(const QString &text, double start, double end)
+{
+	auto accept = [&](Take &take) {
+		if (take.active && end > take.begin && (!take.stop || start < take.stop))
+			take.cues.push_back({start, end, text});
+	};
+	accept(recording_);
+	accept(stream_);
+	for (Take &take : finishing_)
+		accept(take);
+}
+
+void CaptionRecorder::finish(Take &take)
+{
+	if (!take.active)
+		return;
+	take.stop = now();
+	if (take.pauseStart) {
+		take.pauses.emplace_back(take.pauseStart, take.stop);
+		take.pauseStart = 0;
+	}
+	/* The recording's file name is known only now. */
+	if (take.recording)
+		take.recordingPath = takeString(obs_frontend_get_last_recording());
+	take.id = nextId_++;
+	finishing_.push_back(take);
+	const int id = take.id;
+	take = Take();
+	QTimer::singleShot(kLateCaptionMs, this, [this, id] {
+		auto done = std::find_if(finishing_.begin(), finishing_.end(), [id](const Take &t) { return t.id == id; });
+		if (done == finishing_.end())
+			return; /* already written by flush() */
+		write(*done);
+		finishing_.erase(done);
+	});
+}
+
+std::vector<CaptionRecorder::Cue> CaptionRecorder::relative(const Take &take)
+{
+	/* Seconds of take time at Unix time t: from the start, minus pauses. */
+	auto at = [&take](double t) {
+		double paused = 0;
+		for (const auto &[from, to] : take.pauses)
+			paused += std::clamp(t, from, to) - from;
+		return std::clamp(t, take.begin, take.stop) - take.begin - paused;
+	};
+	std::vector<Cue> cues;
+	for (const Cue &cue : take.cues) {
+		const double start = at(cue.start), end = at(cue.end);
+		if (end - start >= 0.2)
+			cues.push_back({start, end, cue.text});
+	}
+	std::sort(cues.begin(), cues.end(), [](const Cue &a, const Cue &b) { return a.start < b.start; });
+	return cues;
+}
+
+QString CaptionRecorder::toSrt(const std::vector<Cue> &cues)
+{
+	/* Split long sentences at punctuation into lines of at most
+	 * kMaxCueChars, sharing the sentence's time by length. */
+	static const QString breaks = QStringLiteral("，。？！；、,.?!;");
+	std::vector<Cue> lines;
+	for (const Cue &cue : cues) {
+		QStringList parts;
+		QString current;
+		for (const QChar c : cue.text) {
+			current += c;
+			if ((breaks.contains(c) && current.size() >= 8) || current.size() >= kMaxCueChars) {
+				parts << current;
+				current.clear();
+			}
+		}
+		if (!current.trimmed().isEmpty())
+			parts << current;
+		qsizetype total = 0;
+		for (const QString &part : parts)
+			total += part.size();
+		double t = cue.start;
+		for (const QString &part : parts) {
+			const double length = (cue.end - cue.start) * part.size() / std::max<qsizetype>(total, 1);
+			QString line = part.trimmed();
+			while (!line.isEmpty() && QStringLiteral("，、,").contains(line.back()))
+				line.chop(1);
+			if (!line.isEmpty())
+				lines.push_back({t, t + length, line});
+			t += length;
+		}
+	}
+	QString srt;
+	for (size_t i = 0; i < lines.size(); i++) {
+		/* Never overlap the next line. */
+		const double end = i + 1 < lines.size() ? std::min(lines[i].end, lines[i + 1].start) : lines[i].end;
+		srt += QStringLiteral("%1\n%2 --> %3\n%4\n\n")
+			       .arg(i + 1)
+			       .arg(timestamp(lines[i].start), timestamp(std::max(end, lines[i].start + 0.3)), lines[i].text);
+	}
+	return srt;
+}
+
+void CaptionRecorder::write(const Take &take)
+{
+	if (!enabled_ || take.cues.empty())
+		return;
+	const std::vector<Cue> cues = relative(take);
+	if (cues.empty())
+		return;
+	QString path;
+	if (take.recording && QFileInfo(take.recordingPath).isAbsolute()) {
+		/* Next to the recording, same name. */
+		const QFileInfo video(take.recordingPath);
+		path = video.dir().filePath(video.completeBaseName() + QStringLiteral(".srt"));
+	} else {
+		QString folder = takeString(obs_frontend_get_current_record_output_path());
+		if (folder.isEmpty() || !QDir(folder).exists())
+			folder = QDir::homePath() + QStringLiteral("/Movies");
+		const char *key = take.recording ? "LiveHime.Captions.SrtRecording" : "LiveHime.Captions.SrtStream";
+		path = QDir(folder).filePath(QString::fromUtf8(obs_module_text(key)).arg(take.startLabel) +
+					     QStringLiteral(".srt"));
+	}
+	QFile file(path);
+	if (!file.open(QIODevice::WriteOnly | QIODevice::Truncate)) {
+		blog(LOG_WARNING, "[livehime] could not write captions to %s", path.toUtf8().constData());
+		emit saveFailed(path);
+		return;
+	}
+	file.write(toSrt(cues).toUtf8());
+	file.close();
+	blog(LOG_INFO, "[livehime] saved %zu captions to %s", cues.size(), path.toUtf8().constData());
+	emit saved(path);
+}
