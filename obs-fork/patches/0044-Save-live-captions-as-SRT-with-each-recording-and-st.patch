+## Captions saved as SRT
+
+`e2e-captions-srt.mjs` plays Chinese speech into live captions while OBS
+records, then checks the `.srt` saved next to the recording: the words, the
+first cue starting when the speech did, cues ordered and inside the
+recording. A second recording pauses for 4 s mid-speech under a temporary
+profile (pausing needs a recording encoder of its own) and checks that the
+pause is left out. It records two short files into the recording folder and
+prints them as `OUTPUT <path>` lines; remove them afterwards. Back up the
+profile's `basic.ini` first and compare it afterwards.
+
+```bash
+node e2e-captions-srt.mjs <websocket password> speech.aiff
+```
+
 ## Cover manager check
 
 `e2e-cover.mjs` drives Bilibili's cover manager in the real window: a real
diff --git a/build-aux/livehime/tests/e2e-captions-srt.mjs b/build-aux/livehime/tests/e2e-captions-srt.mjs
new file mode 100644
index 000000000..3056c3730
--- /dev/null
+++ b/build-aux/livehime/tests/e2e-captions-srt.mjs
@@ -0,0 +1,130 @@
+// Captions saved as SRT: a media source plays Chinese speech into live captions while OBS records;
+// after the recording stops, a .srt with the recording's name must sit next to it, with the
+// speech's words and times counted from the start of the recording. A second recording pauses
+// in the middle: the paused stretch must be left out of the times. It records under a temporary
+// profile whose recording has its own encoder (pausing needs that), then switches back to the
+// original profile and removes the temporary one.
+// Usage: node e2e-captions-srt.mjs <ws password> <speech audio file>
+// Records two short files into the profile's recording folder and prints their paths
+// ("OUTPUT <path>") so the caller can remove them; restores the captions settings it changed.
+import { createHash } from 'node:crypto';
+import { existsSync, readFileSync } from 'node:fs';
+const [password, audioFile] = process.argv.slice(2);
+const sha = (s) => createHash('sha256').update(s).digest('base64');
+const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
+const ws = new WebSocket('ws://127.0.0.1:4466');
+let id = 1; const pend = new Map();
+const req = (t, d = {}) => new Promise((r) => { const k = String(id++); pend.set(k, r); ws.send(JSON.stringify({ op: 6, d: { requestType: t, requestId: k, requestData: d } })); });
+const vendor = async (t, d = {}) => (await req('CallVendorRequest', { vendorName: 'livehime', requestType: t, requestData: d })).responseData?.responseData;
+let fails = 0;
+const check = (n, ok, i = '') => { if (!ok) fails++; console.log(`${ok ? 'PASS' : 'FAIL'}  ${n}${i ? '  — ' + i : ''}`); };
+const MEDIA = 'livehime-e2e-speech', PROFILE = 'LiveHime E2E';
+
+// SRT → [{start, end, text}] in seconds.
+function parseSrt(text) {
+  const t = (s) => { const [h, m, rest] = s.split(':'); const [sec, ms] = rest.split(','); return +h * 3600 + +m * 60 + +sec + +ms / 1000; };
+  return text.trim().split(/\n\n+/).map((block) => {
+    const lines = block.split('\n');
+    const [a, b] = lines[1].split(' --> ');
+    return { start: t(a), end: t(b), text: lines.slice(2).join('') };
+  });
+}
+
+async function waitProfile(name) {
+  for (let i = 0; i < 40; i++) {
+    if ((await req('GetProfileList')).responseData?.currentProfileName === name) return true;
+    await sleep(250);
+  }
+  return false;
+}
+
+async function record(label, { pauseAfter = 0, pauseFor = 0 } = {}) {
+  const started = await req('StartRecord');
+  check(`${label}: recording started`, started.requestStatus.result, started.requestStatus.comment);
+  const t0 = Date.now();
+  await sleep(2000);
+  await req('TriggerMediaInputAction', { inputName: MEDIA, mediaAction: 'OBS_WEBSOCKET_MEDIA_INPUT_ACTION_RESTART' });
+  const speechAt = (Date.now() - t0) / 1000;
+  if (pauseAfter) {
+    await sleep(pauseAfter * 1000);
+    await req('PauseRecord');
+    const status = (await req('GetRecordStatus')).responseData;
+    check(`${label}: recording paused`, status?.outputPaused, JSON.stringify(status));
+    await sleep(pauseFor * 1000);
+    await req('ResumeRecord');
+  }
+  await sleep(15000 - pauseAfter * 1000);
+  const stopped = await req('StopRecord');
+  const elapsed = (Date.now() - t0) / 1000;
+  const video = stopped.responseData?.outputPath;
+  console.log(`OUTPUT ${video}`);
+  const srt = video?.replace(/\.[^./]+$/, '.srt');
+  console.log(`OUTPUT ${srt}`);
+  for (let i = 0; i < 40 && !(srt && existsSync(srt)); i++) await sleep(250);
+  check(`${label}: .srt saved next to the recording`, srt && existsSync(srt), srt);
+  if (!srt || !existsSync(srt)) return;
+  const cues = parseSrt(readFileSync(srt, 'utf8'));
+  const text = cues.map((c) => c.text).join('');
+  console.log(`      ${cues.length} cues: ${text}`);
+  const length = elapsed - pauseFor;
+  check(`${label}: cues hold the speech`, cues.length >= 2 && /直播姬|字幕|电脑/.test(text), text);
+  check(`${label}: first cue starts when the speech did`, Math.abs(cues[0].start - speechAt) < 2.5,
+    `cue ${cues[0].start.toFixed(2)} s, speech at ${speechAt.toFixed(2)} s`);
+  check(`${label}: cues ordered, inside the recording`,
+    cues.every((c, i) => c.end > c.start && c.end <= length + 0.5 && (i === 0 || c.start >= cues[i - 1].end - 0.001)),
+    `last end ${cues.at(-1).end.toFixed(2)} s, recording ${length.toFixed(2)} s`);
+  return cues;
+}
+
+ws.onmessage = async (ev) => {
+  const m = JSON.parse(ev.data);
+  if (m.op === 0) { const { challenge, salt } = m.d.authentication; ws.send(JSON.stringify({ op: 1, d: { rpcVersion: 1, authentication: sha(sha(password + salt) + challenge), eventSubscriptions: 0 } })); return; }
+  if (m.op === 7) { pend.get(m.d.requestId)?.(m.d); return; }
+  if (m.op !== 2) return;
+  for (let i = 0; i < 40 && !(await req('GetVersion')).requestStatus.result; i++) await sleep(500);
+  const before = await vendor('Captions');
+  check('captions supported on this Mac', before?.supported, JSON.stringify(before));
+  const scene = (await req('GetCurrentProgramScene')).responseData.currentProgramSceneName;
+  const originalProfile = (await req('GetProfileList')).responseData.currentProfileName;
+  const recordFolder = (await req('GetRecordDirectory')).responseData.recordDirectory;
+  try {
+    const media = await req('CreateInput', { sceneName: scene, inputName: MEDIA, inputKind: 'ffmpeg_source',
+      inputSettings: { local_file: audioFile, is_local_file: true, looping: false, restart_on_activate: false, close_when_inactive: false } });
+    check('speech media source created', media.requestStatus.result, media.requestStatus.comment);
+    await req('TriggerMediaInputAction', { inputName: MEDIA, mediaAction: 'OBS_WEBSOCKET_MEDIA_INPUT_ACTION_STOP' });
+    let st = await vendor('Captions', { enabled: true, source: MEDIA, locale: 'zh-CN' });
+    for (let i = 0; i < 40 && !/识别|Listening/.test(st?.status); i++) { await sleep(250); st = await vendor('Captions'); }
+    check('captions listening', /识别|Listening/.test(st?.status), st?.status);
+
+    await record('plain');
+    await sleep(1500);
+    // Pause 3 s into the speech for 4 s: later words shift 4 s earlier than on the clock.
+    // CreateProfile switches asynchronously: only write settings once the temporary profile is
+    // current, or they would land in the user's profile.
+    const created = await req('CreateProfile', { profileName: PROFILE });
+    check('temporary profile created', created.requestStatus.result, created.requestStatus.comment);
+    if (!(await waitProfile(PROFILE))) throw new Error('the temporary profile did not become current');
+    for (const [name, value] of [['RecQuality', 'Small'], ['RecFormat2', 'mkv'], ['RecEncoder', 'x264'], ['FilePath', recordFolder]]) {
+      if (!(await waitProfile(PROFILE))) throw new Error('left the temporary profile');
+      await req('SetProfileParameter', { parameterCategory: 'SimpleOutput', parameterName: name, parameterValue: value });
+    }
+    // Outputs are rebuilt from the profile only when it is loaded: switch away and back.
+    await req('SetCurrentProfile', { profileName: originalProfile });
+    await waitProfile(originalProfile);
+    await req('SetCurrentProfile', { profileName: PROFILE });
+    if (!(await waitProfile(PROFILE))) throw new Error('could not return to the temporary profile');
+    await sleep(1000);
+    const paused = await record('paused', { pauseAfter: 3, pauseFor: 4 });
+    if (paused) check('paused: the pause is left out', paused.at(-1).end < 12, `last end ${paused.at(-1).end.toFixed(2)} s`);
+  } finally {
+    if ((await req('GetProfileList')).responseData?.profiles?.includes(PROFILE)) {
+      await req('SetCurrentProfile', { profileName: originalProfile });
+      if (await waitProfile(originalProfile)) await req('RemoveProfile', { profileName: PROFILE });
+    }
+    await vendor('Captions', { enabled: before?.enabled ?? false, source: '', locale: '' });
+    await req('RemoveInput', { inputName: MEDIA });
+  }
+  ws.close();
+  await sleep(1500);
+  process.exit(fails ? 1 : 0);
+};
