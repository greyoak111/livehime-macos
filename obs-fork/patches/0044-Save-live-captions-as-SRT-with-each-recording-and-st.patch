+    /// When a finished sentence was spoken, from its range on the audio
+    /// timeline; falls back to "just now" when the range is unusable.
+    static func spoken(_ range: CMTimeRange, audioStart: Date?, text: String, now: Date = Date()) -> (Date, Date) {
+        let begin = range.start.seconds, length = range.duration.seconds
+        if let audioStart, begin.isFinite, length.isFinite, begin >= 0, length > 0 {
+            let start = audioStart.addingTimeInterval(begin)
+            let end = start.addingTimeInterval(length)
+            if end <= now.addingTimeInterval(1), start >= now.addingTimeInterval(-120) {
+                return (start, end)
+            }
+        }
+        return (now.addingTimeInterval(-max(1, Double(text.count) * 0.25)), now)
+    }
+
     private func startSilenceWatch() {
