+#pragma once
+
+#include <obs-frontend-api.h>
+
+#include <QObject>
+#include <QString>
+
+#include <list>
+#include <vector>
+
+/* Saves the live captions of each recording and live stream as an SRT
+ * file: a recording's next to it with the same name, a stream's in the
+ * recording folder as "直播字幕 <start time>.srt". Cue times count from the
+ * start of the recording (paused stretches left out) or of the stream. */
+class CaptionRecorder : public QObject {
+	Q_OBJECT
+
+public:
+	explicit CaptionRecorder(QObject *parent = nullptr);
+	~CaptionRecorder() override;
+
+	void setEnabled(bool enabled) { enabled_ = enabled; }
+	bool enabled() const { return enabled_; }
+	/* A finished caption and when it was spoken (Unix seconds). */
+	void addCaption(const QString &text, double start, double end);
+
+	struct Cue {
+		double start;
+		double end;
+		QString text;
+	};
+	/* SRT text for cues (times in seconds from 0), long sentences split. */
+	static QString toSrt(const std::vector<Cue> &cues);
+
+signals:
+	void saved(const QString &path);
+	void saveFailed(const QString &path);
+
+private:
+	struct Take {
+		bool active = false;
+		double begin = 0;              /* Unix seconds */
+		double stop = 0;               /* 0 while running */
+		double pauseStart = 0;         /* 0 unless paused */
+		std::vector<std::pair<double, double>> pauses;
+		std::vector<Cue> cues;         /* Unix seconds */
+		QString startLabel;            /* local start time, for file names */
+		QString recordingPath;         /* the recording's file, once stopped */
+		bool recording = false;
+		int id = 0;
+	};
+
+	static void frontendEvent(enum obs_frontend_event event, void *param);
+	void begin(Take &take);
+	void finish(Take &take);
+	void write(const Take &take);
+	/* Writes every stopped take now (LiveHime is quitting). */
+	void flush();
+	static std::vector<Cue> relative(const Take &take);
+
+	bool enabled_ = true;
+	Take recording_;
+	Take stream_;
+	/* Stopped takes waiting for late captions before they are written. */
+	std::list<Take> finishing_;
+	int nextId_ = 1;
+};
