+void FeaturePanel::showFeedMenu(const QPoint &pos)
+{
+	QListWidgetItem *item = feed_->itemAt(pos);
+	if (!item)
+		return;
+	QMenu menu(this);
+	const QString line = item->text();
+	menu.addAction(text("LiveHime.Feature.Copy"), this, [line] { QApplication::clipboard()->setText(line); });
+	const qint64 uid = item->data(Qt::UserRole).toLongLong();
+	const QString user = item->data(Qt::UserRole + 1).toString();
+	if (uid > 0) {
+		QMenu *mute = menu.addMenu(text("LiveHime.Feature.MuteUser").arg(user));
+		const std::pair<const char *, int> choices[] = {{"LiveHime.Feature.MuteSession", 0},
+								{"LiveHime.Feature.MuteHour", 1},
+								{"LiveHime.Feature.MuteForever", -1}};
+		for (const auto &[label, hours] : choices)
+			mute->addAction(text(label), this, [uid, hours = hours] { livehime_core_mute_user(uid, hours); });
+	}
+	menu.exec(feed_->viewport()->mapToGlobal(pos));
+}
+
+void FeaturePanel::showKeywords(const QJsonObject &event)
+{
+	addKeyword_->setEnabled(true);
+	if (!event.value("ok").toBool()) {
+		const QString detail = event.value("message").toString();
+		keywordStatus_->setText(text("LiveHime.Feature.KeywordFailed") +
+					(detail.isEmpty() ? QString() : QStringLiteral("\n") + detail));
+		keywordStatus_->setStyleSheet(QStringLiteral("color: #e06c75;"));
+		return;
+	}
+	keywords_->clear();
+	const QJsonArray list = event.value("keywords").toArray();
+	for (const QJsonValue value : list)
+		keywords_->addItem(value.toString());
+	newKeyword_->clear();
+	keywordStatus_->setText(text("LiveHime.Feature.KeywordHint"));
+	keywordStatus_->setStyleSheet(QStringLiteral("color: #9aa0ab;"));
+}
