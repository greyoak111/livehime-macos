 }
+
+// MARK: Moderation
+
+@_cdecl("livehime_core_mute_user")
+public func livehime_core_mute_user(_ uid: Int64, _ hours: Int32) {
+    onMain {
+        guard let bridge = CoreBridge.shared else { return }
+        Task { @MainActor in
+            do {
+                try await bridge.coordinator.muteUser(uid: uid, hours: Int(hours))
+                bridge.emit(["event": "userMuted", "ok": true, "uid": uid])
+            } catch {
+                bridge.emit(["event": "userMuted", "ok": false, "uid": uid].merging(CoreBridge.errorFields(error)) { $1 })
+            }
+        }
+    }
+}
+
+@_cdecl("livehime_core_load_shield_keywords")
+public func livehime_core_load_shield_keywords() {
+    onMain {
+        guard let bridge = CoreBridge.shared else { return }
+        Task { @MainActor in
+            do {
+                let keywords = try await bridge.coordinator.shieldKeywords()
+                bridge.emit(["event": "shieldKeywords", "ok": true, "keywords": keywords])
+            } catch {
+                bridge.emit(["event": "shieldKeywords", "ok": false].merging(CoreBridge.errorFields(error)) { $1 })
+            }
+        }
+    }
+}
+
+/// Adds (add != 0) or removes a room-wide blocked word, then reloads the list.
+@_cdecl("livehime_core_set_shield_keyword")
+public func livehime_core_set_shield_keyword(_ keyword: UnsafePointer<CChar>?, _ add: Int32) {
+    let word = keyword.map { String(cString: $0) } ?? ""
+    onMain {
+        guard let bridge = CoreBridge.shared else { return }
+        Task { @MainActor in
+            do {
+                try await bridge.coordinator.setShieldKeyword(word, add: add != 0)
+                let keywords = try await bridge.coordinator.shieldKeywords()
+                bridge.emit(["event": "shieldKeywords", "ok": true, "keywords": keywords])
+            } catch {
+                bridge.emit(["event": "shieldKeywords", "ok": false].merging(CoreBridge.errorFields(error)) { $1 })
+            }
+        }
+    }
+}
