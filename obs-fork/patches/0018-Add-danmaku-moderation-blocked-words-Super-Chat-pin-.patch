+    /// Room moderation (the requests the live room page makes).
+    /// `hours`: -1 permanent, 0 for the current live session, otherwise hours.
+    public func muteUser(roomID: Int64, uid: Int64, hours: Int, cookieHeader: String) async throws {
+        let csrf = try csrf(from: cookieHeader)
+        _ = try await requestJSON(url: URL(string: "https://api.live.bilibili.com/xlive/web-ucenter/v1/banned/AddSilentUser")!,
+                                  cookieHeader: cookieHeader,
+                                  body: form([("room_id", String(roomID)), ("tuid", String(uid)), ("mobile_app", "web"),
+                                              ("type", "1"), ("hour", String(hours)), ("csrf", csrf), ("csrf_token", csrf),
+                                              ("visit_id", "")]))
+    }
+
+    public func shieldKeywords(roomID: Int64, cookieHeader: String) async throws -> [String] {
+        let csrf = try csrf(from: cookieHeader)
+        let root = try await requestJSON(url: URL(string: "https://api.live.bilibili.com/xlive/web-ucenter/v1/banned/GetShieldKeywordList")!,
+                                         cookieHeader: cookieHeader,
+                                         body: form([("room_id", String(roomID)), ("csrf", csrf), ("csrf_token", csrf)]))
+        return Self.keywords(in: root["data"])
+    }
+
+    public func setShieldKeyword(roomID: Int64, keyword: String, add: Bool, cookieHeader: String) async throws {
+        let csrf = try csrf(from: cookieHeader)
+        let path = add ? "AddShieldKeyword" : "DelShieldKeyword"
+        _ = try await requestJSON(url: URL(string: "https://api.live.bilibili.com/xlive/web-ucenter/v1/banned/\(path)")!,
+                                  cookieHeader: cookieHeader,
+                                  body: form([("room_id", String(roomID)), ("keyword", keyword), ("csrf", csrf),
+                                              ("csrf_token", csrf)]))
+    }
+
+    /// The list's key names are not stable across versions; take every
+    /// "keyword" string (or plain string item) found in the payload.
+    static func keywords(in value: Any?) -> [String] {
+        var found: [String] = []
+        func walk(_ v: Any?) {
+            if let d = v as? [String: Any] {
+                if let k = d["keyword"] as? String, !k.isEmpty { found.append(k); return }
+                for key in d.keys.sorted() { walk(d[key]) }
+            } else if let a = v as? [Any] {
+                for item in a {
+                    if let s = item as? String, !s.isEmpty { found.append(s) } else { walk(item) }
+                }
+            }
+        }
+        walk(value)
+        var seen = Set<String>()
+        return found.filter { seen.insert($0).inserted }
+    }
+
     private func cookieValue(_ name: String, in header: String) -> String? {
         for part in header.split(separator: ";") {
             let pair = part.split(separator: "=", maxSplits: 1).map { $0.trimmingCharacters(in: .whitespaces) }
