+namespace {
+/* Lays `text` out in the box; returns the lines that fit, keeping the end
+ * of the text (the newest words) when it is too long. */
+std::vector<QString> layoutLines(const QString &text, const Style &style, double wrapWidth)
+{
+	std::vector<QString> lines;
+	if (text.isEmpty())
+		return lines;
+	QTextLayout layout(text, style.font);
+	QTextOption option;
+	option.setWrapMode(QTextOption::WrapAtWordBoundaryOrAnywhere);
+	layout.setTextOption(option);
+	layout.beginLayout();
+	for (QTextLine line = layout.createLine(); line.isValid(); line = layout.createLine()) {
+		line.setLineWidth(wrapWidth);
+		lines.push_back(text.mid(line.textStart(), line.textLength()).trimmed());
+	}
+	layout.endLayout();
+	if (static_cast<int>(lines.size()) > style.maxLines)
+		lines.erase(lines.begin(), lines.end() - style.maxLines);
+	return lines;
+}
+
+/* Keeps the newest part of a sentence: when it does not fit, start again
+ * from a later character so the last line is full width, not a stub. */
+std::vector<QString> fitTail(const QString &text, const Style &style, double wrapWidth)
+{
+	QTextLayout probe(text, style.font);
+	QTextOption option;
+	option.setWrapMode(QTextOption::WrapAtWordBoundaryOrAnywhere);
+	probe.setTextOption(option);
+	probe.beginLayout();
+	std::vector<int> starts;
+	for (QTextLine line = probe.createLine(); line.isValid(); line = probe.createLine()) {
+		line.setLineWidth(wrapWidth);
+		starts.push_back(line.textStart());
+	}
+	probe.endLayout();
+	if (static_cast<int>(starts.size()) <= style.maxLines)
+		return layoutLines(text, style, wrapWidth);
+	/* Lay out backwards: find the earliest start whose tail fits. */
+	const QFontMetricsF metrics(style.font);
+	const double capacity = wrapWidth * style.maxLines;
+	int start = text.size();
+	double used = 0;
+	while (start > 0) {
+		const double w = metrics.horizontalAdvance(text[start - 1]);
+		if (used + w > capacity * 0.97)
+			break;
+		used += w;
+		start--;
+	}
+	return layoutLines(text.mid(start), style, wrapWidth);
+}
+
+QImage render(const std::vector<QString> &lines, const Style &style)
+{
+	QImage image(style.width, style.height, QImage::Format_ARGB32_Premultiplied);
+	image.fill(Qt::transparent);
+	if (lines.empty())
+		return image;
+
+	QPainter painter(&image);
+	painter.setRenderHint(QPainter::Antialiasing);
+	painter.setRenderHint(QPainter::TextAntialiasing);
+	const QFontMetricsF metrics(style.font);
+	const double lineHeight = metrics.height() * 1.15;
+	const double blockHeight = lineHeight * lines.size();
+	double widest = 0;
+	for (const QString &line : lines)
+		widest = std::max(widest, metrics.horizontalAdvance(line));
+
+	const double pad = style.padding;
+	double top = pad;
+	if (style.vAlign == AlignMiddle)
+		top = (style.height - blockHeight) / 2;
+	else if (style.vAlign == AlignBottom)
+		top = style.height - pad - blockHeight;
+
+	auto lineX = [&](double width) {
+		if (style.hAlign == AlignCenter)
+			return (style.width - width) / 2;
+		if (style.hAlign == AlignRight)
+			return style.width - pad - width;
+		return pad;
+	};
+
+	if (style.background) {
+		const double plateWidth = widest + pad * 2;
+		QRectF plate(lineX(widest) - pad, top - pad / 2, plateWidth, blockHeight + pad);
+		painter.setPen(Qt::NoPen);
+		painter.setBrush(style.backgroundColor);
+		painter.drawRoundedRect(plate, 10, 10);
+	}
+
+	for (size_t i = 0; i < lines.size(); i++) {
+		const double width = metrics.horizontalAdvance(lines[i]);
+		const QPointF origin(lineX(width), top + lineHeight * i + (lineHeight - metrics.height()) / 2 + metrics.ascent());
+		QPainterPath path;
+		path.addText(origin, style.font, lines[i]);
+		if (style.shadow) {
+			painter.setPen(Qt::NoPen);
+			painter.setBrush(QColor(0, 0, 0, 140));
+			painter.drawPath(path.translated(2.5, 3));
+		}
+		if (style.outline && style.outlineWidth > 0) {
+			QPen pen(style.outlineColor, style.outlineWidth * 2.0, Qt::SolidLine, Qt::RoundCap, Qt::RoundJoin);
+			painter.setPen(pen);
+			painter.setBrush(Qt::NoBrush);
+			painter.drawPath(path);
+		}
+		painter.setPen(Qt::NoPen);
+		painter.setBrush(style.color);
+		painter.drawPath(path);
+	}
+	return image;
+}
