diff --git a/plugins/livehime/core/Sources/LiveHimeCore/AppUpdateBridge.swift b/plugins/livehime/core/Sources/LiveHimeCore/AppUpdateBridge.swift
new file mode 100644
index 000000000..d30dbbd96
--- /dev/null
+++ b/plugins/livehime/core/Sources/LiveHimeCore/AppUpdateBridge.swift
@@ -0,0 +1,142 @@
+import Foundation
+
+/// Update state behind the C entry points below; everything on the main thread.
+@MainActor
+final class UpdateState {
+    static let shared = UpdateState()
+    var release: AppRelease?
+    var staged: URL?
+    var busy = false
+    var cleaned = false
+    var lastPercent = -1
+
+    func emit(_ fields: [String: Any]) {
+        var object: [String: Any] = ["event": "update", "current": AppUpdater.currentVersion,
+                                     "supported": AppUpdater.installSupported]
+        object.merge(fields) { $1 }
+        CoreBridge.shared?.emit(object)
+    }
+
+    func releaseFields(_ release: AppRelease) -> [String: Any] {
+        ["version": release.version, "notes": release.notes, "page": release.page.absoluteString, "size": release.size]
+    }
+
+    func failed(_ error: Error) {
+        let update = error as? AppUpdateError
+        emit(["status": "failed", "reason": update?.reason ?? "network",
+              "message": update?.errorDescription ?? error.localizedDescription])
+    }
+}
+
+private func onMainThread(_ body: @escaping @MainActor () -> Void) {
+    if Thread.isMainThread {
+        MainActor.assumeIsolated { body() }
+    } else {
+        DispatchQueue.main.async { MainActor.assumeIsolated { body() } }
+    }
+}
+
+/// Looks for a newer release. Emits "checking", then "upToDate",
+/// "available" (with version, notes, page, size) or "failed".
+@_cdecl("livehime_core_update_check")
+public func livehime_core_update_check() {
+    onMainThread {
+        let state = UpdateState.shared
+        guard !state.busy else { return }
+        if !state.cleaned, state.staged == nil {
+            // Leftovers of the last update (the replaced app, downloads).
+            AppUpdater.cleanUp()
+            state.cleaned = true
+        }
+        state.busy = true
+        state.emit(["status": "checking"])
+        Task.detached {
+            do {
+                let release = try await AppUpdater.latest()
+                await MainActor.run {
+                    state.busy = false
+                    state.release = release
+                    if let staged = state.staged, staged.path.contains("/\(release.version)/") {
+                        state.emit(["status": "ready"].merging(state.releaseFields(release)) { $1 })
+                    } else if AppUpdater.isNewer(release.version, than: AppUpdater.currentVersion) {
+                        state.emit(["status": "available"].merging(state.releaseFields(release)) { $1 })
+                    } else {
+                        state.emit(["status": "upToDate", "version": release.version])
+                    }
+                }
+            } catch {
+                await MainActor.run {
+                    state.busy = false
+                    state.failed(error)
+                }
+            }
+        }
+    }
+}
+
+/// Downloads and verifies the release found by the last check. Emits
+/// "downloading" with "progress" (0–1), then "ready" or "failed".
+@_cdecl("livehime_core_update_download")
+public func livehime_core_update_download() {
+    onMainThread {
+        let state = UpdateState.shared
+        guard !state.busy, let release = state.release,
+              AppUpdater.isNewer(release.version, than: AppUpdater.currentVersion) else { return }
+        guard AppUpdater.installSupported else {
+            state.emit(["status": "failed", "reason": "unsupported", "message": "development build"])
+            return
+        }
+        if let staged = state.staged, staged.path.contains("/\(release.version)/") {
+            state.emit(["status": "ready"].merging(state.releaseFields(release)) { $1 })
+            return
+        }
+        state.busy = true
+        state.lastPercent = -1
+        state.emit(["status": "downloading", "progress": 0.0, "version": release.version])
+        Task.detached {
+            do {
+                let app = try await AppUpdater.download(release) { fraction in
+                    DispatchQueue.main.async {
+                        MainActor.assumeIsolated {
+                            let percent = Int(fraction * 100)
+                            guard percent != state.lastPercent else { return }
+                            state.lastPercent = percent
+                            state.emit(["status": "downloading", "progress": fraction, "version": release.version])
+                        }
+                    }
+                }
+                await MainActor.run {
+                    state.busy = false
+                    state.staged = app
+                    state.emit(["status": "ready"].merging(state.releaseFields(release)) { $1 })
+                }
+            } catch {
+                await MainActor.run {
+                    state.busy = false
+                    state.failed(error)
+                }
+            }
+        }
+    }
+}
+
+/// Installs the downloaded update once LiveHime quits (the caller quits it
+/// when `relaunch` is set, and LiveHime reopens afterwards). Returns 1 when
+/// the installer is waiting, 0 when there is nothing to install or it could
+/// not start (then "failed" is emitted). Call on the main thread.
+@_cdecl("livehime_core_update_install")
+public func livehime_core_update_install(_ relaunch: Int32) -> Int32 {
+    guard Thread.isMainThread else { return 0 }
+    return MainActor.assumeIsolated {
+        let state = UpdateState.shared
+        guard let staged = state.staged, !state.busy else { return 0 }
+        do {
+            try AppUpdater.scheduleInstall(staged: staged, relaunch: relaunch != 0)
+            state.staged = nil
+            return 1
+        } catch {
+            state.failed(error)
+            return 0
+        }
+    }
+}
diff --git a/plugins/livehime/core/Sources/LiveHimeCore/AppUpdater.swift b/plugins/livehime/core/Sources/LiveHimeCore/AppUpdater.swift
new file mode 100644
index 000000000..b77d35af2
--- /dev/null
+++ b/plugins/livehime/core/Sources/LiveHimeCore/AppUpdater.swift
@@ -0,0 +1,316 @@
+import CryptoKit
+import Foundation
+import Security
+
+/// A published LiveHime release: the app archive and its checksum.
+public struct AppRelease: Equatable, Sendable {
+    public let version: String
+    public let notes: String
+    public let page: URL
+    public let archive: URL
+    public let size: Int64
+    /// Hex SHA-256 of the archive as published by GitHub ("digest").
+    public let sha256: String?
+}
+
+public enum AppUpdateError: Error, Equatable, LocalizedError {
+    case network(String)
+    case noArchive           // the release has no app archive
+    case missingChecksum     // the release gives no checksum for it
+    case checksumMismatch
+    case invalidApp(String)  // not the same app, version or signer
+    case location(String)    // the running app cannot be replaced in place
+    case busy
+
+    /// Short machine-readable reason for the UI.
+    public var reason: String {
+        switch self {
+        case .network: return "network"
+        case .noArchive: return "noArchive"
+        case .missingChecksum, .checksumMismatch: return "checksum"
+        case .invalidApp: return "invalidApp"
+        case .location: return "location"
+        case .busy: return "busy"
+        }
+    }
+
+    public var errorDescription: String? {
+        switch self {
+        case .network(let detail), .invalidApp(let detail), .location(let detail): return detail
+        default: return reason
+        }
+    }
+}
+
+/// Finds, downloads, verifies and installs LiveHime updates from GitHub
+/// Releases. A download is installed only when its SHA-256 matches the
+/// release's published digest and the app inside has the running app's
+/// bundle identifier, the release's version and a valid signature by the
+/// same certificate as the running app. Installing waits for LiveHime to
+/// quit, then swaps the bundle in place (the old one kept until the swap
+/// succeeds) and optionally reopens it.
+public enum AppUpdater {
+    public static let releasesPage = URL(string: "https://github.com/greyoak111/livehime-macos/releases")!
+    static let latestAPI = URL(string: "https://api.github.com/repos/greyoak111/livehime-macos/releases/latest")!
+
+    /// The release feed; tests point LIVEHIME_UPDATE_FEED at a local JSON file.
+    static var feed: URL {
+        ProcessInfo.processInfo.environment["LIVEHIME_UPDATE_FEED"].flatMap(URL.init(string:)) ?? latestAPI
+    }
+
+    public static var currentVersion: String {
+        Bundle.main.infoDictionary?["CFBundleShortVersionString"] as? String ?? "0"
+    }
+
+    /// Development builds (bundle id ending in ".dev") are not replaced by
+    /// release downloads, unless a test feed is set.
+    public static var installSupported: Bool {
+        !(Bundle.main.bundleIdentifier ?? "").hasSuffix(".dev")
+            || ProcessInfo.processInfo.environment["LIVEHIME_UPDATE_FEED"] != nil
+    }
+
+    // MARK: Versions and the release feed
+
+    /// Numeric comparison of dotted versions ("0.2.10" > "0.2.9").
+    public static func isNewer(_ candidate: String, than current: String) -> Bool {
+        func parts(_ v: String) -> [Int] {
+            v.split(whereSeparator: { !$0.isNumber }).map { Int($0) ?? 0 }
+        }
+        let a = parts(candidate), b = parts(current)
+        for i in 0..<max(a.count, b.count) {
+            let x = i < a.count ? a[i] : 0, y = i < b.count ? b[i] : 0
+            if x != y { return x > y }
+        }
+        return false
+    }
+
+    /// Reads a GitHub "latest release" object.
+    static func release(from data: Data) throws -> AppRelease {
+        guard let root = try JSONSerialization.jsonObject(with: data) as? [String: Any],
+              let tag = root["tag_name"] as? String else { throw AppUpdateError.network("invalid release feed") }
+        let version = tag.hasPrefix("v") ? String(tag.dropFirst()) : tag
+        let assets = root["assets"] as? [[String: Any]] ?? []
+        guard let asset = assets.first(where: {
+            let name = $0["name"] as? String ?? ""
+            return name.hasPrefix("LiveHimeMacApp-") && name.hasSuffix("-arm64.zip")
+        }), let archive = (asset["browser_download_url"] as? String).flatMap(URL.init(string:)) else {
+            throw AppUpdateError.noArchive
+        }
+        var sha: String?
+        if let digest = asset["digest"] as? String, digest.hasPrefix("sha256:") {
+            sha = String(digest.dropFirst("sha256:".count)).lowercased()
+        }
+        return AppRelease(version: version, notes: root["body"] as? String ?? "",
+                          page: (root["html_url"] as? String).flatMap(URL.init(string:)) ?? releasesPage,
+                          archive: archive, size: (asset["size"] as? NSNumber)?.int64Value ?? 0, sha256: sha)
+    }
+
+    public static func latest() async throws -> AppRelease {
+        var request = URLRequest(url: feed, timeoutInterval: 20)
+        request.setValue("application/vnd.github+json", forHTTPHeaderField: "Accept")
+        request.setValue("LiveHime/\(currentVersion)", forHTTPHeaderField: "User-Agent")
+        let data: Data, response: URLResponse
+        do {
+            (data, response) = try await URLSession.shared.data(for: request)
+        } catch {
+            throw AppUpdateError.network(error.localizedDescription)
+        }
+        if let http = response as? HTTPURLResponse, http.statusCode != 200 {
+            throw AppUpdateError.network("HTTP \(http.statusCode)")
+        }
+        return try release(from: data)
+    }
+
+    // MARK: Download and verification
+
+    static var updatesDirectory: URL {
+        let caches = FileManager.default.urls(for: .cachesDirectory, in: .userDomainMask)[0]
+        return caches.appendingPathComponent(Bundle.main.bundleIdentifier ?? "LiveHime")
+            .appendingPathComponent("Updates", isDirectory: true)
+    }
+
+    /// Removes leftovers of earlier updates (downloads, the replaced app).
+    public static func cleanUp() {
+        try? FileManager.default.removeItem(at: updatesDirectory)
+    }
+
+    /// Downloads, checks and unpacks `release`; returns the verified app.
+    public static func download(_ release: AppRelease, progress: @escaping @Sendable (Double) -> Void) async throws -> URL {
+        guard let expected = release.sha256 else { throw AppUpdateError.missingChecksum }
+        let folder = updatesDirectory.appendingPathComponent(release.version, isDirectory: true)
+        let fm = FileManager.default
+        try? fm.removeItem(at: folder)
+        try fm.createDirectory(at: folder, withIntermediateDirectories: true)
+        let archive = folder.appendingPathComponent("app.zip")
+        try await Downloader.fetch(release.archive, to: archive, expectedSize: release.size, progress: progress)
+        guard try sha256(of: archive) == expected else {
+            try? fm.removeItem(at: folder)
+            throw AppUpdateError.checksumMismatch
+        }
+        let unpacked = folder.appendingPathComponent("unpacked", isDirectory: true)
+        try run("/usr/bin/ditto", ["-x", "-k", archive.path, unpacked.path])
+        try? fm.removeItem(at: archive)
+        guard let app = try fm.contentsOfDirectory(at: unpacked, includingPropertiesForKeys: nil)
+            .first(where: { $0.pathExtension == "app" }) else {
+            throw AppUpdateError.invalidApp("no app in the archive")
+        }
+        try verify(app: app, version: release.version)
+        return app
+    }
+
+    static func sha256(of file: URL) throws -> String {
+        let handle = try FileHandle(forReadingFrom: file)
+        defer { try? handle.close() }
+        var hasher = SHA256()
+        while let chunk = try handle.read(upToCount: 1 << 20), !chunk.isEmpty {
+            hasher.update(data: chunk)
+        }
+        return hasher.finalize().map { String(format: "%02x", $0) }.joined()
+    }
+
+    /// The app at `app` must be this app (bundle id), at `version`, validly
+    /// signed by the certificate that signed the running app.
+    static func verify(app: URL, version: String, current: URL = Bundle.main.bundleURL) throws {
+        guard let info = Bundle(url: app)?.infoDictionary else { throw AppUpdateError.invalidApp("not an app") }
+        guard let id = info["CFBundleIdentifier"] as? String, id == Bundle(url: current)?.bundleIdentifier else {
+            throw AppUpdateError.invalidApp("different bundle identifier")
+        }
+        guard (info["CFBundleShortVersionString"] as? String) == version else {
+            throw AppUpdateError.invalidApp("version is not \(version)")
+        }
+        var code: SecStaticCode?
+        guard SecStaticCodeCreateWithPath(app as CFURL, [], &code) == errSecSuccess, let code else {
+            throw AppUpdateError.invalidApp("unreadable signature")
+        }
+        let flags = SecCSFlags(rawValue: kSecCSCheckAllArchitectures | kSecCSCheckNestedCode | kSecCSStrictValidate)
+        let status = SecStaticCodeCheckValidity(code, flags, nil)
+        guard status == errSecSuccess else { throw AppUpdateError.invalidApp("invalid signature (\(status))") }
+        guard let signer = leafCertificate(of: app), signer == leafCertificate(of: current) else {
+            throw AppUpdateError.invalidApp("signed by a different certificate")
+        }
+    }
+
+    static func leafCertificate(of app: URL) -> Data? {
+        var code: SecStaticCode?
+        guard SecStaticCodeCreateWithPath(app as CFURL, [], &code) == errSecSuccess, let code else { return nil }
+        var info: CFDictionary?
+        guard SecCodeCopySigningInformation(code, SecCSFlags(rawValue: kSecCSSigningInformation), &info) == errSecSuccess,
+              let certificates = (info as? [String: Any])?[kSecCodeInfoCertificates as String] as? [SecCertificate],
+              let leaf = certificates.first else { return nil }
+        return SecCertificateCopyData(leaf) as Data
+    }
+
+    // MARK: Installation
+
+    /// Starts a helper that waits for this process to exit, replaces `target`
+    /// with `staged`, and reopens it when `relaunch` is set.
+    public static func scheduleInstall(staged: URL, target: URL = Bundle.main.bundleURL, relaunch: Bool) throws {
+        let fm = FileManager.default
+        if target.path.contains("/AppTranslocation/") {
+            throw AppUpdateError.location("LiveHime is running from a temporary location; move it to Applications first")
+        }
+        guard fm.isWritableFile(atPath: target.deletingLastPathComponent().path), fm.isWritableFile(atPath: target.path) else {
+            throw AppUpdateError.location("no permission to replace \(target.path)")
+        }
+        let folder = staged.deletingLastPathComponent().deletingLastPathComponent()
+        let script = folder.appendingPathComponent("install.sh")
+        try """
+        #!/bin/sh
+        # LiveHime update: wait for the app to quit, swap the bundle, keep the old one on failure.
+        # Arguments after the fifth are "--env NAME=VALUE" pairs passed on to the reopened app.
+        pid="$1"; target="$2"; staged="$3"; backup="$4"; relaunch="$5"; shift 5
+        while /bin/kill -0 "$pid" 2>/dev/null; do /bin/sleep 0.3; done
+        /bin/rm -rf "$backup"
+        /bin/mv "$target" "$backup" || exit 1
+        if /usr/bin/ditto "$staged" "$target"; then
+            /bin/rm -rf "$staged"
+        else
+            /bin/rm -rf "$target"
+            /bin/mv "$backup" "$target"
+            exit 1
+        fi
+        if [ "$relaunch" = 1 ]; then /usr/bin/open "$@" "$target"; fi
+        """.write(to: script, atomically: true, encoding: .utf8)
+        let process = Process()
+        process.executableURL = URL(fileURLWithPath: "/usr/bin/nohup")
+        process.arguments = ["/bin/sh", script.path, String(getpid()), target.path, staged.path,
+                             updatesDirectory.appendingPathComponent("previous.app").path, relaunch ? "1" : "0"]
+            // LiveHime's own settings from the environment (test keychain, test feed) survive the relaunch.
+            + ProcessInfo.processInfo.environment.filter { $0.key.hasPrefix("LIVEHIME_") }.sorted { $0.key < $1.key }
+                .flatMap { ["--env", "\($0.key)=\($0.value)"] }
+        let log = folder.appendingPathComponent("install.log")
+        fm.createFile(atPath: log.path, contents: nil)
+        process.standardOutput = try FileHandle(forWritingTo: log)
+        process.standardError = process.standardOutput
+        try process.run()
+    }
+
+    @discardableResult
+    static func run(_ tool: String, _ arguments: [String]) throws -> Int32 {
+        let process = Process()
+        process.executableURL = URL(fileURLWithPath: tool)
+        process.arguments = arguments
+        try process.run()
+        process.waitUntilExit()
+        guard process.terminationStatus == 0 else {
+            throw AppUpdateError.invalidApp("\((tool as NSString).lastPathComponent) failed (\(process.terminationStatus))")
+        }
+        return process.terminationStatus
+    }
+}
+
+/// A download task that reports progress and moves the file into place.
+private final class Downloader: NSObject, URLSessionDownloadDelegate, @unchecked Sendable {
+    private let destination: URL
+    private let expectedSize: Int64
+    private let progress: @Sendable (Double) -> Void
+    private var continuation: CheckedContinuation<Void, Error>?
+    private var moveError: Error?
+
+    private init(destination: URL, expectedSize: Int64, progress: @escaping @Sendable (Double) -> Void) {
+        self.destination = destination
+        self.expectedSize = expectedSize
+        self.progress = progress
+    }
+
+    static func fetch(_ url: URL, to destination: URL, expectedSize: Int64,
+                      progress: @escaping @Sendable (Double) -> Void) async throws {
+        let delegate = Downloader(destination: destination, expectedSize: expectedSize, progress: progress)
+        let session = URLSession(configuration: .ephemeral, delegate: delegate, delegateQueue: nil)
+        defer { session.finishTasksAndInvalidate() }
+        try await withCheckedThrowingContinuation { (continuation: CheckedContinuation<Void, Error>) in
+            delegate.continuation = continuation
+            session.downloadTask(with: url).resume()
+        }
+    }
+
+    func urlSession(_ session: URLSession, downloadTask: URLSessionDownloadTask, didWriteData bytesWritten: Int64,
+                    totalBytesWritten: Int64, totalBytesExpectedToWrite: Int64) {
+        let total = totalBytesExpectedToWrite > 0 ? totalBytesExpectedToWrite : expectedSize
+        if total > 0 { progress(min(1, Double(totalBytesWritten) / Double(total))) }
+    }
+
+    func urlSession(_ session: URLSession, downloadTask: URLSessionDownloadTask, didFinishDownloadingTo location: URL) {
+        if let http = downloadTask.response as? HTTPURLResponse, http.statusCode != 200 {
+            moveError = AppUpdateError.network("HTTP \(http.statusCode)")
+            return
+        }
+        do {
+            try? FileManager.default.removeItem(at: destination)
+            try FileManager.default.moveItem(at: location, to: destination)
+        } catch {
+            moveError = error
+        }
+    }
+
+    func urlSession(_ session: URLSession, task: URLSessionTask, didCompleteWithError error: Error?) {
+        if let error {
+            continuation?.resume(throwing: AppUpdateError.network(error.localizedDescription))
+        } else if let moveError {
+            continuation?.resume(throwing: moveError)
+        } else {
+            continuation?.resume()
+        }
+        continuation = nil
+    }
+}
