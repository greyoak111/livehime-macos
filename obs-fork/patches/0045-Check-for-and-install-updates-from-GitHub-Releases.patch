+import XCTest
+@testable import LiveHimeCore
+
+final class AppUpdaterTests: XCTestCase {
+    func testVersionsCompareNumerically() {
+        XCTAssertTrue(AppUpdater.isNewer("0.2.10", than: "0.2.9"))
+        XCTAssertTrue(AppUpdater.isNewer("0.3", than: "0.2.7"))
+        XCTAssertTrue(AppUpdater.isNewer("1.0.0", than: "0.9.99"))
+        XCTAssertFalse(AppUpdater.isNewer("0.2.7", than: "0.2.7"))
+        XCTAssertFalse(AppUpdater.isNewer("0.2.7", than: "0.2.7.0"))
+        XCTAssertFalse(AppUpdater.isNewer("0.2.6", than: "0.2.7"))
+    }
+
+    func testReadsTheAppArchiveAndItsDigest() throws {
+        let json = #"""
+        {"tag_name":"v0.2.8","html_url":"https://github.com/x/y/releases/tag/v0.2.8","body":"notes",
+         "assets":[
+          {"name":"DEPENDENCY-INVENTORY-v0.2.8.txt","browser_download_url":"https://example.invalid/inv.txt","size":1,
+           "digest":"sha256:00"},
+          {"name":"LiveHimeMacApp-v0.2.8-arm64.dmg","browser_download_url":"https://example.invalid/a.dmg","size":2},
+          {"name":"LiveHimeMacApp-v0.2.8-arm64.zip","browser_download_url":"https://example.invalid/a.zip","size":3,
+           "digest":"sha256:ABCDEF"}]}
+        """#
+        let release = try AppUpdater.release(from: Data(json.utf8))
+        XCTAssertEqual(release.version, "0.2.8")
+        XCTAssertEqual(release.archive.absoluteString, "https://example.invalid/a.zip")
+        XCTAssertEqual(release.size, 3)
+        XCTAssertEqual(release.sha256, "abcdef")
+        XCTAssertEqual(release.notes, "notes")
+    }
+
+    func testReleaseWithoutArchiveIsRejected() {
+        let json = #"{"tag_name":"v0.2.8","assets":[{"name":"x.dmg","browser_download_url":"https://e.invalid/x"}]}"#
+        XCTAssertThrowsError(try AppUpdater.release(from: Data(json.utf8))) {
+            XCTAssertEqual($0 as? AppUpdateError, .noArchive)
+        }
+    }
+
+    func testSha256OfAFile() throws {
+        let file = FileManager.default.temporaryDirectory.appendingPathComponent(UUID().uuidString)
+        try Data("abc".utf8).write(to: file)
+        defer { try? FileManager.default.removeItem(at: file) }
+        XCTAssertEqual(try AppUpdater.sha256(of: file),
+                       "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
+    }
+
+    func testAnotherAppIsNotAccepted() {
+        // A system app: different bundle identifier and signer than the test host.
+        let other = URL(fileURLWithPath: "/System/Applications/Calculator.app")
+        XCTAssertThrowsError(try AppUpdater.verify(app: other, version: "1.0", current: URL(fileURLWithPath: "/System/Applications/TextEdit.app"))) {
+            guard case .invalidApp = $0 as? AppUpdateError else { return XCTFail("\($0)") }
+        }
+    }
+}
