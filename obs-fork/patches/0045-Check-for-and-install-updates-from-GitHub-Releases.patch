new file mode 100644
index 000000000..9f09412e0
--- /dev/null
+++ b/build-aux/livehime/tests/e2e-update.mjs
@@ -0,0 +1,118 @@
+// Updates end to end, against a local release feed (no GitHub, no real account):
+// - a download whose checksum does not match the feed's digest is discarded;
+// - an app signed by another certificate (ad hoc) is discarded;
+// - automatic mode finds 9.9.9, downloads and verifies it, and "restart" quits LiveHime,
+//   swaps the bundle and reopens it: the installed app is then 9.9.9, validly signed.
+// Usage: node e2e-update.mjs <ws password> <built LiveHime.app> <work dir>
+// Copies the app into <work dir>/install and launches that copy with the e2e keychain and
+// LIVEHIME_UPDATE_FEED; quits it at the end. Back up features.json first (the Updates setting).
+import { createHash } from 'node:crypto';
+import { execFileSync } from 'node:child_process';
+import { existsSync, mkdirSync, readFileSync, rmSync, writeFileSync } from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const [password, builtApp, work] = process.argv.slice(2);
+const here = path.dirname(fileURLToPath(import.meta.url));
+const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
+const sh = (cmd, args) => execFileSync(cmd, args, { encoding: 'utf8' });
+const sha = (s) => createHash('sha256').update(s).digest('base64');
+const fileSha = (f) => createHash('sha256').update(readFileSync(f)).digest('hex');
+let fails = 0;
+const check = (n, ok, i = '') => { if (!ok) fails++; console.log(`${ok ? 'PASS' : 'FAIL'}  ${n}${i ? '  — ' + i : ''}`); };
+const plist = (app, key) => sh('/usr/libexec/PlistBuddy', ['-c', `Print ${key}`, `${app}/Contents/Info.plist`]).trim();
+const install = path.join(work, 'install', 'LiveHime.app');
+const feed = path.join(work, 'feed');
+const running = () => { try { return sh('/usr/bin/pgrep', ['-f', `${install}/Contents/MacOS/LiveHime`]).trim(); } catch { return ''; } };
+
+// Fixtures: the installed copy, a 9.9.9 signed like the build, and a 9.9.9 signed ad hoc.
+rmSync(work, { recursive: true, force: true });
+for (const d of ['install', 'new', 'adhoc', 'feed']) mkdirSync(path.join(work, d), { recursive: true });
+sh('/usr/bin/ditto', [builtApp, install]);
+function variant(dir, sign) {
+  const app = path.join(work, dir, 'LiveHime.app');
+  sh('/usr/bin/ditto', [builtApp, app]);
+  sh('/usr/libexec/PlistBuddy', ['-c', 'Set CFBundleShortVersionString 9.9.9', `${app}/Contents/Info.plist`]);
+  sign(app);
+  const zip = path.join(feed, `${dir}.zip`);
+  sh('/usr/bin/ditto', ['-c', '-k', '--keepParent', app, zip]);
+  return zip;
+}
+const good = variant('new', (app) => sh('python3', [path.join(here, '..', 'local-signing.py'), '--deep', '--sign', app]));
+const adhoc = variant('adhoc', (app) => sh('/usr/bin/codesign', ['--force', '--deep', '-s', '-', app]));
+function publish(zip, digest) {
+  writeFileSync(path.join(feed, 'feed.json'), JSON.stringify({
+    tag_name: 'v9.9.9', html_url: 'https://example.invalid/releases/v9.9.9', body: '## Test release\n\n- e2e',
+    assets: [{ name: 'LiveHimeMacApp-v9.9.9-arm64.zip', browser_download_url: `file://${zip}`,
+      size: readFileSync(zip).length, digest: `sha256:${digest}` }],
+  }));
+}
+publish(good, '0'.repeat(64));
+
+async function connect() {
+  for (let i = 0; i < 60; i++) {
+    try {
+      const ws = new WebSocket('ws://127.0.0.1:4466');
+      await new Promise((ok, bad) => { ws.onopen = ok; ws.onerror = bad; });
+      let id = 1; const pend = new Map();
+      await new Promise((ok) => { ws.onmessage = (m) => { const msg = JSON.parse(m.data);
+        if (msg.op === 0) { const a = msg.d.authentication; ws.send(JSON.stringify({ op: 1, d: { rpcVersion: 1, authentication: sha(sha(password + a.salt) + a.challenge) } })); }
+        else if (msg.op === 2) ok(); else if (msg.op === 7) { pend.get(msg.d.requestId)?.(msg.d); pend.delete(msg.d.requestId); } }; });
+      const req = (t, d = {}) => new Promise((r) => { const k = String(id++); pend.set(k, r); ws.send(JSON.stringify({ op: 6, d: { requestType: t, requestId: k, requestData: d } })); });
+      const update = async (d = {}) => (await req('CallVendorRequest', { vendorName: 'livehime', requestType: 'Update', requestData: d })).responseData?.responseData;
+      return { ws, update };
+    } catch { await sleep(1000); }
+  }
+  throw new Error('websocket did not come up');
+}
+async function until(update, pred, seconds) {
+  let st;
+  for (let i = 0; i < seconds * 4; i++) { st = await update(); if (pred(st)) return st; await sleep(250); }
+  return st;
+}
+
+sh('/usr/bin/open', ['-n', '--env', 'LIVEHIME_KEYCHAIN_SERVICE=local.livehime.macos.e2e-test',
+  '--env', `LIVEHIME_UPDATE_FEED=file://${feed}/feed.json`, install]);
+let { ws, update } = await connect();
+try {
+  // Manual mode for the failure cases.
+  await update({ automatic: false });
+  for (const [label, zip, digest, reason] of [['checksum mismatch', good, '0'.repeat(64), 'checksum'],
+                                              ['ad hoc signature', adhoc, fileSha(adhoc), 'invalidApp']]) {
+    publish(zip, digest);
+    await update({ action: 'check' });
+    let st = await until(update, (s) => s?.available === '9.9.9' && s.status !== 'LiveHime.Update.Status.checking', 20);
+    check(`${label}: 9.9.9 found`, st?.available === '9.9.9', JSON.stringify(st));
+    await update({ action: 'download' });
+    st = await until(update, (s) => s?.status === 'failed', 60);
+    check(`${label}: discarded (${reason})`, st?.status === 'failed' && st.reason === reason && !st.ready, JSON.stringify(st));
+  }
+  check('installed app untouched', plist(install, 'CFBundleShortVersionString') !== '9.9.9');
+
+  // Automatic mode: finds, downloads, verifies; restart installs and reopens.
+  publish(good, fileSha(good));
+  await update({ automatic: true });
+  const st = await until(update, (s) => s?.ready === '9.9.9', 90);
+  check('automatic: 9.9.9 downloaded and verified', st?.ready === '9.9.9', JSON.stringify(st));
+  const before = running();
+  const restart = await update({ action: 'restart' });
+  check('restart accepted', restart?.accepted, JSON.stringify(restart));
+  ws.close();
+  for (let i = 0; i < 60 && running() === before; i++) await sleep(500);
+  let reopened = '';
+  for (let i = 0; i < 60 && !(reopened = running()); i++) await sleep(500);
+  check('LiveHime quit and reopened', reopened && reopened !== before, `before ${before}, after ${reopened}`);
+  check('installed app is 9.9.9', plist(install, 'CFBundleShortVersionString') === '9.9.9');
+  let valid = true;
+  try { sh('/usr/bin/codesign', ['--verify', '--deep', '--strict', install]); } catch { valid = false; }
+  check('installed app signature valid', valid);
+  ({ ws, update } = await connect());
+  // The plugin registers its test hooks a moment after the websocket server starts.
+  const after = await until(update, (s) => s !== undefined, 30);
+  check('reopened app runs 9.9.9', after?.current === '9.9.9', JSON.stringify(after));
+} finally {
+  try { ws.close(); } catch {}
+  try { sh('/usr/bin/osascript', ['-e', `tell application id "${plist(install, 'CFBundleIdentifier')}" to quit`]); } catch {}
+  for (let i = 0; i < 40 && running(); i++) await sleep(500);
+}
+process.exit(fails ? 1 : 0);
