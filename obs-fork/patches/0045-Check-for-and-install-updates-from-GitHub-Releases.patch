diff --git a/plugins/livehime/src/update-page.cpp b/plugins/livehime/src/update-page.cpp
new file mode 100644
index 000000000..01ac69fb5
--- /dev/null
+++ b/plugins/livehime/src/update-page.cpp
@@ -0,0 +1,267 @@
+#include "update-page.hpp"
+#include "plugin-settings.hpp"
+
+#include <livehime-core.h>
+#include <obs-module.h>
+
+#include <CoreFoundation/CoreFoundation.h>
+
+#include <QCheckBox>
+#include <QDesktopServices>
+#include <QHBoxLayout>
+#include <QLabel>
+#include <QMainWindow>
+#include <QProgressBar>
+#include <QPushButton>
+#include <QSignalBlocker>
+#include <QTextBrowser>
+#include <QTimer>
+#include <QUrl>
+#include <QVBoxLayout>
+
+namespace {
+QString text(const char *key)
+{
+	return QString::fromUtf8(obs_module_text(key));
+}
+} // namespace
+
+QString UpdatePage::currentVersion()
+{
+	auto value = static_cast<CFStringRef>(
+		CFBundleGetValueForInfoDictionaryKey(CFBundleGetMainBundle(), CFSTR("CFBundleShortVersionString")));
+	if (!value || CFGetTypeID(value) != CFStringGetTypeID())
+		return QString();
+	char buffer[64] = {};
+	CFStringGetCString(value, buffer, sizeof(buffer), kCFStringEncodingUTF8);
+	return QString::fromUtf8(buffer);
+}
+
+namespace {
+const QString kReleases = QStringLiteral("https://github.com/greyoak111/livehime-macos/releases");
+/* Automatic checks: shortly after launch, then every six hours. */
+constexpr int kFirstCheckMs = 15 * 1000;
+constexpr int kCheckIntervalMs = 6 * 60 * 60 * 1000;
+} // namespace
+
+UpdatePage::UpdatePage(QWidget *parent) : QWidget(parent)
+{
+	load();
+
+	version_ = new QLabel(text("LiveHime.Update.Current").arg(currentVersion()), this);
+	auto_ = new QCheckBox(text("LiveHime.Update.Automatic"), this);
+	auto_->setToolTip(text("LiveHime.Update.AutomaticTip"));
+	auto_->setChecked(automatic_);
+	check_ = new QPushButton(text("LiveHime.Update.Check"), this);
+	status_ = new QLabel(this);
+	status_->setWordWrap(true);
+	bar_ = new QProgressBar(this);
+	bar_->setRange(0, 100);
+	bar_->setTextVisible(true);
+	bar_->hide();
+	notes_ = new QTextBrowser(this);
+	notes_->setOpenExternalLinks(true);
+	notes_->setMaximumHeight(220);
+	notes_->hide();
+	action_ = new QPushButton(this);
+	action_->hide();
+	link_ = new QLabel(QStringLiteral("<a href=\"%1\" style=\"color:#fb7299\">%2</a>")
+				   .arg(kReleases, text("LiveHime.Update.OpenReleases")),
+			   this);
+	link_->setOpenExternalLinks(false);
+	connect(link_, &QLabel::linkActivated, this,
+		[this](const QString &url) { QDesktopServices::openUrl(QUrl(page_.isEmpty() ? url : page_)); });
+	auto *hint = new QLabel(text("LiveHime.Update.Hint"), this);
+	hint->setWordWrap(true);
+	hint->setStyleSheet(QStringLiteral("color: #9aa0ab;"));
+
+	auto *top = new QHBoxLayout;
+	top->addWidget(version_, 1);
+	top->addWidget(check_);
+	auto *layout = new QVBoxLayout(this);
+	layout->setContentsMargins(0, 6, 0, 0);
+	layout->addLayout(top);
+	layout->addWidget(auto_);
+	layout->addWidget(status_);
+	layout->addWidget(bar_);
+	layout->addWidget(notes_);
+	layout->addWidget(action_);
+	layout->addWidget(link_);
+	layout->addWidget(hint);
+	layout->addStretch(1);
+
+	connect(auto_, &QCheckBox::toggled, this, &UpdatePage::setAutomatic);
+	connect(check_, &QPushButton::clicked, this, &UpdatePage::check);
+	connect(action_, &QPushButton::clicked, this, [this] {
+		if (!readyVersion_.isEmpty())
+			restartNow();
+		else
+			download();
+	});
+
+	timer_ = new QTimer(this);
+	connect(timer_, &QTimer::timeout, this, [this] {
+		timer_->setInterval(kCheckIntervalMs);
+		if (automatic_ && readyVersion_.isEmpty())
+			check();
+	});
+	if (automatic_) {
+		timer_->setInterval(kFirstCheckMs);
+		timer_->start();
+	}
+	setStatus(automatic_ ? "LiveHime.Update.Status.auto" : "LiveHime.Update.Status.manual");
+	obs_frontend_add_event_callback(frontendEvent, this);
+}
+
+UpdatePage::~UpdatePage()
+{
+	obs_frontend_remove_event_callback(frontendEvent, this);
+}
+
+void UpdatePage::frontendEvent(enum obs_frontend_event event, void *param)
+{
+	auto *self = static_cast<UpdatePage *>(param);
+	/* A downloaded update is installed when LiveHime quits. */
+	if (event == OBS_FRONTEND_EVENT_EXIT && !self->readyVersion_.isEmpty()) {
+		if (livehime_core_update_install(0))
+			blog(LOG_INFO, "[livehime] installing %s after quitting", self->readyVersion_.toUtf8().constData());
+	}
+}
+
+void UpdatePage::setAutomatic(bool automatic)
+{
+	if (automatic == automatic_)
+		return;
+	automatic_ = automatic;
+	{
+		QSignalBlocker block(auto_);
+		auto_->setChecked(automatic);
+	}
+	save();
+	if (automatic_) {
+		timer_->setInterval(kFirstCheckMs);
+		timer_->start();
+	} else {
+		timer_->stop();
+	}
+	if (status_key_ == "LiveHime.Update.Status.auto" || status_key_ == "LiveHime.Update.Status.manual")
+		setStatus(automatic_ ? "LiveHime.Update.Status.auto" : "LiveHime.Update.Status.manual");
+}
+
+void UpdatePage::check()
+{
+	livehime_core_update_check();
+}
+
+void UpdatePage::download()
+{
+	livehime_core_update_download();
+}
+
+bool UpdatePage::restartNow()
+{
+	if (readyVersion_.isEmpty())
+		return false;
+	if (obs_frontend_streaming_active() || obs_frontend_recording_active()) {
+		setStatus("LiveHime.Update.Status.busyOutput", readyVersion_, true);
+		return false;
+	}
+	if (!livehime_core_update_install(1))
+		return false;
+	readyVersion_.clear();
+	blog(LOG_INFO, "[livehime] quitting to install the update");
+	if (auto *main = static_cast<QMainWindow *>(obs_frontend_get_main_window()))
+		QMetaObject::invokeMethod(main, "close", Qt::QueuedConnection);
+	return true;
+}
+
+void UpdatePage::handleEvent(const QJsonObject &event)
+{
+	const QString status = event.value("status").toString();
+	supported_ = event.value("supported").toBool(true);
+	const QString version = event.value("version").toString();
+	if (event.contains("page"))
+		page_ = event.value("page").toString();
+	check_->setEnabled(status != "checking" && status != "downloading");
+	bar_->setVisible(status == "downloading");
+	if (status != "failed")
+		failReason_.clear();
+	if (status == "checking") {
+		setStatus("LiveHime.Update.Status.checking");
+	} else if (status == "upToDate") {
+		availableVersion_.clear();
+		notes_->hide();
+		action_->hide();
+		setStatus("LiveHime.Update.Status.upToDate");
+	} else if (status == "available") {
+		availableVersion_ = version;
+		notes_->setMarkdown(event.value("notes").toString());
+		notes_->setVisible(!notes_->toPlainText().isEmpty());
+		if (!supported_) {
+			action_->hide();
+			setStatus("LiveHime.Update.Status.devBuild", version);
+		} else {
+			action_->setText(text("LiveHime.Update.Download").arg(version));
+			action_->setVisible(!automatic_);
+			setStatus("LiveHime.Update.Status.available", version);
+			if (automatic_)
+				download();
+		}
+		emit available(version);
+	} else if (status == "downloading") {
+		progress_ = event.value("progress").toDouble();
+		bar_->setValue(static_cast<int>(progress_ * 100));
+		action_->hide();
+		setStatus("LiveHime.Update.Status.downloading", version);
+	} else if (status == "ready") {
+		readyVersion_ = version;
+		action_->setText(text("LiveHime.Update.Restart").arg(version));
+		action_->show();
+		setStatus("LiveHime.Update.Status.ready", version);
+		emit ready(version);
+	} else if (status == "failed") {
+		const QString reason = event.value("reason").toString();
+		failReason_ = reason;
+		const QByteArray key = "LiveHime.Update.Failed." + reason.toUtf8();
+		const char *localized = obs_module_text(key.constData());
+		QString message = QString::fromUtf8(localized);
+		if (message == QString::fromUtf8(key))
+			message = text("LiveHime.Update.Failed.network");
+		status_key_ = QStringLiteral("failed");
+		status_->setText(message + QStringLiteral("\n") + text("LiveHime.Update.Status.manualHint"));
+		status_->setStyleSheet(QStringLiteral("color: #e06c75;"));
+		blog(LOG_WARNING, "[livehime] update failed: %s %s", reason.toUtf8().constData(),
+		     event.value("message").toString().toUtf8().constData());
+		/* A manual retry offers the download again. */
+		if (!availableVersion_.isEmpty() && supported_ && readyVersion_.isEmpty()) {
+			action_->setText(text("LiveHime.Update.Download").arg(availableVersion_));
+			action_->show();
+		}
+	}
+}
+
+void UpdatePage::setStatus(const char *key, const QString &arg, bool error)
+{
+	status_key_ = QString::fromUtf8(key);
+	QString message = text(key);
+	if (message.contains(QStringLiteral("%1")))
+		message = message.arg(arg);
+	status_->setText(message);
+	status_->setStyleSheet(error ? QStringLiteral("color: #e06c75;") : QStringLiteral("color: #9aa0ab;"));
+}
+
+void UpdatePage::load()
+{
+	OBSDataAutoRelease settings = LoadPluginSettings();
+	OBSDataAutoRelease update = obs_data_get_obj(settings, "update");
+	automatic_ = !update || !obs_data_has_user_value(update, "automatic") || obs_data_get_bool(update, "automatic");
+}
+
+void UpdatePage::save() const
+{
+	OBSDataAutoRelease update = obs_data_create();
+	obs_data_set_bool(update, "automatic", automatic_);
+	OBSDataAutoRelease changes = obs_data_create();
+	obs_data_set_obj(changes, "update", update);
+	SavePluginSettings(changes);
+}
