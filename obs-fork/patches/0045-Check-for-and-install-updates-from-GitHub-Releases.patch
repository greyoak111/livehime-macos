@@ -0,0 +1,73 @@
+#pragma once
+
+#include <obs-frontend-api.h>
+
+#include <QJsonObject>
+#include <QWidget>
+
+class QCheckBox;
+class QLabel;
+class QProgressBar;
+class QPushButton;
+class QTextBrowser;
+class QTimer;
+
+/* The dock's "Updates" tab. Automatic mode checks GitHub Releases shortly
+ * after launch and every few hours and downloads a new version in the
+ * background; manual mode checks and downloads only on request. Both use
+ * the same verified download, installed when LiveHime quits or at once with
+ * "Restart and update" (not while streaming or recording). Settings live in
+ * features.json under "update". */
+class UpdatePage : public QWidget {
+	Q_OBJECT
+
+public:
+	explicit UpdatePage(QWidget *parent = nullptr);
+	~UpdatePage() override;
+
+	void handleEvent(const QJsonObject &event);
+	bool automatic() const { return automatic_; }
+	void setAutomatic(bool automatic);
+	/* Automation and the banner: same as the buttons. */
+	void check();
+	void download();
+	/* Quits LiveHime to install now; false while streaming or recording. */
+	bool restartNow();
+	QString status() const { return status_key_; }
+	QString readyVersion() const { return readyVersion_; }
+	QString availableVersion() const { return availableVersion_; }
+	double progress() const { return progress_; }
+	QString failReason() const { return failReason_; }
+	/* The running app's version (CFBundleShortVersionString). */
+	static QString currentVersion();
+
+signals:
+	/* A newer version was found (not yet downloaded), or is downloaded. */
+	void available(const QString &version);
+	void ready(const QString &version);
+
+private:
+	static void frontendEvent(enum obs_frontend_event event, void *param);
+	void setStatus(const char *key, const QString &arg = QString(), bool error = false);
+	void load();
+	void save() const;
+
+	bool automatic_ = true;
+	bool supported_ = true;
+	QString status_key_;
+	QString availableVersion_;
+	QString readyVersion_;
+	QString page_;
+	double progress_ = 0;
+	QString failReason_;
+
+	QLabel *version_;
+	QCheckBox *auto_;
+	QPushButton *check_;
+	QLabel *status_;
+	QProgressBar *bar_;
+	QTextBrowser *notes_;
+	QPushButton *action_;
+	QLabel *link_;
+	QTimer *timer_;
+};
