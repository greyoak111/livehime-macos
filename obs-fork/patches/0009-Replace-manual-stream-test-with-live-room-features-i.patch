+#pragma once
+
+#include <QJsonObject>
+#include <QWidget>
+
+class QCheckBox;
+class QLabel;
+class QLineEdit;
+class QListWidget;
+class QPushButton;
+class QTabWidget;
+
+/* Everyday live-room features below the account section: room stats, the
+ * live danmaku feed (chat, gifts, Super Chats, guards, entries) with sending
+ * and read-aloud, and room title editing. It is driven by the core's state
+ * and events, forwarded by AccountPanel. */
+class FeaturePanel : public QWidget {
+	Q_OBJECT
+
+public:
+	explicit FeaturePanel(QWidget *parent = nullptr);
+
+public slots:
+	void applyState(const QJsonObject &state);
+	void applyEvent(const QJsonObject &event);
+
+private:
+	void appendFeed(const QString &line, const QString &color = QString());
+	void onRoomEvent(const QJsonObject &event);
+	void updateStats();
+	void sendDanmaku();
+	void saveTitle();
+	void loadSettings();
+	void saveSettings();
+
+	bool ready_ = false;
+	int watched_ = -1;
+	int likes_ = -1;
+	int onlineRank_ = -1;
+	QString danmakuStatus_ = QStringLiteral("stopped");
+
+	QLabel *stats_;
+	QTabWidget *tabs_;
+	QListWidget *feed_;
+	QCheckBox *showEntries_;
+	QCheckBox *readAloud_;
+	QLineEdit *message_;
+	QPushButton *send_;
+	QLineEdit *title_;
+	QPushButton *saveTitle_;
+	QLabel *roomStatus_;
+	QLabel *signedOutHint_;
+};
