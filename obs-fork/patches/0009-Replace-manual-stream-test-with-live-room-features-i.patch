diff --git a/plugins/livehime/src/feature-panel.cpp b/plugins/livehime/src/feature-panel.cpp
new file mode 100644
index 000000000..1eae9f181
--- /dev/null
+++ b/plugins/livehime/src/feature-panel.cpp
@@ -0,0 +1,274 @@
+#include "feature-panel.hpp"
+
+#include <livehime-core.h>
+#include <obs-module.h>
+#include <obs.hpp>
+#include <util/platform.h>
+#include <util/util.hpp>
+
+#include <QCheckBox>
+#include <QFormLayout>
+#include <QHBoxLayout>
+#include <QLabel>
+#include <QLineEdit>
+#include <QListWidget>
+#include <QPushButton>
+#include <QScrollBar>
+#include <QTabWidget>
+#include <QVBoxLayout>
+
+namespace {
+QString text(const char *key)
+{
+	return QString::fromUtf8(obs_module_text(key));
+}
+
+QString countText(int value)
+{
+	if (value < 0)
+		return QStringLiteral("—");
+	/* Chinese groups by 万 (10,000); other locales use k (1,000). */
+	const QString unit = text("LiveHime.Feature.TenThousand");
+	const int divisor = unit == QStringLiteral("k") ? 1000 : 10000;
+	if (value >= divisor)
+		return QString::number(value / double(divisor), 'f', 1) + unit;
+	return QString::number(value);
+}
+
+constexpr int kMaxFeedItems = 300;
+} // namespace
+
+FeaturePanel::FeaturePanel(QWidget *parent) : QWidget(parent)
+{
+	stats_ = new QLabel(this);
+	stats_->setStyleSheet(QStringLiteral("color: #9aa0ab; font-family: Menlo, monospace;"));
+	signedOutHint_ = new QLabel(text("LiveHime.Feature.SignInFirst"), this);
+	signedOutHint_->setWordWrap(true);
+	signedOutHint_->setStyleSheet(QStringLiteral("color: #9aa0ab;"));
+
+	/* Danmaku tab */
+	auto *danmakuPage = new QWidget(this);
+	feed_ = new QListWidget(danmakuPage);
+	feed_->setWordWrap(true);
+	feed_->setUniformItemSizes(false);
+	feed_->setSelectionMode(QAbstractItemView::ExtendedSelection);
+	showEntries_ = new QCheckBox(text("LiveHime.Feature.ShowEntries"), danmakuPage);
+	readAloud_ = new QCheckBox(text("LiveHime.Feature.ReadAloud"), danmakuPage);
+	auto *options = new QHBoxLayout;
+	options->addWidget(showEntries_);
+	options->addWidget(readAloud_);
+	options->addStretch(1);
+	message_ = new QLineEdit(danmakuPage);
+	message_->setPlaceholderText(text("LiveHime.Feature.MessagePlaceholder"));
+	message_->setMaxLength(40);
+	send_ = new QPushButton(text("LiveHime.Feature.Send"), danmakuPage);
+	auto *sendRow = new QHBoxLayout;
+	sendRow->addWidget(message_, 1);
+	sendRow->addWidget(send_);
+	auto *danmakuLayout = new QVBoxLayout(danmakuPage);
+	danmakuLayout->setContentsMargins(0, 6, 0, 0);
+	danmakuLayout->addWidget(feed_, 1);
+	danmakuLayout->addLayout(options);
+	danmakuLayout->addLayout(sendRow);
+
+	/* Room tab */
+	auto *roomPage = new QWidget(this);
+	title_ = new QLineEdit(roomPage);
+	title_->setMaxLength(40);
+	saveTitle_ = new QPushButton(text("LiveHime.Feature.SaveTitle"), roomPage);
+	auto *titleRow = new QHBoxLayout;
+	titleRow->addWidget(title_, 1);
+	titleRow->addWidget(saveTitle_);
+	roomStatus_ = new QLabel(roomPage);
+	roomStatus_->setWordWrap(true);
+	auto *roomForm = new QFormLayout;
+	roomForm->addRow(text("LiveHime.Feature.Title"), titleRow);
+	auto *roomLayout = new QVBoxLayout(roomPage);
+	roomLayout->setContentsMargins(0, 6, 0, 0);
+	roomLayout->addLayout(roomForm);
+	roomLayout->addWidget(roomStatus_);
+	roomLayout->addStretch(1);
+
+	tabs_ = new QTabWidget(this);
+	tabs_->addTab(danmakuPage, text("LiveHime.Feature.DanmakuTab"));
+	tabs_->addTab(roomPage, text("LiveHime.Feature.RoomTab"));
+
+	auto *layout = new QVBoxLayout(this);
+	layout->setContentsMargins(0, 0, 0, 0);
+	layout->addWidget(stats_);
+	layout->addWidget(signedOutHint_);
+	layout->addWidget(tabs_, 1);
+
+	connect(send_, &QPushButton::clicked, this, &FeaturePanel::sendDanmaku);
+	connect(message_, &QLineEdit::returnPressed, this, &FeaturePanel::sendDanmaku);
+	connect(saveTitle_, &QPushButton::clicked, this, &FeaturePanel::saveTitle);
+	connect(readAloud_, &QCheckBox::toggled, this, [this](bool on) {
+		livehime_core_set_tts(on ? 1 : 0);
+		saveSettings();
+	});
+	connect(showEntries_, &QCheckBox::toggled, this, &FeaturePanel::saveSettings);
+
+	loadSettings();
+	applyState(QJsonObject());
+}
+
+void FeaturePanel::applyState(const QJsonObject &state)
+{
+	const bool ready = state.value("state").toString() == "ready";
+	if (ready && !title_->hasFocus())
+		title_->setText(state.value("title").toString());
+	if (ready != ready_) {
+		ready_ = ready;
+		if (!ready) {
+			watched_ = likes_ = onlineRank_ = -1;
+			feed_->clear();
+		}
+	}
+	tabs_->setEnabled(ready);
+	signedOutHint_->setVisible(!ready);
+	updateStats();
+}
+
+void FeaturePanel::applyEvent(const QJsonObject &event)
+{
+	const QString name = event.value("event").toString();
+	if (name == "room") {
+		onRoomEvent(event);
+	} else if (name == "danmakuStatus") {
+		danmakuStatus_ = event.value("status").toString();
+		updateStats();
+	} else if (name == "danmakuSent") {
+		send_->setEnabled(true);
+		if (event.value("ok").toBool()) {
+			message_->clear();
+		} else {
+			const QString detail = event.value("message").toString();
+			appendFeed(text("LiveHime.Feature.SendFailed") + (detail.isEmpty() ? QString() : QStringLiteral("：") + detail),
+				   QStringLiteral("#e06c75"));
+		}
+	} else if (name == "titleUpdated") {
+		saveTitle_->setEnabled(true);
+		const bool ok = event.value("ok").toBool();
+		const QString detail = event.value("message").toString();
+		roomStatus_->setText(ok ? text("LiveHime.Feature.TitleSaved")
+					: text("LiveHime.Feature.TitleFailed") +
+						  (detail.isEmpty() ? QString() : QStringLiteral("\n") + detail));
+		roomStatus_->setStyleSheet(ok ? QStringLiteral("color: #9aa0ab;") : QStringLiteral("color: #e06c75;"));
+	}
+}
+
+void FeaturePanel::onRoomEvent(const QJsonObject &event)
+{
+	const QString kind = event.value("kind").toString();
+	const QString user = event.value("user").toString();
+	if (kind == "chat") {
+		const QString medal = event.value("medal").toString();
+		appendFeed((medal.isEmpty() ? QString() : QStringLiteral("[%1] ").arg(medal)) + user + QStringLiteral("：") +
+			   event.value("text").toString());
+	} else if (kind == "gift") {
+		appendFeed(text("LiveHime.Feature.Gift")
+				   .arg(user, event.value("name").toString())
+				   .arg(event.value("count").toInt()),
+			   QStringLiteral("#e0a040"));
+	} else if (kind == "superChat") {
+		appendFeed(text("LiveHime.Feature.SuperChat")
+				   .arg(event.value("price").toInt())
+				   .arg(user, event.value("text").toString()),
+			   QStringLiteral("#fb4d5a"));
+	} else if (kind == "guard") {
+		appendFeed(text("LiveHime.Feature.Guard").arg(user, event.value("name").toString()),
+			   QStringLiteral("#8994ee"));
+	} else if (kind == "enter" || kind == "follow" || kind == "share") {
+		if (showEntries_->isChecked() || kind == "follow") {
+			const QByteArray key = "LiveHime.Feature.Interact." + kind.toUtf8();
+			appendFeed(text(key.constData()).arg(user), QStringLiteral("#6c717b"));
+		}
+	} else if (kind == "watched") {
+		watched_ = event.value("value").toInt();
+		updateStats();
+	} else if (kind == "likes") {
+		likes_ = event.value("value").toInt();
+		updateStats();
+	} else if (kind == "onlineRank") {
+		onlineRank_ = event.value("value").toInt();
+		updateStats();
+	} else if (kind == "liveStarted" || kind == "liveEnded") {
+		appendFeed(text(kind == "liveStarted" ? "LiveHime.Feature.LiveStarted" : "LiveHime.Feature.LiveEnded"),
+			   QStringLiteral("#9aa0ab"));
+	}
+}
+
+void FeaturePanel::appendFeed(const QString &line, const QString &color)
+{
+	QScrollBar *bar = feed_->verticalScrollBar();
+	const bool atBottom = bar->value() >= bar->maximum() - 4;
+	auto *item = new QListWidgetItem(line);
+	if (!color.isEmpty())
+		item->setForeground(QColor(color));
+	feed_->addItem(item);
+	while (feed_->count() > kMaxFeedItems)
+		delete feed_->takeItem(0);
+	/* Keep following new messages unless the user scrolled up to read. */
+	if (atBottom)
+		feed_->scrollToBottom();
+}
+
+void FeaturePanel::updateStats()
+{
+	if (!ready_) {
+		stats_->clear();
+		stats_->setVisible(false);
+		return;
+	}
+	const QByteArray statusKey = "LiveHime.Feature.Danmaku." + danmakuStatus_.toUtf8();
+	stats_->setText(text("LiveHime.Feature.Stats")
+				.arg(countText(watched_), countText(likes_), countText(onlineRank_),
+				     text(statusKey.constData())));
+	stats_->setVisible(true);
+}
+
+void FeaturePanel::sendDanmaku()
+{
+	const QByteArray message = message_->text().trimmed().toUtf8();
+	if (!ready_ || message.isEmpty())
+		return;
+	send_->setEnabled(false);
+	livehime_core_send_danmaku(message.constData());
+}
+
+void FeaturePanel::saveTitle()
+{
+	const QByteArray title = title_->text().trimmed().toUtf8();
+	if (!ready_ || title.isEmpty())
+		return;
+	saveTitle_->setEnabled(false);
+	roomStatus_->setText(text("LiveHime.Feature.TitleSaving"));
+	roomStatus_->setStyleSheet(QStringLiteral("color: #9aa0ab;"));
+	livehime_core_update_title(title.constData());
+}
+
+void FeaturePanel::loadSettings()
+{
+	BPtr<char> path = obs_module_config_path("features.json");
+	OBSDataAutoRelease data = path ? obs_data_create_from_json_file_safe(path, "bak") : nullptr;
+	const bool entries = data ? obs_data_get_bool(data, "show_entries") : false;
+	const bool tts = data ? obs_data_get_bool(data, "read_aloud") : false;
+	QSignalBlocker blockEntries(showEntries_);
+	QSignalBlocker blockTts(readAloud_);
+	showEntries_->setChecked(entries);
+	readAloud_->setChecked(tts);
+	livehime_core_set_tts(tts ? 1 : 0);
+}
+
+void FeaturePanel::saveSettings()
+{
+	BPtr<char> dir = obs_module_config_path("");
+	BPtr<char> path = obs_module_config_path("features.json");
+	if (!dir || !path)
+		return;
+	os_mkdirs(dir);
+	OBSDataAutoRelease data = obs_data_create();
+	obs_data_set_bool(data, "show_entries", showEntries_->isChecked());
+	obs_data_set_bool(data, "read_aloud", readAloud_->isChecked());
+	obs_data_save_json_safe(data, path, "tmp", "bak");
+}
