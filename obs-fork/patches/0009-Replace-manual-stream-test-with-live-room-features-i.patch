diff --git a/plugins/livehime/core/Sources/LiveHimeCore/DanmakuClient.swift b/plugins/livehime/core/Sources/LiveHimeCore/DanmakuClient.swift
new file mode 100644
index 000000000..db2ceee29
--- /dev/null
+++ b/plugins/livehime/core/Sources/LiveHimeCore/DanmakuClient.swift
@@ -0,0 +1,143 @@
+import AVFoundation
+import Foundation
+
+/// Keeps one live room's danmaku connection open: fetch a token, connect to
+/// one of the servers, authenticate, send a heartbeat every 30 seconds and
+/// reconnect with backoff (2 s doubling to 30 s) until stopped.
+@MainActor
+public final class DanmakuClient {
+    public enum Status: String, Sendable { case stopped, connecting, connected, reconnecting }
+
+    public var onEvent: ((LiveRoomEvent) -> Void)?
+    public var onStatus: ((Status) -> Void)?
+    public private(set) var roomID: Int64?
+    public private(set) var status: Status = .stopped {
+        didSet { if status != oldValue { onStatus?(status) } }
+    }
+
+    private var task: Task<Void, Never>?
+    private let socketSession = URLSession(configuration: .ephemeral)
+
+    public init() {}
+
+    public func start(roomID: Int64, uid: Int64, cookieHeader: String) {
+        stop()
+        self.roomID = roomID
+        task = Task { await self.run(roomID: roomID, uid: uid, cookieHeader: cookieHeader) }
+    }
+
+    public func stop() {
+        task?.cancel()
+        task = nil
+        roomID = nil
+        status = .stopped
+    }
+
+    private func run(roomID: Int64, uid: Int64, cookieHeader: String) async {
+        var backoff: Duration = .seconds(2)
+        var attempt = 0
+        while !Task.isCancelled {
+            status = attempt == 0 ? .connecting : .reconnecting
+            attempt += 1
+            let connectedFor = await session(roomID: roomID, uid: uid, cookieHeader: cookieHeader)
+            guard !Task.isCancelled else { break }
+            // A connection that stayed up for a while starts over quickly.
+            backoff = connectedFor > .seconds(60) ? .seconds(2) : min(backoff * 2, .seconds(30))
+            status = .reconnecting
+            try? await Task.sleep(for: backoff)
+        }
+    }
+
+    /// One connection; returns how long it stayed connected.
+    private func session(roomID: Int64, uid: Int64, cookieHeader: String) async -> Duration {
+        let clock = ContinuousClock()
+        var connectedAt: ContinuousClock.Instant?
+        do {
+            let client = BilibiliLiveClient(cookieHeader: cookieHeader, session: BilibiliWeb.session)
+            let info = try await client.danmakuConnectInfo(roomID: roomID, cookieHeader: cookieHeader)
+            let server = info.servers[Int.random(in: 0..<info.servers.count)]
+            var request = URLRequest(url: URL(string: "wss://\(server.host):\(server.port)/sub")!)
+            request.setValue(BilibiliWeb.userAgent, forHTTPHeaderField: "User-Agent")
+            request.setValue("https://live.bilibili.com", forHTTPHeaderField: "Origin")
+            let socket = socketSession.webSocketTask(with: request)
+            socket.resume()
+            defer { socket.cancel(with: .goingAway, reason: nil) }
+
+            let auth: [String: Any] = ["uid": uid, "roomid": roomID, "protover": 3, "buvid": info.buvid,
+                                       "platform": "web", "type": 2, "key": info.token]
+            try await socket.send(.data(DanmakuPacket.encode(.auth, body: try JSONSerialization.data(withJSONObject: auth))))
+
+            let heartbeat = Task {
+                while !Task.isCancelled {
+                    try? await socket.send(.data(DanmakuPacket.encode(.heartbeat, body: Data("[object Object]".utf8))))
+                    try? await Task.sleep(for: .seconds(30))
+                }
+            }
+            defer { heartbeat.cancel() }
+
+            while !Task.isCancelled {
+                let data: Data
+                switch try await socket.receive() {
+                case .data(let bytes): data = bytes
+                case .string(let text): data = Data(text.utf8)
+                @unknown default: continue
+                }
+                for packet in DanmakuPacket.decode(data) {
+                    if packet.operation == DanmakuOperation.authReply.rawValue {
+                        let reply = try? JSONSerialization.jsonObject(with: packet.body) as? [String: Any]
+                        guard DanmakuParser.int(reply?["code"]) == 0 else { return .zero }
+                        connectedAt = clock.now
+                        status = .connected
+                    }
+                    for event in DanmakuParser.events(from: packet) { onEvent?(event) }
+                }
+            }
+        } catch {
+            // Fall through to reconnect; the dock shows the status.
+        }
+        return connectedAt.map { clock.now - $0 } ?? .zero
+    }
+}
+
+/// Reads chat, gifts and Super Chats aloud with the system voice. Keeps a
+/// short queue so a busy room never builds up minutes of backlog.
+@MainActor
+public final class DanmakuSpeaker: NSObject, AVSpeechSynthesizerDelegate {
+    public var enabled = false {
+        didSet { if !enabled { synthesizer.stopSpeaking(at: .immediate); pending = 0 } }
+    }
+    private let synthesizer = AVSpeechSynthesizer()
+    private var pending = 0
+    private let maxPending = 4
+
+    public override init() {
+        super.init()
+        synthesizer.delegate = self
+    }
+
+    public func speak(_ event: LiveRoomEvent) {
+        guard enabled, pending < maxPending, let line = Self.line(for: event) else { return }
+        let utterance = AVSpeechUtterance(string: line)
+        utterance.voice = AVSpeechSynthesisVoice(language: "zh-CN")
+        pending += 1
+        synthesizer.speak(utterance)
+    }
+
+    static func line(for event: LiveRoomEvent) -> String? {
+        switch event {
+        case .chat(_, let user, let text, _): return "\(user)说：\(text)"
+        case .gift(let user, let name, let count, _, _): return "感谢\(user)送的\(count)个\(name)"
+        case .superChat(let user, let text, _): return "\(user)的醒目留言：\(text)"
+        case .guardBought(let user, _, let name, _): return "感谢\(user)开通\(name)"
+        default: return nil
+        }
+    }
+
+    nonisolated public func speechSynthesizer(_ synthesizer: AVSpeechSynthesizer, didFinish utterance: AVSpeechUtterance) {
+        Task { @MainActor in self.pending = max(0, self.pending - 1) }
+    }
+
+    nonisolated public func speechSynthesizer(_ synthesizer: AVSpeechSynthesizer, didCancel utterance: AVSpeechUtterance) {
+        Task { @MainActor in self.pending = max(0, self.pending - 1) }
+    }
+}
diff --git a/plugins/livehime/core/Sources/LiveHimeCore/DanmakuProtocol.swift b/plugins/livehime/core/Sources/LiveHimeCore/DanmakuProtocol.swift
new file mode 100644
index 000000000..ea04f4e6c
--- /dev/null
+++ b/plugins/livehime/core/Sources/LiveHimeCore/DanmakuProtocol.swift
@@ -0,0 +1,251 @@
+import Compression
+import CryptoKit
+import Foundation
+
+// Bilibili live danmaku ("broadcast") protocol: 16-byte big-endian header
+// (packet length, header length, protocol version, operation, sequence)
+// followed by a body. Operation 5 bodies are JSON commands, possibly packed
+// as zlib (version 2) or brotli (version 3) compressed packet streams.
+
+enum DanmakuOperation: UInt32 {
+    case heartbeat = 2
+    case heartbeatReply = 3
+    case message = 5
+    case auth = 7
+    case authReply = 8
+}
+
+struct DanmakuPacket: Equatable {
+    var version: UInt16
+    var operation: UInt32
+    var body: Data
+
+    static let headerLength = 16
+
+    static func encode(_ operation: DanmakuOperation, body: Data, version: UInt16 = 1) -> Data {
+        var data = Data(capacity: headerLength + body.count)
+        func append<T: FixedWidthInteger>(_ value: T) { withUnsafeBytes(of: value.bigEndian) { data.append(contentsOf: $0) } }
+        append(UInt32(headerLength + body.count))
+        append(UInt16(headerLength))
+        append(version)
+        append(operation.rawValue)
+        append(UInt32(1))
+        data.append(body)
+        return data
+    }
+
+    /// Splits a frame into packets, expanding compressed containers.
+    static func decode(_ data: Data) -> [DanmakuPacket] {
+        var packets: [DanmakuPacket] = []
+        var offset = data.startIndex
+        while data.endIndex - offset >= headerLength {
+            let length = Int(read(UInt32.self, data, offset))
+            let header = Int(read(UInt16.self, data, offset + 4))
+            guard length >= header, header >= headerLength, offset + length <= data.endIndex else { break }
+            let packet = DanmakuPacket(version: read(UInt16.self, data, offset + 6),
+                                       operation: read(UInt32.self, data, offset + 8),
+                                       body: data.subdata(in: (offset + header)..<(offset + length)))
+            if packet.operation == DanmakuOperation.message.rawValue, packet.version == 2 || packet.version == 3,
+               let inflated = decompress(packet.body, brotli: packet.version == 3) {
+                packets += decode(inflated)
+            } else {
+                packets.append(packet)
+            }
+            offset += length
+        }
+        return packets
+    }
+
+    private static func read<T: FixedWidthInteger>(_ type: T.Type, _ data: Data, _ offset: Int) -> T {
+        var value: T = 0
+        _ = withUnsafeMutableBytes(of: &value) { data.copyBytes(to: $0, from: offset..<(offset + MemoryLayout<T>.size)) }
+        return T(bigEndian: value)
+    }
+
+    /// zlib bodies carry a 2-byte header and 4-byte checksum around raw
+    /// deflate, which is what Compression's ZLIB algorithm decodes.
+    static func decompress(_ data: Data, brotli: Bool) -> Data? {
+        var input = data
+        if !brotli {
+            guard input.count > 6 else { return nil }
+            input = input.subdata(in: (input.startIndex + 2)..<(input.endIndex - 4))
+        }
+        let algorithm = brotli ? COMPRESSION_BROTLI : COMPRESSION_ZLIB
+        var capacity = max(4096, input.count * 8)
+        while capacity <= 64 << 20 {
+            var output = Data(count: capacity)
+            let written = output.withUnsafeMutableBytes { out in
+                input.withUnsafeBytes { src in
+                    compression_decode_buffer(out.bindMemory(to: UInt8.self).baseAddress!, capacity,
+                                              src.bindMemory(to: UInt8.self).baseAddress!, input.count, nil, algorithm)
+                }
+            }
+            if written == 0 { return nil }
+            if written < capacity { return output.prefix(written) }
+            capacity *= 4 // output may have been truncated; retry larger
+        }
+        return nil
+    }
+}
+
+/// Room activity delivered to the dock.
+public enum LiveRoomEvent: Equatable, Sendable {
+    case chat(uid: Int64, user: String, text: String, medal: String?)
+    case gift(user: String, name: String, count: Int, paid: Bool, totalCoin: Int)
+    case superChat(user: String, text: String, price: Int)
+    case guardBought(user: String, level: Int, name: String, count: Int)
+    case interaction(user: String, kind: InteractionKind)
+    case watched(Int)
+    case likes(Int)
+    case onlineRank(Int)
+    case liveStarted
+    case liveEnded
+    case roomChanged(title: String)
+
+    public enum InteractionKind: Int, Sendable {
+        case enter = 1, follow = 2, share = 3, specialFollow = 4, mutualFollow = 5
+    }
+}
+
+enum DanmakuParser {
+    static func events(from packet: DanmakuPacket) -> [LiveRoomEvent] {
+        guard packet.operation == DanmakuOperation.message.rawValue,
+              let object = try? JSONSerialization.jsonObject(with: packet.body) as? [String: Any] else { return [] }
+        return event(from: object).map { [$0] } ?? []
+    }
+
+    static func event(from object: [String: Any]) -> LiveRoomEvent? {
+        guard let rawCommand = object["cmd"] as? String else { return nil }
+        // Commands may carry suffixes such as "DANMU_MSG:4:0:2:2:2:0".
+        let command = rawCommand.split(separator: ":").first.map(String.init) ?? rawCommand
+        let data = object["data"] as? [String: Any] ?? [:]
+        switch command {
+        case "DANMU_MSG":
+            guard let info = object["info"] as? [Any], info.count > 2,
+                  let text = info[1] as? String, let user = info[2] as? [Any], user.count > 1 else { return nil }
+            var medal: String?
+            if info.count > 3, let m = info[3] as? [Any], m.count > 1, let name = m[1] as? String, !name.isEmpty {
+                medal = "\(name) \(int(m[0]))"
+            }
+            return .chat(uid: int64(user[0]), user: user[1] as? String ?? "", text: text, medal: medal)
+        case "SEND_GIFT", "SEND_GIFT_V2":
+            return .gift(user: data["uname"] as? String ?? "",
+                         name: data["giftName"] as? String ?? data["gift_name"] as? String ?? "",
+                         count: int(data["num"]),
+                         paid: (data["coin_type"] as? String) == "gold",
+                         totalCoin: int(data["total_coin"]))
+        case "SUPER_CHAT_MESSAGE":
+            let user = data["user_info"] as? [String: Any]
+            return .superChat(user: user?["uname"] as? String ?? "", text: data["message"] as? String ?? "",
+                              price: int(data["price"]))
+        case "GUARD_BUY":
+            return .guardBought(user: data["username"] as? String ?? "", level: int(data["guard_level"]),
+                                name: data["gift_name"] as? String ?? "", count: int(data["num"]))
+        case "INTERACT_WORD":
+            guard let kind = LiveRoomEvent.InteractionKind(rawValue: int(data["msg_type"])) else { return nil }
+            return .interaction(user: data["uname"] as? String ?? "", kind: kind)
+        case "INTERACT_WORD_V2":
+            guard let pb = (data["pb"] as? String).flatMap({ Data(base64Encoded: $0) }) else { return nil }
+            let fields = Protobuf.fields(pb)
+            guard let kind = LiveRoomEvent.InteractionKind(rawValue: Int(fields.varint(5) ?? 0)) else { return nil }
+            return .interaction(user: fields.string(2) ?? "", kind: kind)
+        case "WATCHED_CHANGE":
+            return .watched(int(data["num"]))
+        case "LIKE_INFO_V3_UPDATE":
+            return .likes(int(data["click_count"]))
+        case "ONLINE_RANK_COUNT":
+            return .onlineRank(int(data["count"]))
+        case "LIVE":
+            return .liveStarted
+        case "PREPARING":
+            return .liveEnded
+        case "ROOM_CHANGE":
+            return .roomChanged(title: data["title"] as? String ?? "")
+        default:
+            return nil
+        }
+    }
+
+    static func int(_ value: Any?) -> Int {
+        (value as? NSNumber)?.intValue ?? (value as? String).flatMap(Int.init) ?? 0
+    }
+
+    static func int64(_ value: Any?) -> Int64 {
+        (value as? NSNumber)?.int64Value ?? (value as? String).flatMap(Int64.init) ?? 0
+    }
+}
+
+/// Minimal protobuf reader for the few fields the V2 commands need.
+enum Protobuf {
+    struct Fields {
+        var varints: [Int: UInt64] = [:]
+        var bytes: [Int: Data] = [:]
+        func varint(_ field: Int) -> UInt64? { varints[field] }
+        func string(_ field: Int) -> String? { bytes[field].map { String(decoding: $0, as: UTF8.self) } }
+    }
+
+    static func fields(_ data: Data) -> Fields {
+        var result = Fields()
+        var index = data.startIndex
+        func readVarint() -> UInt64? {
+            var value: UInt64 = 0
+            var shift: UInt64 = 0
+            while index < data.endIndex, shift < 64 {
+                let byte = data[index]
+                index += 1
+                value |= UInt64(byte & 0x7f) << shift
+                if byte & 0x80 == 0 { return value }
+                shift += 7
+            }
+            return nil
+        }
+        while index < data.endIndex, let key = readVarint() {
+            let field = Int(key >> 3)
+            switch key & 7 {
+            case 0:
+                guard let value = readVarint() else { return result }
+                result.varints[field] = value
+            case 2:
+                guard let length = readVarint(), index + Int(length) <= data.endIndex else { return result }
+                result.bytes[field] = data.subdata(in: index..<(index + Int(length)))
+                index += Int(length)
+            case 1:
+                index += 8
+            case 5:
+                index += 4
+            default:
+                return result
+            }
+        }
+        return result
+    }
+}
+
+/// WBI request signing used by Bilibili web APIs such as getDanmuInfo.
+struct WBISigner: Sendable {
+    static let mixinTable = [46, 47, 18, 2, 53, 8, 23, 32, 15, 50, 10, 31, 58, 3, 45, 35, 27, 43, 5, 49, 33, 9, 42,
+                             19, 29, 28, 14, 39, 12, 38, 41, 13, 37, 48, 7, 16, 24, 55, 40, 61, 26, 17, 0, 1, 60, 51,
+                             30, 4, 22, 25, 54, 21, 56, 59, 6, 63, 57, 62, 11, 36, 20, 34, 44, 52]
+    let mixinKey: String
+
+    /// `imgURL`/`subURL` come from nav's `wbi_img`; the key is the file stem.
+    init?(imgURL: String, subURL: String) {
+        func stem(_ url: String) -> String { (url.split(separator: "/").last.map(String.init) ?? "").components(separatedBy: ".").first ?? "" }
+        let raw = Array(stem(imgURL) + stem(subURL))
+        guard raw.count >= 64 else { return nil }
+        mixinKey = String(Self.mixinTable.map { raw[$0] }.prefix(32))
+    }
+
+    func sign(_ params: [String: String], timestamp: Int = Int(Date().timeIntervalSince1970)) -> [URLQueryItem] {
+        var all = params
+        all["wts"] = String(timestamp)
+        let unreserved = CharacterSet(charactersIn: "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_.~")
+        let query = all.keys.sorted().map { key -> String in
+            let value = all[key]!.filter { !"!'()*".contains($0) }
+            return "\(key.addingPercentEncoding(withAllowedCharacters: unreserved)!)=\(value.addingPercentEncoding(withAllowedCharacters: unreserved)!)"
+        }.joined(separator: "&")
+        let digest = Insecure.MD5.hash(data: Data((query + mixinKey).utf8)).map { String(format: "%02x", $0) }.joined()
+        return all.keys.sorted().map { URLQueryItem(name: $0, value: all[$0]!.filter { !"!'()*".contains($0) }) }
+            + [URLQueryItem(name: "w_rid", value: digest)]
+    }
+}
