@@ -0,0 +1,24 @@
+import XCTest
+@testable import LiveHimeCore
+
+/// Connects to a real public room anonymously. Skipped unless
+/// LIVEHIME_LIVE_ROOM is set (network access, read-only).
+@MainActor
+final class DanmakuLiveIntegrationTests: XCTestCase {
+    func testReceivesRoomEvents() async throws {
+        guard let room = ProcessInfo.processInfo.environment["LIVEHIME_LIVE_ROOM"].flatMap(Int64.init) else {
+            throw XCTSkip("set LIVEHIME_LIVE_ROOM to a live room id")
+        }
+        let client = DanmakuClient()
+        var statuses: [DanmakuClient.Status] = []
+        var events: [LiveRoomEvent] = []
+        client.onStatus = { statuses.append($0) }
+        client.onEvent = { events.append($0) }
+        client.start(roomID: room, uid: 0, cookieHeader: "")
+        for _ in 0..<60 where events.count < 10 { try await Task.sleep(for: .milliseconds(250)) }
+        client.stop()
+        print("statuses:", statuses.map(\.rawValue), "events:", events.count, "sample:", events.prefix(3))
+        XCTAssertTrue(statuses.contains(.connected))
+        XCTAssertFalse(events.isEmpty)
+    }
+}
