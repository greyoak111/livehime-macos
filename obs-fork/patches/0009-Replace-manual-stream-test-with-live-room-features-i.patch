@@ -0,0 +1,95 @@
+import Foundation
+
+public struct DanmakuServer: Equatable, Sendable {
+    public let host: String
+    public let port: Int
+}
+
+public struct DanmakuConnectInfo: Equatable, Sendable {
+    public let token: String
+    public let servers: [DanmakuServer]
+    public let buvid: String
+}
+
+/// Room operations beyond start/stop: danmaku server discovery, sending
+/// danmaku and editing the title. Errors use BilibiliLiveError like the
+/// rest of the client.
+extension BilibiliLiveClient {
+    /// buvid3 identifies the browser to the danmaku server; QR logins do not
+    /// set it, so fall back to the public fingerprint endpoint.
+    func buvid3(cookieHeader: String) async throws -> String {
+        if let existing = cookieValue("buvid3", in: cookieHeader) { return existing }
+        let root = try await requestJSON(url: URL(string: "https://api.bilibili.com/x/frontend/finger/spi")!,
+                                         cookieHeader: "", body: nil)
+        guard let value = (root["data"] as? [String: Any])?["b_3"] as? String, !value.isEmpty else {
+            throw BilibiliLiveError.invalidResponse
+        }
+        return value
+    }
+
+    /// nav carries the WBI keys even when it answers -101 (not logged in),
+    /// so read them without the usual API-code check.
+    func wbiSigner(cookieHeader: String) async throws -> WBISigner {
+        var request = URLRequest(url: URL(string: "https://api.bilibili.com/x/web-interface/nav")!)
+        request.timeoutInterval = 12
+        request.setValue(cookieHeader, forHTTPHeaderField: "Cookie")
+        request.setValue(BilibiliWeb.userAgent, forHTTPHeaderField: "User-Agent")
+        request.setValue("https://live.bilibili.com/", forHTTPHeaderField: "Referer")
+        let data: Data
+        do { (data, _) = try await session.data(for: request) }
+        catch let error as URLError { throw BilibiliLiveError.network(code: error.errorCode) }
+        let root = (try? JSONSerialization.jsonObject(with: data) as? [String: Any]) ?? [:]
+        guard let wbi = (root["data"] as? [String: Any])?["wbi_img"] as? [String: Any],
+              let signer = WBISigner(imgURL: wbi["img_url"] as? String ?? "", subURL: wbi["sub_url"] as? String ?? "") else {
+            throw BilibiliLiveError.invalidResponse
+        }
+        return signer
+    }
+
+    public func danmakuConnectInfo(roomID: Int64, cookieHeader: String) async throws -> DanmakuConnectInfo {
+        let buvid = try await buvid3(cookieHeader: cookieHeader)
+        let cookies = cookieValue("buvid3", in: cookieHeader) == nil ? cookieHeader + "; buvid3=" + buvid : cookieHeader
+        let signer = try await wbiSigner(cookieHeader: cookies)
+        let query = signer.sign(["id": String(roomID), "type": "0", "web_location": "444.8"])
+        let root = try await requestJSON(
+            url: withQuery(URL(string: "https://api.live.bilibili.com/xlive/web-room/v1/index/getDanmuInfo")!, query),
+            cookieHeader: cookies, body: nil)
+        guard let data = root["data"] as? [String: Any], let token = data["token"] as? String,
+              let hosts = data["host_list"] as? [[String: Any]] else { throw BilibiliLiveError.invalidResponse }
+        let servers = hosts.compactMap { host -> DanmakuServer? in
+            guard let name = host["host"] as? String else { return nil }
+            return DanmakuServer(host: name, port: (host["wss_port"] as? NSNumber)?.intValue ?? 443)
+        }
+        guard !servers.isEmpty else { throw BilibiliLiveError.invalidResponse }
+        return DanmakuConnectInfo(token: token, servers: servers, buvid: buvid)
+    }
+
+    public func sendDanmaku(roomID: Int64, text: String, cookieHeader: String) async throws {
+        let csrf = try csrf(from: cookieHeader)
+        let body = form([
+            ("bubble", "0"), ("msg", text), ("color", "16777215"), ("mode", "1"), ("room_type", "0"),
+            ("jumpfrom", "0"), ("reply_mid", "0"), ("reply_attr", "0"), ("replay_dmid", ""),
+            ("statistics", #"{"appId":100,"platform":5}"#), ("fontsize", "25"),
+            ("rnd", String(Int(Date().timeIntervalSince1970))), ("roomid", String(roomID)),
+            ("csrf", csrf), ("csrf_token", csrf)
+        ])
+        _ = try await requestJSON(url: URL(string: "https://api.live.bilibili.com/msg/send")!,
+                                  cookieHeader: cookieHeader, body: body)
+    }
+
+    public func updateTitle(roomID: Int64, title: String, cookieHeader: String) async throws {
+        let csrf = try csrf(from: cookieHeader)
+        _ = try await requestJSON(url: URL(string: "https://api.live.bilibili.com/room/v1/Room/update")!,
+                                  cookieHeader: cookieHeader,
+                                  body: form([("room_id", String(roomID)), ("title", title),
+                                              ("csrf", csrf), ("csrf_token", csrf)]))
+    }
+
+    private func cookieValue(_ name: String, in header: String) -> String? {
+        for part in header.split(separator: ";") {
+            let pair = part.split(separator: "=", maxSplits: 1).map { $0.trimmingCharacters(in: .whitespaces) }
+            if pair.count == 2, pair[0] == name, !pair[1].isEmpty { return pair[1] }
+        }
+        return nil
+    }
+}
