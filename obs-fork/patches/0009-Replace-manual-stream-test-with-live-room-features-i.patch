+import XCTest
+@testable import LiveHimeCore
+
+/// Fixtures were produced independently with Node's zlib/brotli and a
+/// JavaScript WBI implementation.
+final class DanmakuProtocolTests: XCTestCase {
+    private let brotliFrame = "AAAA2QAQAAMAAAAFAAAAARvpAAAsCuzGYiNDhWv1zRqiHb+gwQN/riXJ40XRtzUNR5GUdzS6BvL8dEIUYlFINl2yKaZLwu3NotPVt0W+nMhW0JTZTocDxN1u9DfZ7iYVhWGsiaWBZTekQcqqqPeGBbskSbOEkrAuPcsX036RWFFWzEUgHOHxdEDtv6mqnAbvy08dqsDDv/n9PMRpVJ6L3+h746dmPhyBJL2S6WbF6B67m6hr0YWjr6K4FAHkfQ67dy++qCs4Hbt8g+k8nwJxEDB1GBZyCzXndg=="
+    private let zlibFrame = "AAAA3QAQAAIAAAAFAAAAAXicY2BgyGQQYAABVgYGBsZqpeTcFCUrJRdHP9/QeN9gdysTKwMrIzA0UNJRysxLy1eyio42iNVRerJ3wdOle5V0ok2MdJReLG96sme6o5KOQaxOtJGhjtLzTZ1Pdsx93tkDEoqtBRreiM2iYFc/l3h3T7cQJR2llMSSRCWraqXSvMTcVCUrqJlOSjpK6ZlpJX4Qwacb+p/ub366v1lJRymvNFfJylhHKTk/My++pLIAJF+cmVOWWqSko1SSX5KYEw+SUrIyqK0FAPO2Soc="
+
+    private let expected: [LiveRoomEvent] = [
+        .chat(uid: 42, user: "观众A", text: "你好", medal: "粉丝牌 21"),
+        .gift(user: "观众B", name: "小心心", count: 3, paid: false, totalCoin: 0)
+    ]
+
+    private func events(_ base64: String) -> [LiveRoomEvent] {
+        DanmakuPacket.decode(Data(base64Encoded: base64)!).flatMap(DanmakuParser.events)
+    }
+
+    func testBrotliContainerExpandsToCommands() {
+        XCTAssertEqual(events(brotliFrame), expected)
+    }
+
+    func testZlibContainerExpandsToCommands() {
+        XCTAssertEqual(events(zlibFrame), expected)
+    }
+
+    func testEncodeDecodeRoundTrip() {
+        let body = Data(#"{"roomid":1}"#.utf8)
+        let frame = DanmakuPacket.encode(.auth, body: body)
+        XCTAssertEqual(frame.count, 16 + body.count)
+        XCTAssertEqual(DanmakuPacket.decode(frame), [DanmakuPacket(version: 1, operation: 7, body: body)])
+    }
+
+    func testTruncatedFrameIsIgnored() {
+        let frame = DanmakuPacket.encode(.message, body: Data("{}".utf8))
+        XCTAssertEqual(DanmakuPacket.decode(frame.prefix(10)), [])
+    }
+
+    func testInteractWordV2ProtobufIsDecoded() {
+        // Captured from a public room: uname "T***", msg_type 1 (enter).
+        let object: [String: Any] = ["cmd": "INTERACT_WORD_V2", "data": ["pb": "EgRUKioqIgEBKAEwtqOsCjjZ48/VBkD89KL3jDRK"]]
+        XCTAssertEqual(DanmakuParser.event(from: object), .interaction(user: "T***", kind: .enter))
+    }
+
+    func testStatsCommands() {
+        XCTAssertEqual(DanmakuParser.event(from: ["cmd": "WATCHED_CHANGE", "data": ["num": 15408]]), .watched(15408))
+        XCTAssertEqual(DanmakuParser.event(from: ["cmd": "LIKE_INFO_V3_UPDATE", "data": ["click_count": "320903"]]), .likes(320903))
+        XCTAssertEqual(DanmakuParser.event(from: ["cmd": "ONLINE_RANK_COUNT", "data": ["count": "2547"]]), .onlineRank(2547))
+        XCTAssertEqual(DanmakuParser.event(from: ["cmd": "PREPARING"]), .liveEnded)
+    }
+
+    func testSuperChatAndGuard() {
+        XCTAssertEqual(DanmakuParser.event(from: ["cmd": "SUPER_CHAT_MESSAGE",
+                                                  "data": ["message": "加油", "price": 30, "user_info": ["uname": "C"]]]),
+                       .superChat(user: "C", text: "加油", price: 30))
+        XCTAssertEqual(DanmakuParser.event(from: ["cmd": "GUARD_BUY",
+                                                  "data": ["username": "D", "guard_level": 3, "gift_name": "舰长", "num": 1]]),
+                       .guardBought(user: "D", level: 3, name: "舰长", count: 1))
+    }
+
+    func testWBISignatureMatchesReference() throws {
+        let signer = try XCTUnwrap(WBISigner(imgURL: "https://i0.hdslb.com/bfs/wbi/7cd084941338484aae1ad9425b84077c.png",
+                                             subURL: "https://i0.hdslb.com/bfs/wbi/4932caff0ff746eab6f01bf08b70ac45.png"))
+        XCTAssertEqual(signer.mixinKey, "ea1db124af3c7062474693fa704f4ff8")
+        let items = signer.sign(["id": "1001", "type": "0", "web_location": "444.8"], timestamp: 1_700_000_000)
+        XCTAssertEqual(items.last, URLQueryItem(name: "w_rid", value: "6a7b397a3b98a73cebbca7b826767240"))
+    }
+}
