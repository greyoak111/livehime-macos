diff --git a/plugins/livehime/src/automation.cpp b/plugins/livehime/src/automation.cpp
new file mode 100644
index 000000000..94a7841f0
--- /dev/null
+++ b/plugins/livehime/src/automation.cpp
@@ -0,0 +1,90 @@
+#include "automation.hpp"
+#include "livehime-dock.hpp"
+
+#include <obs-module.h>
+#include <obs-websocket-api.h>
+
+#include <QMetaEnum>
+#include <QMetaObject>
+#include <QPointer>
+
+namespace {
+obs_websocket_vendor vendor = nullptr;
+QPointer<LiveHimeDock> target;
+
+/* Vendor requests arrive on the websocket thread; run them on the UI thread. */
+template<typename Fn> bool onUiThread(Fn &&fn)
+{
+	LiveHimeDock *dock = target.data();
+	if (!dock)
+		return false;
+	QMetaObject::invokeMethod(dock, std::forward<Fn>(fn), Qt::BlockingQueuedConnection);
+	return true;
+}
+
+void writeState(obs_data_t *response, LiveHimeDock *dock)
+{
+	StreamController *controller = dock->controller();
+	const char *name = QMetaEnum::fromType<StreamController::State>().valueToKey(
+		static_cast<int>(controller->state()));
+	obs_data_set_string(response, "state", name ? name : "Unknown");
+	obs_data_set_bool(response, "ownsSession", controller->ownsSession());
+	obs_data_set_string(response, "lastError", controller->lastError().toUtf8().constData());
+	obs_data_set_int(response, "totalBytes", static_cast<long long>(controller->totalBytes()));
+}
+
+void getStreamState(obs_data_t *, obs_data_t *response, void *)
+{
+	if (!onUiThread([response] { writeState(response, target.data()); }))
+		obs_data_set_string(response, "error", "dock unavailable");
+}
+
+void startManualStream(obs_data_t *request, obs_data_t *response, void *)
+{
+	const QString server = QString::fromUtf8(obs_data_get_string(request, "server"));
+	const QString key = QString::fromUtf8(obs_data_get_string(request, "key"));
+	const bool ran = onUiThread([&] {
+		QString error;
+		const bool ok = target->startManual(server, key, &error);
+		obs_data_set_bool(response, "accepted", ok);
+		if (!ok)
+			obs_data_set_string(response, "error", error.toUtf8().constData());
+		writeState(response, target.data());
+	});
+	if (!ran)
+		obs_data_set_string(response, "error", "dock unavailable");
+}
+
+void stopStream(obs_data_t *, obs_data_t *response, void *)
+{
+	if (!onUiThread([response] {
+		    target->stopStream();
+		    writeState(response, target.data());
+	    }))
+		obs_data_set_string(response, "error", "dock unavailable");
+}
+} // namespace
+
+void RegisterAutomation(LiveHimeDock *dock)
+{
+	target = dock;
+	vendor = obs_websocket_register_vendor("livehime");
+	if (!vendor) {
+		blog(LOG_INFO, "[livehime] obs-websocket not available; automation disabled");
+		return;
+	}
+	obs_websocket_vendor_register_request(vendor, "GetStreamState", getStreamState, nullptr);
+	obs_websocket_vendor_register_request(vendor, "StartManualStream", startManualStream, nullptr);
+	obs_websocket_vendor_register_request(vendor, "StopStream", stopStream, nullptr);
+}
+
+void UnregisterAutomation()
+{
+	if (vendor) {
+		obs_websocket_vendor_unregister_request(vendor, "GetStreamState");
+		obs_websocket_vendor_unregister_request(vendor, "StartManualStream");
+		obs_websocket_vendor_unregister_request(vendor, "StopStream");
+		vendor = nullptr;
+	}
+	target.clear();
+}
