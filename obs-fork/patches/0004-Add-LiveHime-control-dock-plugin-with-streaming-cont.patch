@@ -0,0 +1,9 @@
+#pragma once
+
+class LiveHimeDock;
+
+/* Registers the "livehime" obs-websocket vendor so tests and future local
+ * tools can drive the same code paths as the dock. obs-websocket keeps its
+ * own authentication; nothing here opens a new listener. */
+void RegisterAutomation(LiveHimeDock *dock);
+void UnregisterAutomation();
diff --git a/plugins/livehime/src/livehime-dock.cpp b/plugins/livehime/src/livehime-dock.cpp
new file mode 100644
index 000000000..87f34ea01
--- /dev/null
+++ b/plugins/livehime/src/livehime-dock.cpp
@@ -0,0 +1,172 @@
+#include "livehime-dock.hpp"
+
+#include <obs-module.h>
+
+#include <QFormLayout>
+#include <QGroupBox>
+#include <QHBoxLayout>
+#include <QLabel>
+#include <QLineEdit>
+#include <QPushButton>
+#include <QVBoxLayout>
+
+namespace {
+QString text(const char *key)
+{
+	return QString::fromUtf8(obs_module_text(key));
+}
+
+struct ChipStyle {
+	const char *label;
+	const char *color;
+};
+
+ChipStyle chipStyle(StreamController::State state)
+{
+	using State = StreamController::State;
+	switch (state) {
+	case State::Starting:
+		return {"LiveHime.State.Starting", "#7b80d8"};
+	case State::Live:
+		return {"LiveHime.State.Live", "#fb4d5a"};
+	case State::Reconnecting:
+		return {"LiveHime.State.Reconnecting", "#e0a040"};
+	case State::Stopping:
+		return {"LiveHime.State.Stopping", "#7b80d8"};
+	case State::Failed:
+		return {"LiveHime.State.Failed", "#b36269"};
+	case State::Idle:
+	default:
+		return {"LiveHime.State.Idle", "#5c616b"};
+	}
+}
+} // namespace
+
+LiveHimeDock::LiveHimeDock(QWidget *parent) : QWidget(parent), controller_(new StreamController(this))
+{
+	setObjectName(QStringLiteral("LiveHimeDock"));
+
+	statusChip_ = new QLabel(this);
+	statusChip_->setAlignment(Qt::AlignCenter);
+	statusDetail_ = new QLabel(this);
+	statusDetail_->setWordWrap(true);
+	statusDetail_->setTextInteractionFlags(Qt::TextSelectableByMouse);
+	stats_ = new QLabel(this);
+	stats_->setStyleSheet(QStringLiteral("font-family: Menlo, monospace; color: #9aa0ab;"));
+
+	auto *statusRow = new QHBoxLayout;
+	statusRow->addWidget(statusChip_);
+	statusRow->addWidget(stats_, 1);
+
+	server_ = new QLineEdit(this);
+	server_->setPlaceholderText(QStringLiteral("rtmp://"));
+	key_ = new QLineEdit(this);
+	key_->setEchoMode(QLineEdit::Password);
+	start_ = new QPushButton(text("LiveHime.Stream.Start"), this);
+	stop_ = new QPushButton(text("LiveHime.Stream.Stop"), this);
+
+	auto *form = new QFormLayout;
+	form->addRow(text("LiveHime.Stream.Server"), server_);
+	form->addRow(text("LiveHime.Stream.Key"), key_);
+	auto *buttons = new QHBoxLayout;
+	buttons->addWidget(start_);
+	buttons->addWidget(stop_);
+
+	auto *manual = new QGroupBox(text("LiveHime.Stream.ManualGroup"), this);
+	auto *manualLayout = new QVBoxLayout(manual);
+	manualLayout->addLayout(form);
+	manualLayout->addLayout(buttons);
+	auto *hint = new QLabel(text("LiveHime.Stream.ManualHint"), manual);
+	hint->setWordWrap(true);
+	hint->setStyleSheet(QStringLiteral("color: #9aa0ab;"));
+	manualLayout->addWidget(hint);
+
+	auto *layout = new QVBoxLayout(this);
+	layout->addLayout(statusRow);
+	layout->addWidget(statusDetail_);
+	layout->addWidget(manual);
+	layout->addStretch(1);
+
+	connect(start_, &QPushButton::clicked, this, &LiveHimeDock::onStartClicked);
+	connect(stop_, &QPushButton::clicked, this, &LiveHimeDock::onStopClicked);
+	connect(controller_, &StreamController::stateChanged, this, &LiveHimeDock::onStateChanged);
+	statsTimer_.setInterval(1000);
+	connect(&statsTimer_, &QTimer::timeout, this, &LiveHimeDock::updateStats);
+
+	onStateChanged(controller_->state());
+}
+
+void LiveHimeDock::onStartClicked()
+{
+	QString error;
+	if (!startManual(server_->text(), key_->text(), &error))
+		statusDetail_->setText(error);
+}
+
+bool LiveHimeDock::startManual(const QString &server, const QString &key, QString *error)
+{
+	const QString trimmed = server.trimmed();
+	server_->setText(trimmed);
+	key_->setText(key);
+	if (!trimmed.startsWith(QStringLiteral("rtmp://"), Qt::CaseInsensitive) &&
+	    !trimmed.startsWith(QStringLiteral("rtmps://"), Qt::CaseInsensitive)) {
+		*error = text("LiveHime.Error.BadServer");
+		return false;
+	}
+	if (!controller_->start(trimmed, key)) {
+		*error = controller_->lastError();
+		return false;
+	}
+	return true;
+}
+
+void LiveHimeDock::onStopClicked()
+{
+	controller_->stop();
+}
+
+void LiveHimeDock::onStateChanged(StreamController::State state)
+{
+	using State = StreamController::State;
+	const ChipStyle style = chipStyle(state);
+	statusChip_->setText(text(style.label));
+	statusChip_->setStyleSheet(
+		QStringLiteral("QLabel { background: %1; color: white; border-radius: 9px; padding: 2px 10px; }")
+			.arg(QString::fromLatin1(style.color)));
+
+	const bool busy = state == State::Starting || state == State::Live || state == State::Reconnecting ||
+			  state == State::Stopping;
+	start_->setEnabled(!busy);
+	stop_->setEnabled(state == State::Live || state == State::Reconnecting || state == State::Starting);
+	server_->setEnabled(!busy);
+	key_->setEnabled(!busy);
+
+	statusDetail_->setText(state == State::Failed ? controller_->lastError() : QString());
+
+	if (state == State::Live && !statsTimer_.isActive()) {
+		liveClock_.start();
+		lastBytes_ = controller_->totalBytes();
+		lastStatsMs_ = 0;
+		statsTimer_.start();
+		updateStats();
+	} else if (!busy) {
+		statsTimer_.stop();
+		stats_->clear();
+	}
+}
+
+void LiveHimeDock::updateStats()
+{
+	const qint64 ms = liveClock_.elapsed();
+	const uint64_t bytes = controller_->totalBytes();
+	const qint64 dt = ms - lastStatsMs_;
+	const double kbps = dt > 0 && bytes >= lastBytes_ ? double(bytes - lastBytes_) * 8.0 / double(dt) : 0.0;
+	lastBytes_ = bytes;
+	lastStatsMs_ = ms;
+	const qint64 s = ms / 1000;
+	stats_->setText(QStringLiteral("%1:%2:%3  %4 kb/s")
+				.arg(s / 3600, 2, 10, QLatin1Char('0'))
+				.arg((s / 60) % 60, 2, 10, QLatin1Char('0'))
+				.arg(s % 60, 2, 10, QLatin1Char('0'))
+				.arg(qRound(kbps)));
+}
