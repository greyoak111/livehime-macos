@@ -0,0 +1,14 @@
+# LiveHime streaming end-to-end test
+
+Drives the LiveHime dock's streaming path through the `livehime`
+obs-websocket vendor and checks state, byte flow, error reporting and that
+the user's own stream service is restored.
+
+1. In LiveHime's own config (`~/Library/Application Support/LiveHime/obs-studio/
+   plugin_config/obs-websocket/config.json`) enable the server on port 4466
+   with a password, and set the profile's `service.json` to
+   `rtmp_custom` / `rtmp://user-own-server.invalid/app`.
+2. Start a local RTMP sink:
+   `ffmpeg -listen 1 -i rtmp://127.0.0.1:19350/live/test-key-123 -c copy -f flv -y /tmp/received.flv`
+3. Launch `LiveHime.app`, then run `node e2e-stream.mjs <websocket password>`
+   (Node 22+ for the built-in WebSocket).
diff --git a/build-aux/livehime/tests/e2e-stream.mjs b/build-aux/livehime/tests/e2e-stream.mjs
new file mode 100644
index 000000000..2ef119c31
--- /dev/null
+++ b/build-aux/livehime/tests/e2e-stream.mjs
@@ -0,0 +1,92 @@
+// End-to-end check of the LiveHime dock's streaming path through the
+// "livehime" obs-websocket vendor. Usage: node e2e-stream.mjs <password>
+import { createHash } from 'node:crypto';
+
+const password = process.argv[2];
+const sha = (s) => createHash('sha256').update(s).digest('base64');
+const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
+
+const ws = new WebSocket('ws://127.0.0.1:4466');
+let nextId = 1;
+const pending = new Map();
+const results = [];
+const check = (name, ok, info = '') => {
+  results.push({ name, ok });
+  console.log(`${ok ? 'PASS' : 'FAIL'}  ${name}${info ? '  — ' + info : ''}`);
+};
+
+ws.onmessage = (ev) => {
+  const msg = JSON.parse(ev.data);
+  if (msg.op === 0) {
+    const { challenge, salt } = msg.d.authentication;
+    ws.send(JSON.stringify({ op: 1, d: { rpcVersion: 1, authentication: sha(sha(password + salt) + challenge), eventSubscriptions: 0 } }));
+  } else if (msg.op === 2) {
+    run().catch((e) => { console.error(e); process.exit(2); });
+  } else if (msg.op === 7) {
+    pending.get(msg.d.requestId)?.(msg.d);
+  }
+};
+ws.onerror = (e) => { console.error('websocket error', e.message); process.exit(2); };
+
+function request(requestType, requestData = {}) {
+  const requestId = String(nextId++);
+  return new Promise((resolve) => {
+    pending.set(requestId, resolve);
+    ws.send(JSON.stringify({ op: 6, d: { requestType, requestId, requestData } }));
+  });
+}
+async function vendor(requestType, requestData = {}) {
+  const r = await request('CallVendorRequest', { vendorName: 'livehime', requestType, requestData });
+  if (!r.requestStatus.result) throw new Error(`${requestType}: ${r.requestStatus.comment}`);
+  return r.responseData.responseData;
+}
+async function waitState(want, timeoutMs) {
+  const end = Date.now() + timeoutMs;
+  let s;
+  while (Date.now() < end) {
+    s = await vendor('GetStreamState');
+    if (want.includes(s.state)) return s;
+    await sleep(250);
+  }
+  return s;
+}
+const service = async () => (await request('GetStreamServiceSettings')).responseData.streamServiceSettings;
+
+async function run() {
+  // obs-websocket answers 207 (NotReady) until OBS finishes loading.
+  for (let i = 0; i < 40 && !(await request('GetStreamServiceSettings')).requestStatus.result; i++) await sleep(500);
+  const userServer = 'rtmp://user-own-server.invalid/app';
+  check('user service loaded before test', (await service()).server === userServer);
+  check('initial state Idle', (await vendor('GetStreamState')).state === 'Idle');
+
+  const bad = await vendor('StartManualStream', { server: 'http://example.com/live', key: 'x' });
+  check('rejects non-RTMP server', bad.accepted === false && bad.state === 'Idle', bad.error);
+
+  const started = await vendor('StartManualStream', { server: 'rtmp://127.0.0.1:19350/live', key: 'test-key-123' });
+  check('start accepted', started.accepted === true && started.ownsSession === true, started.state);
+  const live = await waitState(['Live', 'Failed'], 20000);
+  check('reaches Live', live.state === 'Live', live.lastError);
+  const during = await service();
+  check('temporary service in use while live', during.server === 'rtmp://127.0.0.1:19350/live');
+  const again = await vendor('StartManualStream', { server: 'rtmp://127.0.0.1:19350/live', key: 'k' });
+  check('second start rejected while live', again.accepted === false, again.error);
+  await sleep(4000);
+  const bytes = (await vendor('GetStreamState')).totalBytes;
+  check('bytes flowing', bytes > 50000, `${bytes} bytes`);
+
+  await vendor('StopStream');
+  const stopped = await waitState(['Idle', 'Failed'], 15000);
+  check('stops cleanly to Idle', stopped.state === 'Idle', stopped.lastError);
+  check('user service restored after stop', (await service()).server === userServer);
+
+  const refused = await vendor('StartManualStream', { server: 'rtmp://127.0.0.1:19351/live', key: 'nobody-listening' });
+  check('start accepted (unreachable server)', refused.accepted === true);
+  const failed = await waitState(['Failed', 'Idle'], 30000);
+  check('unreachable server ends in Failed with reason', failed.state === 'Failed' && failed.lastError.length > 0, failed.lastError.replace(/\n/g, ' | '));
+  check('user service restored after failure', (await service()).server === userServer);
+
+  const passed = results.filter((r) => r.ok).length;
+  console.log(`\n${passed}/${results.length} checks passed`);
+  ws.close();
+  process.exit(passed === results.length ? 0 : 1);
+}
