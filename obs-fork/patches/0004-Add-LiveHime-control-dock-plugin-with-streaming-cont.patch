index 000000000..2dea26a5c
--- /dev/null
+++ b/plugins/livehime/src/plugin-main.cpp
@@ -0,0 +1,51 @@
+#include "automation.hpp"
+#include "livehime-dock.hpp"
+
+#include <obs-frontend-api.h>
+#include <obs-module.h>
+
+#include <QMainWindow>
+#include <QPointer>
+
+OBS_DECLARE_MODULE()
+OBS_MODULE_USE_DEFAULT_LOCALE("livehime", "en-US")
+
+MODULE_EXPORT const char *obs_module_description(void)
+{
+	return "LiveHime: Bilibili live room control for OBS";
+}
+
+namespace {
+QPointer<LiveHimeDock> dock;
+
+void onFrontendEvent(enum obs_frontend_event event, void *)
+{
+	if (dock)
+		dock->controller()->handleFrontendEvent(event);
+}
+} // namespace
+
+bool obs_module_load(void)
+{
+	auto *mainWindow = static_cast<QMainWindow *>(obs_frontend_get_main_window());
+	dock = new LiveHimeDock(mainWindow);
+	if (!obs_frontend_add_dock_by_id("livehime-control", obs_module_text("LiveHime.DockTitle"), dock)) {
+		blog(LOG_ERROR, "[livehime] failed to add control dock");
+		delete dock;
+		return false;
+	}
+	obs_frontend_add_event_callback(onFrontendEvent, nullptr);
+	blog(LOG_INFO, "[livehime] control dock loaded");
+	return true;
+}
+
+void obs_module_post_load(void)
+{
+	RegisterAutomation(dock);
+}
+
+void obs_module_unload(void)
+{
+	UnregisterAutomation();
+	obs_frontend_remove_event_callback(onFrontendEvent, nullptr);
+}
diff --git a/plugins/livehime/src/stream-controller.cpp b/plugins/livehime/src/stream-controller.cpp
new file mode 100644
index 000000000..1690422b7
--- /dev/null
+++ b/plugins/livehime/src/stream-controller.cpp
@@ -0,0 +1,242 @@
+#include "stream-controller.hpp"
+
+#include <obs-frontend-api.h>
+#include <obs-module.h>
+
+#include <QMetaObject>
+
+namespace {
+const char *stopCodeText(int code)
+{
+	switch (code) {
+	case OBS_OUTPUT_BAD_PATH:
+		return "LiveHime.Error.BadPath";
+	case OBS_OUTPUT_CONNECT_FAILED:
+		return "LiveHime.Error.ConnectFailed";
+	case OBS_OUTPUT_INVALID_STREAM:
+		return "LiveHime.Error.InvalidStream";
+	case OBS_OUTPUT_DISCONNECTED:
+		return "LiveHime.Error.Disconnected";
+	case OBS_OUTPUT_UNSUPPORTED:
+		return "LiveHime.Error.Unsupported";
+	case OBS_OUTPUT_ENCODE_ERROR:
+		return "LiveHime.Error.Encode";
+	default:
+		return "LiveHime.Error.Generic";
+	}
+}
+
+constexpr qint64 kSetupTimeoutMs = 5000;    // STARTING must follow a local rtmp_custom setup quickly
+constexpr qint64 kConnectTimeoutMs = 45000; // longer than the RTMP connect timeout
+} // namespace
+
+StreamController::StreamController(QObject *parent) : QObject(parent)
+{
+	startWatchdog_.setInterval(500);
+	connect(&startWatchdog_, &QTimer::timeout, this, &StreamController::checkStartProgress);
+}
+
+StreamController::~StreamController()
+{
+	disconnectOutputSignals();
+	/* The frontend is shutting down; leave the user's service in place. */
+	if (previousService_) {
+		obs_frontend_set_streaming_service(previousService_);
+		obs_service_release(previousService_);
+		previousService_ = nullptr;
+	}
+}
+
+uint64_t StreamController::totalBytes() const
+{
+	return output_ ? obs_output_get_total_bytes(output_) : 0;
+}
+
+bool StreamController::start(const QString &server, const QString &key)
+{
+	if (obs_frontend_streaming_active() || state_ == State::Starting || state_ == State::Stopping) {
+		lastError_ = QString::fromUtf8(obs_module_text("LiveHime.Error.AlreadyStreaming"));
+		return false;
+	}
+
+	OBSDataAutoRelease settings = obs_data_create();
+	obs_data_set_string(settings, "server", server.trimmed().toUtf8().constData());
+	obs_data_set_string(settings, "key", key.trimmed().toUtf8().constData());
+	obs_data_set_bool(settings, "use_auth", false);
+	OBSServiceAutoRelease session = obs_service_create_private("rtmp_custom", "livehime_session", settings);
+	if (!session) {
+		lastError_ = QString::fromUtf8(obs_module_text("LiveHime.Error.Generic"));
+		setState(State::Failed);
+		return false;
+	}
+
+	if (!previousService_)
+		previousService_ = obs_service_get_ref(obs_frontend_get_streaming_service());
+	obs_frontend_set_streaming_service(session);
+
+	lastError_.clear();
+	sawStarting_ = false;
+	setState(State::Starting);
+	startClock_.start();
+	startWatchdog_.start();
+	obs_frontend_streaming_start();
+	return true;
+}
+
+void StreamController::stop()
+{
+	if (!obs_frontend_streaming_active())
+		return;
+	setState(State::Stopping);
+	obs_frontend_streaming_stop();
+}
+
+void StreamController::handleFrontendEvent(int event)
+{
+	switch (event) {
+	case OBS_FRONTEND_EVENT_STREAMING_STARTING:
+		sawStarting_ = true;
+		connectOutputSignals();
+		if (state_ != State::Starting) {
+			lastError_.clear();
+			setState(State::Starting);
+		}
+		break;
+	case OBS_FRONTEND_EVENT_STREAMING_STARTED:
+		connectOutputSignals();
+		setState(State::Live);
+		break;
+	case OBS_FRONTEND_EVENT_STREAMING_STOPPING:
+		setState(State::Stopping);
+		break;
+	case OBS_FRONTEND_EVENT_STREAMING_STOPPED:
+		/* The output's "stop" signal carries the code. Its queued handler
+		 * is posted before this event is delivered, so queue the fallback
+		 * behind it instead of briefly reporting Idle for a failed stream. */
+		QMetaObject::invokeMethod(
+			this,
+			[this] {
+				if (state_ != State::Idle && state_ != State::Failed)
+					onOutputStopped(OBS_OUTPUT_SUCCESS, QString());
+			},
+			Qt::QueuedConnection);
+		break;
+	case OBS_FRONTEND_EVENT_EXIT:
+		disconnectOutputSignals();
+		break;
+	default:
+		break;
+	}
+}
+
+void StreamController::checkStartProgress()
+{
+	if (state_ != State::Starting) {
+		startWatchdog_.stop();
+		return;
+	}
+	const qint64 elapsed = startClock_.elapsed();
+	if ((!sawStarting_ && elapsed > kSetupTimeoutMs) ||
+	    (elapsed > kConnectTimeoutMs && !obs_frontend_streaming_active()))
+		failStart();
+}
+
+void StreamController::failStart()
+{
+	startWatchdog_.stop();
+	disconnectOutputSignals();
+	restorePreviousService();
+	lastError_ = QString::fromUtf8(obs_module_text("LiveHime.Error.StartFailed"));
+	setState(State::Failed);
+}
+
+void StreamController::setState(State state)
+{
+	if (state != State::Starting)
+		startWatchdog_.stop();
+	if (state_ == state)
+		return;
+	state_ = state;
+	blog(LOG_INFO, "[livehime] stream state -> %d", static_cast<int>(state));
+	emit stateChanged(state);
+}
+
+void StreamController::connectOutputSignals()
+{
+	obs_output_t *output = obs_frontend_get_streaming_output();
+	if (output == output_) {
+		obs_output_release(output);
+		return;
+	}
+	disconnectOutputSignals();
+	output_ = output;
+	if (!output_)
+		return;
+	signal_handler_t *sh = obs_output_get_signal_handler(output_);
+	signal_handler_connect(sh, "reconnect", onReconnect, this);
+	signal_handler_connect(sh, "reconnect_success", onReconnectSuccess, this);
+	signal_handler_connect(sh, "stop", onStop, this);
+}
+
+void StreamController::disconnectOutputSignals()
+{
+	if (!output_)
+		return;
+	signal_handler_t *sh = obs_output_get_signal_handler(output_);
+	signal_handler_disconnect(sh, "reconnect", onReconnect, this);
+	signal_handler_disconnect(sh, "reconnect_success", onReconnectSuccess, this);
+	signal_handler_disconnect(sh, "stop", onStop, this);
+	obs_output_release(output_);
+	output_ = nullptr;
+}
+
+void StreamController::restorePreviousService()
+{
+	if (!previousService_)
+		return;
+	obs_frontend_set_streaming_service(previousService_);
+	obs_service_release(previousService_);
+	previousService_ = nullptr;
+}
+
+void StreamController::onOutputStopped(int code, const QString &detail)
+{
+	disconnectOutputSignals();
+	restorePreviousService();
+
+	if (code == OBS_OUTPUT_SUCCESS) {
+		lastError_.clear();
+		setState(State::Idle);
+		return;
+	}
+	lastError_ = QString::fromUtf8(obs_module_text(stopCodeText(code)));
+	if (!detail.isEmpty())
+		lastError_ += QStringLiteral("\n") + detail;
+	/* Failed is sticky until the next start so the reason stays visible. */
+	state_ = State::Idle;
+	setState(State::Failed);
+}
+
+/* Output signals arrive on libobs threads; hop to the UI thread. */
+void StreamController::onReconnect(void *data, calldata_t *)
+{
+	auto *self = static_cast<StreamController *>(data);
+	QMetaObject::invokeMethod(self, [self] { self->setState(State::Reconnecting); }, Qt::QueuedConnection);
+}
+
+void StreamController::onReconnectSuccess(void *data, calldata_t *)
+{
+	auto *self = static_cast<StreamController *>(data);
+	QMetaObject::invokeMethod(self, [self] { self->setState(State::Live); }, Qt::QueuedConnection);
+}
+
+void StreamController::onStop(void *data, calldata_t *cd)
+{
+	auto *self = static_cast<StreamController *>(data);
+	int code = static_cast<int>(calldata_int(cd, "code"));
+	obs_output_t *output = static_cast<obs_output_t *>(calldata_ptr(cd, "output"));
+	const char *error = output ? obs_output_get_last_error(output) : nullptr;
+	QString detail = error ? QString::fromUtf8(error) : QString();
+	QMetaObject::invokeMethod(self, [self, code, detail] { self->onOutputStopped(code, detail); },
+				  Qt::QueuedConnection);
+}
diff --git a/plugins/livehime/src/stream-controller.hpp b/plugins/livehime/src/stream-controller.hpp
new file mode 100644
index 000000000..ea45049d4
--- /dev/null
+++ b/plugins/livehime/src/stream-controller.hpp
@@ -0,0 +1,67 @@
+#pragma once
+
+#include <obs.hpp>
+
+#include <QElapsedTimer>
+#include <QObject>
+#include <QString>
+#include <QTimer>
+
+/* Owns the streaming side of a LiveHime session.
+ *
+ * The controller swaps in a temporary rtmp_custom service for a session and
+ * restores the user's own service once the output stops, so a per-session
+ * Bilibili stream key never ends up in the profile's service.json. It also
+ * mirrors OBS's streaming state, including streams started from OBS's own
+ * controls. All methods and signals run on the Qt UI thread. */
+class StreamController : public QObject {
+	Q_OBJECT
+
+public:
+	enum class State { Idle, Starting, Live, Reconnecting, Stopping, Failed };
+	Q_ENUM(State)
+
+	explicit StreamController(QObject *parent = nullptr);
+	~StreamController() override;
+
+	State state() const { return state_; }
+	/* True when the running stream uses a service this controller installed. */
+	bool ownsSession() const { return previousService_ != nullptr; }
+	/* Localized description of the last failure; empty unless state is Failed. */
+	QString lastError() const { return lastError_; }
+	uint64_t totalBytes() const;
+
+	/* Installs server/key as a temporary service and starts streaming.
+	 * Returns false (with lastError set) if a stream is already active. */
+	bool start(const QString &server, const QString &key);
+	void stop();
+
+	/* Called from the frontend event callback. */
+	void handleFrontendEvent(int event);
+
+signals:
+	void stateChanged(StreamController::State state);
+
+private:
+	void setState(State state);
+	void connectOutputSignals();
+	void disconnectOutputSignals();
+	void restorePreviousService();
+	void onOutputStopped(int code, const QString &detail);
+	void checkStartProgress();
+	void failStart();
+
+	static void onReconnect(void *data, calldata_t *cd);
+	static void onReconnectSuccess(void *data, calldata_t *cd);
+	static void onStop(void *data, calldata_t *cd);
+
+	State state_ = State::Idle;
+	QString lastError_;
+	obs_service_t *previousService_ = nullptr;
+	/* OBS reports some start failures only through its own error dialog,
+	 * without a STOPPED event; the watchdog keeps us from hanging in Starting. */
+	QTimer startWatchdog_;
+	QElapsedTimer startClock_;
+	bool sawStarting_ = false;
+	obs_output_t *output_ = nullptr; /* strong ref while signals are connected */
+};
