diff --git a/build-aux/livehime/tests/e2e-float-fullscreen.mjs b/build-aux/livehime/tests/e2e-float-fullscreen.mjs
new file mode 100644
index 000000000..cda42bfee
--- /dev/null
+++ b/build-aux/livehime/tests/e2e-float-fullscreen.mjs
@@ -0,0 +1,59 @@
+// Floating chat over other apps: with "on top" on, the chat must stay in front of another app's
+// full-screen window (and, as a control, must not show there with "on top" off), and stay above
+// another app's normal window while LiveHime is inactive.
+// Usage: swiftc -O fullscreen-probe.swift -o /tmp/fullscreen-probe
+//        node e2e-float-fullscreen.mjs <ws password> <LiveHime pid> /tmp/fullscreen-probe
+// The probe takes over the screen for a few seconds per case.
+import { createHash } from 'node:crypto';
+import { execFileSync } from 'node:child_process';
+const [password, pid, helper] = process.argv.slice(2);
+const sha = (s) => createHash('sha256').update(s).digest('base64');
+const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
+let ws, id = 1; const pend = new Map();
+for (let i = 0; i < 60; i++) {
+  try { ws = new WebSocket('ws://127.0.0.1:4466'); await new Promise((ok, bad) => { ws.onopen = ok; ws.onerror = bad; }); break; }
+  catch { await sleep(1000); }
+}
+await new Promise((ok) => {
+  ws.onmessage = (m) => {
+    const msg = JSON.parse(m.data);
+    if (msg.op === 0) {
+      const a = msg.d.authentication;
+      ws.send(JSON.stringify({ op: 1, d: { rpcVersion: 1, authentication: sha(sha(password + a.salt) + a.challenge) } }));
+    } else if (msg.op === 2) ok();
+    else if (msg.op === 7) { pend.get(msg.d.requestId)?.(msg.d); pend.delete(msg.d.requestId); }
+  };
+});
+const req = (t, d = {}) => new Promise((r) => { const k = String(id++); pend.set(k, r); ws.send(JSON.stringify({ op: 6, d: { requestType: t, requestId: k, requestData: d } })); });
+const vendor = async (t, d = {}) => (await req('CallVendorRequest', { vendorName: 'livehime', requestType: t, requestData: d })).responseData?.responseData;
+await sleep(3000);
+let fails = 0;
+for (const onTop of [true, false]) {
+  const st = await vendor('FloatingChat', { visible: true, on_top: onTop, x: 120, y: 160, w: 340, h: 460 });
+  await sleep(800);
+  const out = execFileSync(helper, [pid, '3'], { encoding: 'utf8' });
+  const full = /fullscreen=true/.test(out);
+  const seen = out.split('\n').some((l) => /onscreen .*bounds=120,160,340x460/.test(l));
+  const front = (who) => Number((out.match(new RegExp(`z=(\\d+) ${who}`)) || [])[1] ?? -1);
+  const inFront = seen && front('target') < front('helper');
+  const ok = full && (onTop ? inFront : !seen);
+  if (!ok) fails++;
+  console.log(`${ok ? 'PASS' : 'FAIL'}  on_top=${onTop}: helper fullscreen=${full}, floating chat on screen there=${seen}  (state ${JSON.stringify({ v: st?.visible, top: st?.on_top, x: st?.x, y: st?.y, w: st?.w, h: st?.h })})`);
+  console.log(out.trim().split('\n').map((l) => '      ' + l).join('\n'));
+  await sleep(1500);
+}
+{
+  // Normal desktop: another app's window covers the chat's area and is active.
+  await vendor('FloatingChat', { visible: true, on_top: true, x: 120, y: 160, w: 340, h: 460 });
+  await sleep(800);
+  const out = execFileSync(helper, [pid, '2', 'window'], { encoding: 'utf8' });
+  const front = (who) => Number((out.match(new RegExp(`z=(\\d+) ${who}`)) || [])[1] ?? -1);
+  const layer = Number((out.match(/z=\d+ target layer=(\d+) 340x460/) || [])[1] ?? -1);
+  const ok = front('target') >= 0 && front('target') < front('helper') && layer >= 3;
+  if (!ok) fails++;
+  console.log(`${ok ? 'PASS' : 'FAIL'}  on_top=true, LiveHime inactive: chat in front of the other app's window (layer ${layer})`);
+}
+await vendor('FloatingChat', { visible: false, on_top: true });
+ws.close();
+await sleep(1500);
+process.exit(fails ? 1 : 0);
diff --git a/build-aux/livehime/tests/fullscreen-probe.swift b/build-aux/livehime/tests/fullscreen-probe.swift
new file mode 100644
index 000000000..41822fe7c
--- /dev/null
+++ b/build-aux/livehime/tests/fullscreen-probe.swift
@@ -0,0 +1,44 @@
+// Test probe for e2e-float-fullscreen.mjs: goes full screen in its own Space (or, with "window",
+// covers the screen with a normal window), then prints the front-to-back order of its windows and
+// those of process <pid>. Usage: fullscreen-probe <pid> [seconds] [window]
+import AppKit
+let pid = Int32(CommandLine.arguments[1])!
+let hold = CommandLine.arguments.count > 2 ? Double(CommandLine.arguments[2])! : 3
+// "window": stay a normal window covering the target area instead of going full screen.
+let windowed = CommandLine.arguments.count > 3 && CommandLine.arguments[3] == "window"
+let app = NSApplication.shared
+app.setActivationPolicy(.regular)
+let win = NSWindow(contentRect: NSRect(x: 200, y: 200, width: 600, height: 400), styleMask: [.titled, .resizable],
+                   backing: .buffered, defer: false)
+win.collectionBehavior = [.fullScreenPrimary]
+win.backgroundColor = .darkGray
+win.title = "LiveHime fullscreen test"
+win.makeKeyAndOrderFront(nil)
+app.activate(ignoringOtherApps: true)
+if windowed {
+    win.setFrame(NSRect(x: 0, y: 0, width: 900, height: 900), display: true)
+} else {
+    DispatchQueue.main.asyncAfter(deadline: .now() + 0.8) { win.toggleFullScreen(nil) }
+}
+DispatchQueue.main.asyncAfter(deadline: .now() + 0.8 + hold) {
+    let list = CGWindowListCopyWindowInfo([.optionOnScreenOnly], kCGNullWindowID) as? [[String: Any]] ?? []
+    let mine = list.filter { ($0[kCGWindowOwnerPID as String] as? Int32) == pid }
+    // Front-to-back order: where our full-screen window and the target's windows sit.
+    let me = ProcessInfo.processInfo.processIdentifier
+    for (i, w) in list.enumerated() {
+        let owner = w[kCGWindowOwnerPID as String] as? Int32
+        if owner == me || owner == pid {
+            let b = w[kCGWindowBounds as String] as? [String: Any] ?? [:]
+            print("z=\(i) \(owner == me ? "helper" : "target") layer=\(w[kCGWindowLayer as String] ?? 0) \(b["Width"] ?? 0)x\(b["Height"] ?? 0)")
+        }
+    }
+    let full = win.styleMask.contains(.fullScreen)
+    print("fullscreen=\(full)")
+    for w in mine {
+        let b = w[kCGWindowBounds as String] as? [String: Any] ?? [:]
+        print("onscreen id=\(w[kCGWindowNumber as String] ?? 0) layer=\(w[kCGWindowLayer as String] ?? 0) bounds=\(b["X"] ?? 0),\(b["Y"] ?? 0),\(b["Width"] ?? 0)x\(b["Height"] ?? 0)")
+    }
+    if !windowed { win.toggleFullScreen(nil) }
+    DispatchQueue.main.asyncAfter(deadline: .now() + 1.5) { exit(0) }
+}
+app.run()
