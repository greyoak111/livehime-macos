+/* Qt drops Qt::Tool windows to the normal level whenever LiveHime stops
+ * being the active app, which lets other apps' windows cover the floating
+ * chat. Put windows marked floating back after Qt's own handling. */
+void keepFloatingWhenInactive()
+{
+	static bool installed = false;
+	if (installed)
+		return;
+	installed = true;
+	for (NSNotificationName name : {NSApplicationDidResignActiveNotification, NSApplicationDidBecomeActiveNotification}) {
+		[[NSNotificationCenter defaultCenter]
+			addObserverForName:name
+				    object:nil
+				     queue:[NSOperationQueue mainQueue]
+				usingBlock:^(NSNotification *) {
+					dispatch_async(dispatch_get_main_queue(), ^{
+						for (NSWindow *w in NSApp.windows) {
+							if ([objc_getAssociatedObject(w, kFloatingKey) boolValue] &&
+							    w.level != NSFloatingWindowLevel)
+								w.level = NSFloatingWindowLevel;
