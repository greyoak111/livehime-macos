+#pragma once
+
+#include <QDialog>
+
+class QTextBrowser;
+
+/* Shown once after an update, centered on the main window: what changed in
+ * the versions since the last one seen (from the bundled release notes). Tall
+ * text scrolls inside the dialog, at most 70% of the main window's height, so
+ * the buttons stay visible. It is not modal. With "addonUpdateNeeded", a line
+ * on top offers to open the Updates tab. */
+class WhatsNewDialog : public QDialog {
+	Q_OBJECT
+
+public:
+	WhatsNewDialog(QWidget *parent, const QString &version, const QString &markdown, bool addonUpdateNeeded);
+	/* For tests: whether the text needs scrolling; scroll it to the end. */
+	bool scrolls() const;
+	void scrollToEnd();
+
+	void accept() override;
+	void reject() override;
+
+signals:
+	void openUpdates();
+	/* Closed by the user (a button, Esc or the close button); not when it
+	 * closes because LiveHime quits, so it shows again next time. */
+	void read();
+
+protected:
+	void showEvent(QShowEvent *event) override;
+	void closeEvent(QCloseEvent *event) override;
+
+private:
+	QTextBrowser *text_;
+	bool closing_ = false;
+	bool closedByUser_ = false;
+};
