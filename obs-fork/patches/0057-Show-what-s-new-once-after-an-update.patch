+## What's new after an update
+
+`e2e-whats-new.mjs` sets the last version seen (`update.lastSeenVersion` in
+LiveHime's features.json) before each launch and checks through the
+`WhatsNew` vendor request: an upgrade from a version that did not record it
+shows the current version's notes, centered on the main window; closing it
+records the version and the next start shows nothing; several versions behind
+shows the dialog with scrolling text no taller than 70% of the main window;
+quitting with it open records nothing, so it shows again; after a rollback and
+on a fresh install (no LiveHime settings) nothing is shown and the current
+version is recorded. It launches and quits LiveHime itself and stops if an
+instance is still running. It rewrites LiveHime's own settings: back up
+`plugin_config` first and put it back after.
+
+```bash
+node e2e-whats-new.mjs build_macos/frontend/RelWithDebInfo/LiveHime.app <websocket password> [dialog.png]
+```
+
 ## Bilibili interface check
 
 The Updates tab's "B 站接口巡检…" runs a read-only check of the Bilibili
diff --git a/build-aux/livehime/tests/e2e-whats-new.mjs b/build-aux/livehime/tests/e2e-whats-new.mjs
new file mode 100644
index 000000000..8a4d344a4
--- /dev/null
+++ b/build-aux/livehime/tests/e2e-whats-new.mjs
@@ -0,0 +1,143 @@
+// The "What's new" dialog after an update, driven by the last version seen
+// (features.json "update"."lastSeenVersion"), with no GitHub involved:
+// - upgrading from a version that did not record it (settings exist, no
+//   lastSeenVersion) shows the current version's notes, centered on the main
+//   window; closing it records the version, and the next start shows nothing;
+// - several versions behind shows each of them, newest first; the text
+//   scrolls inside a dialog no taller than 70% of the main window;
+// - after a rollback (last seen newer) and on a fresh install (no LiveHime
+//   settings) nothing is shown and the current version is recorded;
+// - quitting with the dialog open shows it again next time.
+// Launches and quits LiveHime itself (isolated Keychain item). It rewrites
+// LiveHime's own settings (plugin_config/livehime): back up plugin_config
+// first and put it back after, and do not run it while a normal LiveHime is open.
+// Usage: node e2e-whats-new.mjs <LiveHime.app> <websocket password> [<dialog PNG>]
+import { createHash } from 'node:crypto';
+import { execFileSync } from 'node:child_process';
+import { existsSync, mkdirSync, readFileSync, renameSync, rmSync, writeFileSync } from 'node:fs';
+import { homedir } from 'node:os';
+import path from 'node:path';
+
+const [app, password, png] = process.argv.slice(2);
+const sha = (s) => createHash('sha256').update(s).digest('base64');
+const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
+const plist = (key) => execFileSync('/usr/libexec/PlistBuddy', ['-c', `Print :${key}`, `${app}/Contents/Info.plist`]).toString().trim();
+const bundleId = plist('CFBundleIdentifier');
+const current = plist('CFBundleShortVersionString');
+const dir = path.join(homedir(), 'Library/Application Support/LiveHime/obs-studio/plugin_config/livehime');
+const features = path.join(dir, 'features.json');
+let failures = 0;
+const check = (name, ok, detail = '') => {
+  console.log(`${ok ? 'PASS' : 'FAIL'}  ${name}${ok || !detail ? '' : `  (${detail})`}`);
+  if (!ok) failures++;
+};
+
+function setLastSeen(version) {
+  const data = existsSync(features) ? JSON.parse(readFileSync(features, 'utf8')) : {};
+  data.update = { ...(data.update ?? {}) };
+  if (version === undefined) delete data.update.lastSeenVersion; else data.update.lastSeenVersion = version;
+  mkdirSync(dir, { recursive: true });
+  writeFileSync(features, JSON.stringify(data, null, 4));
+}
+const lastSeenOnDisk = () => (existsSync(features) ? JSON.parse(readFileSync(features, 'utf8')).update?.lastSeenVersion ?? '' : '');
+
+let ws, pend, id;
+async function connect() {
+  for (let i = 0; i < 120; i++) {
+    try {
+      ws = new WebSocket('ws://127.0.0.1:4466');
+      pend = new Map();
+      id = 1;
+      await new Promise((ok, bad) => {
+        ws.onerror = bad;
+        ws.onmessage = (m) => {
+          const msg = JSON.parse(m.data);
+          if (msg.op === 0) { const a = msg.d.authentication; ws.send(JSON.stringify({ op: 1, d: { rpcVersion: 1, authentication: sha(sha(password + a.salt) + a.challenge) } })); }
+          else if (msg.op === 2) ok();
+          else if (msg.op === 7) pend.get(msg.d.requestId)?.(msg.d);
+        };
+      });
+      return;
+    } catch { await sleep(500); }
+  }
+  throw new Error('LiveHime did not come up');
+}
+const whatsNew = (requestData = {}) => new Promise((ok) => {
+  const requestId = String(id++);
+  pend.set(requestId, (d) => ok(d.responseData?.responseData ?? {}));
+  ws.send(JSON.stringify({ op: 6, d: { requestType: 'CallVendorRequest', requestId, requestData: { vendorName: 'livehime', requestType: 'WhatsNew', requestData } } }));
+});
+const running = () => { try { execFileSync('pgrep', ['-f', `${app}/Contents/MacOS/`]); return true; } catch { return false; } };
+async function launch() {
+  // Never a second instance: it would answer instead of the one under test.
+  if (running()) throw new Error('LiveHime is still running');
+  execFileSync('open', ['-n', '--env', 'LIVEHIME_KEYCHAIN_SERVICE=local.livehime.macos.e2e-test', app]);
+  await connect();
+  await sleep(4000); // loading finishes, then the dialog appears
+}
+async function quit() {
+  try { execFileSync('osascript', ['-e', `tell application id "${bundleId}" to quit`], { stdio: 'ignore' }); } catch {}
+  for (let i = 0; i < 60 && running(); i++) await sleep(500);
+  if (running()) throw new Error('LiveHime did not quit');
+}
+
+async function run() {
+  // Upgrade from a version before this dialog: settings exist, nothing recorded.
+  setLastSeen(undefined);
+  await launch();
+  let r = await whatsNew();
+  check(`an upgrade from before 0.3.0 shows v${current}`, r.open && r.title === `LiveHime v${current}`, JSON.stringify(r));
+  check('...centered on the main window', r.centered === true, JSON.stringify(r));
+  r = await whatsNew({ action: 'close' });
+  await sleep(300);
+  check('closing records the version', (await whatsNew()).lastSeen === current);
+  await quit();
+  check('...on disk', lastSeenOnDisk() === current, lastSeenOnDisk());
+  await launch();
+  check('the next start shows nothing', (await whatsNew()).open === false);
+  await quit();
+
+  // Several versions behind: all of them, and the text scrolls.
+  setLastSeen('0.2.5');
+  await launch();
+  r = await whatsNew(png ? { path: png } : {});
+  check('several versions behind shows the dialog', r.open === true, JSON.stringify(r));
+  check('...the text scrolls inside it', r.scrolls === true, JSON.stringify(r));
+  check('...no taller than 70% of the main window (plus its title bar)', r.height <= r.mainHeight * 0.7 + 4, JSON.stringify(r));
+  check('...centered', r.centered === true, JSON.stringify(r));
+  // Quitting with it open: shown again next time.
+  await quit();
+  check('quitting with it open records nothing', lastSeenOnDisk() === '0.2.5', lastSeenOnDisk());
+  await launch();
+  check('...so it shows again', (await whatsNew()).open === true);
+  await whatsNew({ action: 'close' });
+  await quit();
+
+  // After a rollback: nothing.
+  setLastSeen('9.9.9');
+  await launch();
+  check('after a rollback nothing is shown', (await whatsNew()).open === false);
+  await quit();
+  check('...and the current version is recorded', lastSeenOnDisk() === current, lastSeenOnDisk());
+
+  // A fresh install: no LiveHime settings at all.
+  const aside = `${dir}.e2e-aside`;
+  rmSync(aside, { recursive: true, force: true });
+  renameSync(dir, aside);
+  try {
+    await launch();
+    check('a fresh install shows nothing', (await whatsNew()).open === false);
+    await quit();
+    check('...and records the current version', lastSeenOnDisk() === current, lastSeenOnDisk());
+  } finally {
+    rmSync(dir, { recursive: true, force: true });
+    renameSync(aside, dir);
+  }
+}
+
+run().catch((e) => { console.log(`FAIL  ${e.message}`); failures++; })
+  .finally(async () => {
+    if (running()) await quit().catch(() => console.log('LiveHime is still running: quit it by hand'));
+    console.log(failures ? `${failures} check(s) failed` : "what's new end to end OK");
+    process.exit(failures ? 1 : 0);
+  });
