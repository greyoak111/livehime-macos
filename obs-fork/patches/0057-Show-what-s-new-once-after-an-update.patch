diff --git a/plugins/livehime/src/whats-new-dialog.cpp b/plugins/livehime/src/whats-new-dialog.cpp
new file mode 100644
index 000000000..1bd217852
--- /dev/null
+++ b/plugins/livehime/src/whats-new-dialog.cpp
@@ -0,0 +1,128 @@
+#include "whats-new-dialog.hpp"
+
+#include <obs-module.h>
+
+#include <QDesktopServices>
+#include <QHBoxLayout>
+#include <QLabel>
+#include <QPushButton>
+#include <QCloseEvent>
+#include <QScrollBar>
+#include <QShowEvent>
+#include <QTextBrowser>
+#include <QTextDocument>
+#include <QUrl>
+#include <QVBoxLayout>
+
+#include <cmath>
+
+namespace {
+QString text(const char *key)
+{
+	return QString::fromUtf8(obs_module_text(key));
+}
+constexpr int kWidth = 520;
+} // namespace
+
+WhatsNewDialog::WhatsNewDialog(QWidget *parent, const QString &version, const QString &markdown,
+			       bool addonUpdateNeeded)
+	: QDialog(parent)
+{
+	setWindowTitle(text("LiveHime.WhatsNew.Title").arg(version));
+	/* Not modal: LiveHime stays usable (and can quit) with it open. */
+	setWindowModality(Qt::NonModal);
+
+	auto *layout = new QVBoxLayout(this);
+	auto *heading = new QLabel(text("LiveHime.WhatsNew.Heading").arg(version), this);
+	heading->setStyleSheet(QStringLiteral("font-size: 16px; font-weight: bold;"));
+	layout->addWidget(heading);
+
+	if (addonUpdateNeeded) {
+		auto *row = new QHBoxLayout;
+		auto *notice = new QLabel(text("LiveHime.WhatsNew.AddonUpdate"), this);
+		notice->setWordWrap(true);
+		notice->setStyleSheet(QStringLiteral("color: #e06c75;"));
+		auto *go = new QPushButton(text("LiveHime.WhatsNew.OpenUpdates"), this);
+		connect(go, &QPushButton::clicked, this, [this] {
+			emit openUpdates();
+			accept();
+		});
+		row->addWidget(notice, 1);
+		row->addWidget(go);
+		layout->addLayout(row);
+	}
+
+	text_ = new QTextBrowser(this);
+	text_->setOpenExternalLinks(true);
+	text_->setFrameShape(QFrame::NoFrame);
+	/* Wheel and scroll bar still scroll it; Enter goes to "Got it". */
+	text_->setFocusPolicy(Qt::NoFocus);
+	text_->setMarkdown(markdown);
+	layout->addWidget(text_, 1);
+
+	auto *buttons = new QHBoxLayout;
+	auto *full = new QPushButton(text("LiveHime.WhatsNew.FullNotes"), this);
+	const QUrl page(QStringLiteral("https://github.com/greyoak111/livehime-macos/releases/tag/v%1").arg(version));
+	connect(full, &QPushButton::clicked, this, [page] { QDesktopServices::openUrl(page); });
+	auto *ok = new QPushButton(text("LiveHime.WhatsNew.Ok"), this);
+	ok->setDefault(true);
+	ok->setFocus();
+	connect(ok, &QPushButton::clicked, this, &QDialog::accept);
+	buttons->addWidget(full);
+	buttons->addStretch(1);
+	buttons->addWidget(ok);
+	layout->addLayout(buttons);
+
+	/* As tall as the text needs, up to 70% of the main window; beyond that the
+	 * text scrolls and the buttons stay in view. */
+	const int textWidth = kWidth - layout->contentsMargins().left() - layout->contentsMargins().right();
+	text_->document()->setTextWidth(textWidth - 8);
+	const int needed = static_cast<int>(std::ceil(text_->document()->size().height())) + 12;
+	const int chrome = layout->sizeHint().height() - text_->sizeHint().height();
+	const int cap = parent ? parent->window()->height() * 7 / 10 : 600;
+	text_->setFixedHeight(std::max(120, std::min(needed, cap - chrome)));
+	setFixedWidth(kWidth);
+	adjustSize();
+}
+
+void WhatsNewDialog::showEvent(QShowEvent *event)
+{
+	QDialog::showEvent(event);
+	text_->verticalScrollBar()->setValue(0);
+	/* Centered on the main window once shown (macOS places new windows itself). */
+	if (QWidget *main = parentWidget() ? parentWidget()->window() : nullptr)
+		move(main->frameGeometry().center() - QPoint(frameGeometry().width() / 2, frameGeometry().height() / 2));
+}
+
+void WhatsNewDialog::accept()
+{
+	emit read();
+	QDialog::accept();
+}
+
+void WhatsNewDialog::reject()
+{
+	/* Esc, or the close button (a spontaneous close); a close without the
+	 * user (LiveHime quitting) does not count. */
+	if (!closing_ || closedByUser_)
+		emit read();
+	QDialog::reject();
+}
+
+void WhatsNewDialog::closeEvent(QCloseEvent *event)
+{
+	closing_ = true;
+	closedByUser_ = event->spontaneous();
+	QDialog::closeEvent(event);
+	closing_ = false;
+}
+
+bool WhatsNewDialog::scrolls() const
+{
+	return text_->verticalScrollBar()->maximum() > 0;
+}
+
+void WhatsNewDialog::scrollToEnd()
+{
+	text_->verticalScrollBar()->setValue(text_->verticalScrollBar()->maximum());
+}
