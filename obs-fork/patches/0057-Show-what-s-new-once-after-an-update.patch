@@ -0,0 +1,98 @@
+import XCTest
+@testable import LiveHimeCore
+
+final class ReleaseNotesTests: XCTestCase {
+    private let notes = """
+    # LiveHime macOS v0.3.0
+
+    Intro that is not shown.
+
+    ## 下载哪个文件 / Which file to download
+
+    | a | b |
+
+    ## 新功能 / What's new
+
+    - Browser source add-on.
+
+    ## 修复 / Fixes
+
+    - A fix.
+
+    ## 升级 / Upgrade
+
+    Settings are kept.
+
+    ## 验证 / Validation
+
+    - Tests.
+
+    ## 源码 / Source
+
+    Link.
+    """
+
+    func testKeepsOnlyWhatMattersAfterUpdating() {
+        let kept = ReleaseNotes.sections(of: notes)
+        XCTAssertEqual(kept, """
+        ### 新功能 / What's new
+
+        - Browser source add-on.
+
+        ### 修复 / Fixes
+
+        - A fix.
+
+        ### 升级 / Upgrade
+
+        Settings are kept.
+        """)
+    }
+
+    func testAngleBracketsAreNotTakenAsHTML() {
+        let kept = ReleaseNotes.sections(of: "## 新功能 / What's new\n\n- Saves “直播字幕 <start>.srt” next to it.\n")
+        XCTAssertTrue(kept.contains("\\<start>"), kept)
+    }
+
+    func testShowsAtMostThreeVersionsAndPointsToTheRest() throws {
+        let dir = FileManager.default.temporaryDirectory.appendingPathComponent("notes-\(UUID().uuidString)")
+        try FileManager.default.createDirectory(at: dir, withIntermediateDirectories: true)
+        defer { try? FileManager.default.removeItem(at: dir) }
+        for version in ["0.2.6", "0.2.7", "0.2.8", "0.2.9", "0.2.10"] {
+            try "# v\(version)\n\n## 修复 / Fixes\n\n- Fix in \(version).\n"
+                .write(to: dir.appendingPathComponent("RELEASE_NOTES_v\(version).md"), atomically: true, encoding: .utf8)
+        }
+        let many = try XCTUnwrap(ReleaseNotes.whatsNew(directory: dir, lastSeen: "0.2.5", current: "0.2.10"))
+        XCTAssertEqual(many.versions, ["0.2.10", "0.2.9", "0.2.8"])
+        XCTAssertTrue(many.markdown.hasSuffix("For earlier versions, see the full release notes."))
+        let few = try XCTUnwrap(ReleaseNotes.whatsNew(directory: dir, lastSeen: "0.2.8", current: "0.2.10"))
+        XCTAssertEqual(few.versions, ["0.2.10", "0.2.9"])
+        XCTAssertFalse(few.markdown.contains("earlier versions"))
+    }
+
+    func testVersionsSinceTheLastSeenNewestFirst() {
+        let available = ["0.2.8", "0.2.9", "0.2.10", "0.3.0", "0.3.1"]
+        XCTAssertEqual(ReleaseNotes.toShow(lastSeen: "0.2.8", current: "0.3.0", available: available), ["0.3.0", "0.2.10", "0.2.9"])
+        XCTAssertEqual(ReleaseNotes.toShow(lastSeen: "0.3.0", current: "0.3.0", available: available), [])
+        // After a rollback, nothing.
+        XCTAssertEqual(ReleaseNotes.toShow(lastSeen: "0.3.1", current: "0.3.0", available: available), [])
+        // From a version that did not record what was seen: only the current one.
+        XCTAssertEqual(ReleaseNotes.toShow(lastSeen: nil, current: "0.3.0", available: available), ["0.3.0"])
+    }
+
+    func testBuildsTheDialogTextFromBundledNotes() throws {
+        let dir = FileManager.default.temporaryDirectory.appendingPathComponent("notes-\(UUID().uuidString)")
+        try FileManager.default.createDirectory(at: dir, withIntermediateDirectories: true)
+        defer { try? FileManager.default.removeItem(at: dir) }
+        try notes.write(to: dir.appendingPathComponent("RELEASE_NOTES_v0.3.0.md"), atomically: true, encoding: .utf8)
+        try "# v0.2.10\n\n## 修复 / Fixes\n\n- Old fix.\n".write(to: dir.appendingPathComponent("RELEASE_NOTES_v0.2.10.md"), atomically: true, encoding: .utf8)
+        try "# v0.2.9\n\n## 源码 / Source\n\nNothing shown.\n".write(to: dir.appendingPathComponent("RELEASE_NOTES_v0.2.9.md"), atomically: true, encoding: .utf8)
+
+        let result = try XCTUnwrap(ReleaseNotes.whatsNew(directory: dir, lastSeen: "0.2.8", current: "0.3.0"))
+        XCTAssertEqual(result.versions, ["0.3.0", "0.2.10"])
+        XCTAssertTrue(result.markdown.hasPrefix("## v0.3.0\n\n### 新功能 / What's new"))
+        XCTAssertTrue(result.markdown.contains("## v0.2.10\n\n### 修复 / Fixes\n\n- Old fix."))
+        XCTAssertFalse(result.markdown.contains("Nothing shown"))
+        XCTAssertNil(ReleaseNotes.whatsNew(directory: dir, lastSeen: "0.3.0", current: "0.3.0"))
+    }
+}
