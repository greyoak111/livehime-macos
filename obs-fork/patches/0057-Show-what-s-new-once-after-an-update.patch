diff --git a/plugins/livehime/core/Sources/LiveHimeCore/ReleaseNotes.swift b/plugins/livehime/core/Sources/LiveHimeCore/ReleaseNotes.swift
new file mode 100644
index 000000000..42b6870c5
--- /dev/null
+++ b/plugins/livehime/core/Sources/LiveHimeCore/ReleaseNotes.swift
@@ -0,0 +1,89 @@
+import Foundation
+
+/// The "What's new" text shown once after an update, from the release notes
+/// bundled with the app (data/release-notes/RELEASE_NOTES_v<version>.md, the
+/// same files as docs/ in the LiveHime repository). Only what matters to
+/// someone who already has the update is kept: what's new, fixes and upgrade
+/// notes; which file to download, validation and source are left out.
+public enum ReleaseNotes {
+    /// Section headings kept, by their Chinese part ("## 新功能 / What's new").
+    static let shown = ["新功能", "修复", "升级"]
+    /// At most this many versions (the newest); older ones are left to the full notes.
+    static let maxVersions = 3
+
+    /// The kept "## …" sections of one release's notes, each heading one level down.
+    static func sections(of markdown: String) -> String {
+        var kept: [String] = []
+        var keeping = false
+        for line in markdown.components(separatedBy: "\n") {
+            if line.hasPrefix("## ") {
+                let title = line.dropFirst(3).trimmingCharacters(in: .whitespaces)
+                keeping = shown.contains { title.hasPrefix($0) }
+                if keeping { kept.append("#" + line) }
+            } else if line.hasPrefix("# ") {
+                keeping = false
+            } else if keeping {
+                // "<start>" and the like would be taken as HTML tags and hide the text after them.
+                kept.append(line.replacingOccurrences(of: "<", with: "\\<"))
+            }
+        }
+        return kept.joined(separator: "\n").trimmingCharacters(in: .whitespacesAndNewlines)
+    }
+
+    /// Versions with notes in `directory`.
+    static func versions(in directory: URL) -> [String] {
+        let names = (try? FileManager.default.contentsOfDirectory(atPath: directory.path)) ?? []
+        return names.compactMap { name in
+            guard name.hasPrefix("RELEASE_NOTES_v"), name.hasSuffix(".md") else { return nil }
+            return String(name.dropFirst("RELEASE_NOTES_v".count).dropLast(".md".count))
+        }
+    }
+
+    /// The versions to show after updating from `lastSeen` to `current`, newest
+    /// first: those after `lastSeen` up to `current`. Without `lastSeen` (an
+    /// upgrade from a version that did not record it) only `current`.
+    static func toShow(lastSeen: String?, current: String, available: [String]) -> [String] {
+        available.filter { version in
+            !AppUpdater.isNewer(version, than: current)
+                && (lastSeen.map { AppUpdater.isNewer(version, than: $0) } ?? (version == current))
+        }.sorted { AppUpdater.isNewer($0, than: $1) }
+    }
+
+    /// Markdown for the dialog, or nil when there is nothing to show.
+    public static func whatsNew(directory: URL, lastSeen: String?, current: String) -> (versions: [String], markdown: String)? {
+        var shownVersions: [String] = []
+        var parts: [String] = []
+        let due = toShow(lastSeen: lastSeen, current: current, available: versions(in: directory))
+        for version in due {
+            if shownVersions.count == maxVersions { break }
+            let file = directory.appendingPathComponent("RELEASE_NOTES_v\(version).md")
+            guard let text = try? String(contentsOf: file, encoding: .utf8) else { continue }
+            let body = sections(of: text)
+            guard !body.isEmpty else { continue }
+            shownVersions.append(version)
+            parts.append("## v\(version)\n\n\(body)")
+        }
+        guard !parts.isEmpty else { return nil }
+        if let last = shownVersions.last, due.contains(where: { AppUpdater.isNewer(last, than: $0) }) {
+            parts.append("更早版本的变化见完整发布说明。/ For earlier versions, see the full release notes.")
+        }
+        return (shownVersions, parts.joined(separator: "\n\n"))
+    }
+}
+
+/// Emits {"event":"whatsNew","current","versions":[…],"markdown","addonUpdateNeeded"}
+/// for updating from `last_seen` (empty: from a version that did not record it);
+/// "markdown" is empty when there is nothing to show. `notes_dir` holds the bundled notes.
+@_cdecl("livehime_core_whats_new")
+public func livehime_core_whats_new(_ notesDir: UnsafePointer<CChar>?, _ lastSeen: UnsafePointer<CChar>?) {
+    guard let notesDir else { return }
+    let directory = URL(fileURLWithPath: String(cString: notesDir), isDirectory: true)
+    let seen = lastSeen.map { String(cString: $0) }.flatMap { $0.isEmpty ? nil : $0 }
+    let current = AppUpdater.currentVersion
+    DispatchQueue.main.async {
+        let result = ReleaseNotes.whatsNew(directory: directory, lastSeen: seen, current: current)
+        CoreBridge.shared?.emit(["event": "whatsNew", "current": current, "versions": result?.versions ?? [],
+                                 "markdown": result?.markdown ?? "",
+                                 "addonUpdateNeeded": AddonManager.status().state == .updateNeeded])
+    }
+}
diff --git a/plugins/livehime/core/Tests/LiveHimeCoreTests/ReleaseNotesTests.swift b/plugins/livehime/core/Tests/LiveHimeCoreTests/ReleaseNotesTests.swift
new file mode 100644
