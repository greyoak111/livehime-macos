+/* What's new for tests: replies whether the dialog is open, its title,
+ * whether its text scrolls, and whether it is centered on the main window;
+ * optional "path" saves it as a PNG ("end": scrolled to the end first),
+ * "action":"close" closes it (as read). */
+void whatsNew(obs_data_t *request, obs_data_t *response, void *)
+{
+	const QString path = QString::fromUtf8(obs_data_get_string(request, "path"));
+	onUiThread([&] {
+		UpdatePage *page = target->features()->updates();
+		WhatsNewDialog *dialog = page->whatsNew();
+		QApplication::processEvents();
+		obs_data_set_bool(response, "open", dialog && dialog->isVisible());
+		obs_data_set_string(response, "lastSeen", page->lastSeenVersion().toUtf8().constData());
+		if (!dialog)
+			return;
+		obs_data_set_string(response, "title", dialog->windowTitle().toUtf8().constData());
+		obs_data_set_bool(response, "scrolls", dialog->scrolls());
+		auto *main = static_cast<QWidget *>(obs_frontend_get_main_window());
+		const QPoint offset = dialog->frameGeometry().center() - main->frameGeometry().center();
+		obs_data_set_bool(response, "centered", offset.manhattanLength() <= 4);
+		obs_data_set_int(response, "height", dialog->height());
+		obs_data_set_int(response, "mainHeight", main->height());
+		if (obs_data_get_bool(request, "end"))
+			dialog->scrollToEnd();
+		if (!path.isEmpty())
+			obs_data_set_bool(response, "saved", dialog->grab().save(path, "PNG"));
+		if (QString::fromUtf8(obs_data_get_string(request, "action")) == "close")
+			dialog->accept();
+	});
+}
