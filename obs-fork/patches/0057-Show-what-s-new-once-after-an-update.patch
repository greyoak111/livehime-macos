+namespace {
+bool newerVersion(const QString &candidate, const QString &current)
+{
+	const QStringList a = candidate.split('.'), b = current.split('.');
+	for (int i = 0; i < std::max(a.size(), b.size()); i++) {
+		const int x = i < a.size() ? a[i].toInt() : 0, y = i < b.size() ? b[i].toInt() : 0;
+		if (x != y)
+			return x > y;
+	}
+	return false;
+}
+} // namespace
+
+WhatsNewDialog *UpdatePage::whatsNew() const
+{
+	return whatsNew_;
+}
+
+void UpdatePage::startWhatsNew()
+{
+	const QString current = currentVersion();
+	/* A fresh install has nothing to catch up on; after a rollback (or at the
+	 * same version) there is nothing new either. */
+	if ((lastSeen_.isEmpty() && !hadSettings_) || (!lastSeen_.isEmpty() && !newerVersion(current, lastSeen_))) {
+		if (lastSeen_ != current) {
+			lastSeen_ = current;
+			save();
+		}
+		return;
+	}
+	BPtr<char> notes = obs_module_file("release-notes");
+	livehime_core_whats_new(notes ? notes.Get() : "", lastSeen_.toUtf8().constData());
+}
+
+void UpdatePage::handleWhatsNewEvent(const QJsonObject &event)
+{
+	const QString current = event.value("current").toString();
+	const QString markdown = event.value("markdown").toString();
+	auto seen = [this, current] {
+		lastSeen_ = current;
+		save();
+	};
+	if (markdown.isEmpty()) {
+		seen();
+		return;
+	}
+	auto *main = static_cast<QWidget *>(obs_frontend_get_main_window());
+	whatsNew_ = new WhatsNewDialog(main, current, markdown, event.value("addonUpdateNeeded").toBool());
+	whatsNew_->setAttribute(Qt::WA_DeleteOnClose);
+	connect(whatsNew_, &WhatsNewDialog::openUpdates, this, &UpdatePage::showRequested);
+	/* Closed by the user counts as read; quitting with it open shows it again. */
+	connect(whatsNew_, &WhatsNewDialog::read, this, seen);
+	blog(LOG_INFO, "[livehime] what's new: showing %s",
+	     event.value("versions").toVariant().toStringList().join(", ").toUtf8().constData());
+	/* A window of its own (open() would make it window-modal, which macOS may
+	 * attach to the main window as a sheet). */
+	QTimer::singleShot(0, whatsNew_, [dialog = whatsNew_] {
+		if (!dialog)
+			return;
+		dialog->show();
+		dialog->raise();
+		dialog->activateWindow();
+	});
+}
