diff --git a/plugins/livehime/core/Sources/LiveHimeCore/ApiProbe.swift b/plugins/livehime/core/Sources/LiveHimeCore/ApiProbe.swift
new file mode 100644
index 000000000..623f60852
--- /dev/null
+++ b/plugins/livehime/core/Sources/LiveHimeCore/ApiProbe.swift
@@ -0,0 +1,179 @@
+import Foundation
+
+/// A manual health check of the Bilibili interfaces LiveHime depends on, for
+/// when something stops working. Every check is read-only and goes through
+/// the same client code the app uses; nothing is sent, changed or started.
+/// Checks that need the account run only when it is signed in.
+@MainActor
+enum ApiProbe {
+    struct Result {
+        enum Outcome: String { case ok, fail, skip }
+        let id: String
+        let outcome: Outcome
+        let detail: String
+        let milliseconds: Int
+    }
+
+    /// Runs every check in order, reporting each as it finishes. `room` is the
+    /// live room for the room and danmaku checks (0: the account's own room).
+    static func run(room requested: Int64, report: @escaping (Result) -> Void) async {
+        let bridge = CoreBridge.shared
+        var account: LiveAccount?
+        if case .ready(let ready) = bridge?.coordinator.state { account = ready }
+        let cookie = account == nil ? "" : (bridge?.coordinator.credentials?.cookieHeader ?? "")
+        let room = requested > 0 ? requested : (account?.room.roomID ?? 0)
+        let client = BilibiliLiveClient(cookieHeader: cookie, session: BilibiliWeb.session)
+
+        func check(_ id: String, needs: Bool = true, skip reason: String = "",
+                   _ body: () async throws -> String) async {
+            guard needs else {
+                report(Result(id: id, outcome: .skip, detail: reason, milliseconds: 0))
+                return
+            }
+            let start = ContinuousClock.now
+            let outcome: Result.Outcome, detail: String
+            do {
+                detail = try await body()
+                outcome = .ok
+            } catch {
+                detail = describe(error)
+                outcome = .fail
+            }
+            let elapsed = ContinuousClock.now - start
+            let ms = Int(elapsed.components.seconds * 1000 + elapsed.components.attoseconds / 1_000_000_000_000_000)
+            report(Result(id: id, outcome: outcome, detail: detail, milliseconds: ms))
+        }
+
+        await check("nav") { try await nav(cookie: cookie) }
+        await check("buvid") {
+            let buvid = try await client.buvid3(cookieHeader: cookie)
+            guard !buvid.isEmpty else { throw BilibiliLiveError.invalidResponse }
+            return "ok"
+        }
+        await check("areas") {
+            let areas = try await client.fetchAreas()
+            guard !areas.isEmpty else { throw BilibiliLiveError.invalidResponse }
+            return "\(areas.count)"
+        }
+        await check("liveVersion") {
+            let version = try await client.fetchLiveVersion()
+            return "\(version.version) (\(version.build))"
+        }
+        await check("qrcode") {
+            let code = try await QRLoginClient().generate()
+            guard !code.url.isEmpty, !code.key.isEmpty else { throw BilibiliLiveError.invalidResponse }
+            return "ok"
+        }
+        let noRoom = "noRoom"
+        await check("roomInfo", needs: room > 0, skip: noRoom) {
+            let info = try await client.fetchRoomInfo(roomID: room, cookieHeader: cookie)
+            return "\(info.roomID) · \(info.liveStatus == 1 ? "live" : "offline")"
+        }
+        await check("danmakuInfo", needs: room > 0, skip: noRoom) {
+            let info = try await client.danmakuConnectInfo(roomID: room, cookieHeader: cookie)
+            guard !info.token.isEmpty else { throw BilibiliLiveError.invalidResponse }
+            return "\(info.servers.count)"
+        }
+        await check("danmakuSocket", needs: room > 0, skip: noRoom) {
+            try await danmakuConnects(room: room, uid: account?.mid ?? 0, cookie: cookie)
+        }
+        for (id, page) in [("loginPage", "https://live.bilibili.com/p/html/live-pc-blink/mini-login-v2/"),
+                           ("coverPage", "https://live.bilibili.com/p/html/live-pc-blink/hime-live-cover/"),
+                           ("faceAuthPage", "https://live.bilibili.com/p/html/bilili-page-face-auth/index.html")] {
+            await check(id) { try await pageLoads(page) }
+        }
+        let signedOut = "signedOut"
+        await check("myRoom", needs: account != nil, skip: signedOut) {
+            let info = try await client.fetchCurrentRoom(mid: account!.mid)
+            return "\(info.roomID)"
+        }
+        await check("faceAuthState", needs: account != nil, skip: signedOut) {
+            try await client.isIdentifiedByFaceAuth(roomID: account!.room.roomID, cookieHeader: cookie) ? "verified" : "notVerified"
+        }
+        await check("shieldKeywords", needs: account != nil, skip: signedOut) {
+            let words = try await client.shieldKeywords(roomID: account!.room.roomID, cookieHeader: cookie)
+            return "\(words.count)"
+        }
+    }
+
+    /// The identity endpoint answers 0 (signed in) or -101 (signed out), and
+    /// always carries the WBI keys that signed requests need.
+    static func nav(cookie: String) async throws -> String {
+        var request = URLRequest(url: URL(string: "https://api.bilibili.com/x/web-interface/nav")!, timeoutInterval: 12)
+        request.setValue(cookie, forHTTPHeaderField: "Cookie")
+        request.setValue(BilibiliWeb.userAgent, forHTTPHeaderField: "User-Agent")
+        let (data, response) = try await BilibiliWeb.session.data(for: request)
+        try httpOK(response)
+        let root = (try? JSONSerialization.jsonObject(with: data) as? [String: Any]) ?? [:]
+        let code = (root["code"] as? NSNumber)?.intValue ?? Int.min
+        let body = root["data"] as? [String: Any]
+        guard code == 0 || code == -101, body?["wbi_img"] is [String: Any] else {
+            throw ProbeError.unexpected("code \(code)")
+        }
+        return (body?["isLogin"] as? Bool) == true ? "signedIn" : "signedOut"
+    }
+
+    static func pageLoads(_ address: String) async throws -> String {
+        var request = URLRequest(url: URL(string: address)!, timeoutInterval: 12)
+        request.setValue(BilibiliWeb.userAgent, forHTTPHeaderField: "User-Agent")
+        let (data, response) = try await BilibiliWeb.session.data(for: request)
+        try httpOK(response)
+        guard data.count > 200 else { throw ProbeError.unexpected("empty page") }
+        return "ok"
+    }
+
+    /// Connects to the room's danmaku server and waits for the handshake.
+    static func danmakuConnects(room: Int64, uid: Int64, cookie: String) async throws -> String {
+        let client = DanmakuClient()
+        defer { client.stop() }
+        client.start(roomID: room, uid: uid, cookieHeader: cookie)
+        for _ in 0..<60 {
+            if client.status == .connected { return "connected" }
+            try await Task.sleep(for: .milliseconds(200))
+        }
+        throw ProbeError.unexpected(client.status == .reconnecting ? "reconnecting" : "timeout")
+    }
+
+    static func httpOK(_ response: URLResponse) throws {
+        if let http = response as? HTTPURLResponse, http.statusCode != 200 {
+            throw ProbeError.unexpected("HTTP \(http.statusCode)")
+        }
+    }
+
+    enum ProbeError: Error { case unexpected(String) }
+
+    /// A short, credential-free description of a failure.
+    static func describe(_ error: Error) -> String {
+        switch error {
+        case ProbeError.unexpected(let detail): return detail
+        case BilibiliLiveError.api(let code, let message): return "code \(code) \(message)".trimmingCharacters(in: .whitespaces)
+        case BilibiliLiveError.network(let code): return "network \(code)"
+        case let error as URLError: return "network \(error.code.rawValue)"
+        default: return String(describing: error).prefix(80).description
+        }
+    }
+}
+
+/// Runs the interface check (see ApiProbe). Emits {"event":"probe",
+/// "status":"running"}, one {"event":"probe","check":id,"result":"ok|fail|
+/// skip","detail","ms"} per check, then {"event":"probe","status":"done",
+/// "passed","failed","skipped"}. `room` 0 uses the account's own room.
+@_cdecl("livehime_core_probe_run")
+public func livehime_core_probe_run(_ room: Int64) {
+    DispatchQueue.main.async {
+        MainActor.assumeIsolated {
+            guard let bridge = CoreBridge.shared else { return }
+            bridge.emit(["event": "probe", "status": "running"])
+            Task { @MainActor in
+                var counts: [ApiProbe.Result.Outcome: Int] = [:]
+                await ApiProbe.run(room: room) { result in
+                    counts[result.outcome, default: 0] += 1
+                    CoreBridge.shared?.emit(["event": "probe", "check": result.id, "result": result.outcome.rawValue,
+                                             "detail": result.detail, "ms": result.milliseconds])
+                }
+                CoreBridge.shared?.emit(["event": "probe", "status": "done", "passed": counts[.ok] ?? 0,
+                                         "failed": counts[.fail] ?? 0, "skipped": counts[.skip] ?? 0])
+            }
+        }
+    }
+}
