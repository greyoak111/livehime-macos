+
+class QLabel;
+class QLineEdit;
+class QPushButton;
+class QTreeWidget;
+
+/* "Check Bilibili interfaces": runs the core's read-only interface check
+ * (public endpoints, the danmaku connection, the official pages, and with an
+ * account its own read-only ones) and lists each result, for when Bilibili
+ * changes something. The report can be copied; it holds no credentials. */
+class ProbeDialog : public QDialog {
+	Q_OBJECT
+
+public:
+	explicit ProbeDialog(QWidget *parent = nullptr);
+
+	void handleEvent(const QJsonObject &event);
+	void start();
+	void setRoom(const QString &room);
+	bool running() const { return running_; }
+	QString report() const;
+
+private:
+	QLineEdit *room_;
+	QPushButton *run_;
+	QPushButton *copy_;
+	QLabel *summary_;
+	QTreeWidget *list_;
+	bool running_ = false;
+};
