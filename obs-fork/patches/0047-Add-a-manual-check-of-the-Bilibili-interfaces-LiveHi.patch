+/* Interface check for tests: optional "room" (number), "action":"run" starts it;
+ * replies with whether it is running and the copyable report so far. */
+void probe(obs_data_t *request, obs_data_t *response, void *)
+{
+	onUiThread([&] {
+		ProbeDialog *dialog = target->features()->updates()->probe();
+		if (obs_data_has_user_value(request, "room"))
+			dialog->setRoom(QString::fromUtf8(obs_data_get_string(request, "room")));
+		if (QString::fromUtf8(obs_data_get_string(request, "action")) == "run")
+			dialog->start();
+		obs_data_set_bool(response, "running", dialog->running());
+		obs_data_set_string(response, "report", dialog->report().toUtf8().constData());
+	});
+}
+
