diff --git a/plugins/livehime/src/probe-dialog.cpp b/plugins/livehime/src/probe-dialog.cpp
new file mode 100644
index 000000000..327041d75
--- /dev/null
+++ b/plugins/livehime/src/probe-dialog.cpp
@@ -0,0 +1,144 @@
+#include "probe-dialog.hpp"
+#include "update-page.hpp"
+
+#include <livehime-core.h>
+#include <obs-module.h>
+
+#include <QApplication>
+#include <QClipboard>
+#include <QDateTime>
+#include <QHBoxLayout>
+#include <QHeaderView>
+#include <QLabel>
+#include <QLineEdit>
+#include <QPushButton>
+#include <QTreeWidget>
+#include <QVBoxLayout>
+
+namespace {
+QString text(const char *key)
+{
+	return QString::fromUtf8(obs_module_text(key));
+}
+
+/* Details the core reports as keywords ("123 · live"), shown in words. */
+QString detailText(const QString &detail)
+{
+	static const QStringList keys = {"signedIn", "signedOut", "noRoom",    "live",         "offline",
+					 "verified", "notVerified", "connected", "reconnecting", "timeout"};
+	if (detail == QStringLiteral("ok"))
+		return QString();
+	QStringList parts = detail.split(QStringLiteral(" · "));
+	for (QString &part : parts) {
+		if (keys.contains(part)) {
+			const QByteArray name = "LiveHime.Probe.Detail." + part.toUtf8();
+			part = text(name.constData());
+		}
+	}
+	return parts.join(QStringLiteral(" · "));
+}
+} // namespace
+
+ProbeDialog::ProbeDialog(QWidget *parent) : QDialog(parent)
+{
+	setWindowTitle(text("LiveHime.Probe.Title"));
+	resize(560, 560);
+	auto *intro = new QLabel(text("LiveHime.Probe.Intro"), this);
+	intro->setWordWrap(true);
+	room_ = new QLineEdit(this);
+	room_->setPlaceholderText(text("LiveHime.Probe.RoomPlaceholder"));
+	room_->setValidator(nullptr);
+	run_ = new QPushButton(text("LiveHime.Probe.Run"), this);
+	copy_ = new QPushButton(text("LiveHime.Probe.Copy"), this);
+	copy_->setEnabled(false);
+	summary_ = new QLabel(this);
+	summary_->setWordWrap(true);
+	list_ = new QTreeWidget(this);
+	list_->setColumnCount(4);
+	list_->setHeaderLabels({text("LiveHime.Probe.Column.Check"), text("LiveHime.Probe.Column.Result"),
+				text("LiveHime.Probe.Column.Time"), text("LiveHime.Probe.Column.Detail")});
+	list_->setRootIsDecorated(false);
+	list_->header()->setSectionResizeMode(0, QHeaderView::ResizeToContents);
+	list_->header()->setSectionResizeMode(1, QHeaderView::ResizeToContents);
+	list_->header()->setSectionResizeMode(2, QHeaderView::ResizeToContents);
+	list_->header()->setStretchLastSection(true);
+
+	auto *row = new QHBoxLayout;
+	row->addWidget(room_, 1);
+	row->addWidget(run_);
+	row->addWidget(copy_);
+	auto *layout = new QVBoxLayout(this);
+	layout->addWidget(intro);
+	layout->addLayout(row);
+	layout->addWidget(summary_);
+	layout->addWidget(list_, 1);
+
+	connect(run_, &QPushButton::clicked, this, &ProbeDialog::start);
+	connect(copy_, &QPushButton::clicked, this, [this] { QApplication::clipboard()->setText(report()); });
+}
+
+void ProbeDialog::start()
+{
+	if (running_)
+		return;
+	running_ = true;
+	list_->clear();
+	run_->setEnabled(false);
+	copy_->setEnabled(false);
+	summary_->setText(text("LiveHime.Probe.Running"));
+	summary_->setStyleSheet(QStringLiteral("color: #9aa0ab;"));
+	livehime_core_probe_run(room_->text().trimmed().toLongLong());
+}
+
+void ProbeDialog::setRoom(const QString &room)
+{
+	room_->setText(room);
+}
+
+void ProbeDialog::handleEvent(const QJsonObject &event)
+{
+	if (event.contains("check")) {
+		const QString id = event.value("check").toString();
+		const QString result = event.value("result").toString();
+		const QByteArray name = "LiveHime.Probe.Check." + id.toUtf8();
+		const QByteArray outcome = "LiveHime.Probe.Result." + result.toUtf8();
+		auto *item = new QTreeWidgetItem(list_);
+		item->setText(0, text(name.constData()));
+		item->setText(1, text(outcome.constData()));
+		item->setText(2, result == "skip" ? QString() : QStringLiteral("%1 ms").arg(event.value("ms").toInt()));
+		item->setText(3, detailText(event.value("detail").toString()));
+		item->setData(0, Qt::UserRole, id);
+		item->setData(1, Qt::UserRole, result);
+		item->setForeground(1, QColor(result == "ok" ? "#6cc070" : result == "fail" ? "#e06c75" : "#9aa0ab"));
+		return;
+	}
+	if (event.value("status").toString() != "done")
+		return;
+	running_ = false;
+	run_->setEnabled(true);
+	copy_->setEnabled(true);
+	const int failed = event.value("failed").toInt();
+	summary_->setText(text(failed ? "LiveHime.Probe.SummaryFailed" : "LiveHime.Probe.SummaryOk")
+				  .arg(event.value("passed").toInt())
+				  .arg(failed)
+				  .arg(event.value("skipped").toInt()));
+	summary_->setStyleSheet(failed ? QStringLiteral("color: #e06c75;") : QStringLiteral("color: #6cc070;"));
+}
+
+QString ProbeDialog::report() const
+{
+	QString out = QStringLiteral("LiveHime %1 · %2\n%3\n\n")
+			      .arg(UpdatePage::currentVersion(),
+				   QDateTime::currentDateTime().toString(QStringLiteral("yyyy-MM-dd HH:mm")),
+				   summary_->text());
+	for (int i = 0; i < list_->topLevelItemCount(); i++) {
+		const QTreeWidgetItem *item = list_->topLevelItem(i);
+		const QString result = item->data(1, Qt::UserRole).toString();
+		const QString mark = result == "ok" ? QStringLiteral("✓") : result == "fail" ? QStringLiteral("✗") : QStringLiteral("–");
+		out += QStringLiteral("%1 %2 [%3] %4 %5\n")
+			       .arg(mark, item->text(0), item->data(0, Qt::UserRole).toString(), item->text(2), item->text(3))
+			       .trimmed() +
+		       QStringLiteral("\n");
+	}
+	return out;
+}
