 if [[ -f $stamp ]]; then
   read -r stamped_patch stamped_plugin < "$stamp"
   if [[ $stamped_patch == $patch_sha && $stamped_plugin == $(shasum -a 256 "$plugin" | cut -d' ' -f1) ]]; then
@@ -51,7 +54,9 @@ fi
 rm -rf "$work/qtbase" "$work/build"
 mkdir -p "$work/qtbase"
 tar --strip-components 1 -xJf "$work/$tarball" -C "$work/qtbase"
-patch -d "$work/qtbase" -p2 --forward --quiet < "$patch_file"
+for patch_file in "${patch_files[@]}"; do
+  patch -d "$work/qtbase" -p2 --forward --quiet < "$patch_file"
