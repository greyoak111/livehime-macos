diff --git a/build-aux/livehime/icon/render.swift b/build-aux/livehime/icon/render.swift
new file mode 100644
index 000000000..53724e2a7
--- /dev/null
+++ b/build-aux/livehime/icon/render.swift
@@ -0,0 +1,49 @@
+import AppKit
+let a = CommandLine.arguments
+let g = try! JSONSerialization.jsonObject(with: Data(contentsOf: URL(fileURLWithPath: a[1]))) as! [String: Any]
+let size = 1024
+let cs = CGColorSpace(name: CGColorSpace.sRGB)!
+let ctx = CGContext(data: nil, width: size, height: size, bitsPerComponent: 8, bytesPerRow: 0, space: cs, bitmapInfo: CGImageAlphaInfo.premultipliedLast.rawValue)!
+ctx.translateBy(x: 0, y: CGFloat(size)); ctx.scaleBy(x: 1, y: -1)   // SVG-style y-down
+func hex(_ s: String, _ alpha: CGFloat = 1) -> CGColor {
+    let v = Int(s.dropFirst(), radix: 16)!
+    return CGColor(colorSpace: cs, components: [CGFloat((v>>16)&255)/255, CGFloat((v>>8)&255)/255, CGFloat(v&255)/255, alpha])!
+}
+func pt(_ v: Any) -> CGPoint { let p = v as! [Double]; return CGPoint(x: p[0], y: p[1]) }
+func path(_ key: String) -> CGPath {
+    let p = CGMutablePath()
+    for e in g[key] as! [[Any]] {
+        switch e[0] as! String {
+        case "M": p.move(to: pt(e[1]))
+        case "L": p.addLine(to: pt(e[1]))
+        case "C": p.addCurve(to: pt(e[3]), control1: pt(e[1]), control2: pt(e[2]))
+        default: p.closeSubpath()
+        }
+    }
+    return p
+}
+func grad(_ c0: String, _ c1: String) -> CGGradient { CGGradient(colorsSpace: cs, colors: [hex(c0), hex(c1)] as CFArray, locations: [0, 1])! }
+let tile = CGPath(roundedRect: CGRect(x: 100, y: 100, width: 824, height: 824), cornerWidth: 185, cornerHeight: 185, transform: nil)
+// shadow (y-down canvas: positive dy moves down)
+ctx.saveGState(); ctx.setShadow(offset: CGSize(width: 0, height: -10), blur: 24, color: hex("#000000", 0.35))
+ctx.addPath(tile); ctx.setFillColor(hex("#14181c")); ctx.fillPath(); ctx.restoreGState()
+ctx.saveGState(); ctx.addPath(tile); ctx.clip()
+ctx.drawLinearGradient(grad("#2a2c30", "#14181c"), start: CGPoint(x: 0, y: 100), end: CGPoint(x: 0, y: 924), options: [])
+ctx.restoreGState()
+ctx.saveGState()
+ctx.addPath(CGPath(roundedRect: CGRect(x: 101.5, y: 101.5, width: 821, height: 821), cornerWidth: 183.5, cornerHeight: 183.5, transform: nil))
+ctx.setLineWidth(3); ctx.replacePathWithStrokedPath(); ctx.clip()
+ctx.drawLinearGradient(CGGradient(colorsSpace: cs, colors: [hex("#ffffff", 0.16), hex("#ffffff", 0.04)] as CFArray, locations: [0, 1])!, start: CGPoint(x: 0, y: 100), end: CGPoint(x: 0, y: 924), options: [])
+ctx.restoreGState()
+let sg = g["stem_grad"] as! [Double]
+ctx.saveGState(); ctx.addPath(path("stem")); ctx.clip()
+ctx.drawLinearGradient(grad("#cfcffb", "#c1c2f8"), start: CGPoint(x: 0, y: sg[0]), end: CGPoint(x: 0, y: sg[1]), options: [.drawsBeforeStartLocation, .drawsAfterEndLocation])
+ctx.restoreGState()
+let og = g["over_grad"] as! [Any]
+ctx.saveGState(); ctx.addPath(path("over")); ctx.clip()
+ctx.drawLinearGradient(grad("#4254a8", "#5264c6"), start: pt(og[0]), end: pt(og[1]), options: [.drawsBeforeStartLocation, .drawsAfterEndLocation])
+ctx.restoreGState()
+ctx.addPath(path("hump")); ctx.setFillColor(hex("#8994ee")); ctx.fillPath()
+let d = g["dot"] as! [Double]
+ctx.addEllipse(in: CGRect(x: d[0]-d[2], y: d[1]-d[2], width: 2*d[2], height: 2*d[2])); ctx.setFillColor(hex("#fb4d5a")); ctx.fillPath()
+try! NSBitmapImageRep(cgImage: ctx.makeImage()!).representation(using: .png, properties: [:])!.write(to: URL(fileURLWithPath: a[2]))
