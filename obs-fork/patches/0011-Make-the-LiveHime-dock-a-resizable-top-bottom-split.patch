 private:
+	void restoreSplitter();
+
 	StreamController *controller_;
 	AccountPanel *account_;
 	FeaturePanel *features_;
 	QLabel *statusChip_;
 	QLabel *statusDetail_;
 	QLabel *stats_;
+	QSplitter *splitter_;
 	QTimer statsTimer_;
 	QElapsedTimer liveClock_;
 	uint64_t lastBytes_ = 0;
