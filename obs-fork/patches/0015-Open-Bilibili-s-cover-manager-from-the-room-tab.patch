diff --git a/plugins/livehime/core/Sources/LiveHimeCore/BilibiliPageWindow.swift b/plugins/livehime/core/Sources/LiveHimeCore/BilibiliPageWindow.swift
new file mode 100644
index 000000000..d081fb9c0
--- /dev/null
+++ b/plugins/livehime/core/Sources/LiveHimeCore/BilibiliPageWindow.swift
@@ -0,0 +1,226 @@
+import AppKit
+import UniformTypeIdentifiers
+import WebKit
+
+/// Hosts one of Bilibili's own web pages for the logged-in account: the
+/// pre-live verification page and the live cover manager (the same pages the
+/// Windows client opens in CEF). Without the client's `biliBridgePc` the
+/// pages run in their standard web mode, so the window only needs the usual
+/// browser pieces: a file picker for uploads and page-initiated close.
+///
+/// The session cookies are copied into a non-persistent WebKit store that
+/// disappears with the window. The app never completes or bypasses anything
+/// on these pages itself.
+@MainActor
+final class BilibiliPageWindow: NSObject, NSWindowDelegate, WKNavigationDelegate, WKUIDelegate {
+    struct Options {
+        var title: String
+        var url: URL
+        var size: NSSize
+        var loadingText: String
+        var readyText: String
+        /// When set, a default button that closes the window and calls back.
+        var confirmTitle: String?
+    }
+
+    private static var open: [String: BilibiliPageWindow] = [:]
+
+    private let key: String
+    private let options: Options
+    private let window: NSWindow
+    private let webView: WKWebView
+    private let status: NSTextField
+    private let onConfirm: (() -> Void)?
+    private let onClose: (() -> Void)?
+
+    /// Shows the page for `key`, reusing an open window for the same key.
+    static func present(key: String, options: Options, credentials: SessionCredentials,
+                        onConfirm: (() -> Void)? = nil, onClose: (() -> Void)? = nil) {
+        if let existing = open[key] {
+            existing.window.makeKeyAndOrderFront(nil)
+            return
+        }
+        let controller = BilibiliPageWindow(key: key, options: options, onConfirm: onConfirm, onClose: onClose)
+        open[key] = controller
+        controller.load(credentials: credentials)
+    }
+
+    private init(key: String, options: Options, onConfirm: (() -> Void)?, onClose: (() -> Void)?) {
+        self.key = key
+        self.options = options
+        self.onConfirm = onConfirm
+        self.onClose = onClose
+        let configuration = WKWebViewConfiguration()
+        configuration.websiteDataStore = .nonPersistent()
+        webView = WKWebView(frame: .zero, configuration: configuration)
+        status = NSTextField(labelWithString: options.loadingText)
+        window = NSWindow(contentRect: NSRect(origin: .zero, size: options.size),
+                          styleMask: [.titled, .closable, .resizable], backing: .buffered, defer: false)
+        super.init()
+
+        var buttons: [NSView] = [status, NSView()]
+        let close = NSButton(title: "关闭", target: self, action: #selector(closeTapped))
+        buttons.append(close)
+        if let confirmTitle = options.confirmTitle {
+            let confirm = NSButton(title: confirmTitle, target: self, action: #selector(confirmTapped))
+            confirm.keyEquivalent = "\r"
+            buttons.append(confirm)
+        }
+        let bar = NSStackView(views: buttons)
+        bar.orientation = .horizontal
+        let root = NSStackView(views: [webView, bar])
+        root.orientation = .vertical
+        root.spacing = 10
+        root.edgeInsets = NSEdgeInsets(top: 0, left: 0, bottom: 12, right: 12)
+        webView.translatesAutoresizingMaskIntoConstraints = false
+        webView.widthAnchor.constraint(equalTo: root.widthAnchor).isActive = true
+        webView.heightAnchor.constraint(greaterThanOrEqualToConstant: options.size.height - 60).isActive = true
+        webView.navigationDelegate = self
+        webView.uiDelegate = self
+
+        window.title = options.title
+        window.contentView = root
+        window.isReleasedWhenClosed = false
+        window.delegate = self
+        window.center()
+        window.makeKeyAndOrderFront(nil)
+        NSApp.activate(ignoringOtherApps: true)
+    }
+
+    private func load(credentials: SessionCredentials) {
+        let store = webView.configuration.websiteDataStore.httpCookieStore
+        Task { @MainActor in
+            for (name, value) in credentials.cookies {
+                if let cookie = HTTPCookie(properties: [.domain: ".bilibili.com", .path: "/", .name: name,
+                                                        .value: value, .secure: "TRUE"]) {
+                    await store.setCookie(cookie)
+                }
+            }
+            webView.load(URLRequest(url: options.url))
+        }
+    }
+
+    @objc private func confirmTapped() {
+        let confirm = onConfirm
+        window.close()
+        confirm?()
+    }
+
+    @objc private func closeTapped() {
+        window.close()
+    }
+
+    func windowWillClose(_ notification: Notification) {
+        webView.stopLoading()
+        Self.open[key] = nil
+        onClose?()
+    }
+
+    // MARK: WKNavigationDelegate
+
+    func webView(_ webView: WKWebView, didFinish navigation: WKNavigation!) {
+        status.stringValue = options.readyText
+    }
+
+    func webView(_ webView: WKWebView, didFail navigation: WKNavigation!, withError error: Error) {
+        status.stringValue = "页面加载失败，请关闭后重试"
+    }
+
+    func webView(_ webView: WKWebView, didFailProvisionalNavigation navigation: WKNavigation!, withError error: Error) {
+        status.stringValue = "页面加载失败，请关闭后重试"
+    }
+
+    // MARK: WKUIDelegate
+
+    /// `<input type="file">` for cover uploads.
+    func webView(_ webView: WKWebView, runOpenPanelWith parameters: WKOpenPanelParameters,
+                 initiatedByFrame frame: WKFrameInfo, completionHandler: @escaping ([URL]?) -> Void) {
+        let panel = NSOpenPanel()
+        panel.allowsMultipleSelection = parameters.allowsMultipleSelection
+        panel.canChooseDirectories = false
+        panel.allowedContentTypes = [.jpeg, .png]
+        panel.beginSheetModal(for: window) { response in
+            completionHandler(response == .OK ? panel.urls : nil)
+        }
+    }
+
+    /// The page's own close action (`window.close()` in web mode).
+    func webViewDidClose(_ webView: WKWebView) {
+        window.close()
+    }
+
+    /// Links that open a new window stay inside this window.
+    func webView(_ webView: WKWebView, createWebViewWith configuration: WKWebViewConfiguration,
+                 for navigationAction: WKNavigationAction, windowFeatures: WKWindowFeatures) -> WKWebView? {
+        if navigationAction.targetFrame == nil { webView.load(navigationAction.request) }
+        return nil
+    }
+
+    func webView(_ webView: WKWebView, runJavaScriptAlertPanelWithMessage message: String,
+                 initiatedByFrame frame: WKFrameInfo, completionHandler: @escaping () -> Void) {
+        let alert = NSAlert()
+        alert.messageText = message
+        alert.beginSheetModal(for: window) { _ in completionHandler() }
+    }
+
+    func webView(_ webView: WKWebView, runJavaScriptConfirmPanelWithMessage message: String,
+                 initiatedByFrame frame: WKFrameInfo, completionHandler: @escaping (Bool) -> Void) {
+        let alert = NSAlert()
+        alert.messageText = message
+        alert.addButton(withTitle: "确定")
+        alert.addButton(withTitle: "取消")
+        alert.beginSheetModal(for: window) { completionHandler($0 == .alertFirstButtonReturn) }
+    }
+}
+
+enum BilibiliPages {
+    static func faceAuth(voucher: String?) -> BilibiliPageWindow.Options {
+        var components = URLComponents(string: "https://live.bilibili.com/p/html/bilili-page-face-auth/index.html")!
+        components.queryItems = [
+            URLQueryItem(name: "is_live_webview", value: "1"),
+            URLQueryItem(name: "app_common", value: "open"),
+            URLQueryItem(name: "pc_ui", value: "500,428,17181a,2")
+        ]
+        if let voucher, !voucher.isEmpty {
+            components.queryItems?.append(URLQueryItem(name: "v_voucher", value: voucher))
+        }
+        return .init(title: "哔哩哔哩开播身份验证", url: components.url!, size: NSSize(width: 560, height: 640),
+                     loadingText: "正在载入哔哩哔哩官方验证页面…",
+                     readyText: "请按页面提示完成验证，然后点击「验证完成，重试开播」",
+                     confirmTitle: "验证完成，重试开播")
+    }
+
+    /// The Windows client's cover manager (upload, crop, history, review).
+    static let cover = BilibiliPageWindow.Options(
+        title: "直播间封面", url: URL(string: "https://live.bilibili.com/p/html/live-pc-blink/hime-live-cover/?pc_ui=680,566,0,1")!,
+        size: NSSize(width: 720, height: 660), loadingText: "正在载入哔哩哔哩封面管理…",
+        readyText: "封面修改后可能需要哔哩哔哩审核", confirmTitle: nil)
+}
+
+/// Opens the verification window for the ready account. When the user
+/// confirms, emits {"event":"faceAuthRetry"} so the dock retries Go live.
+@_cdecl("livehime_core_open_face_auth")
+public func livehime_core_open_face_auth(_ voucher: UnsafePointer<CChar>?) {
+    let voucherText = voucher.map { String(cString: $0) }
+    DispatchQueue.main.async {
+        MainActor.assumeIsolated {
+            guard let bridge = CoreBridge.shared, let credentials = bridge.coordinator.credentials else { return }
+            BilibiliPageWindow.present(key: "faceAuth", options: BilibiliPages.faceAuth(voucher: voucherText),
+                                       credentials: credentials,
+                                       onConfirm: { CoreBridge.shared?.emit(["event": "faceAuthRetry"]) })
+        }
+    }
+}
+
+/// Opens Bilibili's cover manager for the ready account. Emits
+/// {"event":"coverWindowClosed"} when it closes.
+@_cdecl("livehime_core_open_cover_page")
+public func livehime_core_open_cover_page() {
+    DispatchQueue.main.async {
+        MainActor.assumeIsolated {
+            guard let bridge = CoreBridge.shared, let credentials = bridge.coordinator.credentials else { return }
+            BilibiliPageWindow.present(key: "cover", options: BilibiliPages.cover, credentials: credentials,
+                                       onClose: { CoreBridge.shared?.emit(["event": "coverWindowClosed"]) })
+        }
+    }
+}
