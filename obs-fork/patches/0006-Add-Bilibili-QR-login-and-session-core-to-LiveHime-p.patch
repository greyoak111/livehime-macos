@@ -0,0 +1,47 @@
+#pragma once
+
+#include <QJsonObject>
+#include <QWidget>
+
+class QLabel;
+class QPushButton;
+class QStackedWidget;
+
+/* Bilibili account section of the LiveHime dock.
+ *
+ * Renders the Swift session core's state (see core/include/livehime-core.h):
+ * signed out -> QR code -> verifying -> ready, or failed with a retry. The
+ * panel never decides login state itself; it only shows what the core
+ * reports, so a transient error can never bounce the user back to login. */
+class AccountPanel : public QWidget {
+	Q_OBJECT
+
+public:
+	explicit AccountPanel(QWidget *parent = nullptr);
+	~AccountPanel() override;
+
+	/* Last reported state object; "state" is "ready" once a room is loaded. */
+	const QJsonObject &state() const { return state_; }
+
+signals:
+	void stateChanged(const QJsonObject &state);
+
+private:
+	static void onCoreState(const char *json, void *context);
+	void applyState(const QJsonObject &state);
+	QWidget *buildSignedOut();
+	QWidget *buildQRCode();
+	QWidget *buildVerifying();
+	QWidget *buildReady();
+	QWidget *buildFailed();
+
+	QJsonObject state_;
+	QStackedWidget *pages_;
+	QLabel *signedOutNotice_;
+	QLabel *qrImage_;
+	QLabel *qrHint_;
+	QLabel *accountName_;
+	QLabel *roomLine_;
+	QLabel *failedNotice_;
+	QLabel *failedDetail_;
+};
