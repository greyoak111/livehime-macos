diff --git a/plugins/livehime/src/account-panel.cpp b/plugins/livehime/src/account-panel.cpp
new file mode 100644
index 000000000..ac3cf68fa
--- /dev/null
+++ b/plugins/livehime/src/account-panel.cpp
@@ -0,0 +1,184 @@
+#include "account-panel.hpp"
+
+#include <livehime-core.h>
+#include <obs-module.h>
+
+#include <QByteArray>
+#include <cstdlib>
+#include <QHBoxLayout>
+#include <QJsonDocument>
+#include <QLabel>
+#include <QPixmap>
+#include <QPushButton>
+#include <QStackedWidget>
+#include <QVBoxLayout>
+
+namespace {
+QString text(const char *key)
+{
+	return QString::fromUtf8(obs_module_text(key));
+}
+
+QString noticeText(const QString &notice)
+{
+	if (notice.isEmpty())
+		return QString();
+	const QByteArray key = "LiveHime.Account.Notice." + notice.toUtf8();
+	return text(key.constData());
+}
+
+QLabel *wrapLabel(QWidget *parent, const QString &value = QString())
+{
+	auto *label = new QLabel(value, parent);
+	label->setWordWrap(true);
+	return label;
+}
+
+enum Page { SignedOut, QRCode, Verifying, Ready, Failed };
+} // namespace
+
+AccountPanel::AccountPanel(QWidget *parent) : QWidget(parent), pages_(new QStackedWidget(this))
+{
+	pages_->insertWidget(SignedOut, buildSignedOut());
+	pages_->insertWidget(QRCode, buildQRCode());
+	pages_->insertWidget(Verifying, buildVerifying());
+	pages_->insertWidget(Ready, buildReady());
+	pages_->insertWidget(Failed, buildFailed());
+	auto *layout = new QVBoxLayout(this);
+	layout->setContentsMargins(0, 0, 0, 0);
+	layout->addWidget(pages_);
+	pages_->setCurrentIndex(Verifying);
+
+	/* Development/testing override so automated runs never touch the real
+	 * login item. */
+	livehime_core_start(std::getenv("LIVEHIME_KEYCHAIN_SERVICE"), &AccountPanel::onCoreState, this);
+}
+
+AccountPanel::~AccountPanel()
+{
+	livehime_core_stop();
+}
+
+void AccountPanel::onCoreState(const char *json, void *context)
+{
+	/* Delivered on the main thread by the core. */
+	auto *self = static_cast<AccountPanel *>(context);
+	const QJsonDocument doc = QJsonDocument::fromJson(QByteArray(json));
+	if (doc.isObject())
+		self->applyState(doc.object());
+}
+
+void AccountPanel::applyState(const QJsonObject &state)
+{
+	state_ = state;
+	const QString name = state.value("state").toString();
+	blog(LOG_INFO, "[livehime] account state -> %s", name.toUtf8().constData());
+
+	if (name == "signedOut") {
+		signedOutNotice_->setText(noticeText(state.value("notice").toString()));
+		signedOutNotice_->setVisible(!signedOutNotice_->text().isEmpty());
+		pages_->setCurrentIndex(SignedOut);
+	} else if (name == "qrCode") {
+		QPixmap qr;
+		qr.loadFromData(QByteArray::fromBase64(state.value("qrPng").toString().toLatin1()), "PNG");
+		qrImage_->setPixmap(qr.scaled(200, 200, Qt::KeepAspectRatio, Qt::SmoothTransformation));
+		qrHint_->setText(text(state.value("scanned").toBool() ? "LiveHime.Account.QR.Scanned"
+								      : "LiveHime.Account.QR.Hint"));
+		pages_->setCurrentIndex(QRCode);
+	} else if (name == "verifying") {
+		pages_->setCurrentIndex(Verifying);
+	} else if (name == "ready") {
+		accountName_->setText(state.value("username").toString());
+		const qint64 shortId = state.value("shortRoomId").toVariant().toLongLong();
+		const qint64 roomId = state.value("roomId").toVariant().toLongLong();
+		roomLine_->setText(QStringLiteral("%1 %2 · %3")
+					   .arg(text("LiveHime.Account.Room"))
+					   .arg(shortId > 0 ? shortId : roomId)
+					   .arg(state.value("title").toString()));
+		pages_->setCurrentIndex(Ready);
+	} else if (name == "failed") {
+		failedNotice_->setText(noticeText(state.value("notice").toString()));
+		failedDetail_->setText(state.value("detail").toString());
+		pages_->setCurrentIndex(Failed);
+	}
+	emit stateChanged(state);
+}
+
+QWidget *AccountPanel::buildSignedOut()
+{
+	auto *page = new QWidget(this);
+	auto *layout = new QVBoxLayout(page);
+	signedOutNotice_ = wrapLabel(page);
+	signedOutNotice_->setStyleSheet(QStringLiteral("color: #e0a040;"));
+	auto *login = new QPushButton(text("LiveHime.Account.LoginQR"), page);
+	connect(login, &QPushButton::clicked, [] { livehime_core_start_qr_login(); });
+	layout->addWidget(wrapLabel(page, text("LiveHime.Account.SignedOut")));
+	layout->addWidget(signedOutNotice_);
+	layout->addWidget(login);
+	return page;
+}
+
+QWidget *AccountPanel::buildQRCode()
+{
+	auto *page = new QWidget(this);
+	auto *layout = new QVBoxLayout(page);
+	qrImage_ = new QLabel(page);
+	qrImage_->setAlignment(Qt::AlignCenter);
+	qrImage_->setMinimumSize(200, 200);
+	qrHint_ = wrapLabel(page);
+	qrHint_->setAlignment(Qt::AlignCenter);
+	auto *cancel = new QPushButton(text("LiveHime.Account.Cancel"), page);
+	connect(cancel, &QPushButton::clicked, [] { livehime_core_cancel_qr_login(); });
+	layout->addWidget(qrImage_);
+	layout->addWidget(qrHint_);
+	layout->addWidget(cancel);
+	return page;
+}
+
+QWidget *AccountPanel::buildVerifying()
+{
+	auto *page = new QWidget(this);
+	auto *layout = new QVBoxLayout(page);
+	layout->addWidget(wrapLabel(page, text("LiveHime.Account.Verifying")));
+	return page;
+}
+
+QWidget *AccountPanel::buildReady()
+{
+	auto *page = new QWidget(this);
+	auto *layout = new QVBoxLayout(page);
+	accountName_ = new QLabel(page);
+	accountName_->setStyleSheet(QStringLiteral("font-weight: 600; font-size: 14px;"));
+	roomLine_ = wrapLabel(page);
+	roomLine_->setStyleSheet(QStringLiteral("color: #9aa0ab;"));
+	auto *signOut = new QPushButton(text("LiveHime.Account.SignOut"), page);
+	connect(signOut, &QPushButton::clicked, [] { livehime_core_sign_out(); });
+	auto *row = new QHBoxLayout;
+	row->addWidget(accountName_, 1);
+	row->addWidget(signOut);
+	layout->addLayout(row);
+	layout->addWidget(roomLine_);
+	return page;
+}
+
+QWidget *AccountPanel::buildFailed()
+{
+	auto *page = new QWidget(this);
+	auto *layout = new QVBoxLayout(page);
+	failedNotice_ = wrapLabel(page);
+	failedNotice_->setStyleSheet(QStringLiteral("color: #e06c75;"));
+	failedDetail_ = wrapLabel(page);
+	failedDetail_->setStyleSheet(QStringLiteral("color: #9aa0ab; font-size: 11px;"));
+	failedDetail_->setTextInteractionFlags(Qt::TextSelectableByMouse);
+	auto *retry = new QPushButton(text("LiveHime.Account.Retry"), page);
+	connect(retry, &QPushButton::clicked, [] { livehime_core_retry(); });
+	auto *signOut = new QPushButton(text("LiveHime.Account.SignOut"), page);
+	connect(signOut, &QPushButton::clicked, [] { livehime_core_sign_out(); });
+	auto *row = new QHBoxLayout;
+	row->addWidget(retry);
+	row->addWidget(signOut);
+	layout->addWidget(failedNotice_);
+	layout->addWidget(failedDetail_);
+	layout->addLayout(row);
+	return page;
+}
