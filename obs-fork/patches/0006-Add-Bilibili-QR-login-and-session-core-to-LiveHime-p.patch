index 000000000..cb4f1dd8b
--- /dev/null
+++ b/build-aux/livehime/tests/e2e-account.mjs
@@ -0,0 +1,20 @@
+import { createHash } from 'node:crypto';
+const sha=(s)=>createHash('sha256').update(s).digest('base64'); const sleep=(ms)=>new Promise(r=>setTimeout(r,ms));
+const ws=new WebSocket('ws://127.0.0.1:4466'); let id=1; const pend=new Map(); let fails=0;
+const check=(n,ok,i='')=>{ if(!ok) fails++; console.log(`${ok?'PASS':'FAIL'}  ${n}${i?'  — '+i:''}`); };
+const req=(t,d={})=>new Promise(r=>{const k=String(id++);pend.set(k,r);ws.send(JSON.stringify({op:6,d:{requestType:t,requestId:k,requestData:d}}));});
+const vendor=async(t,d={})=>{const r=await req('CallVendorRequest',{vendorName:'livehime',requestType:t,requestData:d});return r.requestStatus.result?r.responseData.responseData:{error:r.requestStatus.comment};};
+const wait=async(want,ms)=>{const end=Date.now()+ms;let s;while(Date.now()<end){s=await vendor('GetAccountState');if(want.includes(s.state))return s;await sleep(250);}return s;};
+ws.onmessage=async(ev)=>{const m=JSON.parse(ev.data);
+ if(m.op===0){const {challenge,salt}=m.d.authentication;ws.send(JSON.stringify({op:1,d:{rpcVersion:1,authentication:sha(sha(process.argv[2]+salt)+challenge),eventSubscriptions:0}}));}
+ else if(m.op===7) pend.get(m.d.requestId)?.(m.d);
+ else if(m.op===2){
+  for(let i=0;i<40&&!(await req('GetVersion')).requestStatus.result;i++) await sleep(500);
+  const s0=await wait(['signedOut','failed','ready'],10000); check('restores to signedOut with empty test keychain', s0.state==='signedOut', JSON.stringify(s0));
+  await vendor('StartQRLogin');
+  const s1=await wait(['qrCode','failed'],10000); check('QR code generated from Bilibili', s1.state==='qrCode'&&s1.hasQr===true&&s1.scanned===false, JSON.stringify(s1));
+  await sleep(3500);
+  const s2=await vendor('GetAccountState'); check('still waiting for scan after polling', s2.state==='qrCode', s2.state);
+  await vendor('CancelQRLogin');
+  const s3=await wait(['signedOut'],5000); check('cancel returns to signedOut', s3.state==='signedOut');
+  console.log(fails? `${fails} failed`:'all passed'); process.exit(fails?1:0);}};
