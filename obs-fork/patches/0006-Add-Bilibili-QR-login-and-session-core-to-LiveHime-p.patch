+void getAccountState(obs_data_t *, obs_data_t *response, void *)
+{
+	if (!onUiThread([response] {
+		    QJsonObject state = target->account()->state();
+		    /* Report whether a QR image exists instead of the image itself. */
+		    state.insert("hasQr", state.contains("qrPng"));
+		    state.remove("qrPng");
+		    const QByteArray json = QJsonDocument(state).toJson(QJsonDocument::Compact);
+		    OBSDataAutoRelease data = obs_data_create_from_json(json.constData());
+		    obs_data_apply(response, data);
+	    }))
+		obs_data_set_string(response, "error", "dock unavailable");
+}
+
+void startQRLogin(obs_data_t *, obs_data_t *, void *)
+{
+	onUiThread([] { livehime_core_start_qr_login(); });
+}
+
+void cancelQRLogin(obs_data_t *, obs_data_t *, void *)
+{
+	onUiThread([] { livehime_core_cancel_qr_login(); });
+}
