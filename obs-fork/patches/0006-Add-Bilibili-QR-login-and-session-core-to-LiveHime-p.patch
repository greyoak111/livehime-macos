+final class CredentialParsingTests: XCTestCase {
+    func testPollSuccessReadsSetCookieHeaders() throws {
+        let url = URL(string: "https://passport.bilibili.com/x/passport-login/web/qrcode/poll")!
+        let response = HTTPURLResponse(url: url, statusCode: 200, httpVersion: nil, headerFields: [
+            "Set-Cookie": "SESSDATA=s1; Path=/; Domain=bilibili.com, bili_jct=c1; Path=/; Domain=bilibili.com, DedeUserID=7; Path=/; Domain=bilibili.com"
+        ])!
+        let creds = try QRLoginClient.credentials(from: ["refresh_token": "rt"], response: response)
+        XCTAssertEqual(creds.cookies, ["SESSDATA": "s1", "bili_jct": "c1", "DedeUserID": "7"])
+        XCTAssertEqual(creds.refreshToken, "rt")
+    }
+
+    func testPollSuccessFallsBackToCrossDomainURL() throws {
+        let url = URL(string: "https://passport.bilibili.com/x/passport-login/web/qrcode/poll")!
+        let response = HTTPURLResponse(url: url, statusCode: 200, httpVersion: nil, headerFields: [:])!
+        let creds = try QRLoginClient.credentials(from: [
+            "url": "https://passport.biligame.com/x/passport-login/web/crossDomain?DedeUserID=9&SESSDATA=s2&bili_jct=c2&gourl=x",
+            "refresh_token": "rt"
+        ], response: response)
+        XCTAssertEqual(creds.mid, 9)
+        XCTAssertNil(creds.cookies["gourl"], "only session cookies are kept")
+    }
+
+    func testIncompleteCookiesAreRejected() {
+        let url = URL(string: "https://passport.bilibili.com/")!
+        let response = HTTPURLResponse(url: url, statusCode: 200, httpVersion: nil, headerFields: ["Set-Cookie": "SESSDATA=s"])!
+        XCTAssertThrowsError(try QRLoginClient.credentials(from: [:], response: response)) {
+            XCTAssertEqual($0 as? QRLoginError, .incompleteCredentials)
+        }
+    }
+
+    func testStoredDataVersions() throws {
+        let creds = SessionCredentials(cookies: ["SESSDATA": "s", "bili_jct": "c", "DedeUserID": "1"], refreshToken: "r",
+                                       savedAt: Date(timeIntervalSince1970: 0))
+        let v2 = try JSONEncoder().encode(CredentialEnvelope(schemaVersion: 2, credentials: creds))
+        XCTAssertEqual(decodeStoredCredentials(v2), .current(creds))
+        XCTAssertEqual(decodeStoredCredentials(Data(#"{"type":"cookie","refreshToken":"SESS"}"#.utf8)),
+                       .legacy(refreshToken: nil, sessdata: "SESS"))
+        XCTAssertEqual(decodeStoredCredentials(Data(#"{"type":"qr","refreshToken":"RT","timestamp":"1"}"#.utf8)),
+                       .legacy(refreshToken: "RT", sessdata: nil))
+        XCTAssertEqual(decodeStoredCredentials(Data("garbage".utf8)), .none)
+    }
+}
