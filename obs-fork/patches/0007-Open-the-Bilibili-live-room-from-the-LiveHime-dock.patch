+@MainActor
+final class LiveRoomTests: XCTestCase {
+    private func readyCoordinator(_ api: StubAPI) async -> SessionCoordinator {
+        let store = MemoryCredentialStore(.current(SessionCredentials(cookies: completeCookies, refreshToken: "")))
+        let c = SessionCoordinator(api: api, store: store)
+        c.restore(); await c.waitForIdle()
+        return c
+    }
+
+    func testStartLiveReturnsEndpointAndRefreshesRoom() async throws {
+        let api = StubAPI()
+        let c = await readyCoordinator(api)
+        let endpoint = try await c.startLive(area: BilibiliLiveArea(areaID: 7, parentAreaID: 2, name: ""))
+        XCTAssertEqual(endpoint.address, "rtmp://live-push.example/live-bvc/")
+        XCTAssertEqual(api.startedAreas, [7])
+        guard case .ready(let account) = c.state else { return XCTFail("\(c.state)") }
+        XCTAssertEqual(account.room.liveStatus, 1)
+
+        try await c.stopLive()
+        guard case .ready(let after) = c.state else { return XCTFail("\(c.state)") }
+        XCTAssertEqual(after.room.liveStatus, 0)
+        XCTAssertEqual(api.stopCalls, 1)
+    }
+
+    func testFaceAuthErrorKeepsSessionReady() async {
+        let api = StubAPI()
+        api.startResult = .failure(BilibiliLiveError.faceAuthRequired(voucher: "v"))
+        let c = await readyCoordinator(api)
+        do {
+            _ = try await c.startLive(area: BilibiliLiveArea(areaID: 7, name: ""))
+            XCTFail("expected face auth")
+        } catch {
+            XCTAssertEqual(error as? BilibiliLiveError, .faceAuthRequired(voucher: "v"))
+            XCTAssertEqual(CoreBridge.errorFields(error)["kind"] as? String, "faceAuth")
+        }
+        guard case .ready = c.state else { return XCTFail("face auth must not sign out: \(c.state)") }
+    }
+
+    func testRejectedLoginDuringStartLiveSignsOut() async {
+        let api = StubAPI()
+        api.startResult = .failure(BilibiliLiveError.notLoggedIn)
+        let c = await readyCoordinator(api)
+        _ = try? await c.startLive(area: BilibiliLiveArea(areaID: 7, name: ""))
+        XCTAssertEqual(c.state, .signedOut(.sessionExpired))
+    }
+
+    func testStartLiveRequiresReadySession() async {
+        let c = SessionCoordinator(api: StubAPI(), store: MemoryCredentialStore())
+        do {
+            _ = try await c.startLive(area: BilibiliLiveArea(areaID: 7, name: ""))
+            XCTFail("expected notReady")
+        } catch {
+            XCTAssertEqual(error as? SessionCoordinator.LiveError, .notReady)
+        }
+    }
+}
