+    // MARK: Live room
+
+    public enum LiveError: Error, Equatable {
+        case notReady
+        case unknownArea
+    }
+
+    public func loadAreas() async throws -> [BilibiliLiveArea] {
+        let (saved, _) = try readyAccount()
+        return try await guarded { try await self.api.areas(cookieHeader: saved.cookieHeader) }
+    }
+
+    /// Opens the live room and returns the RTMP endpoint for OBS. The room
+    /// record is refreshed afterwards so the dock shows Bilibili's view.
+    public func startLive(area: BilibiliLiveArea) async throws -> BilibiliStreamConfig {
+        let (saved, account) = try readyAccount()
+        let endpoint = try await guarded {
+            try await self.api.startLive(roomID: account.room.roomID, area: area, cookieHeader: saved.cookieHeader)
+        }
+        await refreshRoom()
+        return endpoint
+    }
+
+    public func stopLive() async throws {
+        let (saved, account) = try readyAccount()
+        do {
+            try await guarded { try await self.api.stopLive(roomID: account.room.roomID, cookieHeader: saved.cookieHeader) }
+        } catch {
+            await refreshRoom()
+            throw error
+        }
+        await refreshRoom()
+    }
+
+    /// Re-reads the room so live status and area reflect Bilibili's state.
+    /// Failures leave the current account untouched.
+    public func refreshRoom() async {
+        guard let (saved, account) = try? readyAccount(),
+              let room = try? await api.roomInfo(roomID: account.room.roomID, cookieHeader: saved.cookieHeader),
+              case .ready(let current) = state, current.mid == account.mid else { return }
+        state = .ready(LiveAccount(mid: account.mid, username: account.username, room: room))
+    }
+
+    private func readyAccount() throws -> (SessionCredentials, LiveAccount) {
+        guard case .ready(let account) = state, let saved = credentials else { throw LiveError.notReady }
+        return (saved, account)
+    }
+
+    /// Runs a live-room request; a rejected login signs out like verify does.
+    private func guarded<T>(_ body: () async throws -> T) async throws -> T {
+        do {
+            return try await body()
+        } catch {
+            if Self.isSessionRejected(error) {
+                try? store.remove()
+                credentials = nil
+                state = .signedOut(.sessionExpired)
+            }
+            throw error
+        }
+    }
+
     /// Awaits the running action; used by tests.
     public func waitForIdle() async { await task?.value }
 
