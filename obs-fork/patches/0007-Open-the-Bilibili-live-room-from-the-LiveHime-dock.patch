 public func livehime_core_sign_out() { onMain { CoreBridge.shared?.coordinator.signOut() } }
+
+// MARK: Live room
+
+extension CoreBridge {
+    func emit(_ object: [String: Any]) {
+        guard let callback,
+              let data = try? JSONSerialization.data(withJSONObject: object, options: [.sortedKeys]) else { return }
+        String(decoding: data, as: UTF8.self).withCString { callback($0, context) }
+    }
+
+    /// Error payload for the dock; `kind` selects the localized message.
+    static func errorFields(_ error: Error) -> [String: Any] {
+        switch error {
+        case BilibiliLiveError.faceAuthRequired(let voucher):
+            var fields: [String: Any] = ["kind": "faceAuth"]
+            if let voucher { fields["voucher"] = voucher }
+            return fields
+        case BilibiliLiveError.notLoggedIn, BilibiliControlError.notLoggedIn:
+            return ["kind": "sessionExpired"]
+        case BilibiliLiveError.missingRoom:
+            return ["kind": "noLiveRoom"]
+        case BilibiliLiveError.api(let code, let message):
+            return ["kind": "api", "code": code, "message": message]
+        case BilibiliLiveError.http(let status, _):
+            return ["kind": "http", "code": status]
+        case SessionCoordinator.LiveError.notReady:
+            return ["kind": "notReady"]
+        default:
+            return ["kind": SessionCoordinator.notice(for: error) == .network ? "network" : "server",
+                    "message": "\(error)"]
+        }
+    }
+
+    static func areaFields(_ area: BilibiliLiveArea) -> [String: Any] {
+        ["id": area.areaID, "parentId": area.parentAreaID, "name": area.name, "parentName": area.parentName]
+    }
+}
+
+@_cdecl("livehime_core_load_areas")
+public func livehime_core_load_areas() {
+    onMain {
+        guard let bridge = CoreBridge.shared else { return }
+        Task { @MainActor in
+            do {
+                let areas = try await bridge.coordinator.loadAreas()
+                bridge.emit(["event": "areas", "areas": areas.map(CoreBridge.areaFields)])
+            } catch {
+                bridge.emit(["event": "areasFailed"].merging(CoreBridge.errorFields(error)) { $1 })
+            }
+        }
+    }
+}
+
+/// Opens the live room in `area_id` (a leaf area from the areas event).
+/// Emits "streamEndpoint" with server and key, or "liveError".
+@_cdecl("livehime_core_start_live")
+public func livehime_core_start_live(_ areaID: Int64, _ parentAreaID: Int64) {
+    onMain {
+        guard let bridge = CoreBridge.shared else { return }
+        let area = BilibiliLiveArea(areaID: areaID, parentAreaID: parentAreaID, name: "")
+        Task { @MainActor in
+            do {
+                let endpoint = try await bridge.coordinator.startLive(area: area)
+                bridge.emit(["event": "streamEndpoint", "server": endpoint.address, "key": endpoint.key])
+            } catch {
+                bridge.emit(["event": "liveError"].merging(CoreBridge.errorFields(error)) { $1 })
+            }
+        }
+    }
+}
+
+/// Closes the live room. Emits "liveStopped" with ok true/false.
+@_cdecl("livehime_core_stop_live")
+public func livehime_core_stop_live() {
+    onMain {
+        guard let bridge = CoreBridge.shared else { return }
+        Task { @MainActor in
+            do {
+                try await bridge.coordinator.stopLive()
+                bridge.emit(["event": "liveStopped", "ok": true])
+            } catch {
+                bridge.emit(["event": "liveStopped", "ok": false].merging(CoreBridge.errorFields(error)) { $1 })
+            }
+        }
+    }
+}
