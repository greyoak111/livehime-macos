+
+void AccountPanel::applyEvent(const QJsonObject &event)
+{
+	const QString name = event.value("event").toString();
+	blog(LOG_INFO, "[livehime] live event -> %s", name.toUtf8().constData());
+
+	if (name == "areas") {
+		area_->clear();
+		const int current = state_.value("areaId").toInt();
+		const QJsonArray areas = event.value("areas").toArray();
+		for (const QJsonValue value : areas) {
+			const QJsonObject item = value.toObject();
+			const QString label = QStringLiteral("%1 · %2").arg(item.value("parentName").toString(),
+									     item.value("name").toString());
+			area_->addItem(label, QVariantList{item.value("id").toVariant(), item.value("parentId").toVariant()});
+			if (item.value("id").toInt() == current)
+				area_->setCurrentIndex(area_->count() - 1);
+		}
+		areasLoaded_ = area_->count() > 0;
+	} else if (name == "areasFailed") {
+		area_->clear();
+		area_->addItem(text("LiveHime.Live.AreasFailed"));
+		setLiveStatus(errorText(event), true);
+	} else if (name == "streamEndpoint") {
+		requesting_ = false;
+		const QString server = event.value("server").toString();
+		const QString key = event.value("key").toString();
+		if (stream_->start(server, key))
+			setLiveStatus(text("LiveHime.Live.Connecting"));
+		else
+			setLiveStatus(stream_->lastError() + QStringLiteral("\n") + text("LiveHime.Live.RoomStillOpen"), true);
+	} else if (name == "liveError") {
+		requesting_ = false;
+		setLiveStatus(errorText(event), true);
+	} else if (name == "liveStopped") {
+		stopping_ = false;
+		if (event.value("ok").toBool())
+			setLiveStatus(text("LiveHime.Live.Ended"));
+		else
+			setLiveStatus(text("LiveHime.Live.StopFailed") + QStringLiteral("\n") + errorText(event), true);
+	}
+	updateLiveControls();
+}
+
+void AccountPanel::onGoLive()
+{
+	const QVariantList ids = area_->currentData().toList();
+	if (ids.size() != 2)
+		return;
+	requesting_ = true;
+	setLiveStatus(text("LiveHime.Live.Requesting"));
+	updateLiveControls();
+	livehime_core_start_live(ids[0].toLongLong(), ids[1].toLongLong());
+}
+
+void AccountPanel::onEndLive()
+{
+	stopping_ = true;
+	setLiveStatus(text("LiveHime.Live.Ending"));
+	updateLiveControls();
+	/* Stop OBS and close the room together; neither waits for the other so
+	 * a stuck output can never keep the room open, or the reverse. */
+	stream_->stop();
+	livehime_core_stop_live();
+}
+
+void AccountPanel::onStreamStateChanged(StreamController::State state)
+{
+	using State = StreamController::State;
+	const bool roomOpen = state_.value("liveStatus").toInt() == 1;
+	if (state == State::Live && stream_->ownsSession())
+		setLiveStatus(text("LiveHime.Live.OnAir"));
+	else if (state == State::Failed && roomOpen && !stopping_)
+		setLiveStatus(stream_->lastError() + QStringLiteral("\n") + text("LiveHime.Live.RoomStillOpen"), true);
+	updateLiveControls();
+}
+
+void AccountPanel::updateLiveControls()
+{
+	const bool ready = state_.value("state").toString() == "ready";
+	const bool roomOpen = ready && state_.value("liveStatus").toInt() == 1;
+	const bool busy = streamBusy(stream_->state());
+	const bool canStart = ready && areasLoaded_ && !requesting_ && !stopping_ && !busy;
+
+	area_->setEnabled(canStart);
+	goLive_->setEnabled(canStart);
+	endLive_->setEnabled(ready && !stopping_ && (roomOpen || busy));
+	/* Never leave a room running unattended: log out only when offline. */
+	signOut_->setEnabled(!roomOpen && !busy && !requesting_ && !stopping_);
+	signOut_->setToolTip(signOut_->isEnabled() ? QString() : text("LiveHime.Live.EndBeforeSignOut"));
+}
+
+void AccountPanel::setLiveStatus(const QString &message, bool warning)
+{
+	liveStatus_->setText(message);
+	liveStatus_->setStyleSheet(warning ? QStringLiteral("color: #e06c75;") : QStringLiteral("color: #9aa0ab;"));
 }
 
