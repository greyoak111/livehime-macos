+/* Localized text for a core error payload ({"kind", "code", "message"}). */
+QString errorText(const QJsonObject &error)
+{
+	const QString kind = error.value("kind").toString();
+	QString message = keyedText("LiveHime.Live.Error.", kind);
+	if (kind == "api" || kind == "http") {
+		message = message.arg(error.value("code").toInt());
+		const QString detail = error.value("message").toString();
+		if (!detail.isEmpty())
+			message += QStringLiteral("\n") + detail;
+	}
+	return message.isEmpty() ? text("LiveHime.Live.Error.server") : message;
+}
