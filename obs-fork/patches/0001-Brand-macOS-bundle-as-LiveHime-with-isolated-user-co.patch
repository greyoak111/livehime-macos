+/* LiveHime: builds that set OBS_USER_CONFIG_SUBDIR keep all per-user state in
+ * their own directory so they never share scenes, profiles or plugin settings
+ * with a separately installed OBS Studio. System-wide paths are unchanged. */
+static NSString *user_config_root(NSString *application_support, NSSearchPathDomainMask domainMask)
+{
+#ifdef OBS_USER_CONFIG_SUBDIR
+    if (domainMask == NSUserDomainMask && OBS_USER_CONFIG_SUBDIR[0] != '\0')
+        return [application_support stringByAppendingPathComponent:@OBS_USER_CONFIG_SUBDIR];
+#else
+    (void) domainMask;
+#endif
+    return application_support;
+}
