From edb9c46491aa3f454a35298558d49b4d36dc2a5e Mon Sep 17 00:00:00 2001
From: greyoak111 <151205158+greyoak111@users.noreply.github.com>
Date: Wed, 23 Sep 2026 22:28:00 +0800
Subject: [PATCH 01/43] Brand macOS bundle as LiveHime with isolated user
 config

Add cache options for the app bundle identifier, name and display name
(defaults keep upstream values) and OBS_USER_CONFIG_SUBDIR, which moves
the per-user Application Support root so a LiveHime build never shares
scenes, profiles or plugin settings with an installed OBS Studio.
Replace the app icon with the LiveHime mark on the macOS icon grid.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 cmake/macos/defaults.cmake                    |   7 +++++++
 cmake/macos/helpers.cmake                     |  14 +++++++-------
 .../AppIcon.appiconset/icon_128x128.png       | Bin 51391 -> 16918 bytes
 .../AppIcon.appiconset/icon_128x128@2x.png    | Bin 163961 -> 55762 bytes
 .../AppIcon.appiconset/icon_16x16.png         | Bin 4257 -> 1328 bytes
 .../AppIcon.appiconset/icon_16x16@2x.png      | Bin 7456 -> 2365 bytes
 .../AppIcon.appiconset/icon_256x256.png       | Bin 163961 -> 55762 bytes
 .../AppIcon.appiconset/icon_256x256@2x.png    | Bin 555491 -> 169533 bytes
 .../AppIcon.appiconset/icon_32x32.png         | Bin 7456 -> 2365 bytes
 .../AppIcon.appiconset/icon_32x32@2x.png      | Bin 17609 -> 5684 bytes
 .../AppIcon.appiconset/icon_512x512.png       | Bin 555491 -> 169533 bytes
 .../AppIcon.appiconset/icon_512x512@2x.png    | Bin 1738448 -> 410323 bytes
 libobs/cmake/os-macos.cmake                   |   4 ++++
 libobs/util/platform-cocoa.m                  |  18 ++++++++++++++++--
 14 files changed, 34 insertions(+), 9 deletions(-)

diff --git a/cmake/macos/defaults.cmake b/cmake/macos/defaults.cmake
index 7c6daf437..b4466c6b1 100644
--- a/cmake/macos/defaults.cmake
+++ b/cmake/macos/defaults.cmake
@@ -14,6 +14,13 @@ endif()
 
 include(xcode)
 
+# LiveHime: application identity and per-user configuration root. The defaults
+# keep upstream OBS behavior; the LiveHime build overrides them at configure time.
+set(LIVEHIME_APP_BUNDLE_ID "com.obsproject.obs-studio" CACHE STRING "Application bundle identifier")
+set(LIVEHIME_APP_NAME "OBS" CACHE STRING "Application bundle and executable name")
+set(LIVEHIME_APP_DISPLAY_NAME "OBS Studio" CACHE STRING "Application display name")
+set(OBS_USER_CONFIG_SUBDIR "" CACHE STRING "Subdirectory of ~/Library/Application Support used as the user config root")
+
 include(buildspec)
 
 # SWIG hard codes the directory to its library directory at compile time. As obs-deps need to be relocatable, we need to
diff --git a/cmake/macos/helpers.cmake b/cmake/macos/helpers.cmake
index 8913b2b24..4fa4eb97a 100644
--- a/cmake/macos/helpers.cmake
+++ b/cmake/macos/helpers.cmake
@@ -43,7 +43,7 @@ function(set_target_properties_obs target)
       set_target_properties(
         ${target}
         PROPERTIES
-          OUTPUT_NAME OBS
+          OUTPUT_NAME "${LIVEHIME_APP_NAME}"
           MACOSX_BUNDLE TRUE
           MACOSX_BUNDLE_INFO_PLIST "${CMAKE_CURRENT_SOURCE_DIR}/cmake/macos/Info.plist.in"
           XCODE_EMBED_FRAMEWORKS_REMOVE_HEADERS_ON_COPY YES
@@ -54,8 +54,8 @@ function(set_target_properties_obs target)
 
       set_target_xcode_properties(
         ${target}
-        PROPERTIES PRODUCT_BUNDLE_IDENTIFIER com.obsproject.obs-studio
-                   PRODUCT_NAME OBS
+        PROPERTIES PRODUCT_BUNDLE_IDENTIFIER "${LIVEHIME_APP_BUNDLE_ID}"
+                   PRODUCT_NAME "${LIVEHIME_APP_NAME}"
                    ASSETCATALOG_COMPILER_APPICON_NAME AppIcon
                    CURRENT_PROJECT_VERSION ${OBS_BUILD_NUMBER}
                    MARKETING_VERSION ${OBS_VERSION_CANONICAL}
@@ -64,11 +64,11 @@ function(set_target_properties_obs target)
                    CLANG_ENABLE_OBJC_ARC YES
                    SKIP_INSTALL NO
                    INSTALL_PATH "$(LOCAL_APPS_DIR)"
-                   INFOPLIST_KEY_CFBundleDisplayName "OBS Studio"
+                   INFOPLIST_KEY_CFBundleDisplayName "${LIVEHIME_APP_DISPLAY_NAME}"
                    INFOPLIST_KEY_NSHumanReadableCopyright "(c) 2012-${CURRENT_YEAR} Lain Bailey"
-                   INFOPLIST_KEY_NSCameraUsageDescription "OBS needs to access the camera to enable camera sources to work."
-                   INFOPLIST_KEY_NSMicrophoneUsageDescription "OBS needs to access the microphone to enable audio input."
-                   INFOPLIST_KEY_NSAppleEventsUsageDescription "OBS needs to access background events to enable hotkeys while not in focus."
+                   INFOPLIST_KEY_NSCameraUsageDescription "${LIVEHIME_APP_DISPLAY_NAME} needs to access the camera to enable camera sources to work."
+                   INFOPLIST_KEY_NSMicrophoneUsageDescription "${LIVEHIME_APP_DISPLAY_NAME} needs to access the microphone to enable audio input."
+                   INFOPLIST_KEY_NSAppleEventsUsageDescription "${LIVEHIME_APP_DISPLAY_NAME} needs to access background events to enable hotkeys while not in focus."
       )
 
       get_property(obs_dependencies GLOBAL PROPERTY _OBS_DEPENDENCIES)
