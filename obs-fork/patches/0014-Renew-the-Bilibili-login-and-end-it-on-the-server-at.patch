+@MainActor
+final class SessionMaintenanceTests: XCTestCase {
+    private func ready(_ api: StubAPI, _ store: MemoryCredentialStore) async -> (SessionCoordinator, () -> [String]) {
+        let c = SessionCoordinator(api: api, store: store, maintenanceInterval: .seconds(3600))
+        var results: [String] = []
+        c.onMaintenance = { results.append($0) }
+        c.restore(); await c.waitForIdle()
+        return (c, { results })
+    }
+
+    func testRenewedLoginIsSavedThenOldTokenRetired() async throws {
+        let api = StubAPI()
+        let renewed = SessionCredentials(cookies: ["SESSDATA": "new", "bili_jct": "c2", "DedeUserID": "42"], refreshToken: "rt2")
+        api.refreshResult = .success(renewed)
+        let store = MemoryCredentialStore(.current(SessionCredentials(cookies: completeCookies, refreshToken: "rt1")))
+        let (c, results) = await ready(api, store)
+        await c.maintainSession() // races the automatic check; only one may renew
+        for _ in 0..<100 where results().isEmpty { try await Task.sleep(for: .milliseconds(10)) }
+        XCTAssertEqual(try store.load(), .current(renewed))
+        XCTAssertEqual(c.credentials, renewed)
+        XCTAssertEqual(api.confirmed, ["rt1"])
+        XCTAssertEqual(results().last, "refreshed")
+    }
+
+    func testFailureKeepsCurrentLogin() async throws {
+        let api = StubAPI()
+        api.refreshResult = .failure(SessionRefreshError.step("refreshCSRF"))
+        let original = SessionCredentials(cookies: completeCookies, refreshToken: "rt1")
+        let store = MemoryCredentialStore(.current(original))
+        let (c, results) = await ready(api, store)
+        await c.maintainSession()
+        for _ in 0..<100 where results().isEmpty { try await Task.sleep(for: .milliseconds(10)) }
+        XCTAssertEqual(try store.load(), .current(original))
+        XCTAssertEqual(results().last, "failed:refreshCSRF")
+        guard case .ready = c.state else { return XCTFail("\(c.state)") }
+    }
+
+    func testSkippedWhileLive() async {
+        let api = StubAPI()
+        api.roomResult = .success(BilibiliRoomInfo(roomID: 1001, uid: 42, title: "t", liveStatus: 1, areaID: 7))
+        let store = MemoryCredentialStore(.current(SessionCredentials(cookies: completeCookies, refreshToken: "rt1")))
+        let (c, results) = await ready(api, store)
+        let before = api.refreshCalls
+        await c.maintainSession()
+        XCTAssertEqual(api.refreshCalls, before)
+        XCTAssertEqual(results().last, "skippedWhileLive")
+    }
+
+    func testSignOutEndsServerLogin() async throws {
+        let api = StubAPI()
+        let store = MemoryCredentialStore(.current(SessionCredentials(cookies: completeCookies, refreshToken: "rt1")))
+        let (c, _) = await ready(api, store)
+        c.signOut()
+        for _ in 0..<50 where api.loggedOut.isEmpty { try await Task.sleep(for: .milliseconds(10)) }
+        XCTAssertEqual(api.loggedOut.first?.csrf, "csrf")
+    }
+
+    func testCorrespondPathAndCSRFParsing() {
+        let path = SessionMaintenance.correspondPath(timestampMs: 1_700_000_000_000)
+        XCTAssertEqual(path?.count, 256, "1024-bit RSA ciphertext as hex")
+        XCTAssertNotEqual(path, SessionMaintenance.correspondPath(timestampMs: 1_700_000_000_000), "OAEP is randomized")
+        XCTAssertEqual(SessionMaintenance.refreshCSRF(fromHTML: #"<html><div id="1-name">abc123</div></html>"#), "abc123")
+        XCTAssertNil(SessionMaintenance.refreshCSRF(fromHTML: "<html></html>"))
+    }
+}
