--- /dev/null
+++ b/plugins/livehime/core/Sources/LiveHimeCore/SessionMaintenance.swift
@@ -0,0 +1,154 @@
+import Foundation
+import Security
+
+/// Keeps a web login alive and ends it on the server.
+///
+/// Renewal follows Bilibili's web flow: `cookie/info` says whether a refresh
+/// is due; `refresh_<timestamp ms>` is encrypted with RSA-OAEP (SHA-256)
+/// under the public key the main site ships in `wasm_rsa_encrypt_bg.wasm`;
+/// the `correspond/1/<hex>` page reveals `refresh_csrf`; `cookie/refresh`
+/// issues new cookies and a new refresh token; `confirm/refresh` retires
+/// the old token. The caller saves the new login before confirming, and any
+/// failure leaves the current login untouched.
+public enum SessionRefreshError: Error, Equatable {
+    case missingCSRF
+    case step(String)      // which step failed; never carries secrets
+}
+
+struct SessionMaintenance: Sendable {
+    /// Modulus of the RSA public key embedded in the main site's
+    /// wasm_rsa_encrypt_bg.wasm (exponent 65537).
+    static let modulusHex = "cb81dd8e02470656da04dd38544446e2a3412051cfe9adc6a330a5ef90228509684960970b91c3360ca29c49e1690ff8fa068cb9dfc6179d1e9585cb9424e847db1ef59f33e37dd4dca8ccfb7631ee9b4a92640d00c8204300152a0ab7cd802889d3445aec69918fe6022b534912e7b095be3424dad1ba81145e969b533181f1"
+
+    let session: URLSession
+
+    init(session: URLSession = BilibiliWeb.session) {
+        self.session = session
+    }
+
+    // MARK: RSA
+
+    /// PKCS#1 RSAPublicKey DER: SEQUENCE { INTEGER n, INTEGER 65537 }.
+    static func publicKey() -> SecKey? {
+        var modulus = [UInt8]()
+        var index = modulusHex.startIndex
+        while index < modulusHex.endIndex {
+            let next = modulusHex.index(index, offsetBy: 2)
+            modulus.append(UInt8(modulusHex[index..<next], radix: 16)!)
+            index = next
+        }
+        let n: [UInt8] = [0x02, 0x81, UInt8(modulus.count + 1), 0x00] + modulus
+        let e: [UInt8] = [0x02, 0x03, 0x01, 0x00, 0x01]
+        let body = n + e
+        let der = Data([0x30, 0x81, UInt8(body.count)] + body)
+        let attributes: [String: Any] = [kSecAttrKeyType as String: kSecAttrKeyTypeRSA,
+                                         kSecAttrKeyClass as String: kSecAttrKeyClassPublic]
+        return SecKeyCreateWithData(der as CFData, attributes as CFDictionary, nil)
+    }
+
+    static func correspondPath(timestampMs: Int64) -> String? {
+        guard let key = publicKey(),
+              let encrypted = SecKeyCreateEncryptedData(key, .rsaEncryptionOAEPSHA256,
+                                                        Data("refresh_\(timestampMs)".utf8) as CFData, nil) as Data? else {
+            return nil
+        }
+        return encrypted.map { String(format: "%02x", $0) }.joined()
+    }
+
+    static func refreshCSRF(fromHTML html: String) -> String? {
+        guard let range = html.range(of: #"<div id="1-name">([^<]+)</div>"#, options: .regularExpression) else { return nil }
+        let match = String(html[range])
+        return match.replacingOccurrences(of: #"<div id="1-name">"#, with: "").replacingOccurrences(of: "</div>", with: "")
+            .trimmingCharacters(in: .whitespacesAndNewlines)
+    }
+
+    // MARK: Flow
+
+    /// Returns renewed credentials, or nil when Bilibili says no refresh is due.
+    func refreshIfNeeded(_ current: SessionCredentials) async throws -> SessionCredentials? {
+        guard let csrf = current.csrf else { throw SessionRefreshError.missingCSRF }
+        var info = URLComponents(string: "https://passport.bilibili.com/x/passport-login/web/cookie/info")!
+        info.queryItems = [URLQueryItem(name: "csrf", value: csrf)]
+        let (infoRoot, _) = try await send(info.url!, cookies: current.cookieHeader, step: "cookieInfo")
+        let data = infoRoot["data"] as? [String: Any] ?? [:]
+        guard (data["refresh"] as? Bool) == true else { return nil }
+        let timestamp = (data["timestamp"] as? NSNumber)?.int64Value ?? Int64(Date().timeIntervalSince1970 * 1000)
+        guard !current.refreshToken.isEmpty else { throw SessionRefreshError.step("noRefreshToken") }
+
+        guard let path = Self.correspondPath(timestampMs: timestamp) else { throw SessionRefreshError.step("encrypt") }
+        let html = try await page(URL(string: "https://www.bilibili.com/correspond/1/\(path)")!, cookies: current.cookieHeader)
+        guard let refreshCSRF = Self.refreshCSRF(fromHTML: html) else { throw SessionRefreshError.step("refreshCSRF") }
+
+        let (refreshRoot, response) = try await send(
+            URL(string: "https://passport.bilibili.com/x/passport-login/web/cookie/refresh")!,
+            cookies: current.cookieHeader,
+            form: [("csrf", csrf), ("refresh_csrf", refreshCSRF), ("source", "main_web"),
+                   ("refresh_token", current.refreshToken)],
+            step: "cookieRefresh")
+        var cookies = current.cookies
+        if let url = response.url, let fields = response.allHeaderFields as? [String: String] {
+            for cookie in HTTPCookie.cookies(withResponseHeaderFields: fields, for: url) { cookies[cookie.name] = cookie.value }
+        }
+        let newToken = (refreshRoot["data"] as? [String: Any])?["refresh_token"] as? String ?? ""
+        let renewed = SessionCredentials(cookies: cookies, refreshToken: newToken)
+        guard renewed.isComplete, !newToken.isEmpty, renewed.cookies["SESSDATA"] != current.cookies["SESSDATA"] else {
+            throw SessionRefreshError.step("cookieRefreshResult")
+        }
+        return renewed
+    }
+
+    /// Retires the previous refresh token once the renewed login is saved.
+    func confirm(renewed: SessionCredentials, previousRefreshToken: String) async throws {
+        guard let csrf = renewed.csrf else { throw SessionRefreshError.missingCSRF }
+        _ = try await send(URL(string: "https://passport.bilibili.com/x/passport-login/web/confirm/refresh")!,
+                           cookies: renewed.cookieHeader,
+                           form: [("csrf", csrf), ("refresh_token", previousRefreshToken)], step: "confirmRefresh")
+    }
+
+    /// Ends the login on Bilibili's side (the same request the web header's
+    /// "log out" makes).
+    func logout(_ current: SessionCredentials) async throws {
+        guard let csrf = current.csrf else { throw SessionRefreshError.missingCSRF }
+        _ = try await send(URL(string: "https://passport.bilibili.com/login/exit/v2")!, cookies: current.cookieHeader,
+                           form: [("biliCSRF", csrf)], step: "logout")
+    }
+
+    // MARK: HTTP
+
+    private func request(_ url: URL, cookies: String) -> URLRequest {
+        var request = URLRequest(url: url)
+        request.timeoutInterval = 12
+        request.setValue(cookies, forHTTPHeaderField: "Cookie")
+        request.setValue(BilibiliWeb.userAgent, forHTTPHeaderField: "User-Agent")
+        request.setValue("https://www.bilibili.com/", forHTTPHeaderField: "Referer")
+        return request
+    }
+
+    private func send(_ url: URL, cookies: String, form: [(String, String)]? = nil,
+                      step: String) async throws -> ([String: Any], HTTPURLResponse) {
+        var request = request(url, cookies: cookies)
+        if let form {
+            let allowed = CharacterSet.urlQueryAllowed.subtracting(CharacterSet(charactersIn: "+&="))
+            request.httpMethod = "POST"
+            request.setValue("application/x-www-form-urlencoded", forHTTPHeaderField: "Content-Type")
+            request.httpBody = Data(form.map {
+                "\($0.0)=\($0.1.addingPercentEncoding(withAllowedCharacters: allowed) ?? "")"
+            }.joined(separator: "&").utf8)
+        }
+        guard let (data, response) = try? await session.data(for: request), let http = response as? HTTPURLResponse,
+              (200..<300).contains(http.statusCode),
+              let root = try? JSONSerialization.jsonObject(with: data) as? [String: Any],
+              (root["code"] as? NSNumber)?.intValue == 0 else {
+            throw SessionRefreshError.step(step)
+        }
+        return (root, http)
+    }
+
+    private func page(_ url: URL, cookies: String) async throws -> String {
+        guard let (data, response) = try? await session.data(for: request(url, cookies: cookies)),
+              let http = response as? HTTPURLResponse, (200..<300).contains(http.statusCode) else {
+            throw SessionRefreshError.step("correspond")
+        }
+        return String(decoding: data, as: UTF8.self)
+    }
+}
