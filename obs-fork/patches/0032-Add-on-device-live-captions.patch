--- /dev/null
+++ b/plugins/livehime/core/Sources/LiveHimeCore/LiveCaptions.swift
@@ -0,0 +1,280 @@
+import AVFoundation
+import Foundation
+import Speech
+
+/// Caption text as shown to viewers: the recognizer's spacing around
+/// Chinese text removed and known mis-hearings fixed.
+public enum CaptionText {
+    /// Words the recognizer cannot tell from a homophone, as a streamer on
+    /// Bilibili means them.
+    public static let replacements: [(String, String)] = [("直播机", "直播姬"), ("b站", "B站"), ("哔哩哔哩直播机", "哔哩哔哩直播姬")]
+
+    public static func clean(_ raw: String) -> String {
+        var text = raw.trimmingCharacters(in: .whitespacesAndNewlines)
+        // "晚上好 ，欢迎" -> "晚上好，欢迎"; keep spaces between Latin words.
+        let cjk = "\\p{Han}，。！？、；：“”‘’（）《》…"
+        text = text.replacingOccurrences(of: "\\s+(?=[\(cjk)])", with: "", options: .regularExpression)
+        text = text.replacingOccurrences(of: "(?<=[\(cjk)])\\s+", with: "", options: .regularExpression)
+        for (heard, meant) in replacements {
+            text = text.replacingOccurrences(of: heard, with: meant)
+        }
+        // A result that is only punctuation carries nothing to show.
+        if text.unicodeScalars.allSatisfy({ CharacterSet.punctuationCharacters.contains($0) || CharacterSet.whitespaces.contains($0) }) {
+            return ""
+        }
+        return text
+    }
+}
+
+/// On-device live captions with Apple's SpeechAnalyzer (macOS 26+).
+/// Audio arrives from one thread at a time as mono float samples; results
+/// are the in-progress text of the current sentence and finished sentences.
+@available(macOS 26, *)
+final class LiveCaptioner: @unchecked Sendable {
+    enum Event: Sendable {
+        case preparing          // downloading / loading the language model
+        case listening
+        case partial(String)    // in-progress text, replaced by later updates
+        case final(String)      // a finished sentence
+        case failed(String)
+    }
+
+    /// Terms a Bilibili streamer says often; they bias recognition.
+    static let vocabulary = ["直播姬", "哔哩哔哩", "B站", "弹幕", "上舰", "舰长", "提督", "总督", "醒目留言",
+                             "一键三连", "UP主", "粉丝牌", "开播", "下播", "直播间", "打赏"]
+
+    private let locale: Locale
+    private let onEvent: @Sendable (Event) -> Void
+    private let lock = NSLock()
+    private var continuation: AsyncStream<AnalyzerInput>.Continuation?
+    private var analyzerFormat: AVAudioFormat?
+    private var converter: AVAudioConverter?
+    private var converterInputRate: Double = 0
+    private var analyzer: SpeechAnalyzer?
+    private var resultsTask: Task<Void, Never>?
+    private var stopped = false
+    /// When audio stops arriving (a media file ends, a device drops out),
+    /// the last sentence would never finish; feed silence instead.
+    private var lastPush = Date.distantFuture
+    private var lastRate: Double = 48000
+    private var silenceTimer: DispatchSourceTimer?
+
+    init(localeIdentifier: String, onEvent: @escaping @Sendable (Event) -> Void) {
+        locale = Locale(identifier: localeIdentifier)
+        self.onEvent = onEvent
+    }
+
+    func start() async {
+        do {
+            guard let supported = await SpeechTranscriber.supportedLocale(equivalentTo: locale) else {
+                onEvent(.failed("unsupportedLocale"))
+                return
+            }
+            let transcriber = SpeechTranscriber(locale: supported, transcriptionOptions: [],
+                                                reportingOptions: [.volatileResults, .fastResults], attributeOptions: [])
+            if let request = try await AssetInventory.assetInstallationRequest(supporting: [transcriber]) {
+                onEvent(.preparing)
+                try await request.downloadAndInstall()
+            }
+            guard let format = await SpeechAnalyzer.bestAvailableAudioFormat(compatibleWith: [transcriber]) else {
+                onEvent(.failed("noAudioFormat"))
+                return
+            }
+            let (stream, continuation) = AsyncStream<AnalyzerInput>.makeStream(bufferingPolicy: .bufferingNewest(500))
+            let analyzer = SpeechAnalyzer(modules: [transcriber])
+            let context = AnalysisContext()
+            context.contextualStrings[.general] = Self.vocabulary
+            try await analyzer.setContext(context)
+            try await analyzer.prepareToAnalyze(in: format)
+            let cancelled = lock.withLock { () -> Bool in
+                guard !stopped else { return true }
+                self.analyzerFormat = format
+                self.continuation = continuation
+                self.analyzer = analyzer
+                return false
+            }
+            if cancelled {
+                continuation.finish()
+                return
+            }
+            let onEvent = self.onEvent
+            resultsTask = Task {
+                do {
+                    for try await result in transcriber.results {
+                        let text = CaptionText.clean(String(result.text.characters))
+                        guard !text.isEmpty else { continue }
+                        onEvent(result.isFinal ? .final(text) : .partial(text))
+                    }
+                } catch is CancellationError {
+                } catch {
+                    onEvent(.failed(error.localizedDescription))
+                }
+            }
+            try await analyzer.start(inputSequence: stream)
+            startSilenceWatch()
+            onEvent(.listening)
+        } catch {
+            onEvent(.failed(error.localizedDescription))
+        }
+    }
+
+    private func startSilenceWatch() {
+        let timer = DispatchSource.makeTimerSource(queue: .global(qos: .userInitiated))
+        timer.schedule(deadline: .now() + 0.1, repeating: 0.1)
+        timer.setEventHandler { [weak self] in
+            guard let self else { return }
+            let (idle, rate) = self.lock.withLock { (Date().timeIntervalSince(self.lastPush), self.lastRate) }
+            guard idle > 0.6 else { return }
+            let count = Int(rate / 10)
+            let zeros = [Float](repeating: 0, count: count)
+            zeros.withUnsafeBufferPointer { self.feed($0.baseAddress!, count: count, sampleRate: rate, silence: true) }
+        }
+        lock.withLock { silenceTimer = timer }
+        timer.resume()
+    }
+
+    /// Mono float samples at `sampleRate`, dropped until the analyzer is
+    /// ready. Called from the audio thread.
+    func push(_ samples: UnsafePointer<Float>, count: Int, sampleRate: Double) {
+        feed(samples, count: count, sampleRate: sampleRate, silence: false)
+    }
+
+    private func feed(_ samples: UnsafePointer<Float>, count: Int, sampleRate: Double, silence: Bool) {
+        lock.lock()
+        defer { lock.unlock() }
+        if !silence {
+            lastPush = Date()
+            lastRate = sampleRate
+        }
+        guard count > 0, let continuation, let target = analyzerFormat,
+              let source = AVAudioFormat(commonFormat: .pcmFormatFloat32, sampleRate: sampleRate, channels: 1, interleaved: false),
+              let input = AVAudioPCMBuffer(pcmFormat: source, frameCapacity: AVAudioFrameCount(count)) else { return }
+        input.frameLength = AVAudioFrameCount(count)
+        input.floatChannelData![0].update(from: samples, count: count)
+        if converter == nil || converterInputRate != sampleRate {
+            converter = AVAudioConverter(from: source, to: target)
+            converterInputRate = sampleRate
+        }
+        guard let converter,
+              let output = AVAudioPCMBuffer(pcmFormat: target,
+                                            frameCapacity: AVAudioFrameCount(Double(count) * target.sampleRate / sampleRate) + 32)
+        else { return }
+        var supplied = false
+        var error: NSError?
+        converter.convert(to: output, error: &error) { _, status in
+            if supplied {
+                status.pointee = .noDataNow
+                return nil
+            }
+            supplied = true
+            status.pointee = .haveData
+            return input
+        }
+        if error == nil, output.frameLength > 0 {
+            continuation.yield(AnalyzerInput(buffer: output))
+        }
+    }
+
+    func stop() async {
+        let (continuation, analyzer) = lock.withLock { () -> (AsyncStream<AnalyzerInput>.Continuation?, SpeechAnalyzer?) in
+            stopped = true
+            silenceTimer?.cancel()
+            silenceTimer = nil
+            defer {
+                self.continuation = nil
+                self.analyzer = nil
+                self.analyzerFormat = nil
+                self.converter = nil
+            }
+            return (self.continuation, self.analyzer)
+        }
+        continuation?.finish()
+        try? await analyzer?.finalizeAndFinishThroughEndOfInput()
+        await resultsTask?.value
+        resultsTask = nil
+    }
+}
+
+/// The running captioner, shared between the main thread (start / stop)
+/// and the audio thread (push).
+final class CaptionSession: @unchecked Sendable {
+    static let shared = CaptionSession()
+    private let lock = NSLock()
+    private var captioner: AnyObject?
+    private var generation = 0
+
+    func start(locale: String) {
+        guard #available(macOS 26, *) else {
+            Self.emit(["event": "captions", "status": "unsupported"])
+            return
+        }
+        stop()
+        let id = lock.withLock { () -> Int in
+            generation += 1
+            return generation
+        }
+        let captioner = LiveCaptioner(localeIdentifier: locale) { [weak self] event in
+            guard let self, self.lock.withLock({ self.generation == id }) else { return }
+            switch event {
+            case .preparing: Self.emit(["event": "captions", "status": "preparing"])
+            case .listening: Self.emit(["event": "captions", "status": "listening"])
+            case .partial(let text): Self.emit(["event": "caption", "text": text, "final": false])
+            case .final(let text): Self.emit(["event": "caption", "text": text, "final": true])
+            case .failed(let message): Self.emit(["event": "captions", "status": "failed", "message": message])
+            }
+        }
+        lock.withLock { self.captioner = captioner }
+        Task { await captioner.start() }
+    }
+
+    func push(_ samples: UnsafePointer<Float>, count: Int, sampleRate: Double) {
+        guard #available(macOS 26, *) else { return }
+        let captioner = lock.withLock { self.captioner as? LiveCaptioner }
+        captioner?.push(samples, count: count, sampleRate: sampleRate)
+    }
+
+    func stop() {
+        guard #available(macOS 26, *) else { return }
+        let (captioner, id) = lock.withLock { () -> (LiveCaptioner?, Int) in
+            defer { self.captioner = nil }
+            generation += 1
+            return (self.captioner as? LiveCaptioner, generation)
+        }
+        guard let captioner else { return }
+        Task {
+            await captioner.stop()
+            // Unless a new session started meanwhile.
+            if lock.withLock({ generation == id }) { Self.emit(["event": "captions", "status": "stopped"]) }
+        }
+    }
+
+    private static func emit(_ object: [String: Any]) {
+        let payload = object as NSDictionary
+        DispatchQueue.main.async {
+            MainActor.assumeIsolated { CoreBridge.shared?.emit(payload as! [String: Any]) }
+        }
+    }
+}
+
+/// 1 when live captions can run here (macOS 26 or later).
+@_cdecl("livehime_core_captions_supported")
+public func livehime_core_captions_supported() -> Int32 {
+    if #available(macOS 26, *) { return SpeechTranscriber.isAvailable ? 1 : 0 }
+    return 0
+}
+
+@_cdecl("livehime_core_captions_start")
+public func livehime_core_captions_start(_ locale: UnsafePointer<CChar>?) {
+    CaptionSession.shared.start(locale: locale.map { String(cString: $0) } ?? "zh-CN")
+}
+
+@_cdecl("livehime_core_captions_push")
+public func livehime_core_captions_push(_ samples: UnsafePointer<Float>?, _ count: Int32, _ sampleRate: Double) {
+    guard let samples, count > 0 else { return }
+    CaptionSession.shared.push(samples, count: Int(count), sampleRate: sampleRate)
+}
+
+@_cdecl("livehime_core_captions_stop")
+public func livehime_core_captions_stop() {
+    CaptionSession.shared.stop()
+}
