diff --git a/plugins/livehime/src/caption-controller.cpp b/plugins/livehime/src/caption-controller.cpp
new file mode 100644
index 000000000..a00b9d94e
--- /dev/null
+++ b/plugins/livehime/src/caption-controller.cpp
@@ -0,0 +1,161 @@
+#include "caption-controller.hpp"
+#include "plugin-settings.hpp"
+
+#include <livehime-core.h>
+#include <obs-frontend-api.h>
+#include <obs-module.h>
+
+#include <QMetaObject>
+
+CaptionController::CaptionController(QObject *parent) : QObject(parent)
+{
+	signal_handler_connect(obs_get_signal_handler(), "source_remove", &CaptionController::sourceRemoved, this);
+	obs_frontend_add_event_callback(&CaptionController::frontendEvent, this);
+	load();
+}
+
+CaptionController::~CaptionController()
+{
+	obs_frontend_remove_event_callback(&CaptionController::frontendEvent, this);
+	signal_handler_disconnect(obs_get_signal_handler(), "source_remove", &CaptionController::sourceRemoved, this);
+	stop();
+}
+
+/* Sources exist only once the scene collection has loaded; a collection
+ * switch replaces them. */
+void CaptionController::frontendEvent(enum obs_frontend_event event, void *param)
+{
+	auto *self = static_cast<CaptionController *>(param);
+	switch (event) {
+	case OBS_FRONTEND_EVENT_FINISHED_LOADING:
+	case OBS_FRONTEND_EVENT_SCENE_COLLECTION_CHANGED:
+		self->stop();
+		if (self->enabled_)
+			self->start();
+		break;
+	case OBS_FRONTEND_EVENT_SCENE_COLLECTION_CHANGING:
+	case OBS_FRONTEND_EVENT_SCRIPTING_SHUTDOWN:
+		self->stop();
+		break;
+	default:
+		break;
+	}
+}
+
+bool CaptionController::supported()
+{
+	return livehime_core_captions_supported() != 0;
+}
+
+void CaptionController::configure(bool enabled, const QString &sourceUuid, const QString &locale)
+{
+	const bool restart = enabled != enabled_ || sourceUuid != sourceUuid_ || locale != locale_;
+	enabled_ = enabled;
+	sourceUuid_ = sourceUuid;
+	locale_ = locale.isEmpty() ? QStringLiteral("zh-CN") : locale;
+	save();
+	if (!restart)
+		return;
+	stop();
+	if (enabled_)
+		start();
+}
+
+void CaptionController::start()
+{
+	if (!supported()) {
+		livehime_core_captions_start(locale_.toUtf8().constData()); /* reports "unsupported" */
+		return;
+	}
+	OBSSourceAutoRelease source = obs_get_source_by_uuid(sourceUuid_.toUtf8().constData());
+	if (!source) {
+		blog(LOG_INFO, "[livehime] captions: audio source not found");
+		emit sourceLost();
+		return;
+	}
+	source_ = source.Get();
+	livehime_core_captions_start(locale_.toUtf8().constData());
+	obs_source_add_audio_capture_callback(source_, &CaptionController::audioCallback, this);
+	blog(LOG_INFO, "[livehime] captions: listening to '%s' (%s)", obs_source_get_name(source_),
+	     locale_.toUtf8().constData());
+}
+
+void CaptionController::stop()
+{
+	if (source_) {
+		obs_source_remove_audio_capture_callback(source_, &CaptionController::audioCallback, this);
+		source_ = nullptr;
+		livehime_core_captions_stop();
+		blog(LOG_INFO, "[livehime] captions: stopped");
+	}
+}
+
+void CaptionController::audioCallback(void *param, obs_source_t *, const struct audio_data *audio, bool muted)
+{
+	auto *self = static_cast<CaptionController *>(param);
+	const audio_t *output = obs_get_audio();
+	const size_t channels = audio_output_get_channels(output);
+	const double rate = audio_output_get_sample_rate(output);
+	const uint32_t frames = audio->frames;
+	if (!frames || !channels)
+		return;
+
+	std::lock_guard lock(self->mixMutex_);
+	self->mono_.assign(frames, 0.0f);
+	if (!muted) {
+		size_t used = 0;
+		for (size_t channel = 0; channel < channels && channel < MAX_AV_PLANES; channel++) {
+			const auto *plane = reinterpret_cast<const float *>(audio->data[channel]);
+			if (!plane)
+				continue;
+			for (uint32_t i = 0; i < frames; i++)
+				self->mono_[i] += plane[i];
+			used++;
+		}
+		if (used > 1) {
+			for (float &sample : self->mono_)
+				sample /= static_cast<float>(used);
+		}
+	}
+	livehime_core_captions_push(self->mono_.data(), static_cast<int>(frames), rate);
+}
+
+void CaptionController::sourceRemoved(void *param, calldata_t *data)
+{
+	auto *self = static_cast<CaptionController *>(param);
+	obs_source_t *removed = static_cast<obs_source_t *>(calldata_ptr(data, "source"));
+	const QString uuid = QString::fromUtf8(obs_source_get_uuid(removed));
+	QMetaObject::invokeMethod(
+		self,
+		[self, uuid] {
+			if (uuid != self->sourceUuid_ || !self->source_)
+				return;
+			self->stop();
+			emit self->sourceLost();
+		},
+		Qt::QueuedConnection);
+}
+
+void CaptionController::load()
+{
+	OBSDataAutoRelease settings = LoadPluginSettings();
+	OBSDataAutoRelease captions = obs_data_get_obj(settings, "captions");
+	if (!captions)
+		return;
+	enabled_ = obs_data_get_bool(captions, "enabled");
+	sourceUuid_ = QString::fromUtf8(obs_data_get_string(captions, "source_uuid"));
+	const QString locale = QString::fromUtf8(obs_data_get_string(captions, "locale"));
+	if (!locale.isEmpty())
+		locale_ = locale;
+}
+
+void CaptionController::save() const
+{
+	OBSDataAutoRelease captions = obs_data_create();
+	obs_data_set_bool(captions, "enabled", enabled_);
+	obs_data_set_string(captions, "source_uuid", sourceUuid_.toUtf8().constData());
+	obs_data_set_string(captions, "locale", locale_.toUtf8().constData());
+	OBSDataAutoRelease changes = obs_data_create();
+	obs_data_set_obj(changes, "captions", captions);
+	SavePluginSettings(changes);
+}
diff --git a/plugins/livehime/src/caption-controller.hpp b/plugins/livehime/src/caption-controller.hpp
new file mode 100644
index 000000000..45f622bae
--- /dev/null
+++ b/plugins/livehime/src/caption-controller.hpp
@@ -0,0 +1,51 @@
+#pragma once
+
+#include <obs-frontend-api.h>
+#include <obs.hpp>
+
+#include <QObject>
+#include <QString>
+
+#include <mutex>
+#include <vector>
+
+/* Feeds one OBS audio source (usually the microphone) to the core's live
+ * captioner. The source's audio is taken after its filters, mixed down to
+ * mono; while the source is muted, silence is sent so sentences still end.
+ * Settings live in features.json under "captions". */
+class CaptionController : public QObject {
+	Q_OBJECT
+
+public:
+	explicit CaptionController(QObject *parent = nullptr);
+	~CaptionController() override;
+
+	static bool supported();
+
+	bool enabled() const { return enabled_; }
+	QString sourceUuid() const { return sourceUuid_; }
+	QString locale() const { return locale_; }
+
+	/* Applies and saves; restarts recognition as needed. */
+	void configure(bool enabled, const QString &sourceUuid, const QString &locale);
+
+signals:
+	/* The selected source was removed from OBS; captions stopped. */
+	void sourceLost();
+
+private:
+	void start();
+	void stop();
+	void load();
+	void save() const;
+	static void audioCallback(void *param, obs_source_t *source, const struct audio_data *audio, bool muted);
+	static void sourceRemoved(void *param, calldata_t *data);
+	static void frontendEvent(enum obs_frontend_event event, void *param);
+
+	bool enabled_ = false;
+	QString sourceUuid_;
+	QString locale_ = QStringLiteral("zh-CN");
+	OBSSource source_;
+	std::mutex mixMutex_;
+	std::vector<float> mono_;
+};
diff --git a/plugins/livehime/src/caption-overlay.cpp b/plugins/livehime/src/caption-overlay.cpp
new file mode 100644
index 000000000..458ebaadd
--- /dev/null
+++ b/plugins/livehime/src/caption-overlay.cpp
@@ -0,0 +1,279 @@
+#include "caption-overlay.hpp"
+
+#include <obs-module.h>
+#include <obs.hpp>
+
+#include <QDateTime>
+
+#include <algorithm>
+#include <atomic>
+#include <cmath>
+
+namespace {
+constexpr int kDefaultLines = 2;
+constexpr int kDefaultLinger = 4;
+constexpr int kDefaultWidth = 1200;
+constexpr int kDefaultFontSize = 48;
+constexpr const char *kDefaultFace = "Hiragino Sans GB"; /* see danmaku-overlay.cpp */
+
+/* Rough width of a character in ems: CJK glyphs are square, Latin about half. */
+double charWidth(QChar c)
+{
+	return c.unicode() >= 0x2E80 ? 1.0 : 0.55;
+}
+} // namespace
+
+struct CaptionOverlay {
+	obs_source_t *label = nullptr; /* private text_ft2_source_v2 */
+	std::atomic<int> width{kDefaultWidth};
+	std::atomic<int> height{kDefaultLines * kDefaultFontSize * 4 / 3};
+
+	/* Touched on the UI thread only (hub). */
+	int maxLines = kDefaultLines;
+	int lingerSeconds = kDefaultLinger;
+	int fontSize = kDefaultFontSize;
+	QString shown;
+};
+
+CaptionOverlayHub *CaptionOverlayHub::instance_ = nullptr;
+
+CaptionOverlayHub::CaptionOverlayHub()
+{
+	timer_.setInterval(150);
+	connect(&timer_, &QTimer::timeout, this, &CaptionOverlayHub::refresh);
+	timer_.start();
+}
+
+void CaptionOverlayHub::create()
+{
+	if (!instance_)
+		instance_ = new CaptionOverlayHub();
+}
+
+void CaptionOverlayHub::destroy()
+{
+	delete instance_;
+	instance_ = nullptr;
+}
+
+void CaptionOverlayHub::add(CaptionOverlay *overlay)
+{
+	std::lock_guard lock(mutex_);
+	overlays_.insert(overlay);
+}
+
+void CaptionOverlayHub::remove(CaptionOverlay *overlay)
+{
+	std::lock_guard lock(mutex_);
+	overlays_.erase(overlay);
+}
+
+QString CaptionOverlayHub::shownText()
+{
+	std::lock_guard lock(mutex_);
+	return overlays_.empty() ? QString() : (*overlays_.begin())->shown;
+}
+
+void CaptionOverlayHub::push(const QJsonObject &event)
+{
+	const QString name = event.value("event").toString();
+	if (name == "captions") {
+		const QString status = event.value("status").toString();
+		if (status == "stopped" || status == "failed") {
+			finished_.clear();
+			partial_.clear();
+		}
+		return;
+	}
+	if (name != "caption")
+		return;
+	const QString text = event.value("text").toString();
+	if (event.value("final").toBool()) {
+		/* Keep only a little finished text: the box shows the tail. */
+		finished_ = (finished_ + text).right(200);
+		partial_.clear();
+	} else {
+		partial_ = text;
+	}
+	updatedMs_ = QDateTime::currentMSecsSinceEpoch();
+}
+
+void CaptionOverlayHub::refresh()
+{
+	const qint64 now = QDateTime::currentMSecsSinceEpoch();
+	std::lock_guard lock(mutex_);
+	for (CaptionOverlay *overlay : overlays_) {
+		QString text = finished_ + partial_;
+		if (overlay->lingerSeconds > 0 && now - updatedMs_ > overlay->lingerSeconds * 1000LL)
+			text.clear();
+
+		/* Keep the words that fit in maxLines rows, cutting from the front
+		 * (at punctuation when one is close), and pad from the top so the
+		 * text sits on the bottom row like a subtitle. */
+		const double perRow = std::max(4.0, overlay->width.load() / double(std::max(overlay->fontSize, 1)));
+		const double capacity = perRow * overlay->maxLines;
+		double used = 0;
+		int start = text.size();
+		while (start > 0 && used + charWidth(text[start - 1]) <= capacity) {
+			used += charWidth(text[start - 1]);
+			start--;
+		}
+		if (start > 0) {
+			for (int i = start; i < std::min<int>(text.size(), start + 8); i++) {
+				if (QStringLiteral("，。！？、；：,.!? ").contains(text[i])) {
+					start = i + 1;
+					break;
+				}
+			}
+			text = text.mid(start);
+		}
+		const int rows = std::max(1, static_cast<int>(std::ceil(used / perRow)));
+		const QString display = text.isEmpty() ? QString()
+						       : QString(std::max(0, overlay->maxLines - rows), QChar('\n')) + text;
+		if (display == overlay->shown)
+			continue;
+		overlay->shown = display;
+		OBSDataAutoRelease update = obs_data_create();
+		obs_data_set_string(update, "text", display.isEmpty() ? " " : display.toUtf8().constData());
+		obs_source_update(overlay->label, update);
+	}
+}
+
+/* ---- obs_source_info ---- */
+
+namespace {
+const char *captionName(void *)
+{
+	return obs_module_text("LiveHime.Captions.SourceName");
+}
+
+void captionUpdate(void *data, obs_data_t *settings)
+{
+	auto *overlay = static_cast<CaptionOverlay *>(data);
+	OBSDataAutoRelease font = obs_data_get_obj(settings, "font");
+	int fontSize = font ? static_cast<int>(obs_data_get_int(font, "size")) : kDefaultFontSize;
+	if (fontSize <= 0)
+		fontSize = kDefaultFontSize;
+	const int lines = static_cast<int>(obs_data_get_int(settings, "lines"));
+	const int width = static_cast<int>(obs_data_get_int(settings, "width"));
+	overlay->width = width;
+	overlay->height = lines * fontSize * 4 / 3;
+
+	if (CaptionOverlayHub *hub = CaptionOverlayHub::instance()) {
+		hub->remove(overlay);
+		overlay->maxLines = lines;
+		overlay->lingerSeconds = static_cast<int>(obs_data_get_int(settings, "linger"));
+		overlay->fontSize = fontSize;
+		overlay->shown = QStringLiteral("\x01"); /* redraw with the new layout */
+		hub->add(overlay);
+	}
+
+	OBSDataAutoRelease label = obs_data_create();
+	OBSDataAutoRelease labelFont = obs_data_create();
+	obs_data_set_string(labelFont, "face", font ? obs_data_get_string(font, "face") : kDefaultFace);
+	obs_data_set_string(labelFont, "style", font ? obs_data_get_string(font, "style") : "");
+	obs_data_set_int(labelFont, "size", fontSize);
+	obs_data_set_int(labelFont, "flags", font ? obs_data_get_int(font, "flags") : 0);
+	obs_data_set_obj(label, "font", labelFont);
+	const long long color = obs_data_get_int(settings, "color");
+	obs_data_set_int(label, "color1", color);
+	obs_data_set_int(label, "color2", color);
+	obs_data_set_bool(label, "outline", obs_data_get_bool(settings, "outline"));
+	obs_data_set_bool(label, "drop_shadow", obs_data_get_bool(settings, "drop_shadow"));
+	obs_data_set_bool(label, "word_wrap", true);
+	obs_data_set_int(label, "custom_width", width);
+	obs_source_update(overlay->label, label);
+}
+
+void *captionCreate(obs_data_t *settings, obs_source_t *)
+{
+	auto *overlay = new CaptionOverlay();
+	OBSDataAutoRelease label = obs_data_create();
+	obs_data_set_string(label, "text", " ");
+	overlay->label = obs_source_create_private("text_ft2_source_v2", "livehime-caption-text", label);
+	if (!overlay->label) {
+		delete overlay;
+		return nullptr;
+	}
+	captionUpdate(overlay, settings);
+	return overlay;
+}
+
+void captionDestroy(void *data)
+{
+	auto *overlay = static_cast<CaptionOverlay *>(data);
+	if (CaptionOverlayHub *hub = CaptionOverlayHub::instance())
+		hub->remove(overlay);
+	obs_source_release(overlay->label);
+	delete overlay;
+}
+
+uint32_t captionWidth(void *data)
+{
+	return static_cast<uint32_t>(static_cast<CaptionOverlay *>(data)->width.load());
+}
+
+uint32_t captionHeight(void *data)
+{
+	return static_cast<uint32_t>(static_cast<CaptionOverlay *>(data)->height.load());
+}
+
+void captionRender(void *data, gs_effect_t *)
+{
+	obs_source_video_render(static_cast<CaptionOverlay *>(data)->label);
+}
+
+void captionDefaults(obs_data_t *settings)
+{
+	OBSDataAutoRelease font = obs_data_create();
+	obs_data_set_default_string(font, "face", kDefaultFace);
+	obs_data_set_default_int(font, "size", kDefaultFontSize);
+	obs_data_set_default_int(font, "flags", 0);
+	obs_data_set_default_string(font, "style", "W6");
+	obs_data_set_default_obj(settings, "font", font);
+	obs_data_set_default_int(settings, "lines", kDefaultLines);
+	obs_data_set_default_int(settings, "linger", kDefaultLinger);
+	obs_data_set_default_int(settings, "width", kDefaultWidth);
+	obs_data_set_default_int(settings, "color", 0xFFFFFFFF);
+	obs_data_set_default_bool(settings, "outline", true);
+	obs_data_set_default_bool(settings, "drop_shadow", true);
+}
+
+obs_properties_t *captionProperties(void *)
+{
+	obs_properties_t *props = obs_properties_create();
+	obs_properties_add_font(props, "font", obs_module_text("LiveHime.Overlay.Font"));
+	obs_properties_add_color_alpha(props, "color", obs_module_text("LiveHime.Overlay.Color"));
+	obs_properties_add_bool(props, "outline", obs_module_text("LiveHime.Overlay.Outline"));
+	obs_properties_add_bool(props, "drop_shadow", obs_module_text("LiveHime.Overlay.Shadow"));
+	obs_properties_add_int_slider(props, "lines", obs_module_text("LiveHime.Overlay.Lines"), 1, 6, 1);
+	obs_property_t *width =
+		obs_properties_add_int(props, "width", obs_module_text("LiveHime.Overlay.Width"), 200, 3840, 10);
+	obs_property_int_set_suffix(width, " px");
+	obs_property_t *linger =
+		obs_properties_add_int(props, "linger", obs_module_text("LiveHime.Captions.Linger"), 0, 60, 1);
+	obs_property_int_set_suffix(linger, " s");
+	obs_property_set_long_description(linger, obs_module_text("LiveHime.Captions.LingerHint"));
+	obs_properties_add_text(props, "hint", obs_module_text("LiveHime.Captions.SourceHint"), OBS_TEXT_INFO);
+	return props;
+}
+} // namespace
+
+void RegisterCaptionOverlaySource()
+{
+	obs_source_info info = {};
+	info.id = "livehime_captions";
+	info.type = OBS_SOURCE_TYPE_INPUT;
+	info.output_flags = OBS_SOURCE_VIDEO | OBS_SOURCE_CUSTOM_DRAW;
+	info.icon_type = OBS_ICON_TYPE_TEXT;
+	info.get_name = captionName;
+	info.create = captionCreate;
+	info.destroy = captionDestroy;
+	info.update = captionUpdate;
+	info.get_width = captionWidth;
+	info.get_height = captionHeight;
+	info.video_render = captionRender;
+	info.get_defaults = captionDefaults;
+	info.get_properties = captionProperties;
+	obs_register_source(&info);
+}
