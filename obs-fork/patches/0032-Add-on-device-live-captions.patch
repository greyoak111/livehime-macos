+++ b/plugins/livehime/src/captions-page.cpp
@@ -0,0 +1,194 @@
+#include "captions-page.hpp"
+#include "caption-controller.hpp"
+
+#include <obs-module.h>
+#include <obs.hpp>
+
+#include <QCheckBox>
+#include <QComboBox>
+#include <QFormLayout>
+#include <QLabel>
+#include <QSignalBlocker>
+#include <QVBoxLayout>
+
+namespace {
+QString text(const char *key)
+{
+	return QString::fromUtf8(obs_module_text(key));
+}
+} // namespace
+
+CaptionsPage::CaptionsPage(QWidget *parent) : QWidget(parent)
+{
+	controller_ = new CaptionController(this);
+
+	enabled_ = new QCheckBox(text("LiveHime.Captions.Enable"), this);
+	source_ = new QComboBox(this);
+	source_->setSizeAdjustPolicy(QComboBox::AdjustToMinimumContentsLengthWithIcon);
+	locale_ = new QComboBox(this);
+	for (const auto &[label, code] : {std::pair{"LiveHime.Captions.Lang.zhCN", "zh-CN"},
+					  std::pair{"LiveHime.Captions.Lang.zhTW", "zh-TW"},
+					  std::pair{"LiveHime.Captions.Lang.yue", "yue-CN"},
+					  std::pair{"LiveHime.Captions.Lang.en", "en-US"}})
+		locale_->addItem(text(label), QString::fromLatin1(code));
+	status_ = new QLabel(this);
+	status_->setWordWrap(true);
+	preview_ = new QLabel(this);
+	preview_->setWordWrap(true);
+	preview_->setMinimumHeight(64);
+	preview_->setAlignment(Qt::AlignLeft | Qt::AlignBottom);
+	preview_->setStyleSheet(QStringLiteral(
+		"QLabel { background: #1d2025; border: 1px solid #3a3f48; border-radius: 6px; padding: 8px; font-size: 15px; }"));
+	auto *hint = new QLabel(text("LiveHime.Captions.Hint"), this);
+	hint->setWordWrap(true);
+	hint->setStyleSheet(QStringLiteral("color: #9aa0ab;"));
+
+	auto *form = new QFormLayout;
+	form->addRow(text("LiveHime.Captions.Source"), source_);
+	form->addRow(text("LiveHime.Captions.Language"), locale_);
+	auto *layout = new QVBoxLayout(this);
+	layout->setContentsMargins(0, 6, 0, 0);
+	layout->addWidget(enabled_);
+	layout->addLayout(form);
+	layout->addWidget(status_);
+	layout->addWidget(preview_);
+	layout->addWidget(hint);
+	layout->addStretch(1);
+
+	refreshSources();
+	{
+		QSignalBlocker blockEnabled(enabled_);
+		QSignalBlocker blockLocale(locale_);
+		enabled_->setChecked(controller_->enabled());
+		const int localeIndex = locale_->findData(controller_->locale());
+		locale_->setCurrentIndex(localeIndex >= 0 ? localeIndex : 0);
+	}
+	if (!CaptionController::supported()) {
+		enabled_->setEnabled(false);
+		source_->setEnabled(false);
+		locale_->setEnabled(false);
+		setStatus("LiveHime.Captions.Status.unsupported", true);
+	} else {
+		setStatus(controller_->enabled() ? "LiveHime.Captions.Status.preparing" : "LiveHime.Captions.Status.off");
+	}
+
+	connect(enabled_, &QCheckBox::toggled, this, &CaptionsPage::apply);
+	connect(source_, &QComboBox::activated, this, &CaptionsPage::apply);
+	connect(locale_, &QComboBox::activated, this, &CaptionsPage::apply);
+	connect(controller_, &CaptionController::sourceLost, this,
+		[this] { setStatus("LiveHime.Captions.Status.noSource", true); });
+}
+
+void CaptionsPage::showEvent(QShowEvent *event)
+{
+	QWidget::showEvent(event);
+	refreshSources();
+}
+
+void CaptionsPage::refreshSources()
+{
+	const QString selected = controller_->sourceUuid();
+	QSignalBlocker block(source_);
+	source_->clear();
+	struct Found {
+		QList<std::pair<QString, QString>> items;
+	} found;
+	obs_enum_sources(
+		[](void *param, obs_source_t *source) {
+			if (obs_source_get_output_flags(source) & OBS_SOURCE_AUDIO) {
+				static_cast<Found *>(param)->items.append({QString::fromUtf8(obs_source_get_name(source)),
+									   QString::fromUtf8(obs_source_get_uuid(source))});
+			}
+			return true;
+		},
+		&found);
+	int current = -1, microphone = -1;
+	for (const auto &[name, uuid] : found.items) {
+		source_->addItem(name, uuid);
+		if (uuid == selected)
+			current = source_->count() - 1;
+		OBSSourceAutoRelease source = obs_get_source_by_uuid(uuid.toUtf8().constData());
+		if (microphone < 0 && source && QString::fromUtf8(obs_source_get_id(source)).contains("input_capture"))
+			microphone = source_->count() - 1;
+	}
+	/* Default to the microphone. */
+	source_->setCurrentIndex(current >= 0 ? current : (microphone >= 0 ? microphone : 0));
+}
+
+void CaptionsPage::apply()
+{
+	finished_.clear();
+	partial_.clear();
+	preview_->clear();
+	const QString uuid = source_->currentData().toString();
+	if (enabled_->isChecked() && uuid.isEmpty()) {
+		setStatus("LiveHime.Captions.Status.noSource", true);
+		return;
+	}
+	if (enabled_->isChecked())
+		setStatus("LiveHime.Captions.Status.preparing");
+	controller_->configure(enabled_->isChecked(), uuid, locale_->currentData().toString());
+	if (!enabled_->isChecked())
+		setStatus("LiveHime.Captions.Status.off");
+}
+
+void CaptionsPage::handleEvent(const QJsonObject &event)
+{
+	const QString name = event.value("event").toString();
+	if (name == "captions") {
+		const QString status = event.value("status").toString();
+		if (status == "stopped") {
+			if (!controller_->enabled())
+				setStatus("LiveHime.Captions.Status.off");
+			return;
+		}
+		const QByteArray key = "LiveHime.Captions.Status." + status.toUtf8();
+		setStatus(key.constData(), status == "failed" || status == "unsupported");
+		if (status == "failed" && !event.value("message").toString().isEmpty())
+			status_->setText(status_->text() + QStringLiteral("\n") + event.value("message").toString());
+		return;
+	}
+	if (name != "caption")
+		return;
+	if (event.value("final").toBool()) {
+		finished_ = (finished_ + event.value("text").toString()).right(120);
+		partial_.clear();
+	} else {
+		partial_ = event.value("text").toString();
+	}
+	preview_->setText(currentCaption().right(80));
+}
+
+QString CaptionsPage::statusText() const
+{
+	return status_->text();
+}
+
+void CaptionsPage::setSelection(bool enabled, const QString &sourceName, const QString &locale)
+{
+	refreshSources();
+	if (!sourceName.isEmpty()) {
+		const int index = source_->findText(sourceName);
+		if (index >= 0)
+			source_->setCurrentIndex(index);
+	}
+	if (!locale.isEmpty()) {
+		const int index = locale_->findData(locale);
+		if (index >= 0)
+			locale_->setCurrentIndex(index);
+	}
+	QSignalBlocker block(enabled_);
+	enabled_->setChecked(enabled);
+	apply();
+}
+
+QString CaptionsPage::currentCaption() const
+{
+	return finished_ + partial_;
+}
+
+void CaptionsPage::setStatus(const QString &key, bool error)
+{
+	status_->setText(text(key.toUtf8().constData()));
+	status_->setStyleSheet(error ? QStringLiteral("color: #e06c75;") : QStringLiteral("color: #9aa0ab;"));
+}
