+import XCTest
+@testable import LiveHimeCore
+
+final class CaptionTextTests: XCTestCase {
+    func testRemovesRecognizerSpacingAroundChinese() {
+        XCTAssertEqual(CaptionText.clean("大家晚上好 ，欢迎来到 我的直播间"), "大家晚上好，欢迎来到我的直播间")
+    }
+
+    func testKeepsSpacesBetweenLatinWords() {
+        XCTAssertEqual(CaptionText.clean("hello world 你好"), "hello world你好")
+    }
+
+    func testFixesHomophones() {
+        XCTAssertEqual(CaptionText.clean("怎么用直播机开播"), "怎么用直播姬开播")
+    }
+
+    func testDropsPunctuationOnlyResults() {
+        XCTAssertEqual(CaptionText.clean(" 。"), "")
+    }
+}
