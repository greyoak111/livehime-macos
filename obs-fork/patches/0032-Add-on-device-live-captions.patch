+## Live captions check
+
+`e2e-captions.mjs` plays a speech file through a temporary media source,
+points live captions at it and checks the Captions tab and a temporary
+"LiveHime captions" source (macOS 26+). Both sources are removed
+afterwards. It changes the captions settings in `features.json`; back the
+file up and restore it around the run. A Chinese sample:
+`say -v Tingting -o speech.aiff "大家晚上好，欢迎来到我的直播间……"`.
+
+```bash
+node e2e-captions.mjs <websocket password> /path/to/speech.aiff
+```
diff --git a/build-aux/livehime/tests/e2e-captions.mjs b/build-aux/livehime/tests/e2e-captions.mjs
new file mode 100644
index 000000000..a8d19acd0
--- /dev/null
+++ b/build-aux/livehime/tests/e2e-captions.mjs
@@ -0,0 +1,63 @@
+// Live captions end to end: a media source plays Chinese speech, captions
+// listen to it, and the "LiveHime captions" source shows the words.
+// Usage: node e2e-captions.mjs <ws password> <speech audio file>
+// Adds a media source and a captions source to the program scene and
+// removes both afterwards; restores the captions settings it changed.
+import { createHash } from 'node:crypto';
+const [password, audioFile] = process.argv.slice(2);
+const sha = (s) => createHash('sha256').update(s).digest('base64');
+const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
+const ws = new WebSocket('ws://127.0.0.1:4466');
+let id = 1; const pend = new Map();
+const req = (t, d = {}) => new Promise((r) => { const k = String(id++); pend.set(k, r); ws.send(JSON.stringify({ op: 6, d: { requestType: t, requestId: k, requestData: d } })); });
+const vendor = async (t, d = {}) => (await req('CallVendorRequest', { vendorName: 'livehime', requestType: t, requestData: d })).responseData?.responseData;
+let fails = 0;
+const check = (n, ok, i = '') => { if (!ok) fails++; console.log(`${ok ? 'PASS' : 'FAIL'}  ${n}${i ? '  — ' + i : ''}`); };
+const MEDIA = 'livehime-e2e-speech', CAPTIONS = 'livehime-e2e-captions';
+
+ws.onmessage = async (ev) => {
+  const m = JSON.parse(ev.data);
+  if (m.op === 0) { const { challenge, salt } = m.d.authentication; ws.send(JSON.stringify({ op: 1, d: { rpcVersion: 1, authentication: sha(sha(password + salt) + challenge), eventSubscriptions: 0 } })); return; }
+  if (m.op === 7) { pend.get(m.d.requestId)?.(m.d); return; }
+  if (m.op !== 2) return;
+  for (let i = 0; i < 40 && !(await req('GetVersion')).requestStatus.result; i++) await sleep(500);
+  const before = await vendor('Captions');
+  check('captions supported on this Mac', before?.supported, JSON.stringify(before));
+  const scene = (await req('GetCurrentProgramScene')).responseData.currentProgramSceneName;
+  try {
+    const media = await req('CreateInput', { sceneName: scene, inputName: MEDIA, inputKind: 'ffmpeg_source',
+      inputSettings: { local_file: audioFile, is_local_file: true, looping: false, restart_on_activate: false, close_when_inactive: false } });
+    check('speech media source created', media.requestStatus.result, media.requestStatus.comment);
+    const cap = await req('CreateInput', { sceneName: scene, inputName: CAPTIONS, inputKind: 'livehime_captions', inputSettings: { lines: 2, width: 1200, linger: 30 } });
+    check('captions source created', cap.requestStatus.result, cap.requestStatus.comment);
+    await req('TriggerMediaInputAction', { inputName: MEDIA, mediaAction: 'OBS_WEBSOCKET_MEDIA_INPUT_ACTION_STOP' });
+
+    let st = await vendor('Captions', { enabled: true, source: MEDIA, locale: 'zh-CN' });
+    for (let i = 0; i < 40 && !/识别|Listening/.test(st?.status); i++) { await sleep(250); st = await vendor('Captions'); }
+    check('captions listening', /识别|Listening/.test(st?.status), st?.status);
+
+    await req('TriggerMediaInputAction', { inputName: MEDIA, mediaAction: 'OBS_WEBSOCKET_MEDIA_INPUT_ACTION_RESTART' });
+    const t0 = Date.now(); let first = 0, seen = new Set();
+    for (let i = 0; i < 70; i++) {
+      await sleep(250); st = await vendor('Captions');
+      if (st?.caption && !first) first = Date.now() - t0;
+      if (st?.caption) seen.add(st.caption);
+    }
+    console.log('first caption after', first, 'ms;', seen.size, 'distinct updates');
+    console.log('caption:', st?.caption);
+    console.log('overlay:', JSON.stringify(st?.overlay));
+    check('captions appear while the speech plays', first > 0 && first < 4000, `${first} ms`);
+    check('recognized the speech', /欢迎来到我的直播间/.test(st?.caption || ''), st?.caption);
+    check('homophone fixed (直播姬)', /直播姬/.test(st?.caption || ''), st?.caption);
+    check('captions source shows the latest words, bottom-aligned', (st?.overlay || '').replace(/\n/g, '').length > 0 && (st.caption || '').endsWith((st.overlay || '').replace(/^\n+/, '').slice(-6)), JSON.stringify(st?.overlay));
+  } catch (e) { check('run', false, e.stack); }
+  finally {
+    await vendor('Captions', { enabled: before?.enabled ?? false, source: '', locale: '' });
+    await req('RemoveInput', { inputName: CAPTIONS });
+    await req('RemoveInput', { inputName: MEDIA });
+    await sleep(800);
+    const left = (await req('GetInputList')).responseData.inputs.map((i) => i.inputName);
+    check('temporary sources removed', !left.includes(MEDIA) && !left.includes(CAPTIONS), left.join(','));
+  }
+  console.log(fails ? `${fails} failed` : 'all passed'); process.exit(fails ? 1 : 0);
+};
