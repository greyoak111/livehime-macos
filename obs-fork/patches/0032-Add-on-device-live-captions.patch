 void livehime_core_open_cover_page(void);
 
+/* Live captions (on-device speech recognition, macOS 26+). start/stop on
+ * the main thread; push mono float samples from the audio thread. Emits
+ *   {"event":"captions","status":"preparing|listening|stopped|failed|unsupported"[,"message"]}
+ *   {"event":"caption","text","final":true|false}  (in-progress text is
+ *   replaced by later updates until a final sentence arrives) */
+int livehime_core_captions_supported(void);
+void livehime_core_captions_start(const char *locale);
+void livehime_core_captions_push(const float *samples, int count, double sample_rate);
+void livehime_core_captions_stop(void);
+
