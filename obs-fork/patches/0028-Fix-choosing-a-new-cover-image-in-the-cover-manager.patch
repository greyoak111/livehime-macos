@@ -246,6 +288,42 @@ final class BilibiliPageWindow: NSObject, NSWindowDelegate, WKNavigationDelegate
     })();
     """
 
+    /// The pages are written for the Windows client's Chromium; two things
+    /// they rely on fail in WebKit:
+    /// - A file input that is never added to the document can be garbage
+    ///   collected while the open panel is up, so its change event (the
+    ///   chosen image) never arrives. Keep it in the document until then.
+    /// - Image loaders add "?<timestamp>" to every non-data URL. Chromium
+    ///   ignores a query on a blob: URL, WebKit fails to load it, so a newly
+    ///   chosen local image never reaches the cover editor and Confirm
+    ///   uploads the previous picture again. Drop the query from blob: URLs.
+    static let webKitCompatibilityScript = """
+    (() => {
+      const click = HTMLInputElement.prototype.click;
+      HTMLInputElement.prototype.click = function () {
+        if (this.type === 'file' && !this.isConnected && document.body) {
+          this.style.display = 'none';
+          document.body.appendChild(this);
+          const done = () => setTimeout(() => this.remove(), 0);
+          this.addEventListener('change', done, {once: true});
+          this.addEventListener('cancel', done, {once: true});
+        }
+        return click.apply(this, arguments);
+      };
+      const clean = value => (typeof value === 'string' && value.startsWith('blob:')) ? value.replace(/\\?\\d+$/, '') : value;
+      const src = Object.getOwnPropertyDescriptor(HTMLImageElement.prototype, 'src');
+      Object.defineProperty(HTMLImageElement.prototype, 'src', {
+        configurable: true, enumerable: src.enumerable, get: src.get,
+        set(value) { src.set.call(this, clean(value)); }
+      });
+      const setAttribute = Element.prototype.setAttribute;
+      Element.prototype.setAttribute = function (name, value) {
+        if (this instanceof HTMLImageElement && String(name).toLowerCase() === 'src') value = clean(value);
+        return setAttribute.call(this, name, value);
+      };
+    })();
+    """
+
     /// Reports failed requests, page errors and toasts. Only host and path
     /// of a URL are kept; request and response bodies are never read beyond
     /// the API result code and message.
@@ -482,3 +560,32 @@ final class WeakMessageHandler: NSObject, WKScriptMessageHandler {
         target?.userContentController(controller, didReceive: message)
     }
 }
+
+public typealias LiveHimePageResultCallback = @convention(c) (UnsafePointer<CChar>?, UnsafeMutableRawPointer?) -> Void
+
+/// Test hook: evaluates a script in the open hosted page `key` ("cover",
+/// "faceAuth"). `done` runs on the main thread with the JSON result.
+@_cdecl("livehime_core_page_eval")
+public func livehime_core_page_eval(_ key: UnsafePointer<CChar>?, _ script: UnsafePointer<CChar>?,
+                                    _ done: LiveHimePageResultCallback?, _ context: UnsafeMutableRawPointer?) {
+    let name = key.map { String(cString: $0) } ?? ""
+    let source = script.map { String(cString: $0) } ?? ""
+    MainActor.assumeIsolated {
+        guard let page = BilibiliPageWindow.page(name) else {
+            done?("{\"error\":\"page not open\"}", context)
+            return
+        }
+        page.evaluate(source) { json in json.withCString { done?($0, context) } }
+    }
+}
+
+/// Test hook: clicks the open hosted page `key` at page coordinates.
+@_cdecl("livehime_core_page_click")
+public func livehime_core_page_click(_ key: UnsafePointer<CChar>?, _ x: Double, _ y: Double) -> Int32 {
+    let name = key.map { String(cString: $0) } ?? ""
+    return MainActor.assumeIsolated {
+        guard let page = BilibiliPageWindow.page(name) else { return 0 }
+        page.click(x: x, y: y)
+        return 1
+    }
+}
