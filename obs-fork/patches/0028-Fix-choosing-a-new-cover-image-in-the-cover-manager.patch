+
+## Cover manager check
+
+`e2e-cover.mjs` drives Bilibili's cover manager in the real window: a real
+click on "重新上传", the file chooser answered with
+`LIVEHIME_E2E_PICK_FILE`, then checks that the editor canvas shows the
+chosen image. With `--submit` it also clicks "确定" and checks that the
+room cover changed. `--submit` replaces the signed-in account's live room
+cover (it goes to Bilibili review), so run it only with the account
+owner's consent:
+
+```bash
+open --env LIVEHIME_E2E_PICK_FILE=/path/to/image.jpg build_macos/frontend/RelWithDebInfo/LiveHime.app
+node e2e-cover.mjs <websocket password> image.jpg [--submit]
+```
diff --git a/build-aux/livehime/tests/e2e-cover.mjs b/build-aux/livehime/tests/e2e-cover.mjs
new file mode 100644
index 000000000..3c56811f6
--- /dev/null
+++ b/build-aux/livehime/tests/e2e-cover.mjs
@@ -0,0 +1,87 @@
+// Cover manager: re-upload a local image and confirm, through a real click.
+// Usage: node e2e-cover.mjs <ws password> <file name picked by LIVEHIME_E2E_PICK_FILE> [--submit]
+import { createHash } from 'node:crypto';
+const [password, fileName] = process.argv.slice(2);
+const submit = process.argv.includes('--submit');
+const sha = (s) => createHash('sha256').update(s).digest('base64');
+const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
+const ws = new WebSocket('ws://127.0.0.1:4466');
+let id = 1; const pend = new Map();
+const req = (t, d = {}) => new Promise((r) => { const k = String(id++); pend.set(k, r); ws.send(JSON.stringify({ op: 6, d: { requestType: t, requestId: k, requestData: d } })); });
+const vendor = async (t, d = {}) => (await req('CallVendorRequest', { vendorName: 'livehime', requestType: t, requestData: d })).responseData?.responseData;
+const page = async (script) => { const r = await vendor('HostedPage', { page: 'cover', script }); return r?.result ? JSON.parse(r.result) : r; };
+let fails = 0;
+const check = (n, ok, i = '') => { if (!ok) fails++; console.log(`${ok ? 'PASS' : 'FAIL'}  ${n}${i ? '  — ' + i : ''}`); };
+// The cover editor component (Vue 2) and a leaf element by its exact text.
+const helpers = `
+  const editor = () => { for (const el of document.querySelectorAll('*')) { const vm = el.__vue__; if (vm && 'rawSrc' in vm && 'hasCoverImage' in vm && 'isUploading' in vm && vm.handleReload) return vm; } return null; };
+  const clipper = () => { for (const el of document.querySelectorAll('*')) { const vm = el.__vue__; if (vm && typeof vm.exportEditedCanvas === 'function') return vm; } return null; };
+  const byText = (text) => [...document.querySelectorAll('body *')].filter(e => e.children.length === 0 && e.textContent.trim() === text && e.getBoundingClientRect().width > 0);
+  const center = (e) => { const r = e.getBoundingClientRect(); return { x: r.left + r.width / 2, y: r.top + r.height / 2 }; };
+`;
+const state = () => page(helpers + `const vm = editor(); return vm && { rawName: vm.rawSrc && vm.rawSrc.name || null, rawType: vm.rawSrc && vm.rawSrc.constructor.name, status: vm.rawSrcStatus, has: vm.hasCoverImage, uploading: vm.isUploading };`);
+
+ws.onmessage = async (ev) => {
+  const m = JSON.parse(ev.data);
+  if (m.op === 0) { const { challenge, salt } = m.d.authentication; ws.send(JSON.stringify({ op: 1, d: { rpcVersion: 1, authentication: sha(sha(password + salt) + challenge), eventSubscriptions: 0 } })); return; }
+  if (m.op === 7) { pend.get(m.d.requestId)?.(m.d); return; }
+  if (m.op !== 2) return;
+  try {
+    let acct;
+    for (let i = 0; i < 40; i++) { acct = await vendor('GetAccountState'); if (acct?.state === 'ready') break; await sleep(500); }
+    check('account ready', acct?.state === 'ready', acct?.state);
+    await vendor('HostedPage', { open: 'cover' });
+    let st;
+    for (let i = 0; i < 40; i++) { await sleep(500); st = await state(); if (st && st.status === 'ready') break; }
+    check('cover editor loaded with the current cover', st?.status === 'ready', JSON.stringify(st));
+    const before = await page(helpers + `const vm = editor(); return vm && vm.liveCover;`);
+    console.log('room cover before:', JSON.stringify(before));
+    const target = await page(helpers + `const e = byText('重新上传')[0]; return e && center(e);`);
+    check('re-upload button found', !!target?.x, JSON.stringify(target));
+    const clicked = await vendor('HostedPage', { page: 'cover', click: target });
+    check('real click sent', clicked?.clicked);
+    for (let i = 0; i < 16; i++) { await sleep(500); st = await state(); if (st?.rawName) break; }
+    check('page took the local image', st?.rawName === fileName, JSON.stringify(st));
+    // What Confirm would upload: the editor canvas the export draws from, compared with the
+    // chosen file (average colour of each, centre-cropped to 4:3).
+    await sleep(2500);
+    const cmp = await page(helpers + `
+      const vm = editor();
+      const avg = (source, w, h) => { const c = document.createElement('canvas'); c.width = 48; c.height = 36;
+        const s = Math.min(w / 4, h / 3), sw = 4 * s, sh = 3 * s; const g = c.getContext('2d');
+        g.drawImage(source, (w - sw) / 2, (h - sh) / 2, sw, sh, 0, 0, 48, 36);
+        const d = g.getImageData(0, 0, 48, 36).data; let r = 0, gg = 0, b = 0; for (let i = 0; i < d.length; i += 4) { r += d[i]; gg += d[i + 1]; b += d[i + 2]; }
+        const n = d.length / 4; return [r / n, gg / n, b / n].map(v => Math.round(v)); };
+      let stage = 'export';
+      try {
+        const exported = clipper().getInternalCanvas();
+        stage = 'read file';
+        const url = await new Promise(res => { const f = new FileReader(); f.onload = () => res(f.result); f.readAsDataURL(vm.rawSrc); });
+        stage = 'load file';
+        const img = await new Promise((res, rej) => { const i = new Image(); i.onload = () => res(i); i.onerror = () => rej(new Error('image load')); i.src = url; });
+        stage = 'measure export';
+        const e = avg(exported, exported.width, exported.height);
+        stage = 'measure file';
+        return { exported: e, chosen: avg(img, img.naturalWidth, img.naturalHeight), size: [exported.width, exported.height], editorImg: String(vm.imgSrc).slice(0, 60) };
+      } catch (err) { return { stage, err: String(err && (err.name + ': ' + err.message)), editorImg: String(vm.imgSrc).slice(0, 60) }; }`);
+    const dist = cmp?.exported ? Math.hypot(...cmp.exported.map((v, i) => v - cmp.chosen[i])) : 999;
+    check('export (what Confirm uploads) shows the chosen image', dist < 12, JSON.stringify(cmp) + ' dist=' + dist.toFixed(1));
+    if (submit && st?.rawName === fileName && dist < 12) {
+      await sleep(1500);
+      const ok = await page(helpers + `const e = byText('确定').filter(e => e.closest('.action-bar'))[0] || byText('确定')[0]; return e && center(e);`);
+      check('confirm button found', !!ok?.x, JSON.stringify(ok));
+      await vendor('HostedPage', { page: 'cover', click: ok });
+      let closed = false;
+      for (let i = 0; i < 30; i++) { await sleep(500); const r = await vendor('HostedPage', { page: 'cover', script: 'return 1' }); if (r?.result?.includes?.('page not open') || r?.error) { closed = true; break; } }
+      check('window closed after the upload (host confirm)', closed);
+      // Reopen: the room's current cover should now be the submitted one.
+      await sleep(1500);
+      await vendor('HostedPage', { open: 'cover' });
+      let now;
+      for (let i = 0; i < 40; i++) { await sleep(500); now = await page(helpers + `const vm = editor(); return vm && vm.rawSrcStatus === 'ready' ? { cover: vm.liveCover, auditing: vm.isAuditing } : null;`); if (now?.cover) break; }
+      console.log('room cover after reopening:', JSON.stringify(now));
+      check('room cover changed', now?.cover && JSON.stringify(now.cover) !== JSON.stringify(before), '');
+    }
+  } catch (e) { check('run', false, e.stack); }
+  console.log(fails ? `${fails} failed` : 'all passed'); process.exit(fails ? 1 : 0);
+};
