+/* Hosted Bilibili pages for tests: {"open":"cover"} opens the cover
+ * manager; {"page","script"} evaluates an async function body there and
+ * returns its JSON as "result"; {"page","click":{"x","y"}} clicks at page
+ * coordinates. */
+void hostedPage(obs_data_t *request, obs_data_t *response, void *)
+{
+	const std::string open = obs_data_get_string(request, "open");
+	const std::string page = obs_data_get_string(request, "page");
+	const std::string script = obs_data_get_string(request, "script");
+	if (open == "cover") {
+		onUiThread([] { livehime_core_open_cover_page(); });
+		obs_data_set_bool(response, "opened", true);
+		return;
+	}
+	if (obs_data_has_user_value(request, "click")) {
+		OBSDataAutoRelease click = obs_data_get_obj(request, "click");
+		const double x = obs_data_get_double(click, "x"), y = obs_data_get_double(click, "y");
+		int ok = 0;
+		onUiThread([&] { ok = livehime_core_page_click(page.c_str(), x, y); });
+		obs_data_set_bool(response, "clicked", ok != 0);
+		return;
+	}
+	if (script.empty())
+		return;
+	/* The result arrives later on the main thread; wait here, on the
+	 * websocket thread. */
+	auto result = std::make_shared<std::promise<std::string>>();
+	std::future<std::string> future = result->get_future();
+	auto *holder = new std::shared_ptr<std::promise<std::string>>(result);
+	const bool ran = onUiThread([&] {
+		livehime_core_page_eval(
+			page.c_str(), script.c_str(),
+			[](const char *json, void *context) {
+				auto *promise = static_cast<std::shared_ptr<std::promise<std::string>> *>(context);
+				(*promise)->set_value(json ? json : "null");
+				delete promise;
+			},
+			holder);
+	});
+	if (!ran) {
+		delete holder;
+		obs_data_set_string(response, "error", "dock unavailable");
+		return;
+	}
+	if (future.wait_for(std::chrono::seconds(20)) != std::future_status::ready) {
+		obs_data_set_string(response, "error", "timeout");
+		return;
+	}
+	obs_data_set_string(response, "result", future.get().c_str());
+}
