+
+## Emoticons
+
+`e2e-emoticons.mjs` checks emoticons without an account: chat lines with
+inline emoticons and a sticker are drawn with their pictures (fetched from
+Bilibili's public image host), and the panel works from an injected pack
+list (insert, locked hint, sticker send failing while signed out, shared by
+the floating chat). The feed is told it is signed in while the core is not,
+so nothing is sent. It saves a snapshot of the dock:
+
+```bash
+node e2e-emoticons.mjs <websocket password> /tmp/emoticons-dock.png
+```
+
+`e2e-float-fullscreen.mjs` also opens the panel over a full-screen app: it
+must stay inside the chat window (no extra window) and show its pictures.
+The real pack list and sending need a signed-in instance: open the panel,
+check the packs against the web room, send one inline emoji and one sticker.
diff --git a/build-aux/livehime/tests/e2e-emoticons.mjs b/build-aux/livehime/tests/e2e-emoticons.mjs
new file mode 100644
index 000000000..ac9dc2067
--- /dev/null
+++ b/build-aux/livehime/tests/e2e-emoticons.mjs
@@ -0,0 +1,124 @@
+// Emoticons end to end, without an account (nothing is sent to Bilibili):
+// - chat lines with inline emoticons ("[笑哭]") and a sticker are drawn with their pictures,
+//   fetched from Bilibili's image host (a snapshot of the dock is saved for a look);
+// - the dock's panel shows an injected pack list: tabs, pictures, an inline emoji inserts its
+//   code into the send box, a locked one only explains itself, a sticker is sent on its own and
+//   (the core being signed out) fails without touching the draft;
+// - Esc closes the panel first; signing out hides it and forgets the list.
+// The feed is told it is signed in ("ready") while the core stays signed out.
+// Usage: node e2e-emoticons.mjs <ws password> <snapshot.png>
+import { createHash } from 'node:crypto';
+const [password, snapshot] = process.argv.slice(2);
+const sha = (s) => createHash('sha256').update(s).digest('base64');
+const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
+let ws, id = 1; const pend = new Map();
+for (let i = 0; i < 60; i++) {
+  try { ws = new WebSocket('ws://127.0.0.1:4466'); await new Promise((ok, bad) => { ws.onopen = ok; ws.onerror = bad; }); break; }
+  catch { await sleep(1000); }
+}
+await new Promise((ok) => {
+  ws.onmessage = (m) => {
+    const msg = JSON.parse(m.data);
+    if (msg.op === 0) {
+      const a = msg.d.authentication;
+      ws.send(JSON.stringify({ op: 1, d: { rpcVersion: 1, authentication: sha(sha(password + a.salt) + a.challenge) } }));
+    } else if (msg.op === 2) ok();
+    else if (msg.op === 7) { pend.get(msg.d.requestId)?.(msg.d); pend.delete(msg.d.requestId); }
+  };
+});
+const req = (t, d = {}) => new Promise((r) => { const k = String(id++); pend.set(k, r); ws.send(JSON.stringify({ op: 6, d: { requestType: t, requestId: k, requestData: d } })); });
+const vendor = async (t, d = {}) => (await req('CallVendorRequest', { vendorName: 'livehime', requestType: t, requestData: d })).responseData?.responseData;
+for (let i = 0; i < 60 && (await vendor('Emoticons', { dock: true })) === undefined; i++) await sleep(500);
+let fails = 0;
+const check = (n, ok, i = '') => { if (!ok) fails++; console.log(`${ok ? 'PASS' : 'FAIL'}  ${n}${i ? '  — ' + i : ''}`); };
+const until = async (fn, pred, seconds = 15) => { let v; for (let i = 0; i < seconds * 4; i++) { v = await fn(); if (pred(v)) return v; await sleep(250); } return v; };
+
+const img = (h) => `https://i0.hdslb.com/bfs/emote/${h}.png`;
+const xiaoku = img('c3043ba94babf824dea03ce500d0e73763bf4f40');
+const dundun = img('878f1dfac79622050f730d1fee5f7b1a55951c74');
+const star = img('63c9d1a31c0da745b61cdb35e0ecb28635675db2');
+const doge = img('aadaca1895e09c5596fc6365192ec93a23718cf0');
+const packs = {
+  event: 'emoticons', ok: true, room: 1, packs: [
+    { id: 1, name: '通用表情', items: [
+      { key: 'emoji_1', text: '[笑哭]', name: '笑哭', url: xiaoku, inline: true, usable: true, hint: '' },
+      { key: 'emoji_2', text: '[蹲蹲]', name: '蹲蹲', url: dundun, inline: true, usable: true, hint: '' }] },
+    { id: 9, name: '房间专属表情', large: true, items: [
+      { key: 'room_1_1', text: '星星', name: '星星', url: star, inline: false, usable: true, hint: '' },
+      { key: 'room_1_2', text: '金箍', name: '金箍', url: doge, inline: false, usable: false, hint: '粉丝团3级' }] },
+  ],
+};
+
+try {
+  // Chat lines with pictures.
+  await vendor('Snapshot', { path: snapshot, tab: 0 });
+  const before = (await vendor('Emoticons', { dock: true, ready: true, draft: '' })).lines;
+  await vendor('InjectOverlayEvent', { kind: 'chat', uid: 11, user: '测试观众', text: '好耶[笑哭][笑哭] 不是表情[abc]',
+    emots: { '[笑哭]': xiaoku } });
+  await vendor('InjectOverlayEvent', { kind: 'chat', uid: 12, user: '测试观众B', text: '星星', sticker: { url: star, w: 160, h: 160 } });
+  // A main-site emote sent by the apps: a 20 px sticker named "upower_[code]", drawn at text size.
+  await vendor('InjectOverlayEvent', { kind: 'chat', uid: 13, user: '测试观众C', text: '[蹲蹲]',
+    sticker: { url: dundun, w: 20, h: 20, key: 'upower_[蹲蹲]' } });
+  const lines = await until(() => vendor('Emoticons', { dock: true }), (s) => s?.lines >= before + 3);
+  check('chat lines with emoticons added', lines?.lines >= before + 3, `lines ${before} -> ${lines?.lines}`);
+
+  // The dock's panel with an injected list.
+  let st = await vendor('Emoticons', { dock: true, inject: packs, picker: true, pack: 0 });
+  check('panel open with both packs', st?.picker_visible && st.packs === 2 && st.status === 'ready', JSON.stringify(st));
+  st = await until(() => vendor('Emoticons', { dock: true }), (s) => s?.pictures === 2);
+  check('inline pack shows its pictures', st?.pictures === 2 && st.items === 2, JSON.stringify(st));
+  await sleep(500);
+  await vendor('Snapshot', { path: snapshot, tab: 0 });
+  console.log(`      snapshot: ${snapshot}`);
+
+  st = await vendor('Emoticons', { dock: true, click: 0 });
+  st = await vendor('Emoticons', { dock: true, click: 1 });
+  check('inline emoji inserted into the send box', st?.draft === '[笑哭][蹲蹲]', JSON.stringify(st?.draft));
+
+  st = await vendor('Emoticons', { dock: true, pack: 1 });
+  st = await until(() => vendor('Emoticons', { dock: true }), (s) => s?.pictures === 2);
+  check('sticker pack shows its pictures (locked one greyed)', st?.pack === 1 && st.pictures === 2, JSON.stringify(st));
+  const linesBefore = st.lines;
+  st = await vendor('Emoticons', { dock: true, click: 1 });
+  await sleep(1000);
+  st = await vendor('Emoticons', { dock: true });
+  check('locked sticker explains itself and sends nothing', /粉丝团3级|locked/.test(st?.hint) && st.lines === linesBefore, st?.hint);
+  st = await vendor('Emoticons', { dock: true, click: 0 });
+  st = await until(() => vendor('Emoticons', { dock: true }), (s) => s?.lines > linesBefore, 10);
+  check('sticker sent on its own: fails while signed out, draft kept', st?.lines === linesBefore + 1 && st.draft === '[笑哭][蹲蹲]',
+    `lines ${linesBefore} -> ${st?.lines}, draft ${st?.draft}`);
+
+  // The floating chat's feed shares the list.
+  await vendor('FloatingChat', { visible: true });
+  st = await vendor('Emoticons', { ready: true, picker: true, pack: 1 });
+  st = await until(() => vendor('Emoticons'), (s) => s?.pictures === 2);
+  check('floating chat panel shares the list', st?.picker_visible && st.packs === 2 && st.items === 2 && st.pictures === 2,
+    JSON.stringify(st));
+  await vendor('Emoticons', { picker: false });
+  await vendor('FloatingChat', { visible: false });
+
+  // A flood of chat in the dock: the list scrolls, stays where the reader scrolled to while new
+  // lines come in, and follows the newest again once back at the bottom.
+  for (let i = 1; i <= 60; i++) await vendor('InjectOverlayEvent', { kind: 'chat', uid: 100 + i, user: `刷屏${i}`, text: `第${i}条` });
+  st = await until(() => vendor('Emoticons', { dock: true }), (s) => s?.scroll_max > 0 && s.scroll === s.scroll_max);
+  check('flood: dock list enabled, scrollable and at the newest line', st?.list_enabled && st.scroll_max > 0 && st.scroll === st.scroll_max,
+    JSON.stringify({ enabled: st?.list_enabled, scroll: st?.scroll, max: st?.scroll_max }));
+  await vendor('Emoticons', { dock: true, scroll: 0 });
+  for (let i = 61; i <= 70; i++) await vendor('InjectOverlayEvent', { kind: 'chat', uid: 100 + i, user: `刷屏${i}`, text: `第${i}条` });
+  await sleep(500);
+  st = await vendor('Emoticons', { dock: true });
+  check('flood: scrolled up stays put while lines arrive', st?.scroll === 0 && st.scroll_max > 0, JSON.stringify({ scroll: st?.scroll, max: st?.scroll_max }));
+  await vendor('Emoticons', { dock: true, scroll: st.scroll_max });
+  await vendor('InjectOverlayEvent', { kind: 'chat', uid: 171, user: '刷屏71', text: '第71条' });
+  st = await until(() => vendor('Emoticons', { dock: true }), (s) => s?.scroll === s?.scroll_max && s.lines >= 74, 5);
+  check('flood: back at the bottom follows the newest', st?.scroll === st?.scroll_max, JSON.stringify({ scroll: st?.scroll, max: st?.scroll_max }));
+  // Signed out (the test instance's real state), the list still takes input.
+  st = await vendor('Emoticons', { dock: true, ready: false });
+  check('signed out: panel closed, list not disabled', st?.picker_visible === false && st.list_enabled, JSON.stringify(st));
+} finally {
+  // Back to the real state: the core is signed out, so both feeds are too; forget the injected list.
+  await vendor('Emoticons', { dock: true, ready: false, reset: true, draft: '' });
+  await vendor('Emoticons', { ready: false });
+  ws.close();
+}
+process.exit(fails ? 1 : 0);
