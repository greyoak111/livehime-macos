@@ -0,0 +1,260 @@
+#include "emoji-picker.hpp"
+#include "emoticon-store.hpp"
+
+#include <obs-module.h>
+
+#include <QHBoxLayout>
+#include <QLabel>
+#include <QListWidget>
+#include <QStyle>
