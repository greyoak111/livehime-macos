diff --git a/plugins/livehime/src/emoticon-store.cpp b/plugins/livehime/src/emoticon-store.cpp
new file mode 100644
index 000000000..7ca2501d9
--- /dev/null
+++ b/plugins/livehime/src/emoticon-store.cpp
@@ -0,0 +1,88 @@
+#include "emoticon-store.hpp"
+
+#include <livehime-core.h>
+
+#include <QJsonArray>
+
+EmoticonStore *EmoticonStore::instance()
+{
+	static EmoticonStore *store = new EmoticonStore;
+	return store;
+}
+
+void EmoticonStore::load(bool retry)
+{
+	if (status_ == Status::Loading || status_ == Status::Ready || (status_ == Status::Failed && !retry))
+		return;
+	status_ = Status::Loading;
+	error_.clear();
+	emit packsChanged();
+	livehime_core_emoticons_load();
+}
+
+void EmoticonStore::reset()
+{
+	if (status_ == Status::Idle && packs_.isEmpty())
+		return;
+	status_ = Status::Idle;
+	error_.clear();
+	packs_.clear();
+	emit packsChanged();
+}
+
+QPixmap EmoticonStore::pixmap(const QString &url)
+{
+	if (url.isEmpty())
+		return {};
+	if (const QPixmap *cached = images_.object(url))
+		return *cached;
+	if (!pending_.contains(url) && !missing_.contains(url)) {
+		pending_.insert(url);
+		livehime_core_emoticon_image(url.toUtf8().constData());
+	}
+	return {};
+}
+
+void EmoticonStore::handleEvent(const QJsonObject &event)
+{
+	const QString name = event.value("event").toString();
+	if (name == "emoticonImage") {
+		const QString url = event.value("url").toString();
+		pending_.remove(url);
+		QPixmap picture(event.value("path").toString());
+		if (picture.isNull()) {
+			missing_.insert(url);
+			return;
+		}
+		const qint64 cost = qint64(picture.width()) * picture.height() * 4 / 1024 + 1;
+		images_.insert(url, new QPixmap(picture), cost);
+		emit imageReady(url);
+		return;
+	}
+	if (name != "emoticons")
+		return;
+	packs_.clear();
+	if (!event.value("ok").toBool()) {
+		status_ = Status::Failed;
+		error_ = event.value("message").toString();
+		emit packsChanged();
+		return;
+	}
+	for (const QJsonValue packValue : event.value("packs").toArray()) {
+		const QJsonObject pack = packValue.toObject();
+		Pack entry;
+		entry.name = pack.value("name").toString();
+		entry.large = pack.value("large").toBool();
+		for (const QJsonValue itemValue : pack.value("items").toArray()) {
+			const QJsonObject item = itemValue.toObject();
+			entry.items.append({item.value("key").toString(), item.value("text").toString(),
+					    item.value("name").toString(), item.value("url").toString(),
+					    item.value("hint").toString(), item.value("inline").toBool(),
+					    item.value("usable").toBool(true)});
+		}
+		if (!entry.items.isEmpty())
+			packs_.append(entry);
+	}
+	status_ = Status::Ready;
+	emit packsChanged();
+}
diff --git a/plugins/livehime/src/emoticon-store.hpp b/plugins/livehime/src/emoticon-store.hpp
new file mode 100644
index 000000000..c55447089
--- /dev/null
+++ b/plugins/livehime/src/emoticon-store.hpp
@@ -0,0 +1,64 @@
+#pragma once
+
+#include <QCache>
+#include <QJsonObject>
+#include <QObject>
+#include <QPixmap>
+#include <QSet>
+#include <QVector>
+
+/* The room's emoticon packs and the pictures of emoticons on screen, shared
+ * by every chat feed and picker. The list is loaded the first time a picker
+ * opens; pictures are fetched when first needed (the core keeps them small
+ * on disk) and at most 16 MB of them stay in memory. */
+class EmoticonStore : public QObject {
+	Q_OBJECT
+
+public:
+	struct Item {
+		QString key; /* what a sticker is sent as */
+		QString text; /* "[dog]" for inline emoji */
+		QString name;
+		QString url;
+		QString hint; /* how to unlock it */
+		bool inlineEmoji = false;
+		bool usable = true;
+	};
+	struct Pack {
+		QString name;
+		bool large = false;
+		QVector<Item> items;
+	};
+	enum class Status { Idle, Loading, Ready, Failed };
+
+	static EmoticonStore *instance();
+
+	/* Loads the list unless it is loaded or loading (`retry`: also after a failure). */
+	void load(bool retry = false);
+	/* Forgets the list (signed out or another room). */
+	void reset();
+	Status status() const { return status_; }
+	QString error() const { return error_; }
+	const QVector<Pack> &packs() const { return packs_; }
+
+	/* The picture for `url`, or a null pixmap while it is fetched (imageReady
+	 * follows) or when it cannot be had. */
+	QPixmap pixmap(const QString &url);
+
+	/* Core events "emoticons" and "emoticonImage". */
+	void handleEvent(const QJsonObject &event);
+
+signals:
+	void packsChanged();
+	void imageReady(const QString &url);
+
+private:
+	EmoticonStore() = default;
+
+	Status status_ = Status::Idle;
+	QString error_;
+	QVector<Pack> packs_;
+	QCache<QString, QPixmap> images_{16 * 1024}; /* cost in KB */
+	QSet<QString> pending_;
+	QSet<QString> missing_;
+};
