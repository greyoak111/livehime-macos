+#include <QTabBar>
+#include <QToolButton>
+#include <QVBoxLayout>
+
+
+namespace {
+QString text(const char *key)
+{
+	return QString::fromUtf8(obs_module_text(key));
+}
+
+constexpr int kKeyRole = Qt::UserRole;
+constexpr int kUrlRole = Qt::UserRole + 1;
+constexpr int kTextRole = Qt::UserRole + 2;
+constexpr int kNameRole = Qt::UserRole + 3;
+constexpr int kInlineRole = Qt::UserRole + 4;
+constexpr int kUsableRole = Qt::UserRole + 5;
+constexpr int kHintRole = Qt::UserRole + 6;
+} // namespace
+
+EmojiPicker::EmojiPicker(bool compact, QWidget *parent) : QWidget(parent), compact_(compact)
+{
+	tabs_ = new QTabBar(this);
+	tabs_->setFocusPolicy(Qt::NoFocus);
+	tabs_->setExpanding(false);
+	tabs_->setDrawBase(false);
+	tabs_->setUsesScrollButtons(true);
+	tabs_->setElideMode(Qt::ElideRight);
+	connect(tabs_, &QTabBar::currentChanged, this, &EmojiPicker::showPack);
+
+	grid_ = new QListWidget(this);
+	grid_->setFocusPolicy(Qt::NoFocus);
+	grid_->setViewMode(QListView::IconMode);
+	grid_->setMovement(QListView::Static);
+	grid_->setResizeMode(QListView::Adjust);
+	grid_->setWrapping(true);
+	grid_->setUniformItemSizes(true);
+	grid_->setSelectionMode(QAbstractItemView::NoSelection);
+	grid_->setMouseTracking(true);
+	grid_->setFrameShape(QFrame::NoFrame);
+	grid_->setHorizontalScrollBarPolicy(Qt::ScrollBarAlwaysOff);
+	connect(grid_, &QListWidget::itemEntered, this, &EmojiPicker::hover);
+	connect(grid_, &QListWidget::itemClicked, this, &EmojiPicker::clicked);
+
+	hint_ = new QLabel(this);
+	hint_->setStyleSheet(QStringLiteral("QLabel { color: #9aa0ab; }"));
+	hint_->setMinimumWidth(1);
+	retry_ = new QToolButton(this);
+	retry_->setText(text("LiveHime.Emoji.Retry"));
+	retry_->setFocusPolicy(Qt::NoFocus);
+	retry_->hide();
+	connect(retry_, &QToolButton::clicked, this, [] { EmoticonStore::instance()->load(true); });
+	auto *hintRow = new QHBoxLayout;
+	hintRow->setContentsMargins(4, 0, 4, 0);
+	hintRow->addWidget(hint_, 1);
+	hintRow->addWidget(retry_);
+
+	auto *layout = new QVBoxLayout(this);
+	layout->setContentsMargins(0, 0, 0, 0);
+	layout->setSpacing(2);
+	layout->addWidget(tabs_);
+	layout->addWidget(grid_, 1);
+	layout->addLayout(hintRow);
+	setFixedHeight(compact ? 150 : 180);
+
+	EmoticonStore *store = EmoticonStore::instance();
+	connect(store, &EmoticonStore::packsChanged, this, &EmojiPicker::rebuild);
+	connect(store, &EmoticonStore::imageReady, this, &EmojiPicker::pictureReady);
+	rebuild();
+}
+
+void EmojiPicker::setReady(bool ready)
+{
+	ready_ = ready;
+	if (ready && isVisible())
+		EmoticonStore::instance()->load();
+	showStatus();
+}
+
+void EmojiPicker::showEvent(QShowEvent *event)
+{
+	QWidget::showEvent(event);
+	if (ready_)
+		EmoticonStore::instance()->load();
+	/* Pictures are only fetched for a visible grid. */
+	showPack(tabs_->currentIndex());
+}
+
+void EmojiPicker::rebuild()
+{
+	const QVector<EmoticonStore::Pack> &packs = EmoticonStore::instance()->packs();
+	const QString current = tabs_->currentIndex() >= 0 ? tabs_->tabText(tabs_->currentIndex()) : QString();
+	const QSignalBlocker block(tabs_);
+	while (tabs_->count())
+		tabs_->removeTab(0);
+	int select = 0;
+	for (int i = 0; i < packs.size(); ++i) {
+		tabs_->addTab(packs[i].name);
+		if (packs[i].name == current)
+			select = i;
+	}
+	tabs_->setVisible(packs.size() > 1);
+	if (!packs.isEmpty())
+		tabs_->setCurrentIndex(select);
+	showPack(packs.isEmpty() ? -1 : select);
+}
+
+void EmojiPicker::showPack(int index)
+{
+	grid_->clear();
+	const QVector<EmoticonStore::Pack> &packs = EmoticonStore::instance()->packs();
+	if (index >= 0 && index < packs.size()) {
+		/* Small emoji in small cells; stickers and big emotes larger. */
+		const EmoticonStore::Pack &pack = packs[index];
+		const int icon = pack.large ? (compact_ ? 40 : 48) : 28;
+		grid_->setIconSize(QSize(icon, icon));
+		grid_->setGridSize(QSize(icon + 10, icon + 10));
+		for (const EmoticonStore::Item &entry : pack.items) {
+			auto *item = new QListWidgetItem(grid_);
+			item->setData(kKeyRole, entry.key);
+			item->setData(kUrlRole, entry.url);
+			item->setData(kTextRole, entry.text);
+			item->setData(kNameRole, entry.name);
+			item->setData(kInlineRole, entry.inlineEmoji);
+			item->setData(kUsableRole, entry.usable);
+			item->setData(kHintRole, entry.hint);
+			item->setSizeHint(grid_->gridSize());
+			if (isVisible())
+				setIcon(item);
+		}
+	}
+	showStatus();
+}
+
+void EmojiPicker::setIcon(QListWidgetItem *item)
+{
+	QPixmap picture = EmoticonStore::instance()->pixmap(item->data(kUrlRole).toString());
+	if (picture.isNull())
+		return;
+	if (!item->data(kUsableRole).toBool()) {
+		QStyleOption option;
+		option.initFrom(grid_);
+		picture = style()->generatedIconPixmap(QIcon::Disabled, picture, &option);
+	}
+	item->setIcon(QIcon(picture));
+}
+
+void EmojiPicker::pictureReady(const QString &url)
+{
+	if (!isVisible())
+		return;
+	for (int i = 0; i < grid_->count(); ++i) {
+		QListWidgetItem *item = grid_->item(i);
+		if (item->data(kUrlRole).toString() == url)
+			setIcon(item);
+	}
+}
+
+void EmojiPicker::hover(QListWidgetItem *item)
+{
+	if (!item)
+		return;
+	const QString name = item->data(kInlineRole).toBool() ? item->data(kTextRole).toString()
+							       : item->data(kNameRole).toString();
+	QString line;
+	if (!item->data(kUsableRole).toBool()) {
+		const QString hint = item->data(kHintRole).toString();
+		line = hint.isEmpty() ? text("LiveHime.Emoji.LockedPlain").arg(name)
+				      : text("LiveHime.Emoji.Locked").arg(name, hint);
+	} else {
+		line = text(item->data(kInlineRole).toBool() ? "LiveHime.Emoji.Insert" : "LiveHime.Emoji.Send").arg(name);
+	}
+	hint_->setText(line);
+}
+
+void EmojiPicker::clicked(QListWidgetItem *item)
+{
+	if (!item || !ready_)
+		return;
+	hover(item);
+	if (!item->data(kUsableRole).toBool())
+		return;
+	if (item->data(kInlineRole).toBool())
+		emit insertText(item->data(kTextRole).toString());
+	else
+		emit sendSticker(item->data(kKeyRole).toString());
+}
+
+void EmojiPicker::showStatus()
+{
+	EmoticonStore *store = EmoticonStore::instance();
+	retry_->setVisible(ready_ && store->status() == EmoticonStore::Status::Failed);
+	if (!ready_) {
+		hint_->setText(text("LiveHime.Emoji.SignedOut"));
+		return;
+	}
+	switch (store->status()) {
+	case EmoticonStore::Status::Loading:
+		hint_->setText(text("LiveHime.Emoji.Loading"));
+		break;
+	case EmoticonStore::Status::Failed:
+		hint_->setText(text("LiveHime.Emoji.Failed") +
+			       (store->error().isEmpty() ? QString() : QStringLiteral("：") + store->error()));
+		break;
+	case EmoticonStore::Status::Ready:
+		hint_->setText(store->packs().isEmpty() ? text("LiveHime.Emoji.Empty") : text("LiveHime.Emoji.Pick"));
+		break;
+	case EmoticonStore::Status::Idle:
+		hint_->clear();
+		break;
+	}
+}
+
+int EmojiPicker::packCount() const
+{
+	return tabs_->count();
+}
+
+int EmojiPicker::currentPack() const
+{
+	return tabs_->currentIndex();
+}
+
+void EmojiPicker::setCurrentPack(int index)
+{
+	tabs_->setCurrentIndex(index);
+}
+
+int EmojiPicker::itemCount() const
+{
+	return grid_->count();
+}
+
+int EmojiPicker::shownPictures() const
+{
+	int shown = 0;
+	for (int i = 0; i < grid_->count(); ++i)
+		shown += grid_->item(i)->icon().isNull() ? 0 : 1;
+	return shown;
+}
+
+QString EmojiPicker::hintText() const
+{
+	return hint_->text();
+}
+
+void EmojiPicker::activate(int row)
+{
+	clicked(grid_->item(row));
+}
