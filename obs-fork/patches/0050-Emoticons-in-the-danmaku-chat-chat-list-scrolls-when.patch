+  await sleep(600);
+  const st = await vendor('Emoticons', { click: 0 });
+  const out = await probe;
+  const targets = out.split('\n').filter((l) => / target /.test(l));
+  const chat = targets.find((l) => /340x460/.test(l));
+  const z = (l) => Number((l?.match(/z=(\d+)/) || [])[1] ?? 99);
+  const helperZ = Number((out.match(/z=(\d+) helper/) || [])[1] ?? -1);
+  const inside = st && st.picker_x >= 120 && st.picker_y >= 160 && st.picker_x + st.picker_w <= 460 && st.picker_y + st.picker_h <= 620;
+  const ok = /fullscreen=true/.test(out) && st?.picker_visible && st.pictures === 1 && st.draft === '[笑哭]' && inside &&
+    chat && z(chat) < helperZ && targets.length === 1;
+  if (!ok) fails++;
+  console.log(`${ok ? 'PASS' : 'FAIL'}  emoticon panel over a full-screen app: visible=${st?.picker_visible}, pictures=${st?.pictures}, ` +
+    `draft=${st?.draft}, inside chat=${inside}, LiveHime windows there=${targets.length}, ` +
+    `helper fullscreen=${/fullscreen=true/.test(out)}, chat z=${z(chat)} helper z=${helperZ}`);
+  console.log(targets.map((l) => '      ' + l.trim()).join('\n'));
+  await vendor('Emoticons', { picker: false, ready: false, reset: true, draft: '' });
+  await sleep(1500);
+}
 await vendor('FloatingChat', { visible: false, on_top: true });
 ws.close();
 await sleep(1500);
