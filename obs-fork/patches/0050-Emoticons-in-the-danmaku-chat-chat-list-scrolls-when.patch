diff --git a/plugins/livehime/core/Sources/LiveHimeCore/Emoticons.swift b/plugins/livehime/core/Sources/LiveHimeCore/Emoticons.swift
new file mode 100644
index 000000000..77a4bb926
--- /dev/null
+++ b/plugins/livehime/core/Sources/LiveHimeCore/Emoticons.swift
@@ -0,0 +1,303 @@
+import CryptoKit
+import Foundation
+import ImageIO
+import UniformTypeIdentifiers
+
+/// One emoticon a live room offers. Inline ones ("[dog]") are typed into the
+/// message as text; the others are stickers, sent on their own by `unique`.
+public struct Emoticon: Equatable, Sendable {
+    public let unique: String
+    public let text: String
+    public let name: String
+    public let url: String
+    public let width: Int
+    public let height: Int
+    /// false when the account has not unlocked it; `hint` says how.
+    public let usable: Bool
+    public let hint: String
+
+    /// Typed into the message as text (the live room's own "[dog]" codes);
+    /// otherwise sent on its own as a sticker by `unique`.
+    public var sentAsText: Bool? = nil
+    public var inline: Bool { sentAsText ?? (text.count > 2 && text.hasPrefix("[") && text.hasSuffix("]")) }
+}
+
+public struct EmoticonPack: Equatable, Sendable {
+    public let id: Int64
+    public let name: String
+    /// Bilibili's pkg_type (1 general, 2 room, 3 streamer, others seen on apps).
+    public var type: Int = 0
+    public let items: [Emoticon]
+    /// Pictures shown large in the picker (stickers, big main-site emotes).
+    public var large: Bool = false
+}
+
+enum EmoticonParser {
+    /// Parses GetEmoticons: data.data[] packs with emoticons[]. Packs and
+    /// items without a usable image are dropped.
+    static func packs(from root: [String: Any]) -> [EmoticonPack] {
+        let packs = (root["data"] as? [String: Any])?["data"] as? [[String: Any]] ?? []
+        return packs.compactMap { pack in
+            let items = (pack["emoticons"] as? [[String: Any]] ?? []).compactMap { item -> Emoticon? in
+                guard let url = item["url"] as? String, !url.isEmpty,
+                      let unique = item["emoticon_unique"] as? String, !unique.isEmpty else { return nil }
+                let name = item["descript"] as? String ?? ""
+                let text = item["emoji"] as? String ?? name
+                let perm = item["perm"].map { DanmakuParser.int($0) } ?? 1
+                let hint = (item["unlock_show_text"] as? String).flatMap { $0.isEmpty ? nil : $0 }
+                    ?? { let level = DanmakuParser.int(item["unlock_need_level"]); return level > 0 ? "Lv\(level)" : "" }()
+                return Emoticon(unique: unique, text: text.isEmpty ? name : text, name: name.isEmpty ? text : name,
+                                url: url, width: DanmakuParser.int(item["width"]), height: DanmakuParser.int(item["height"]),
+                                usable: perm != 0, hint: hint)
+            }
+            guard !items.isEmpty else { return nil }
+            return EmoticonPack(id: DanmakuParser.int64(pack["pkg_id"]), name: pack["pkg_name"] as? String ?? "",
+                                type: DanmakuParser.int(pack["pkg_type"]), items: items,
+                                large: !items.allSatisfy(\.inline))
+        }
+    }
+
+    /// Parses the account's main-site emote panel (x/emote/user/panel/web):
+    /// data.packages[] with emote[] of "[code]" texts, the 小黄脸 set and the
+    /// packs the account owns. The live room does not read these codes as
+    /// text; the apps send them as stickers named "upower_" + code (seen in
+    /// danmaku from the Android app), shown at emoji size. Text-only packs
+    /// (颜文字) are left out.
+    static func mainSitePacks(from root: [String: Any]) -> [EmoticonPack] {
+        let packs = (root["data"] as? [String: Any])?["packages"] as? [[String: Any]] ?? []
+        return packs.compactMap { pack in
+            let id = DanmakuParser.int64(pack["id"])
+            let items = (pack["emote"] as? [[String: Any]] ?? []).compactMap { item -> Emoticon? in
+                guard let url = item["url"] as? String, url.hasPrefix("http") || url.hasPrefix("//"),
+                      let text = item["text"] as? String, text.hasPrefix("["), text.hasSuffix("]") else { return nil }
+                let meta = item["meta"] as? [String: Any]
+                let flags = item["flags"] as? [String: Any]
+                let locked = (flags?["no_access"] as? Bool) == true && (flags?["unlocked"] as? Bool) != true
+                return Emoticon(unique: "upower_" + text, text: text,
+                                name: (meta?["alias"] as? String).flatMap { $0.isEmpty ? nil : $0 } ?? text,
+                                url: url, width: 0, height: 0, usable: !locked, hint: "", sentAsText: false)
+            }
+            guard !items.isEmpty else { return nil }
+            let size = DanmakuParser.int((pack["meta"] as? [String: Any])?["size"])
+            return EmoticonPack(id: id, name: pack["text"] as? String ?? "", type: -DanmakuParser.int(pack["type"]),
+                                items: items, large: size == 2)
+        }
+    }
+
+    /// The picker's order, like the apps': 小黄脸 first, then the live room's
+    /// packs, then the account's other main-site packs.
+    static func merged(live: [EmoticonPack], mainSite: [EmoticonPack]) -> [EmoticonPack] {
+        let faces = mainSite.filter { $0.id == 1 }
+        return faces + live + mainSite.filter { $0.id != 1 }
+    }
+}
+
+extension BilibiliLiveClient {
+    /// The live room's own packs (general stickers, room and streamer packs;
+    /// needs sign-in). Every platform value answers the same.
+    public func emoticons(roomID: Int64, cookieHeader: String) async throws -> [EmoticonPack] {
+        let root = try await requestJSON(
+            url: withQuery(URL(string: "https://api.live.bilibili.com/xlive/web-ucenter/v2/emoticon/GetEmoticons")!,
+                           [URLQueryItem(name: "platform", value: "pc"), URLQueryItem(name: "room_id", value: String(roomID))]),
+            cookieHeader: cookieHeader, body: nil)
+        return EmoticonParser.packs(from: root)
+    }
+
+    /// The account's main-site emote packs (see EmoticonParser.mainSitePacks).
+    public func mainSiteEmoticons(cookieHeader: String) async throws -> [EmoticonPack] {
+        let root = try await requestJSON(
+            url: withQuery(URL(string: "https://api.bilibili.com/x/emote/user/panel/web")!,
+                           [URLQueryItem(name: "business", value: "reply")]),
+            cookieHeader: cookieHeader, body: nil)
+        return EmoticonParser.mainSitePacks(from: root)
+    }
+
+    /// Everything the picker offers: the room's packs and, when they load, the
+    /// account's main-site packs.
+    public func allEmoticons(roomID: Int64, cookieHeader: String) async throws -> [EmoticonPack] {
+        async let mainSite = try? mainSiteEmoticons(cookieHeader: cookieHeader)
+        let live = try await emoticons(roomID: roomID, cookieHeader: cookieHeader)
+        return EmoticonParser.merged(live: live, mainSite: await mainSite ?? [])
+    }
+
+    /// Sends a sticker: the web room posts its `emoticon_unique` as the
+    /// message with dm_type 1 (and a literal "[object Object]" option field).
+    public func sendEmoticon(roomID: Int64, unique: String, reply: DanmakuReply? = nil, cookieHeader: String) async throws {
+        let csrf = try csrf(from: cookieHeader)
+        let replyDMID = reply?.danmakuID ?? ""
+        let body = form([
+            ("bubble", "0"), ("msg", unique), ("color", "16777215"), ("mode", "1"), ("room_type", "0"),
+            ("jumpfrom", "0"), ("reply_mid", reply.map { String($0.uid) } ?? "0"), ("reply_attr", "0"),
+            ("replay_dmid", replyDMID), ("reply_dmid", replyDMID),
+            ("dm_type", "1"), ("emoticonOptions", "[object Object]"),
+            ("statistics", #"{"appId":100,"platform":5}"#), ("fontsize", "25"),
+            ("rnd", String(Int(Date().timeIntervalSince1970))), ("roomid", String(roomID)),
+            ("csrf", csrf), ("csrf_token", csrf)
+        ])
+        _ = try await requestJSON(url: URL(string: "https://api.live.bilibili.com/msg/send")!,
+                                  cookieHeader: cookieHeader, body: body)
+    }
+}
+
+/// Emoticon pictures, downloaded once and kept small: each is scaled to at
+/// most 160 px and stored as PNG under Caches/LiveHime/emoticons, which is
+/// trimmed to 20 MB when it grows past 30 MB. Only Bilibili's image hosts
+/// are fetched, without cookies.
+@MainActor
+final class EmoticonImages {
+    static let shared = EmoticonImages()
+
+    let folder: URL
+    private var waiting: [String: [(String?) -> Void]] = [:]
+    private var trimmed = false
+    private let session: URLSession = {
+        let configuration = URLSessionConfiguration.ephemeral
+        configuration.httpCookieStorage = nil
+        configuration.httpShouldSetCookies = false
+        configuration.urlCache = nil
+        configuration.timeoutIntervalForRequest = 12
+        configuration.httpMaximumConnectionsPerHost = 4
+        return URLSession(configuration: configuration)
+    }()
+
+    init(folder: URL? = nil) {
+        self.folder = folder ?? FileManager.default.urls(for: .cachesDirectory, in: .userDomainMask)[0]
+            .appendingPathComponent("LiveHime/emoticons", isDirectory: true)
+    }
+
+    nonisolated static func allowed(_ address: String) -> URL? {
+        var address = address
+        if address.hasPrefix("//") { address = "https:" + address }
+        if address.hasPrefix("http://") { address = "https://" + address.dropFirst(7) }
+        guard let url = URL(string: address), url.scheme == "https", let host = url.host?.lowercased(),
+              ["hdslb.com", "biliimg.com"].contains(where: { host == $0 || host.hasSuffix("." + $0) }) else { return nil }
+        return url
+    }
+
+    func file(for address: String) -> URL {
+        let digest = SHA256.hash(data: Data(address.utf8)).map { String(format: "%02x", $0) }.joined()
+        return folder.appendingPathComponent(digest + ".png")
+    }
+
+    /// Calls `done` with the local PNG path, or nil when it cannot be had.
+    func fetch(_ address: String, done: @escaping (String?) -> Void) {
+        guard let url = Self.allowed(address) else { return done(nil) }
+        let target = file(for: address)
+        if FileManager.default.fileExists(atPath: target.path) { return done(target.path) }
+        if waiting[address] != nil { waiting[address]!.append(done); return }
+        waiting[address] = [done]
+        trimOnce()
+        Task { @MainActor in
+            var path: String?
+            if let (data, response) = try? await session.data(from: url),
+               (response as? HTTPURLResponse)?.statusCode == 200, data.count < 4_000_000,
+               let png = Self.smallPNG(data) {
+                try? FileManager.default.createDirectory(at: folder, withIntermediateDirectories: true)
+                if (try? png.write(to: target, options: .atomic)) != nil { path = target.path }
+            }
+            for callback in waiting.removeValue(forKey: address) ?? [] { callback(path) }
+        }
+    }
+
+    /// The first frame, scaled to at most 160 px, as PNG.
+    nonisolated static func smallPNG(_ data: Data) -> Data? {
+        guard let source = CGImageSourceCreateWithData(data as CFData, nil),
+              let image = CGImageSourceCreateThumbnailAtIndex(source, 0, [
+                  kCGImageSourceCreateThumbnailFromImageAlways: true,
+                  kCGImageSourceCreateThumbnailWithTransform: true,
+                  kCGImageSourceThumbnailMaxPixelSize: 160
+              ] as CFDictionary) else { return nil }
+        let out = NSMutableData()
+        guard let destination = CGImageDestinationCreateWithData(out, UTType.png.identifier as CFString, 1, nil) else { return nil }
+        CGImageDestinationAddImage(destination, image, nil)
+        return CGImageDestinationFinalize(destination) ? out as Data : nil
+    }
+
+    private func trimOnce() {
+        guard !trimmed else { return }
+        trimmed = true
+        let folder = folder
+        Task.detached(priority: .background) { Self.trim(folder, above: 30_000_000, to: 20_000_000) }
+    }
+
+    /// Removes the least recently written files until the folder is under `to` bytes.
+    nonisolated static func trim(_ folder: URL, above limit: Int, to target: Int) {
+        let keys: [URLResourceKey] = [.fileSizeKey, .contentModificationDateKey]
+        guard let files = try? FileManager.default.contentsOfDirectory(at: folder, includingPropertiesForKeys: keys) else { return }
+        var entries = files.compactMap { url -> (URL, Int, Date)? in
+            guard let values = try? url.resourceValues(forKeys: Set(keys)) else { return nil }
+            return (url, values.fileSize ?? 0, values.contentModificationDate ?? .distantPast)
+        }
+        var total = entries.reduce(0) { $0 + $1.1 }
+        guard total > limit else { return }
+        entries.sort { $0.2 < $1.2 }
+        for (url, size, _) in entries where total > target {
+            if (try? FileManager.default.removeItem(at: url)) != nil { total -= size }
+        }
+    }
+}
+
+extension CoreBridge {
+    static func fields(for pack: EmoticonPack) -> [String: Any] {
+        ["id": pack.id, "name": pack.name, "large": pack.large, "items": pack.items.map { item in
+            ["key": item.unique, "text": item.text, "name": item.name, "url": item.url, "w": item.width,
+             "h": item.height, "inline": item.inline, "usable": item.usable, "hint": item.hint] as [String: Any]
+        }]
+    }
+}
+
+/// Loads the room's emoticons. Emits {"event":"emoticons","ok":true,"room",
+/// "packs":[{"id","name","large","items":[{"key","text","name","url","w","h",
+/// "inline","usable","hint"}]}]} or {"event":"emoticons","ok":false,...}.
+@_cdecl("livehime_core_emoticons_load")
+public func livehime_core_emoticons_load() {
+    DispatchQueue.main.async {
+        MainActor.assumeIsolated {
+            guard let bridge = CoreBridge.shared else { return }
+            Task { @MainActor in
+                do {
+                    let (room, packs) = try await bridge.coordinator.emoticons()
+                    bridge.emit(["event": "emoticons", "ok": true, "room": room, "packs": packs.map(CoreBridge.fields(for:))])
+                } catch {
+                    bridge.emit(["event": "emoticons", "ok": false].merging(CoreBridge.errorFields(error)) { $1 })
+                }
+            }
+        }
+    }
+}
+
+/// Fetches an emoticon picture. Emits {"event":"emoticonImage","url","path"}
+/// ("path" empty when it could not be fetched).
+@_cdecl("livehime_core_emoticon_image")
+public func livehime_core_emoticon_image(_ url: UnsafePointer<CChar>?) {
+    let address = url.map { String(cString: $0) } ?? ""
+    DispatchQueue.main.async {
+        MainActor.assumeIsolated {
+            EmoticonImages.shared.fetch(address) { path in
+                CoreBridge.shared?.emit(["event": "emoticonImage", "url": address, "path": path ?? ""])
+            }
+        }
+    }
+}
+
+/// Sends the sticker `key` (an emoticon's "key"), optionally as a reply.
+/// Replies with {"event":"danmakuSent","ok",...,"sticker":true}.
+@_cdecl("livehime_core_send_emoticon")
+public func livehime_core_send_emoticon(_ key: UnsafePointer<CChar>?, _ replyUID: Int64,
+                                        _ replyDanmakuID: UnsafePointer<CChar>?) {
+    let unique = key.map { String(cString: $0) } ?? ""
+    let reply = replyUID > 0 ? DanmakuReply(uid: replyUID, danmakuID: replyDanmakuID.map { String(cString: $0) } ?? "") : nil
+    DispatchQueue.main.async {
+        MainActor.assumeIsolated {
+            guard let bridge = CoreBridge.shared else { return }
+            Task { @MainActor in
+                do {
+                    try await bridge.coordinator.sendEmoticon(unique, reply: reply)
+                    bridge.emit(["event": "danmakuSent", "ok": true, "sticker": true])
+                } catch {
+                    bridge.emit(["event": "danmakuSent", "ok": false, "sticker": true].merging(CoreBridge.errorFields(error)) { $1 })
+                }
+            }
+        }
+    }
+}
