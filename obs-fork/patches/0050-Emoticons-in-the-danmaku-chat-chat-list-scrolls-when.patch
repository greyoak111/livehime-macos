+/* Emoticons for tests, on the floating chat's feed or ("dock": true) the
+ * dock's: optional "ready" (bool; lets the feed act as signed in, while the
+ * core itself stays signed out so nothing reaches Bilibili), "inject" (an
+ * "emoticons" core event, as if loaded), "reset" (forget the list), "draft"
+ * (send box text), "scroll" (chat list position), "picker" (bool: show or hide the
+ * panel), "pack" (tab index) and "click" (row in the current pack). Replies
+ * with the panel and store state and the send box's draft. */
+void emoticons(obs_data_t *request, obs_data_t *response, void *)
+{
+	onUiThread([&] {
+		FeaturePanel *features = target->features();
+		DanmakuFeed *feed = obs_data_get_bool(request, "dock") ? features->feed() : features->floatingChat()->feed();
+		EmojiPicker *picker = feed->picker();
+		EmoticonStore *store = EmoticonStore::instance();
+		if (obs_data_has_user_value(request, "ready"))
+			feed->setReady(obs_data_get_bool(request, "ready"));
+		if (obs_data_get_bool(request, "reset"))
+			store->reset();
+		if (obs_data_has_user_value(request, "draft"))
+			feed->setDraft(QString::fromUtf8(obs_data_get_string(request, "draft")));
+		if (obs_data_has_user_value(request, "scroll"))
+			feed->setScrollValue(static_cast<int>(obs_data_get_int(request, "scroll")));
+		if (OBSDataAutoRelease inject = obs_data_get_obj(request, "inject"))
+			store->handleEvent(QJsonDocument::fromJson(QByteArray(obs_data_get_json(inject))).object());
+		if (obs_data_has_user_value(request, "picker"))
+			feed->setPickerVisible(obs_data_get_bool(request, "picker"));
+		if (obs_data_has_user_value(request, "pack"))
+			picker->setCurrentPack(static_cast<int>(obs_data_get_int(request, "pack")));
+		if (obs_data_has_user_value(request, "click"))
+			picker->activate(static_cast<int>(obs_data_get_int(request, "click")));
+		QApplication::processEvents();
+		static const char *statuses[] = {"idle", "loading", "ready", "failed"};
+		obs_data_set_string(response, "status", statuses[static_cast<int>(store->status())]);
+		obs_data_set_bool(response, "picker_visible", picker->isVisible());
+		obs_data_set_int(response, "packs", picker->packCount());
+		obs_data_set_int(response, "pack", picker->currentPack());
+		obs_data_set_int(response, "items", picker->itemCount());
+		obs_data_set_int(response, "pictures", picker->shownPictures());
+		obs_data_set_string(response, "hint", picker->hintText().toUtf8().constData());
+		obs_data_set_string(response, "draft", feed->draft().toUtf8().constData());
+		obs_data_set_int(response, "lines", feed->lineCount());
+		obs_data_set_bool(response, "list_enabled", feed->listEnabled());
+		obs_data_set_int(response, "scroll", feed->scrollValue());
+		obs_data_set_int(response, "scroll_max", feed->scrollMaximum());
+		const QRect area(picker->mapToGlobal(QPoint(0, 0)), picker->size());
+		obs_data_set_int(response, "picker_x", area.x());
+		obs_data_set_int(response, "picker_y", area.y());
+		obs_data_set_int(response, "picker_w", area.width());
+		obs_data_set_int(response, "picker_h", area.height());
+	});
+}
