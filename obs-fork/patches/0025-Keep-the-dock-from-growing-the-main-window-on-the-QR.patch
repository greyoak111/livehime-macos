From e8c513c868edf78f561d4a9ce09132fcf766fbfa Mon Sep 17 00:00:00 2001
From: greyoak111 <151205158+greyoak111@users.noreply.github.com>
Date: Thu, 24 Sep 2026 03:46:13 +0800
Subject: [PATCH 25/29] Keep the dock from growing the main window on the QR
 login page

The QR page is the tallest account page; its minimum height propagated up
through the splitter to the dock, and OBS grew the main window to fit,
pushing it under the Dock. The top section (account, go-live, stream
status) now sits in a scroll area like the room tab, and the QR code is
180 points.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 plugins/livehime/src/account-panel.cpp |  4 ++--
 plugins/livehime/src/livehime-dock.cpp | 10 +++++++++-
 2 files changed, 11 insertions(+), 3 deletions(-)

diff --git a/plugins/livehime/src/account-panel.cpp b/plugins/livehime/src/account-panel.cpp
index 78bbee824..6e525d8d5 100644
--- a/plugins/livehime/src/account-panel.cpp
+++ b/plugins/livehime/src/account-panel.cpp
@@ -150,7 +150,7 @@ void AccountPanel::applyState(const QJsonObject &state)
 	} else if (name == "qrCode") {
 		QPixmap qr;
 		qr.loadFromData(QByteArray::fromBase64(state.value("qrPng").toString().toLatin1()), "PNG");
-		qrImage_->setPixmap(qr.scaled(200, 200, Qt::KeepAspectRatio, Qt::SmoothTransformation));
+		qrImage_->setPixmap(qr.scaled(180, 180, Qt::KeepAspectRatio, Qt::SmoothTransformation));
 		qrHint_->setText(text(state.value("scanned").toBool() ? "LiveHime.Account.QR.Scanned"
 								      : "LiveHime.Account.QR.Hint"));
 		pages_->setCurrentIndex(QRCode);
@@ -375,7 +375,7 @@ QWidget *AccountPanel::buildQRCode()
 	auto *layout = new QVBoxLayout(page);
 	qrImage_ = new QLabel(page);
 	qrImage_->setAlignment(Qt::AlignCenter);
-	qrImage_->setMinimumSize(200, 200);
+	qrImage_->setMinimumSize(180, 180);
 	qrHint_ = wrapLabel(page);
 	qrHint_->setAlignment(Qt::AlignCenter);
 	auto *cancel = new QPushButton(text("LiveHime.Account.Cancel"), page);
diff --git a/plugins/livehime/src/livehime-dock.cpp b/plugins/livehime/src/livehime-dock.cpp
index e52d00c59..8bb90f465 100644
--- a/plugins/livehime/src/livehime-dock.cpp
+++ b/plugins/livehime/src/livehime-dock.cpp
@@ -10,6 +10,7 @@
 #include <QLabel>
 #include <QLineEdit>
 #include <QPushButton>
+#include <QScrollArea>
 #include <QSplitter>
 #include <QVBoxLayout>
 
@@ -91,7 +92,14 @@ LiveHimeDock::LiveHimeDock(QWidget *parent) : QWidget(parent), controller_(new S
 	splitter_ = new QSplitter(Qt::Vertical, this);
 	splitter_->setChildrenCollapsible(false);
 	splitter_->setHandleWidth(8);
-	splitter_->addWidget(top);
+	/* Scrollable, so a taller page (the QR code) never raises the dock's
+	 * minimum height and makes OBS grow its main window. */
+	auto *topScroll = new QScrollArea(this);
+	topScroll->setWidget(top);
+	topScroll->setWidgetResizable(true);
+	topScroll->setFrameShape(QFrame::NoFrame);
+	topScroll->setHorizontalScrollBarPolicy(Qt::ScrollBarAlwaysOff);
+	splitter_->addWidget(topScroll);
 	splitter_->addWidget(featureBox);
 	splitter_->setStretchFactor(0, 0);
 	splitter_->setStretchFactor(1, 1);
