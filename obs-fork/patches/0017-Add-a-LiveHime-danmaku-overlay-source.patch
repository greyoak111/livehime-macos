index 000000000..eef54fe06
--- /dev/null
+++ b/build-aux/livehime/tests/e2e-overlay.mjs
@@ -0,0 +1,71 @@
+// Checks the "LiveHime danmaku" overlay source renders injected messages.
+// Works in a temporary scene that is removed afterwards.
+import { createHash } from 'node:crypto';
+import { writeFileSync } from 'node:fs';
+import zlib from 'node:zlib';
+
+const sha = (s) => createHash('sha256').update(s).digest('base64');
+const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
+const ws = new WebSocket('ws://127.0.0.1:4466');
+let id = 1;
+const pend = new Map();
+const req = (t, d = {}) => new Promise((r) => { const k = String(id++); pend.set(k, r); ws.send(JSON.stringify({ op: 6, d: { requestType: t, requestId: k, requestData: d } })); });
+const vendor = async (t, d = {}) => (await req('CallVendorRequest', { vendorName: 'livehime', requestType: t, requestData: d })).responseData?.responseData;
+let fails = 0;
+const check = (n, ok, i = '') => { if (!ok) fails++; console.log(`${ok ? 'PASS' : 'FAIL'}  ${n}${i ? '  — ' + i : ''}`); };
+
+// Minimal PNG decode (8-bit RGBA, non-interlaced) to count visible pixels.
+function visiblePixels(png) {
+  let o = 8, w = 0, h = 0; const idat = [];
+  while (o < png.length) {
+    const len = png.readUInt32BE(o), type = png.toString('ascii', o + 4, o + 8), data = png.subarray(o + 8, o + 8 + len);
+    if (type === 'IHDR') { w = data.readUInt32BE(0); h = data.readUInt32BE(4); if (data[8] !== 8 || data[9] !== 6) return { w, h, count: -1 }; }
+    if (type === 'IDAT') idat.push(data);
+    o += 12 + len;
+  }
+  const raw = zlib.inflateSync(Buffer.concat(idat)), stride = w * 4; let prev = Buffer.alloc(stride), count = 0;
+  for (let y = 0; y < h; y++) {
+    const f = raw[y * (stride + 1)], line = Buffer.from(raw.subarray(y * (stride + 1) + 1, (y + 1) * (stride + 1)));
+    for (let x = 0; x < stride; x++) {
+      const a = x >= 4 ? line[x - 4] : 0, b = prev[x], c = x >= 4 ? prev[x - 4] : 0;
+      const p = f === 1 ? a : f === 2 ? b : f === 3 ? (a + b) >> 1 : f === 4 ? (() => { const pa = Math.abs(b - c), pb = Math.abs(a - c), pc = Math.abs(a + b - 2 * c); return pa <= pb && pa <= pc ? a : pb <= pc ? b : c; })() : 0;
+      line[x] = (line[x] + p) & 255;
+    }
+    for (let x = 3; x < stride; x += 4) if (line[x] > 128) count++;
+    prev = line;
+  }
+  return { w, h, count };
+}
+
+async function shot(name) {
+  const r = await req('GetSourceScreenshot', { sourceName: name, imageFormat: 'png' });
+  const png = Buffer.from(r.responseData.imageData.split(',')[1], 'base64');
+  return { png, ...visiblePixels(png) };
+}
+
+ws.onmessage = async (ev) => {
+  const m = JSON.parse(ev.data);
+  if (m.op === 0) { const { challenge, salt } = m.d.authentication; ws.send(JSON.stringify({ op: 1, d: { rpcVersion: 1, authentication: sha(sha(process.argv[2] + salt) + challenge), eventSubscriptions: 0 } })); }
+  else if (m.op === 7) pend.get(m.d.requestId)?.(m.d);
+  else if (m.op === 2) {
+    for (let i = 0; i < 40 && !(await req('GetVersion')).requestStatus.result; i++) await sleep(500);
+    const scene = 'livehime-e2e', input = 'livehime-e2e-danmaku';
+    await req('CreateScene', { sceneName: scene });
+    const created = await req('CreateInput', { sceneName: scene, inputName: input, inputKind: 'livehime_danmaku_overlay', inputSettings: { lifetime: 0 } });
+    check('overlay source can be created', created.requestStatus.result, created.requestStatus.comment);
+    await sleep(800);
+    const empty = await shot(input);
+    check('empty overlay renders nothing', empty.count === 0, `${empty.w}x${empty.h}, ${empty.count} px`);
+    for (const [user, text] of [['观众A', '主播好！'], ['观众B', '这个画面好清楚'], ['观众C', 'hello LiveHime']])
+      await vendor('InjectOverlayEvent', { kind: 'chat', user, text });
+    await vendor('InjectOverlayEvent', { kind: 'gift', user: '观众D', name: '小心心', count: 3 });
+    await sleep(1200);
+    const full = await shot(input);
+    writeFileSync(process.argv[3] || '/tmp/overlay.png', full.png);
+    check('injected messages are drawn', full.count > 500, `${full.w}x${full.h}, ${full.count} px`);
+    await req('RemoveScene', { sceneName: scene });
+    const gone = await req('GetSceneList');
+    check('temporary scene removed', !gone.responseData.scenes.some((s) => s.sceneName === scene));
+    console.log(fails ? `${fails} failed` : 'all passed'); process.exit(fails ? 1 : 0);
+  }
+};
