+/* Test hook: feeds a room event ({"kind","user","text",...}) to the danmaku
+ * overlays only. Nothing is sent to Bilibili. */
+void injectOverlayEvent(obs_data_t *request, obs_data_t *response, void *)
+{
+	const char *json = obs_data_get_json(request);
+	const QJsonObject event = QJsonDocument::fromJson(QByteArray(json)).object();
+	const bool ran = onUiThread([&] {
+		QJsonObject room = event;
+		room.insert("event", "room");
+		if (DanmakuOverlayHub *hub = DanmakuOverlayHub::instance())
+			hub->push(room);
+	});
+	obs_data_set_bool(response, "accepted", ran);
+}
+
