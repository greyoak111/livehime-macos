diff --git a/plugins/livehime/src/danmaku-overlay.cpp b/plugins/livehime/src/danmaku-overlay.cpp
new file mode 100644
index 000000000..9730d6058
--- /dev/null
+++ b/plugins/livehime/src/danmaku-overlay.cpp
@@ -0,0 +1,282 @@
+#include "danmaku-overlay.hpp"
+
+#include <obs-module.h>
+#include <obs.hpp>
+
+#include <QDateTime>
+#include <QStringList>
+
+#include <atomic>
+#include <deque>
+
+namespace {
+constexpr int kDefaultLines = 8;
+constexpr int kDefaultLifetime = 30;
+constexpr int kDefaultWidth = 700;
+constexpr int kDefaultFontSize = 36;
+/* FreeType finds fonts on disk; PingFang lives in a system asset store it
+ * cannot see, while Hiragino Sans GB ships in /System/Library/Fonts. */
+constexpr const char *kDefaultFace = "Hiragino Sans GB";
+
+QString text(const char *key)
+{
+	return QString::fromUtf8(obs_module_text(key));
+}
+} // namespace
+
+struct DanmakuOverlay {
+	obs_source_t *self = nullptr;
+	obs_source_t *label = nullptr; /* private text_ft2_source_v2 */
+
+	std::atomic<int> width{kDefaultWidth};
+	std::atomic<int> height{kDefaultLines * kDefaultFontSize * 4 / 3};
+
+	/* Touched on the UI thread only (hub push/refresh). */
+	int maxLines = kDefaultLines;
+	int lifetimeSeconds = kDefaultLifetime;
+	bool showGifts = true;
+	bool showSuperChats = true;
+	bool showGuards = true;
+	struct Line {
+		QString text;
+		qint64 postedMs;
+	};
+	std::deque<Line> lines;
+	QString shown;
+};
+
+DanmakuOverlayHub *DanmakuOverlayHub::instance_ = nullptr;
+
+DanmakuOverlayHub::DanmakuOverlayHub()
+{
+	timer_.setInterval(500);
+	connect(&timer_, &QTimer::timeout, this, &DanmakuOverlayHub::refresh);
+	timer_.start();
+}
+
+void DanmakuOverlayHub::create()
+{
+	if (!instance_)
+		instance_ = new DanmakuOverlayHub();
+}
+
+void DanmakuOverlayHub::destroy()
+{
+	delete instance_;
+	instance_ = nullptr;
+}
+
+void DanmakuOverlayHub::add(DanmakuOverlay *overlay)
+{
+	std::lock_guard lock(mutex_);
+	overlays_.insert(overlay);
+}
+
+void DanmakuOverlayHub::remove(DanmakuOverlay *overlay)
+{
+	std::lock_guard lock(mutex_);
+	overlays_.erase(overlay);
+}
+
+void DanmakuOverlayHub::push(const QJsonObject &event)
+{
+	if (event.value("event").toString() != "room")
+		return;
+	const QString kind = event.value("kind").toString();
+	const QString user = event.value("user").toString();
+	QString line;
+	if (kind == "chat")
+		line = user + QStringLiteral("：") + event.value("text").toString();
+	else if (kind == "gift")
+		line = text("LiveHime.Feature.Gift").arg(user, event.value("name").toString()).arg(event.value("count").toInt());
+	else if (kind == "superChat")
+		line = text("LiveHime.Feature.SuperChat")
+			       .arg(event.value("price").toInt())
+			       .arg(user, event.value("text").toString());
+	else if (kind == "guard")
+		line = text("LiveHime.Feature.Guard").arg(user, event.value("name").toString());
+	else
+		return;
+
+	const qint64 now = QDateTime::currentMSecsSinceEpoch();
+	std::lock_guard lock(mutex_);
+	for (DanmakuOverlay *overlay : overlays_) {
+		if ((kind == "gift" && !overlay->showGifts) || (kind == "superChat" && !overlay->showSuperChats) ||
+		    (kind == "guard" && !overlay->showGuards))
+			continue;
+		overlay->lines.push_back({line, now});
+		while (static_cast<int>(overlay->lines.size()) > overlay->maxLines)
+			overlay->lines.pop_front();
+	}
+}
+
+void DanmakuOverlayHub::refresh()
+{
+	const qint64 now = QDateTime::currentMSecsSinceEpoch();
+	std::lock_guard lock(mutex_);
+	for (DanmakuOverlay *overlay : overlays_) {
+		if (overlay->lifetimeSeconds > 0) {
+			while (!overlay->lines.empty() && now - overlay->lines.front().postedMs > overlay->lifetimeSeconds * 1000LL)
+				overlay->lines.pop_front();
+		}
+		QStringList rows;
+		for (const auto &line : overlay->lines)
+			rows << line.text;
+		const QString joined = rows.join(QStringLiteral("\n"));
+		if (joined == overlay->shown)
+			continue;
+		overlay->shown = joined;
+		OBSDataAutoRelease update = obs_data_create();
+		/* An empty string would fall back to the text source's placeholder. */
+		obs_data_set_string(update, "text", joined.isEmpty() ? " " : joined.toUtf8().constData());
+		obs_source_update(overlay->label, update);
+	}
+}
+
+/* ---- obs_source_info ---- */
+
+namespace {
+const char *overlayName(void *)
+{
+	return obs_module_text("LiveHime.Overlay.Name");
+}
+
+void overlayUpdate(void *data, obs_data_t *settings)
+{
+	auto *overlay = static_cast<DanmakuOverlay *>(data);
+	OBSDataAutoRelease font = obs_data_get_obj(settings, "font");
+	const int fontSize = font ? static_cast<int>(obs_data_get_int(font, "size")) : kDefaultFontSize;
+	const int lines = static_cast<int>(obs_data_get_int(settings, "lines"));
+	const int width = static_cast<int>(obs_data_get_int(settings, "width"));
+	overlay->width = width;
+	overlay->height = lines * (fontSize > 0 ? fontSize : kDefaultFontSize) * 4 / 3;
+
+	if (DanmakuOverlayHub *hub = DanmakuOverlayHub::instance()) {
+		hub->remove(overlay);
+		overlay->maxLines = lines;
+		overlay->lifetimeSeconds = static_cast<int>(obs_data_get_int(settings, "lifetime"));
+		overlay->showGifts = obs_data_get_bool(settings, "show_gifts");
+		overlay->showSuperChats = obs_data_get_bool(settings, "show_super_chats");
+		overlay->showGuards = obs_data_get_bool(settings, "show_guards");
+		while (static_cast<int>(overlay->lines.size()) > overlay->maxLines)
+			overlay->lines.pop_front();
+		hub->add(overlay);
+	}
+
+	OBSDataAutoRelease label = obs_data_create();
+	/* Copy the font explicitly: settings merges keep only set values, so
+	 * passing an object that holds defaults would reach the text source
+	 * as an empty font. */
+	OBSDataAutoRelease labelFont = obs_data_create();
+	obs_data_set_string(labelFont, "face", font ? obs_data_get_string(font, "face") : kDefaultFace);
+	obs_data_set_string(labelFont, "style", font ? obs_data_get_string(font, "style") : "");
+	obs_data_set_int(labelFont, "size", fontSize > 0 ? fontSize : kDefaultFontSize);
+	obs_data_set_int(labelFont, "flags", font ? obs_data_get_int(font, "flags") : 0);
+	obs_data_set_obj(label, "font", labelFont);
+	const long long color = obs_data_get_int(settings, "color");
+	obs_data_set_int(label, "color1", color);
+	obs_data_set_int(label, "color2", color);
+	obs_data_set_bool(label, "outline", obs_data_get_bool(settings, "outline"));
+	obs_data_set_bool(label, "drop_shadow", obs_data_get_bool(settings, "drop_shadow"));
+	obs_data_set_bool(label, "word_wrap", true);
+	obs_data_set_int(label, "custom_width", width);
+	obs_source_update(overlay->label, label);
+}
+
+void *overlayCreate(obs_data_t *settings, obs_source_t *source)
+{
+	auto *overlay = new DanmakuOverlay();
+	overlay->self = source;
+	OBSDataAutoRelease label = obs_data_create();
+	obs_data_set_string(label, "text", " ");
+	overlay->label = obs_source_create_private("text_ft2_source_v2", "livehime-danmaku-text", label);
+	if (!overlay->label) {
+		delete overlay;
+		return nullptr;
+	}
+	overlayUpdate(overlay, settings);
+	return overlay;
+}
+
+void overlayDestroy(void *data)
+{
+	auto *overlay = static_cast<DanmakuOverlay *>(data);
+	if (DanmakuOverlayHub *hub = DanmakuOverlayHub::instance())
+		hub->remove(overlay);
+	obs_source_release(overlay->label);
+	delete overlay;
+}
+
+uint32_t overlayWidth(void *data)
+{
+	return static_cast<uint32_t>(static_cast<DanmakuOverlay *>(data)->width.load());
+}
+
+uint32_t overlayHeight(void *data)
+{
+	return static_cast<uint32_t>(static_cast<DanmakuOverlay *>(data)->height.load());
+}
+
+void overlayRender(void *data, gs_effect_t *)
+{
+	obs_source_video_render(static_cast<DanmakuOverlay *>(data)->label);
+}
+
+void overlayDefaults(obs_data_t *settings)
+{
+	OBSDataAutoRelease font = obs_data_create();
+	obs_data_set_default_string(font, "face", kDefaultFace);
+	obs_data_set_default_int(font, "size", kDefaultFontSize);
+	obs_data_set_default_int(font, "flags", 0);
+	obs_data_set_default_string(font, "style", "W3");
+	obs_data_set_default_obj(settings, "font", font);
+	obs_data_set_default_int(settings, "lines", kDefaultLines);
+	obs_data_set_default_int(settings, "lifetime", kDefaultLifetime);
+	obs_data_set_default_int(settings, "width", kDefaultWidth);
+	obs_data_set_default_int(settings, "color", 0xFFFFFFFF);
+	obs_data_set_default_bool(settings, "outline", true);
+	obs_data_set_default_bool(settings, "drop_shadow", false);
+	obs_data_set_default_bool(settings, "show_gifts", true);
+	obs_data_set_default_bool(settings, "show_super_chats", true);
+	obs_data_set_default_bool(settings, "show_guards", true);
+}
+
+obs_properties_t *overlayProperties(void *)
+{
+	obs_properties_t *props = obs_properties_create();
+	obs_properties_add_font(props, "font", obs_module_text("LiveHime.Overlay.Font"));
+	obs_properties_add_color_alpha(props, "color", obs_module_text("LiveHime.Overlay.Color"));
+	obs_properties_add_bool(props, "outline", obs_module_text("LiveHime.Overlay.Outline"));
+	obs_properties_add_bool(props, "drop_shadow", obs_module_text("LiveHime.Overlay.Shadow"));
+	obs_properties_add_int_slider(props, "lines", obs_module_text("LiveHime.Overlay.Lines"), 1, 30, 1);
+	obs_property_t *lifetime =
+		obs_properties_add_int(props, "lifetime", obs_module_text("LiveHime.Overlay.Lifetime"), 0, 3600, 5);
+	obs_property_int_set_suffix(lifetime, " s");
+	obs_property_set_long_description(lifetime, obs_module_text("LiveHime.Overlay.LifetimeHint"));
+	obs_property_t *width = obs_properties_add_int(props, "width", obs_module_text("LiveHime.Overlay.Width"), 100, 3840, 10);
+	obs_property_int_set_suffix(width, " px");
+	obs_properties_add_bool(props, "show_gifts", obs_module_text("LiveHime.Overlay.ShowGifts"));
+	obs_properties_add_bool(props, "show_super_chats", obs_module_text("LiveHime.Overlay.ShowSuperChats"));
+	obs_properties_add_bool(props, "show_guards", obs_module_text("LiveHime.Overlay.ShowGuards"));
+	return props;
+}
+} // namespace
+
+void RegisterDanmakuOverlaySource()
+{
+	obs_source_info info = {};
