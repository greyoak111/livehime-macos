 	obs_websocket_vendor_register_request(vendor, "GetAccountState", getAccountState, nullptr);
 	obs_websocket_vendor_register_request(vendor, "GetBrandingState", getBrandingState, nullptr);
+	obs_websocket_vendor_register_request(vendor, "InjectOverlayEvent", injectOverlayEvent, nullptr);
 	obs_websocket_vendor_register_request(vendor, "StartQRLogin", startQRLogin, nullptr);
 	obs_websocket_vendor_register_request(vendor, "CancelQRLogin", cancelQRLogin, nullptr);
 }
