@@ -115,6 +116,7 @@ FeaturePanel::FeaturePanel(QWidget *parent) : QWidget(parent)
 	auto *shield = new QGroupBox(text("LiveHime.Feature.Keywords"), roomPage);
 	keywords_ = new QListWidget(shield);
 	keywords_->setSelectionMode(QAbstractItemView::ExtendedSelection);
+	keywords_->setMinimumHeight(110);
 	newKeyword_ = new QLineEdit(shield);
 	newKeyword_->setPlaceholderText(text("LiveHime.Feature.KeywordPlaceholder"));
 	addKeyword_ = new QPushButton(text("LiveHime.Feature.AddKeyword"), shield);
@@ -145,9 +147,16 @@ FeaturePanel::FeaturePanel(QWidget *parent) : QWidget(parent)
 			livehime_core_set_shield_keyword(item->text().toUtf8().constData(), 0);
 	});
 
+	/* The room tab keeps its natural size and scrolls when the dock is
+	 * short, instead of squashing the blocked-words controls. */
+	auto *roomScroll = new QScrollArea(this);
+	roomScroll->setWidget(roomPage);
