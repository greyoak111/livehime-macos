From 58ffa3a4604878cba5c2d175971c73e06d6c6aea Mon Sep 17 00:00:00 2001
From: greyoak111 <151205158+greyoak111@users.noreply.github.com>
Date: Fri, 25 Sep 2026 22:32:46 +0800
Subject: [PATCH 52/53] Scroll the Captions and Updates tabs instead of
 squashing them

In a short dock their text was squeezed; they now scroll like the Room tab.
The Snapshot test hook can render the dock at a given height.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 plugins/livehime/src/automation.cpp    |  9 +++++++--
 plugins/livehime/src/feature-panel.cpp | 20 ++++++++++++++++----
 plugins/livehime/src/feature-panel.hpp |  1 +
 3 files changed, 24 insertions(+), 6 deletions(-)

diff --git a/plugins/livehime/src/automation.cpp b/plugins/livehime/src/automation.cpp
index c1f619ba0..dc13a9c3b 100644
--- a/plugins/livehime/src/automation.cpp
+++ b/plugins/livehime/src/automation.cpp
@@ -254,16 +254,21 @@ void probe(obs_data_t *request, obs_data_t *response, void *)
 	});
 }
 
-/* Test hook: renders the dock (optionally switched to "tab" 0-3) into the
- * PNG file "path", as it would appear on screen. */
+/* Test hook: renders the dock (optionally switched to "tab" 0-3, and
+ * optionally at height "h" to see how it fits a short dock) into the PNG
+ * file "path", as it would appear on screen. */
 void snapshot(obs_data_t *request, obs_data_t *response, void *)
 {
 	const QString path = QString::fromUtf8(obs_data_get_string(request, "path"));
 	onUiThread([&] {
 		if (obs_data_has_user_value(request, "tab"))
 			target->features()->tabs()->setCurrentIndex(static_cast<int>(obs_data_get_int(request, "tab")));
+		const QSize size = target->size();
+		if (obs_data_has_user_value(request, "h"))
+			target->resize(size.width(), static_cast<int>(obs_data_get_int(request, "h")));
 		QApplication::processEvents();
 		const bool ok = !path.isEmpty() && target->grab().save(path, "PNG");
+		target->resize(size);
 		obs_data_set_bool(response, "saved", ok);
 	});
 }
diff --git a/plugins/livehime/src/feature-panel.cpp b/plugins/livehime/src/feature-panel.cpp
index b60dffd57..1ac4a4f17 100644
--- a/plugins/livehime/src/feature-panel.cpp
+++ b/plugins/livehime/src/feature-panel.cpp
@@ -146,6 +146,18 @@ FeaturePanel::FeaturePanel(QWidget *parent) : QWidget(parent)
 	/* Captions tab: works without signing in. */
 	captions_ = new CaptionsPage(this);
 	updates_ = new UpdatePage(this);
+	/* Like the room tab, these scroll when the dock is short rather than
+	 * squashing their text. */
+	auto scrolled = [this](QWidget *page) {
+		auto *area = new QScrollArea(this);
+		area->setWidget(page);
+		area->setWidgetResizable(true);
+		area->setFrameShape(QFrame::NoFrame);
+		area->setHorizontalScrollBarPolicy(Qt::ScrollBarAlwaysOff);
+		return area;
+	};
+	QScrollArea *captionsScroll = scrolled(captions_);
+	updatesTab_ = scrolled(updates_);
 
 	/* A slim notice above the tabs when an update is found or downloaded. */
 	updateBanner_ = new QWidget(this);
@@ -169,9 +181,9 @@ FeaturePanel::FeaturePanel(QWidget *parent) : QWidget(parent)
 	connect(updateBannerButton_, &QPushButton::clicked, this, [this] {
 		if (!updates_->readyVersion().isEmpty()) {
 			if (!updates_->restartNow())
-				tabs_->setCurrentWidget(updates_);
+				tabs_->setCurrentWidget(updatesTab_);
 		} else {
-			tabs_->setCurrentWidget(updates_);
+			tabs_->setCurrentWidget(updatesTab_);
 		}
 	});
 	connect(updates_, &UpdatePage::available, this, [this](const QString &version) {
@@ -192,8 +204,8 @@ FeaturePanel::FeaturePanel(QWidget *parent) : QWidget(parent)
 	tabs_ = new QTabWidget(this);
 	tabs_->addTab(danmakuPage, text("LiveHime.Feature.DanmakuTab"));
 	tabs_->addTab(roomScroll, text("LiveHime.Feature.RoomTab"));
-	tabs_->addTab(captions_, text("LiveHime.Captions.Tab"));
-	tabs_->addTab(updates_, text("LiveHime.Update.Tab"));
+	tabs_->addTab(captionsScroll, text("LiveHime.Captions.Tab"));
+	tabs_->addTab(updatesTab_, text("LiveHime.Update.Tab"));
 
 	auto *layout = new QVBoxLayout(this);
 	layout->setContentsMargins(0, 0, 0, 0);
diff --git a/plugins/livehime/src/feature-panel.hpp b/plugins/livehime/src/feature-panel.hpp
index 47f15c7a9..45f57d856 100644
--- a/plugins/livehime/src/feature-panel.hpp
+++ b/plugins/livehime/src/feature-panel.hpp
@@ -56,6 +56,7 @@ private:
 	QWidget *roomPage_;
 	CaptionsPage *captions_;
 	UpdatePage *updates_;
+	QWidget *updatesTab_;
 	QWidget *updateBanner_;
 	QLabel *updateBannerText_;
 	QPushButton *updateBannerButton_;
-- 
