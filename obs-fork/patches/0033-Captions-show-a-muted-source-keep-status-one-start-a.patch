diff --git a/plugins/livehime/src/caption-controller.cpp b/plugins/livehime/src/caption-controller.cpp
index a00b9d94e..e266e1722 100644
--- a/plugins/livehime/src/caption-controller.cpp
+++ b/plugins/livehime/src/caption-controller.cpp
@@ -28,7 +28,15 @@ void CaptionController::frontendEvent(enum obs_frontend_event event, void *param
 	auto *self = static_cast<CaptionController *>(param);
 	switch (event) {
 	case OBS_FRONTEND_EVENT_FINISHED_LOADING:
+		self->loaded_ = true;
+		self->stop();
+		if (self->enabled_)
+			self->start();
+		break;
 	case OBS_FRONTEND_EVENT_SCENE_COLLECTION_CHANGED:
+		/* Also sent during startup, before FINISHED_LOADING. */
+		if (!self->loaded_)
+			break;
 		self->stop();
 		if (self->enabled_)
 			self->start();
@@ -47,7 +55,7 @@ bool CaptionController::supported()
 	return livehime_core_captions_supported() != 0;
 }
 
-void CaptionController::configure(bool enabled, const QString &sourceUuid, const QString &locale)
+bool CaptionController::configure(bool enabled, const QString &sourceUuid, const QString &locale)
 {
 	const bool restart = enabled != enabled_ || sourceUuid != sourceUuid_ || locale != locale_;
 	enabled_ = enabled;
@@ -55,10 +63,11 @@ void CaptionController::configure(bool enabled, const QString &sourceUuid, const
 	locale_ = locale.isEmpty() ? QStringLiteral("zh-CN") : locale;
 	save();
 	if (!restart)
-		return;
