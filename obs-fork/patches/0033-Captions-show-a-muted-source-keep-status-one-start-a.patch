 .../Sources/LiveHimeCore/LiveCaptions.swift   | 40 ++++++++++++-------
 plugins/livehime/data/locale/en-US.ini        |  1 +
 plugins/livehime/data/locale/zh-CN.ini        |  1 +
 plugins/livehime/src/caption-controller.cpp   | 15 ++++++-
 plugins/livehime/src/caption-controller.hpp   | 10 ++++-
 plugins/livehime/src/captions-page.cpp        | 38 +++++++++++++-----
 plugins/livehime/src/captions-page.hpp        |  4 ++
 8 files changed, 93 insertions(+), 28 deletions(-)

diff --git a/build-aux/livehime/tests/e2e-captions.mjs b/build-aux/livehime/tests/e2e-captions.mjs
index a8d19acd0..94e9b66dc 100644
--- a/build-aux/livehime/tests/e2e-captions.mjs
+++ b/build-aux/livehime/tests/e2e-captions.mjs
@@ -50,6 +50,18 @@ ws.onmessage = async (ev) => {
     check('recognized the speech', /欢迎来到我的直播间/.test(st?.caption || ''), st?.caption);
     check('homophone fixed (直播姬)', /直播姬/.test(st?.caption || ''), st?.caption);
     check('captions source shows the latest words, bottom-aligned', (st?.overlay || '').replace(/\n/g, '').length > 0 && (st.caption || '').endsWith((st.overlay || '').replace(/^\n+/, '').slice(-6)), JSON.stringify(st?.overlay));
+    // A muted source sends silence; the tab says so.
+    await req('SetInputMute', { inputName: MEDIA, inputMuted: true });
+    await req('TriggerMediaInputAction', { inputName: MEDIA, mediaAction: 'OBS_WEBSOCKET_MEDIA_INPUT_ACTION_RESTART' });
+    await sleep(1500);
+    st = await vendor('Captions');
+    check('muted source is shown in the status', /静音|muted/.test(st?.status), st?.status);
+    await req('SetInputMute', { inputName: MEDIA, inputMuted: false });
+    // Choosing the same settings again keeps the recognizer running.
+    st = await vendor('Captions', { enabled: true, source: MEDIA, locale: 'zh-CN' });
+    await sleep(600);
+    st = await vendor('Captions');
+    check('re-applying the same settings keeps listening', /正在识别|Listening/.test(st?.status), st?.status);
   } catch (e) { check('run', false, e.stack); }
   finally {
     await vendor('Captions', { enabled: before?.enabled ?? false, source: '', locale: '' });
diff --git a/plugins/livehime/core/Sources/LiveHimeCore/LiveCaptions.swift b/plugins/livehime/core/Sources/LiveHimeCore/LiveCaptions.swift
index 995ba2d23..686220c49 100644
--- a/plugins/livehime/core/Sources/LiveHimeCore/LiveCaptions.swift
+++ b/plugins/livehime/core/Sources/LiveHimeCore/LiveCaptions.swift
@@ -196,24 +196,26 @@ final class LiveCaptioner: @unchecked Sendable {
 }
 
 /// The running captioner, shared between the main thread (start / stop)
-/// and the audio thread (push).
+/// and the audio thread (push). Starts and stops run one after another, so
+/// two recognizers never prepare the language model at the same time.
 final class CaptionSession: @unchecked Sendable {
     static let shared = CaptionSession()
     private let lock = NSLock()
     private var captioner: AnyObject?
     private var generation = 0
+    private var chain: Task<Void, Never>?
 
     func start(locale: String) {
         guard #available(macOS 26, *) else {
             Self.emit(["event": "captions", "status": "unsupported"])
             return
         }
-        stop()
-        let id = lock.withLock { () -> Int in
+        let (id, previous, running) = lock.withLock { () -> (Int, LiveCaptioner?, Task<Void, Never>?) in
             generation += 1
-            return generation
+            return (generation, self.captioner as? LiveCaptioner, chain)
         }
         let captioner = LiveCaptioner(localeIdentifier: locale) { [weak self] event in
+            // Events from a replaced session are dropped.
             guard let self, self.lock.withLock({ self.generation == id }) else { return }
             switch event {
             case .preparing: Self.emit(["event": "captions", "status": "preparing"])
@@ -223,8 +225,14 @@ final class CaptionSession: @unchecked Sendable {
             case .failed(let message): Self.emit(["event": "captions", "status": "failed", "message": message])
             }
         }
-        lock.withLock { self.captioner = captioner }
-        Task { await captioner.start() }
+        lock.withLock {
+            self.captioner = captioner
+            chain = Task {
+                await running?.value
+                await previous?.stop()
+                await captioner.start()
+            }
+        }
     }
 
     func push(_ samples: UnsafePointer<Float>, count: Int, sampleRate: Double) {
@@ -235,16 +243,18 @@ final class CaptionSession: @unchecked Sendable {
 
     func stop() {
         guard #available(macOS 26, *) else { return }
-        let (captioner, id) = lock.withLock { () -> (LiveCaptioner?, Int) in
-            defer { self.captioner = nil }
+        lock.withLock {
+            guard let current = self.captioner as? LiveCaptioner else { return }
             generation += 1
-            return (self.captioner as? LiveCaptioner, generation)
-        }
-        guard let captioner else { return }
-        Task {
-            await captioner.stop()
-            // Unless a new session started meanwhile.
-            if lock.withLock({ generation == id }) { Self.emit(["event": "captions", "status": "stopped"]) }
+            let id = generation
+            let running = chain
+            self.captioner = nil
+            chain = Task {
+                await running?.value
+                await current.stop()
+                // Unless a new session started meanwhile.
+                if self.lock.withLock({ self.generation == id }) { Self.emit(["event": "captions", "status": "stopped"]) }
+            }
         }
     }
 
