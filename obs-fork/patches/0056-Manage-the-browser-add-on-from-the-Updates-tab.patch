+/// When the browser source is installed and the update moves to another OBS
+/// base, downloads and stages the add-on for that base too, so both are ready
+/// before LiveHime restarts. Returns why that failed; the app update still
+/// goes ahead then, and the old add-on is simply not loaded until updated.
+func stageAddon(for release: AppRelease, app: URL) async -> String? {
+    let fm = FileManager.default
+    guard fm.fileExists(atPath: AddonManager.installedBundle.path),
+          !fm.fileExists(atPath: AddonManager.removalMarker.path),
+          let installed = AddonManager.manifest(of: AddonManager.installedBundle) else { return nil }
+    let obs = AddonManager.obsBase(AppUpdater.obsVersion(of: app))
+    if installed.obs == obs { return nil }
+    if let pending = AddonManager.manifest(of: AddonManager.pendingBundle), pending.obs == obs { return nil }
+    do {
+        let offer = try await AddonManager.offer(for: release, obs: obs)
+        let bundle = try await AddonManager.download(offer) { _ in }
+        try AddonManager.stage(bundle)
+        return nil
+    } catch {
+        return (error as? AppUpdateError)?.errorDescription ?? error.localizedDescription
+    }
+}
+
+/// Tries staging the browser source for the downloaded update again. Emits
+/// "ready" (with "addonProblem" if it failed again).
+@_cdecl("livehime_core_update_retry_addon")
+public func livehime_core_update_retry_addon() {
+    onMainThread {
+        let state = UpdateState.shared
+        guard !state.busy, let release = state.release, let staged = state.staged else { return }
+        state.busy = true
+        Task.detached {
+            let problem = await stageAddon(for: release, app: staged)
+            await MainActor.run {
+                state.busy = false
+                state.addonProblem = problem
+                state.emit(["status": "ready"].merging(state.releaseFields(release)) { $1 })
+            }
+        }
+    }
+}
