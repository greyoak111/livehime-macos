+void UpdatePage::handleAddonEvent(const QJsonObject &event)
+{
+	addonState_ = event.value("state").toString();
+	addonStatus_ = event.value("status").toString();
+	addonInstalled_ = event.value("installed").toString();
+	addonPending_ = event.value("pending").toString();
+	addonProblem_ = event.value("problem").toString();
+	if (event.contains("available"))
+		addonAvailable_ = event.value("available").toBool();
+	if (event.contains("size"))
+		addonSize_ = static_cast<qint64>(event.value("size").toDouble());
+	addonProgress_ = event.value("progress").toDouble();
+	addonReason_ = addonStatus_ == "failed" ? event.value("reason").toString() : QString();
+	if (addonStatus_ == "failed")
+		blog(LOG_WARNING, "[livehime] browser add-on: %s %s", addonReason_.toUtf8().constData(),
+		     event.value("message").toString().toUtf8().constData());
+	showAddon();
+}
+
+void UpdatePage::showAddon()
+{
+	const bool pending = addonState_ == "pendingInstall" || addonState_ == "pendingRemoval";
+	const QString size = addonSize_ > 0 ? text("LiveHime.Addon.Size").arg(qRound(addonSize_ / 1048576.0))
+					    : QString();
+	QString message;
+	QString action;
+	QString secondary;
+	bool error = false;
+	if (addonStatus_ == "checking") {
+		message = text("LiveHime.Addon.State.checking");
+	} else if (addonStatus_ == "downloading") {
+		message = text("LiveHime.Addon.State.downloading").arg(qRound(addonProgress_ * 100));
+		addonBar_->setValue(static_cast<int>(addonProgress_ * 100));
+	} else if (addonStatus_ == "failed") {
+		/* The add-on's own wording first, then the updater's. */
+		QString reason;
+		for (const char *prefix : {"LiveHime.Addon.Failed.", "LiveHime.Update.Failed."}) {
+			const QByteArray key = prefix + addonReason_.toUtf8();
+			reason = QString::fromUtf8(obs_module_text(key.constData()));
+			if (reason != QString::fromUtf8(key))
+				break;
+			reason = text("LiveHime.Update.Failed.network");
+		}
+		message = text("LiveHime.Addon.State.failed").arg(reason);
+		action = text("LiveHime.Addon.Retry");
+		error = true;
+	} else if (addonState_ == "installed") {
+		message = text("LiveHime.Addon.State.installed").arg(addonInstalled_);
+		secondary = text("LiveHime.Addon.Remove");
+	} else if (addonState_ == "updateNeeded") {
+		message = text("LiveHime.Addon.State.updateNeeded");
+		action = text("LiveHime.Addon.Update") + size;
+		secondary = text("LiveHime.Addon.Remove");
+		error = true;
+	} else if (addonState_ == "pendingInstall") {
+		message = text("LiveHime.Addon.State.pendingInstall").arg(addonPending_);
+		action = text("LiveHime.Addon.Restart");
+		secondary = text("LiveHime.Addon.Cancel");
+	} else if (addonState_ == "pendingRemoval") {
+		message = text("LiveHime.Addon.State.pendingRemoval");
+		action = text("LiveHime.Addon.Restart");
+		secondary = text("LiveHime.Addon.Cancel");
+	} else if (addonState_ == "damaged") {
+		message = text("LiveHime.Addon.State.damaged");
+		action = text("LiveHime.Addon.Reinstall") + size;
+		secondary = text("LiveHime.Addon.Remove");
+		error = true;
+	} else if (addonState_ == "notInstalled" && !addonAvailable_) {
+		message = text("LiveHime.Addon.State.unavailable");
+	} else {
+		message = text("LiveHime.Addon.State.notInstalled");
+		action = text("LiveHime.Addon.Install") + size;
+	}
+	if (!pending && !addonAvailable_ && addonStatus_ != "failed" && addonState_ != "installed")
+		action.clear();
+	const bool busy = addonStatus_ == "checking" || addonStatus_ == "downloading";
+	addonStateLabel_->setText(message);
+	addonStateLabel_->setStyleSheet(error ? QStringLiteral("color: #e06c75;") : QStringLiteral("color: #9aa0ab;"));
+	addonBar_->setVisible(addonStatus_ == "downloading");
+	addonAction_->setText(action);
+	addonAction_->setVisible(!action.isEmpty() && !busy);
+	addonSecondary_->setText(secondary);
+	addonSecondary_->setVisible(!secondary.isEmpty() && !busy);
+}
+
+void UpdatePage::installAddon()
+{
+	livehime_core_addon_install();
+}
+
+void UpdatePage::removeAddon(bool confirm)
+{
+	if (confirm && QMessageBox::question(this, text("LiveHime.Addon.RemoveTitle"),
+					     text("LiveHime.Addon.RemoveConfirm")) != QMessageBox::Yes)
+		return;
+	livehime_core_addon_remove();
+}
+
+void UpdatePage::cancelAddon()
+{
+	livehime_core_addon_cancel();
+}
+
+bool UpdatePage::restartForAddon()
+{
+	/* With a downloaded update, restarting installs it too (the staged add-on
+	 * applies on the way up either way). */
+	if (!readyVersion_.isEmpty())
+		return restartNow();
+	if (obs_frontend_streaming_active() || obs_frontend_recording_active()) {
+		addonStateLabel_->setText(text("LiveHime.Addon.BusyOutput"));
+		addonStateLabel_->setStyleSheet(QStringLiteral("color: #e06c75;"));
+		return false;
+	}
+	if (!livehime_core_relaunch())
+		return false;
+	blog(LOG_INFO, "[livehime] restarting to apply the browser add-on change");
+	if (auto *main = static_cast<QMainWindow *>(obs_frontend_get_main_window()))
+		QMetaObject::invokeMethod(main, "close", Qt::QueuedConnection);
+	return true;
+}
