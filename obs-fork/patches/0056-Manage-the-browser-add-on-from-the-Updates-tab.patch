+## Browser add-on
+
+Needs a browser add-on zip signed like the build
+(`build-aux/livehime/package-browser-addon.sh arm64 1.0.0 <dir>`).
+
+`e2e-addon.mjs` drives the Updates tab's "Optional add-ons" through the
+`Addon` vendor request, against a local add-on list (`LIVEHIME_ADDONS_FEED`;
+write one with `addons-manifest.py` and point its `url` at the zip with
+`file://`). It launches and quits LiveHime itself and checks: not installed
+and offered; install stages it until a restart, undo drops it; "Restart
+LiveHime" reopens the app with the add-on installed and a browser source
+rendering a page; an add-on whose manifest names another OBS base is kept
+but not loaded (update needed), and so is one whose files changed after
+signing (damaged); remove stages the removal, and after a restart the add-on
+is in the Trash and the browser source is gone.
+
+`e2e-addon-update.mjs` installs the zip, offers 9.9.9 "on OBS 33.0" with an
+addons.json listing the add-on rebuilt for OBS 33.0, and checks that
+downloading the update also stages that add-on; then, with the add-on zip
+gone, that the update stays ready, reports the problem and stages nothing.
+Quitting installs 9.9.9 into the work copy.
+
+Both share LiveHime's settings folder: back up `basic`, `plugin_config`,
+`plugin_manager`, `user.ini` and `global.ini` first and put them back after;
+move `obs-studio/plugins`, `obs-studio/addons-pending`, the backups the update
+test prints and `~/Library/Caches/local.livehime.macos.dev/Updates` to the
+Trash.
+
+```bash
+node e2e-addon.mjs build_macos/frontend/RelWithDebInfo/LiveHime.app <websocket password> <addons.json>
+node e2e-addon-update.mjs <websocket password> build_macos/frontend/RelWithDebInfo/LiveHime.app <add-on zip> /tmp/livehime-addon-update
+```
+
 ## Bilibili interface check
 
 The Updates tab's "B 站接口巡检…" runs a read-only check of the Bilibili
diff --git a/build-aux/livehime/tests/e2e-addon-update.mjs b/build-aux/livehime/tests/e2e-addon-update.mjs
new file mode 100644
index 000000000..4dd1c7fc1
--- /dev/null
+++ b/build-aux/livehime/tests/e2e-addon-update.mjs
@@ -0,0 +1,146 @@
+// The browser add-on across an app update that changes the OBS base, against a
+// local release feed (no GitHub):
+// - with the add-on installed, downloading 9.9.9 (claiming OBS 33.0) also
+//   downloads, verifies and stages the add-on built for OBS 33.0, from the
+//   release's addons.json, before the update is ready;
+// - when that add-on cannot be downloaded, the update is still ready, says
+//   so ("addonProblem"), stages nothing and keeps the installed add-on.
+// The update is installed into the work copy when the test quits LiveHime.
+// Usage: node e2e-addon-update.mjs <ws password> <built LiveHime.app> <browser add-on zip> <work dir>
+// The zip must be signed like the app. Copies the app into <work dir>/install and launches that
+// copy with the e2e keychain and LIVEHIME_UPDATE_FEED; installs the add-on zip into LiveHime's
+// plugin folder. It shares LiveHime's settings folder: back it up first and restore it after
+// (including plugins and addons-pending); prints the settings backups the update created
+// ("BACKUP <path>") so the caller can remove them.
+import { createHash } from 'node:crypto';
+import { execFileSync } from 'node:child_process';
+import { existsSync, mkdirSync, readdirSync, readFileSync, rmSync, writeFileSync } from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const [password, builtApp, addonZip, work] = process.argv.slice(2);
+const here = path.dirname(fileURLToPath(import.meta.url));
+const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
+const sh = (cmd, args) => execFileSync(cmd, args, { encoding: 'utf8' });
+const sha = (s) => createHash('sha256').update(s).digest('base64');
+const fileSha = (f) => createHash('sha256').update(readFileSync(f)).digest('hex');
+let fails = 0;
+const check = (n, ok, i = '') => { if (!ok) fails++; console.log(`${ok ? 'PASS' : 'FAIL'}  ${n}${i && !ok ? '  — ' + i : ''}`); };
+const install = path.join(work, 'install', 'LiveHime.app');
+const feed = path.join(work, 'feed');
+const support = path.join(os.homedir(), 'Library/Application Support/LiveHime');
+const config = path.join(support, 'obs-studio');
+const plugins = path.join(config, 'plugins');
+const staged = path.join(config, 'addons-pending', 'obs-browser.plugin');
+const backups = path.join(support, 'backups');
+const listBackups = () => (existsSync(backups) ? readdirSync(backups).filter((n) => !n.startsWith('.')) : []);
+const backupsBefore = new Set(listBackups());
+const manifest = (bundle) => JSON.parse(readFileSync(path.join(bundle, 'Contents/Resources/addon.json'), 'utf8'));
+const running = () => { try { return sh('/usr/bin/pgrep', ['-f', `${install}/Contents/MacOS/`]).trim(); } catch { return ''; } };
+const signLikeBuild = (bundle) => sh('python3', [path.join(here, '..', 'local-signing.py'), '--deep', '--sign', bundle]);
+
+// Fixtures: the installed copy with the current add-on, 9.9.9 on "OBS 33.0", and the add-on
+// rebuilt for OBS 33.0 (same files, manifest changed, signed like the build).
+rmSync(work, { recursive: true, force: true });
+for (const d of ['install', 'new', 'addon33', 'feed']) mkdirSync(path.join(work, d), { recursive: true });
+sh('/usr/bin/ditto', [builtApp, install]);
+mkdirSync(plugins, { recursive: true });
+sh('/usr/bin/ditto', ['-x', '-k', addonZip, plugins]);
+const current = manifest(path.join(plugins, 'obs-browser.plugin'));
+
+const newApp = path.join(work, 'new', 'LiveHime.app');
+sh('/usr/bin/ditto', [builtApp, newApp]);
+sh('/usr/libexec/PlistBuddy', ['-c', 'Set CFBundleShortVersionString 9.9.9', `${newApp}/Contents/Info.plist`]);
+sh('/usr/libexec/PlistBuddy', ['-c', 'Set CFBundleShortVersionString 33.0.0', `${newApp}/Contents/Frameworks/libobs.framework/Resources/Info.plist`]);
+signLikeBuild(newApp);
+const appZip = path.join(feed, 'app.zip');
+sh('/usr/bin/ditto', ['-c', '-k', '--keepParent', newApp, appZip]);
+
+sh('/usr/bin/ditto', ['-x', '-k', addonZip, path.join(work, 'addon33')]);
+const bundle33 = path.join(work, 'addon33', 'obs-browser.plugin');
+writeFileSync(path.join(bundle33, 'Contents/Resources/addon.json'),
+  JSON.stringify({ ...current, version: '2.0.0', obs: '33.0' }, null, 2) + '\n');
+signLikeBuild(bundle33);
+const addon33 = path.join(feed, 'LiveHime-BrowserAddon-v2.0.0-arm64.zip');
+sh('/usr/bin/ditto', ['-c', '-k', '--keepParent', bundle33, addon33]);
+const addons = path.join(feed, 'addons.json');
+writeFileSync(addons, JSON.stringify({ schema: 1, addons: [{ id: 'browser-source', version: '2.0.0', obs: '33.0', cef: current.cef,
+  assets: { arm64: { name: path.basename(addon33), url: `file://${addon33}`, size: readFileSync(addon33).length, sha256: fileSha(addon33) } } }] }));
+writeFileSync(path.join(feed, 'feed.json'), JSON.stringify({
+  tag_name: 'v9.9.9', prerelease: false, draft: false, html_url: 'https://example.invalid/releases/v9.9.9', body: '## Test release 9.9.9',
+  assets: [
+    { name: 'LiveHimeMacApp-v9.9.9-arm64.zip', browser_download_url: `file://${appZip}`, size: readFileSync(appZip).length, digest: `sha256:${fileSha(appZip)}` },
+    { name: 'addons.json', browser_download_url: `file://${addons}`, size: readFileSync(addons).length, digest: `sha256:${fileSha(addons)}` },
+  ],
+}));
+
+let ws, pend, id = 1;
+async function connect() {
+  for (let i = 0; i < 120; i++) {
+    try {
+      ws = new WebSocket('ws://127.0.0.1:4466');
+      pend = new Map();
+      await new Promise((ok, bad) => {
+        ws.onerror = bad;
+        ws.onmessage = (m) => {
+          const msg = JSON.parse(m.data);
+          if (msg.op === 0) { const a = msg.d.authentication; ws.send(JSON.stringify({ op: 1, d: { rpcVersion: 1, authentication: sha(sha(password + a.salt) + a.challenge) } })); }
+          else if (msg.op === 2) ok();
+          else if (msg.op === 7) pend.get(msg.d.requestId)?.(msg.d);
+        };
+      });
+      return;
+    } catch { await sleep(500); }
+  }
+  throw new Error('LiveHime did not come up');
+}
+const vendor = (requestType, requestData = {}) => new Promise((ok) => {
+  const requestId = String(id++);
+  pend.set(requestId, (d) => ok(d.responseData?.responseData ?? {}));
+  ws.send(JSON.stringify({ op: 6, d: { requestType: 'CallVendorRequest', requestId, requestData: { vendorName: 'livehime', requestType, requestData } } }));
+});
+async function waitUpdate(want, action) {
+  let r = await vendor('Update', action ? { action } : {});
+  for (let i = 0; i < 240 && !want(r); i++) { await sleep(500); r = await vendor('Update'); }
+  return r;
+}
+
+async function run() {
+  sh('/usr/bin/open', ['-n', '--env', 'LIVEHIME_KEYCHAIN_SERVICE=local.livehime.macos.e2e-test',
+    '--env', `LIVEHIME_UPDATE_FEED=file://${path.join(feed, 'feed.json')}`, install]);
+  await connect();
+  await sleep(2500);
+  await vendor('Update', { automatic: false });
+  let r = await waitUpdate((s) => s.available === '9.9.9', 'check');
+  check('9.9.9 is offered', r.available === '9.9.9', JSON.stringify(r));
+  r = await waitUpdate((s) => s.ready === '9.9.9' || s.status === 'failed', 'download');
+  check('9.9.9 is ready', r.ready === '9.9.9', JSON.stringify(r));
+  check('...with the add-on for its OBS staged', existsSync(staged) && manifest(staged).obs === '33.0' && manifest(staged).version === '2.0.0',
+    existsSync(staged) ? JSON.stringify(manifest(staged)) : 'nothing staged');
+  check('...and no add-on problem', r.addonProblem === '', r.addonProblem);
+  check('the installed add-on is untouched until the restart', manifest(path.join(plugins, 'obs-browser.plugin')).obs === current.obs);
+
+  // The add-on for OBS 33 cannot be downloaded any more: the update stays ready without it.
+  await vendor('Addon', { action: 'cancel' });
+  rmSync(addon33);
+  r = await vendor('Update', { action: 'retryAddon' });
+  for (let i = 0; i < 60 && !r.addonProblem; i++) { await sleep(500); r = await vendor('Update'); }
+  check('a failed add-on download is reported', r.addonProblem !== '', JSON.stringify(r));
+  check('...the update stays ready', r.ready === '9.9.9');
+  check('...nothing is staged', !existsSync(staged));
+  check('...and the installed add-on is kept', manifest(path.join(plugins, 'obs-browser.plugin')).obs === current.obs);
+
+  // Quitting installs the update into the work copy; wait for the swap to finish.
+  try { execFileSync('/usr/bin/osascript', ['-e', 'tell application id "local.livehime.macos.dev" to quit'], { stdio: 'ignore' }); } catch {}
+  for (let i = 0; i < 120 && running(); i++) await sleep(500);
+  const version = () => { try { return JSON.stringify(execFileSync('/usr/bin/plutil', ['-extract', 'CFBundleShortVersionString', 'raw', `${install}/Contents/Info.plist`], { encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] }).trim()); } catch { return ''; } };
+  for (let i = 0; i < 60 && version() !== '"9.9.9"'; i++) await sleep(500);
+}
+
+run().catch((e) => { fails++; console.log(`FAIL  ${e.message}`); })
+  .finally(() => {
+    for (const b of listBackups().filter((n) => !backupsBefore.has(n))) console.log(`BACKUP ${path.join(backups, b)}`);
+    console.log(fails ? `${fails} check(s) failed` : 'browser add-on across an update OK');
+    process.exit(fails ? 1 : 0);
+  });
diff --git a/build-aux/livehime/tests/e2e-addon.mjs b/build-aux/livehime/tests/e2e-addon.mjs
new file mode 100644
index 000000000..320a57823
--- /dev/null
+++ b/build-aux/livehime/tests/e2e-addon.mjs
@@ -0,0 +1,202 @@
+// The browser add-on end to end, against a local add-on list (no GitHub):
+// - not installed at first, and the list offers it;
+// - install stages it (pending until restart); undo drops it; install again;
+// - "Restart LiveHime" reopens the app, the add-on is installed and a browser
+//   source renders a page into the canvas;
+// - an add-on built for another OBS base is not loaded (update needed), nor
+//   one whose files were changed after signing (damaged);
+// - remove stages the removal; after a restart the add-on is in the Trash and
+//   the browser source is gone.
+// Launches and quits LiveHime itself, with an isolated Keychain item and
+// LIVEHIME_ADDONS_FEED. It shares LiveHime's settings folder: back up
+// basic, plugin_config, user.ini and global.ini first and restore them after,
+// and do not run it while a normal LiveHime is open.
+// Usage: node e2e-addon.mjs <LiveHime.app> <websocket password> <addons.json>
+//   (the add-on zip the list points at must be signed like the app)
+import { createHash } from 'node:crypto';
+import { execFileSync } from 'node:child_process';
+import { appendFileSync, copyFileSync, existsSync, readFileSync, writeFileSync } from 'node:fs';
+import { homedir } from 'node:os';
+import path from 'node:path';
+import { inflateSync } from 'node:zlib';
+
+const [app, password, list] = process.argv.slice(2);
+const sha = (s) => createHash('sha256').update(s).digest('base64');
+const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
+const bundleId = execFileSync('/usr/libexec/PlistBuddy', ['-c', 'Print :CFBundleIdentifier', `${app}/Contents/Info.plist`]).toString().trim();
+const plugin = path.join(homedir(), 'Library/Application Support/LiveHime/obs-studio/plugins/obs-browser.plugin');
+let failures = 0;
+function check(name, ok, detail = '') {
+  console.log(`${ok ? 'PASS' : 'FAIL'}  ${name}${ok || !detail ? '' : `  (${detail})`}`);
+  if (!ok) failures++;
+}
+
+let ws, pending, nextId;
+function connect() {
+  return new Promise((resolve, reject) => {
+    ws = new WebSocket('ws://127.0.0.1:4466');
+    pending = new Map();
+    nextId = 1;
+    ws.onerror = () => reject(new Error('connect'));
+    ws.onclose = () => { for (const r of pending.values()) r(null); pending.clear(); };
+    ws.onmessage = (event) => {
+      const msg = JSON.parse(event.data);
+      if (msg.op === 0) {
+        const { challenge, salt } = msg.d.authentication;
+        ws.send(JSON.stringify({ op: 1, d: { rpcVersion: 1, authentication: sha(sha(password + salt) + challenge), eventSubscriptions: 0 } }));
+      } else if (msg.op === 2) resolve();
+      else if (msg.op === 7) pending.get(msg.d.requestId)?.(msg.d);
+    };
+  });
+}
+function request(requestType, requestData = {}) {
+  const requestId = String(nextId++);
+  return new Promise((resolve) => {
+    pending.set(requestId, resolve);
+    ws.send(JSON.stringify({ op: 6, d: { requestType, requestId, requestData } }));
+  });
+}
+async function addon(action) {
+  const r = await request('CallVendorRequest', { vendorName: 'livehime', requestType: 'Addon', requestData: action ? { action } : {} });
+  return r?.responseData?.responseData ?? {};
+}
+async function waitAddon(want, timeoutMs = 60000) {
+  const end = Date.now() + timeoutMs;
+  let last = {};
+  while (Date.now() < end) {
+    last = await addon();
+    if (want(last)) return last;
+    await sleep(300);
+  }
+  return last;
+}
+async function hasBrowserSource() {
+  return (await request('GetInputKindList')).responseData.inputKinds.includes('browser_source');
+}
+
+async function running() {
+  try { execFileSync('pgrep', ['-f', `${app}/Contents/MacOS/`]); return true; } catch { return false; }
+}
+async function launch() {
+  execFileSync('open', ['-n', '--env', 'LIVEHIME_KEYCHAIN_SERVICE=local.livehime.macos.e2e-test',
+    '--env', `LIVEHIME_ADDONS_FEED=file://${path.resolve(list)}`, app]);
+  await reconnect();
+}
+async function reconnect(timeoutMs = 60000) {
+  const end = Date.now() + timeoutMs;
+  while (Date.now() < end) {
+    try { await connect(); await sleep(2500); return; } catch { await sleep(500); }
+  }
+  throw new Error('LiveHime did not come up');
+}
+async function quit() {
+  try { execFileSync('osascript', ['-e', `tell application id "${bundleId}" to quit`], { stdio: 'ignore' }); } catch {}
+  for (let i = 0; i < 60 && await running(); i++) await sleep(500);
+}
+async function waitRestart() {
+  for (let i = 0; i < 60 && ws.readyState === WebSocket.OPEN; i++) await sleep(250);
+  await sleep(1500);
+  await reconnect();
+}
+
+function pixel(png, x, y) {
+  let pos = 8, width = 0, colorType = 0;
+  const idat = [];
+  while (pos < png.length) {
+    const len = png.readUInt32BE(pos), type = png.toString('latin1', pos + 4, pos + 8), data = png.subarray(pos + 8, pos + 8 + len);
+    if (type === 'IHDR') { width = data.readUInt32BE(0); colorType = data[9]; }
+    if (type === 'IDAT') idat.push(data);
+    pos += 12 + len;
+  }
+  const bpp = colorType === 6 ? 4 : 3, stride = width * bpp, raw = inflateSync(Buffer.concat(idat));
+  const rows = [];
+  for (let r = 0; r <= y; r++) {
+    const f = raw[r * (stride + 1)], line = raw.subarray(r * (stride + 1) + 1, (r + 1) * (stride + 1)), out = Buffer.alloc(stride);
+    for (let i = 0; i < stride; i++) {
+      const a = i >= bpp ? out[i - bpp] : 0, b = r ? rows[r - 1][i] : 0, c = i >= bpp && r ? rows[r - 1][i - bpp] : 0;
+      const p = a + b - c, pa = Math.abs(p - a), pb = Math.abs(p - b), pc = Math.abs(p - c);
+      out[i] = (line[i] + [0, a, b, (a + b) >> 1, pa <= pb && pa <= pc ? a : pb <= pc ? b : c][f]) & 255;
+    }
+    rows.push(out);
+  }
+  return [...rows[y].subarray(x * bpp, x * bpp + 3)];
+}
+async function renders() {
+  const scene = (await request('GetCurrentProgramScene')).responseData.currentProgramSceneName;
+  const url = 'data:text/html,<html><body style="margin:0;background:%23ff00aa"></body></html>';
+  await request('CreateInput', { sceneName: scene, inputName: 'e2e Browser', inputKind: 'browser_source', inputSettings: { url, width: 320, height: 180 } });
+  await sleep(4000);
+  const shot = await request('GetSourceScreenshot', { sourceName: 'e2e Browser', imageFormat: 'png' });
+  await request('RemoveInput', { inputName: 'e2e Browser' });
+  const [r, g, b] = pixel(Buffer.from(shot.responseData.imageData.split(',')[1], 'base64'), 160, 90);
+  return Math.abs(r - 255) < 8 && g < 8 && Math.abs(b - 170) < 8;
+}
+
+async function run() {
+  check('starts without the add-on', !existsSync(plugin), plugin);
+  await launch();
+  let state = await waitAddon((s) => s.state === 'notInstalled' && s.available);
+  check('not installed, and this version offers it', state.state === 'notInstalled' && state.available, JSON.stringify(state));
+  check('no browser source yet', !(await hasBrowserSource()));
+
+  await addon('install');
+  state = await waitAddon((s) => s.status === 'idle' && s.state === 'pendingInstall');
+  check('install stages it until restart', state.state === 'pendingInstall' && state.pending === '1.0.0', JSON.stringify(state));
+  state = await addon('cancel');
+  state = await waitAddon((s) => s.state === 'notInstalled');
+  check('undo drops the staged install', state.state === 'notInstalled', JSON.stringify(state));
+  await addon('install');
+  state = await waitAddon((s) => s.status === 'idle' && s.state === 'pendingInstall');
+  check('install again', state.state === 'pendingInstall', JSON.stringify(state));
+
+  const restart = await addon('restart');
+  check('restart accepted', restart.accepted === true);
+  await waitRestart();
+  state = await waitAddon((s) => s.state === 'installed');
+  check('installed after the restart', state.state === 'installed' && state.installed === '1.0.0', JSON.stringify(state));
+  check('browser source available', await hasBrowserSource());
+  check('a browser source renders the page', await renders());
+
+  // Another OBS base: kept on disk, not loaded.
+  await quit();
+  const manifest = path.join(plugin, 'Contents/Resources/addon.json');
+  const original = readFileSync(manifest);
+  writeFileSync(manifest, original.toString().replace(/"obs": "[^"]*"/, '"obs": "31.1"'));
+  await launch();
+  state = await waitAddon((s) => s.state === 'updateNeeded');
+  check('built for another OBS: update needed', state.state === 'updateNeeded', JSON.stringify(state));
+  check('...and not loaded', !(await hasBrowserSource()));
+  await quit();
+  writeFileSync(manifest, original);
+
+  // Changed after signing: damaged, not loaded.
+  const page = path.join(plugin, 'Contents/Resources/error.html');
+  copyFileSync(page, `${page}.e2e`);
+  appendFileSync(page, '<!-- changed -->');
+  await launch();
+  state = await waitAddon((s) => s.state === 'damaged');
+  check('changed after signing: damaged', state.state === 'damaged', JSON.stringify(state));
+  check('...and not loaded', !(await hasBrowserSource()));
+  await quit();
+  copyFileSync(`${page}.e2e`, page);
+  execFileSync('rm', [`${page}.e2e`]);
+
+  await launch();
+  state = await waitAddon((s) => s.state === 'installed');
+  check('restored add-on loads again', state.state === 'installed' && await hasBrowserSource(), JSON.stringify(state));
+  await addon('remove');
+  state = await waitAddon((s) => s.state === 'pendingRemoval');
+  check('remove stages the removal', state.state === 'pendingRemoval', JSON.stringify(state));
+  await addon('restart');
+  await waitRestart();
+  state = await waitAddon((s) => s.state === 'notInstalled');
+  check('removed after the restart', state.state === 'notInstalled' && !existsSync(plugin), JSON.stringify(state));
+  check('browser source gone', !(await hasBrowserSource()));
+  await quit();
+}
+
+run().catch((e) => { console.log(`FAIL  ${e.message}`); failures++; })
+  .finally(() => {
+    console.log(failures ? `${failures} check(s) failed` : 'browser add-on end to end OK');
+    process.exit(failures ? 1 : 0);
+  });
