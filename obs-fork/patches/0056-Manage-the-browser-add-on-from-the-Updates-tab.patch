diff --git a/plugins/livehime/core/Sources/LiveHimeCore/AddonBridge.swift b/plugins/livehime/core/Sources/LiveHimeCore/AddonBridge.swift
new file mode 100644
index 000000000..d5a6067ff
--- /dev/null
+++ b/plugins/livehime/core/Sources/LiveHimeCore/AddonBridge.swift
@@ -0,0 +1,145 @@
+import Foundation
+
+/// Add-on state behind the C entry points below; everything on the main thread.
+@MainActor
+final class AddonTask {
+    static let shared = AddonTask()
+    var busy = false
+    var offer: AddonOffer?
+    var lastPercent = -1
+
+    /// Emits {"event":"addon","id","state","installed","pending","problem","size","available",
+    /// "status"(idle|checking|downloading|failed), …}.
+    func emit(_ fields: [String: Any] = [:]) {
+        let status = AddonManager.status()
+        var object: [String: Any] = ["event": "addon", "id": AddonManager.browserSource,
+                                     "state": status.state.rawValue, "status": "idle"]
+        if let installed = status.installed { object["installed"] = installed }
+        if let pending = status.pending { object["pending"] = pending }
+        if let problem = status.problem { object["problem"] = problem }
+        if let offer { object["size"] = offer.size; object["version"] = offer.version }
+        object.merge(fields) { $1 }
+        CoreBridge.shared?.emit(object)
+    }
+
+    func failed(_ error: Error) {
+        let update = error as? AppUpdateError
+        emit(["status": "failed", "reason": update?.reason ?? "network",
+              "message": update?.errorDescription ?? error.localizedDescription])
+    }
+}
+
+private func onMainThread(_ body: @escaping @MainActor () -> Void) {
+    if Thread.isMainThread {
+        MainActor.assumeIsolated { body() }
+    } else {
+        DispatchQueue.main.async { MainActor.assumeIsolated { body() } }
+    }
+}
+
+/// Emits the browser source's state. When it is not installed or needs an
+/// update, also looks up the fitting add-on of the running version (to show
+/// its size): "available" true, or false when this version offers none.
+@_cdecl("livehime_core_addon_state")
+public func livehime_core_addon_state() {
+    onMainThread {
+        let state = AddonTask.shared
+        state.emit()
+        let current = AddonManager.status().state
+        guard !state.busy, state.offer == nil, current == .notInstalled || current == .updateNeeded else { return }
+        Task.detached {
+            let offer = try? await AddonManager.offerForRunningApp()
+            await MainActor.run {
+                state.offer = offer
+                state.emit(["available": offer != nil])
+            }
+        }
+    }
+}
+
+/// Downloads, verifies and stages the browser source for the running
+/// version; it is installed when LiveHime next starts. Emits "checking",
+/// "downloading" with "progress", then the new state or "failed".
+@_cdecl("livehime_core_addon_install")
+public func livehime_core_addon_install() {
+    onMainThread {
+        let state = AddonTask.shared
+        guard !state.busy else { return }
+        state.busy = true
+        state.lastPercent = -1
+        state.emit(["status": "checking"])
+        Task.detached {
+            do {
+                let offer: AddonOffer
+                if let known = await MainActor.run(body: { state.offer }) {
+                    offer = known
+                } else {
+                    offer = try await AddonManager.offerForRunningApp()
+                }
+                await MainActor.run {
+                    state.offer = offer
+                    state.emit(["status": "downloading", "progress": 0.0])
+                }
+                let bundle = try await AddonManager.download(offer) { fraction in
+                    DispatchQueue.main.async {
+                        MainActor.assumeIsolated {
+                            let percent = Int(fraction * 100)
+                            guard percent != state.lastPercent else { return }
+                            state.lastPercent = percent
+                            state.emit(["status": "downloading", "progress": fraction])
+                        }
+                    }
+                }
+                try AddonManager.stage(bundle)
+                await MainActor.run {
+                    state.busy = false
+                    state.emit()
+                }
+            } catch {
+                await MainActor.run {
+                    state.busy = false
+                    state.failed(error)
+                }
+            }
+        }
+    }
+}
+
+/// Marks the browser source for removal (to the Trash) at the next start.
+@_cdecl("livehime_core_addon_remove")
+public func livehime_core_addon_remove() {
+    onMainThread {
+        let state = AddonTask.shared
+        guard !state.busy else { return }
+        do {
+            try AddonManager.scheduleRemoval()
+            state.emit()
+        } catch {
+            state.failed(error)
+        }
+    }
+}
+
+/// Drops a staged install or removal.
+@_cdecl("livehime_core_addon_cancel")
+public func livehime_core_addon_cancel() {
+    onMainThread {
+        let state = AddonTask.shared
+        guard !state.busy else { return }
+        AddonManager.cancelPending()
+        state.emit()
+    }
+}
+
+/// Arranges for LiveHime to reopen once it quits (the caller then quits).
+/// Returns 1 when arranged. Call on the main thread.
+@_cdecl("livehime_core_relaunch")
+public func livehime_core_relaunch() -> Int32 {
+    guard Thread.isMainThread else { return 0 }
+    do {
+        try AddonManager.scheduleRelaunch()
+        return 1
+    } catch {
+        return 0
+    }
+}
diff --git a/plugins/livehime/core/Sources/LiveHimeCore/AddonManager.swift b/plugins/livehime/core/Sources/LiveHimeCore/AddonManager.swift
new file mode 100644
index 000000000..c84c9e388
--- /dev/null
+++ b/plugins/livehime/core/Sources/LiveHimeCore/AddonManager.swift
@@ -0,0 +1,274 @@
+import Foundation
+import Security
+
+/// An add-on's own manifest (Contents/Resources/addon.json in its bundle).
+public struct AddonManifest: Equatable, Sendable, Decodable {
+    public let id: String
+    public let version: String
+    /// The OBS base it was built against, "major.minor".
+    public let obs: String
+    public let arch: String
+    public let cef: String?
+}
+
+/// An add-on as a release offers it (from the release's addons.json), for one architecture.
+public struct AddonOffer: Equatable, Sendable {
+    public let id: String
+    public let version: String
+    public let obs: String
+    public let archive: URL
+    public let size: Int64
+    public let sha256: String
+}
+
+/// What the Updates tab shows for an add-on.
+public enum AddonState: String, Sendable {
+    case notInstalled, installed, updateNeeded, pendingInstall, pendingRemoval, damaged
+}
+
+public struct AddonStatus: Equatable, Sendable {
+    public var state: AddonState
+    /// The installed add-on's version, and the staged one's.
+    public var installed: String?
+    public var pending: String?
+    /// Why it is not loaded (updateNeeded, damaged).
+    public var problem: String?
+}
+
+/// LiveHime's optional add-ons; so far one, the browser source (obs-browser
+/// with its own CEF). It lives in OBS's user plugin folder. Installs and
+/// removals are staged under addons-pending and take effect when LiveHime next
+/// starts, before any module loads (the frontend does that, see
+/// ApplyLiveHimeAddons); the frontend also refuses to load an add-on that does
+/// not fit this OBS base and architecture or is not signed like the app.
+/// An add-on follows the OBS base: each release's addons.json lists the add-on
+/// for that release's OBS, with a download URL, size and SHA-256.
+public enum AddonManager {
+    public static let browserSource = "browser-source"
+    static let bundleName = "obs-browser.plugin"
+
+    /// OBS's configuration folder; unit tests use a temporary one.
+    nonisolated(unsafe) static var configDirectory: URL = AppUpdater.configDirectory
+    static var pluginsDirectory: URL { configDirectory.appendingPathComponent("plugins", isDirectory: true) }
+    static var pendingDirectory: URL { configDirectory.appendingPathComponent("addons-pending", isDirectory: true) }
+    static var installedBundle: URL { pluginsDirectory.appendingPathComponent(bundleName, isDirectory: true) }
+    static var pendingBundle: URL { pendingDirectory.appendingPathComponent(bundleName, isDirectory: true) }
+    static var removalMarker: URL { pendingDirectory.appendingPathComponent("remove-\(browserSource)") }
+
+    /// "32.2.2" → "32.2".
+    static func obsBase(_ version: String?) -> String? {
+        guard let parts = version?.split(separator: "."), parts.count >= 2 else { return nil }
+        return "\(parts[0]).\(parts[1])"
+    }
+
+    /// The OBS base of the running app.
+    public static var currentOBS: String? { obsBase(AppUpdater.obsVersion(of: Bundle.main.bundleURL)) }
+
+    static func manifest(of bundle: URL) -> AddonManifest? {
+        let file = bundle.appendingPathComponent("Contents/Resources/addon.json")
+        return (try? Data(contentsOf: file)).flatMap { try? JSONDecoder().decode(AddonManifest.self, from: $0) }
+    }
+
+    /// Signed validly (the bundle's own seal) by the certificate that signed `app`.
+    static func signedLike(_ bundle: URL, app: URL, nested: Bool) -> Bool {
+        var code: SecStaticCode?
+        guard SecStaticCodeCreateWithPath(bundle as CFURL, [], &code) == errSecSuccess, let code else { return false }
+        var flags = kSecCSStrictValidate
+        if nested { flags |= kSecCSCheckNestedCode | kSecCSCheckAllArchitectures }
+        guard SecStaticCodeCheckValidity(code, SecCSFlags(rawValue: flags), nil) == errSecSuccess else { return false }
+        guard let leaf = AppUpdater.leafCertificate(of: bundle) else { return false }
+        return leaf == AppUpdater.leafCertificate(of: app)
+    }
+
+    /// The add-on's state, judged the way the frontend judges it at start-up.
+    static func status(obs: String? = currentOBS, arch: String = AppUpdater.architecture,
+                              app: URL = Bundle.main.bundleURL) -> AddonStatus {
+        let fm = FileManager.default
+        let installed = fm.fileExists(atPath: installedBundle.path) ? manifest(of: installedBundle) : nil
+        var status = AddonStatus(state: .notInstalled, installed: installed?.version)
+        if fm.fileExists(atPath: removalMarker.path) {
+            status.state = .pendingRemoval
+        } else if fm.fileExists(atPath: pendingBundle.path) {
+            status.state = .pendingInstall
+            status.pending = manifest(of: pendingBundle)?.version
+        } else if !fm.fileExists(atPath: installedBundle.path) {
+            status.state = .notInstalled
+        } else if let installed, installed.id == browserSource {
+            if installed.arch != arch || installed.obs != obs {
+                status.state = .updateNeeded
+                status.problem = "built for OBS \(installed.obs) (\(installed.arch))"
+            } else if !signedLike(installedBundle, app: app, nested: false) {
+                status.state = .damaged
+                status.problem = "invalid signature"
+            } else {
+                status.state = .installed
+            }
+        } else {
+            status.state = .damaged
+            status.problem = "no valid manifest"
+        }
+        return status
+    }
+
+    // MARK: Finding the add-on for a release
+
+    /// The add-ons a release offers for `architecture`, from its addons.json.
+    static func offers(from data: Data, architecture: String = AppUpdater.architecture) throws -> [AddonOffer] {
+        guard let root = try JSONSerialization.jsonObject(with: data) as? [String: Any],
+              let list = root["addons"] as? [[String: Any]] else {
+            throw AppUpdateError.network("invalid add-on list")
+        }
+        return list.compactMap { entry in
+            guard let id = entry["id"] as? String, let version = entry["version"] as? String,
+                  let obs = entry["obs"] as? String,
+                  let asset = (entry["assets"] as? [String: Any])?[architecture] as? [String: Any],
+                  let url = (asset["url"] as? String).flatMap(URL.init(string:)),
+                  let sha = asset["sha256"] as? String else { return nil }
+            return AddonOffer(id: id, version: version, obs: obs, archive: url,
+                              size: (asset["size"] as? NSNumber)?.int64Value ?? 0, sha256: sha.lowercased())
+        }
+    }
+
+    /// Tests point LIVEHIME_ADDONS_FEED at a local addons.json.
+    static var feedOverride: URL? {
+        ProcessInfo.processInfo.environment["LIVEHIME_ADDONS_FEED"].flatMap(URL.init(string:))
+    }
+
+    static func fetch(_ url: URL, github: Bool = false) async throws -> Data {
+        var request = URLRequest(url: url, timeoutInterval: 20)
+        if github { request.setValue("application/vnd.github+json", forHTTPHeaderField: "Accept") }
+        request.setValue("LiveHime/\(AppUpdater.currentVersion)", forHTTPHeaderField: "User-Agent")
+        let data: Data, response: URLResponse
+        do {
+            (data, response) = try await URLSession.shared.data(for: request)
+        } catch {
+            throw AppUpdateError.network(error.localizedDescription)
+        }
+        if let http = response as? HTTPURLResponse, http.statusCode != 200 {
+            throw AppUpdateError.network("HTTP \(http.statusCode)")
+        }
+        return data
+    }
+
+    /// The add-on list of a release, checked against its published digest.
+    static func offers(listedAt url: URL, sha256: String?) async throws -> [AddonOffer] {
+        let data = try await fetch(url)
+        if let sha256 {
+            let file = FileManager.default.temporaryDirectory.appendingPathComponent(UUID().uuidString)
+            try data.write(to: file)
+            defer { try? FileManager.default.removeItem(at: file) }
+            guard try AppUpdater.sha256(of: file) == sha256 else { throw AppUpdateError.checksumMismatch }
+        } else if feedOverride == nil {
+            throw AppUpdateError.missingChecksum
+        }
+        return try offers(from: data)
+    }
+
+    /// The browser source that fits `obs`, from the release of the running
+    /// version (whose OBS base is the running one), or from the test feed.
+    public static func offerForRunningApp(obs: String? = currentOBS) async throws -> AddonOffer {
+        let offers: [AddonOffer]
+        if let feed = feedOverride {
+            offers = try await self.offers(listedAt: feed, sha256: nil)
+        } else {
+            let tag = URL(string: "https://api.github.com/repos/greyoak111/livehime-macos/releases/tags/v\(AppUpdater.currentVersion)")!
+            let release = try AppUpdater.release(from: try await fetch(tag, github: true))
+            guard let list = release.addons else { throw AppUpdateError.noArchive }
+            offers = try await self.offers(listedAt: list, sha256: release.addonsSha256)
+        }
+        return try offer(in: offers, obs: obs)
+    }
+
+    /// The browser source for `obs` in `release` (used when an update changes the OBS base).
+    static func offer(for release: AppRelease, obs: String?) async throws -> AddonOffer {
+        if let feed = feedOverride {
+            return try offer(in: try await offers(listedAt: feed, sha256: nil), obs: obs)
+        }
+        guard let list = release.addons else { throw AppUpdateError.noArchive }
+        return try offer(in: try await offers(listedAt: list, sha256: release.addonsSha256), obs: obs)
+    }
+
+    static func offer(in offers: [AddonOffer], obs: String?) throws -> AddonOffer {
+        guard let offer = offers.first(where: { $0.id == browserSource && $0.obs == obs }) else {
+            throw AppUpdateError.noArchive
+        }
+        return offer
+    }
+
+    // MARK: Download, verification and staging
+
+    /// Downloads, checks and unpacks `offer`; returns the verified bundle.
+    public static func download(_ offer: AddonOffer, progress: @escaping @Sendable (Double) -> Void) async throws -> URL {
+        let fm = FileManager.default
+        let folder = AppUpdater.updatesDirectory.appendingPathComponent("addon-\(offer.id)-\(offer.version)", isDirectory: true)
+        try? fm.removeItem(at: folder)
+        try fm.createDirectory(at: folder, withIntermediateDirectories: true)
+        let archive = folder.appendingPathComponent("addon.zip")
+        try await Downloader.fetch(offer.archive, to: archive, expectedSize: offer.size, progress: progress)
+        guard try AppUpdater.sha256(of: archive) == offer.sha256 else {
+            try? fm.removeItem(at: folder)
+            throw AppUpdateError.checksumMismatch
+        }
+        let unpacked = folder.appendingPathComponent("unpacked", isDirectory: true)
+        try AppUpdater.run("/usr/bin/ditto", ["-x", "-k", archive.path, unpacked.path])
+        try? fm.removeItem(at: archive)
+        let bundle = unpacked.appendingPathComponent(bundleName, isDirectory: true)
+        try verify(bundle: bundle, offer: offer)
+        return bundle
+    }
+
+    /// The bundle must be the offered add-on (id, version, OBS base, this
+    /// architecture), validly signed throughout by the app's certificate.
+    static func verify(bundle: URL, offer: AddonOffer, arch: String = AppUpdater.architecture,
+                       app: URL = Bundle.main.bundleURL) throws {
+        guard let manifest = manifest(of: bundle) else { throw AppUpdateError.invalidApp("no add-on manifest") }
+        guard manifest.id == offer.id, manifest.version == offer.version, manifest.obs == offer.obs else {
+            throw AppUpdateError.invalidApp("not the offered add-on")
+        }
+        guard manifest.arch == arch else { throw AppUpdateError.invalidApp("built for \(manifest.arch)") }
+        guard signedLike(bundle, app: app, nested: true) else {
+            throw AppUpdateError.invalidApp("not signed like the app")
+        }
+    }
+
+    /// Puts a verified bundle where the next start installs it from; replaces
+    /// an earlier staged one and a pending removal.
+    public static func stage(_ bundle: URL) throws {
+        let fm = FileManager.default
+        try fm.createDirectory(at: pendingDirectory, withIntermediateDirectories: true)
+        try? fm.removeItem(at: removalMarker)
+        try? fm.removeItem(at: pendingBundle)
+        try fm.moveItem(at: bundle, to: pendingBundle)
+        try? fm.removeItem(at: bundle.deletingLastPathComponent().deletingLastPathComponent())
+    }
+
+    /// Marks the add-on for removal at the next start (it is in use now).
+    public static func scheduleRemoval() throws {
+        let fm = FileManager.default
+        try fm.createDirectory(at: pendingDirectory, withIntermediateDirectories: true)
+        try? fm.removeItem(at: pendingBundle)
+        try Data().write(to: removalMarker)
+    }
+
+    /// Drops a staged install or removal.
+    public static func cancelPending() {
+        try? FileManager.default.removeItem(at: pendingBundle)
+        try? FileManager.default.removeItem(at: removalMarker)
+    }
+
+    /// Starts a helper that reopens LiveHime once it has quit (the caller
+    /// then quits). LiveHime's own environment (test keychain, feeds) is kept.
+    public static func scheduleRelaunch(app: URL = Bundle.main.bundleURL) throws {
+        let environment = ProcessInfo.processInfo.environment.filter { $0.key.hasPrefix("LIVEHIME_") }
+            .sorted { $0.key < $1.key }
+        let passed = environment.flatMap { ["--env", "\($0.key)=\($0.value)"] }
+        let process = Process()
+        process.executableURL = URL(fileURLWithPath: "/usr/bin/nohup")
+        process.arguments = ["/bin/sh", "-c",
+                             "while /bin/kill -0 \"$0\" 2>/dev/null; do /bin/sleep 0.3; done; /usr/bin/open \"$@\"",
+                             String(getpid())] + passed + [app.path]
+        process.standardOutput = FileHandle.nullDevice
+        process.standardError = FileHandle.nullDevice
+        try process.run()
+    }
+}
