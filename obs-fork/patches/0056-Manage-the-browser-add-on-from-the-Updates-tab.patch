diff --git a/frontend/utility/platform-osx.mm b/frontend/utility/platform-osx.mm
index 5421a23e7..8e5181852 100644
--- a/frontend/utility/platform-osx.mm
+++ b/frontend/utility/platform-osx.mm
@@ -22,6 +22,7 @@
 #import <util/threading.h>
 
 #import <AVFoundation/AVFoundation.h>
+#import <Security/Security.h>
 #import <AppKit/AppKit.h>
 #import <dlfcn.h>
 
@@ -359,3 +360,102 @@ bool HighContrastEnabled()
 {
     return [[NSWorkspace sharedWorkspace] accessibilityDisplayShouldIncreaseContrast];
 }
+
+/* LiveHime's optional add-ons (the browser source) live in the user plugin
+ * folder. The Updates tab stages installs and removals under
+ * addons-pending; they take effect here, before any module loads. An add-on
+ * is then loaded only when its manifest names this OBS base and architecture
+ * and it is signed by the app's certificate; otherwise it stays on disk and
+ * obs-browser is added to the disabled modules. */
+static NSData *LeafCertificate(NSURL *url, bool validate)
+{
+    SecStaticCodeRef code = nullptr;
+    if (SecStaticCodeCreateWithPath((__bridge CFURLRef) url, kSecCSDefaultFlags, &code) != errSecSuccess)
+        return nil;
+    NSData *leaf = nil;
+    CFDictionaryRef info = nullptr;
+    if ((!validate || SecStaticCodeCheckValidity(code, kSecCSStrictValidate, nullptr) == errSecSuccess) &&
+        SecCodeCopySigningInformation(code, kSecCSSigningInformation, &info) == errSecSuccess) {
+        NSArray *certificates = ((__bridge NSDictionary *) info)[(__bridge NSString *) kSecCodeInfoCertificates];
+        if (certificates.count > 0)
+            leaf = (__bridge_transfer NSData *) SecCertificateCopyData(
+                (__bridge SecCertificateRef) certificates.firstObject);
+        CFRelease(info);
+    }
+    CFRelease(code);
+    return leaf;
+}
+
+void ApplyLiveHimeAddons()
+{
+    char path[512];
+    if (GetAppConfigPath(path, sizeof(path), "obs-studio") <= 0)
+        return;
+    NSFileManager *fm = [NSFileManager defaultManager];
+    NSURL *config = [NSURL fileURLWithPath:@(path) isDirectory:YES];
+    NSURL *pending = [config URLByAppendingPathComponent:@"addons-pending" isDirectory:YES];
+    NSURL *plugins = [config URLByAppendingPathComponent:@"plugins" isDirectory:YES];
+    NSURL *installed = [plugins URLByAppendingPathComponent:@"obs-browser.plugin" isDirectory:YES];
+    NSURL *staged = [pending URLByAppendingPathComponent:@"obs-browser.plugin" isDirectory:YES];
+    NSURL *removal = [pending URLByAppendingPathComponent:@"remove-browser-source"];
+
+    auto trash = [&](NSURL *url) {
+        if (![fm fileExistsAtPath:url.path])
+            return true;
+        NSError *error = nil;
+        if ([fm trashItemAtURL:url resultingItemURL:nil error:&error])
+            return true;
+        blog(LOG_WARNING, "[livehime] add-on: cannot move %s to the Trash: %s", url.path.UTF8String,
+             error.localizedDescription.UTF8String);
+        return false;
+    };
+
+    if ([fm fileExistsAtPath:removal.path]) {
+        if (trash(installed))
+            blog(LOG_INFO, "[livehime] add-on: browser source removed");
+        [fm removeItemAtURL:removal error:nil];
+    }
+    if ([fm fileExistsAtPath:staged.path] && trash(installed)) {
+        NSError *error = nil;
+        [fm createDirectoryAtURL:plugins withIntermediateDirectories:YES attributes:nil error:nil];
+        if ([fm moveItemAtURL:staged toURL:installed error:&error])
+            blog(LOG_INFO, "[livehime] add-on: browser source installed");
+        else
+            blog(LOG_WARNING, "[livehime] add-on: cannot install the browser source: %s",
+                 error.localizedDescription.UTF8String);
+    }
+    if (![fm fileExistsAtPath:installed.path])
+        return;
+
+    NSString *problem = nil;
+    NSData *data =
+        [NSData dataWithContentsOfURL:[installed URLByAppendingPathComponent:@"Contents/Resources/addon.json"]];
+    NSDictionary *manifest = data ? [NSJSONSerialization JSONObjectWithData:data options:0 error:nil] : nil;
+    uint32_t version = obs_get_version();
+    NSString *obs = [NSString stringWithFormat:@"%u.%u", version >> 24, (version >> 16) & 0xFF];
+#if defined(__aarch64__)
+    NSString *arch = @"arm64";
+#else
+    NSString *arch = @"x86_64";
+#endif
+    if (![manifest isKindOfClass:[NSDictionary class]] || ![manifest[@"id"] isEqual:@"browser-source"])
+        problem = @"no valid manifest";
+    else if (![manifest[@"obs"] isEqual:obs])
+        problem = [NSString stringWithFormat:@"built for OBS %@, this is OBS %@", manifest[@"obs"], obs];
+    else if (![manifest[@"arch"] isEqual:arch])
+        problem = [NSString stringWithFormat:@"built for %@", manifest[@"arch"]];
+    else {
+        NSData *app = LeafCertificate([NSBundle mainBundle].bundleURL, false);
+        NSData *addon = LeafCertificate(installed, true);
+        if (!addon)
+            problem = @"invalid signature";
+        else if (![addon isEqualToData:app])
+            problem = @"signed by a different certificate";
+    }
+    if (problem) {
+        obs_add_disabled_module("obs-browser");
+        blog(LOG_WARNING, "[livehime] add-on: browser source not loaded (%s)", problem.UTF8String);
+    } else {
+        blog(LOG_INFO, "[livehime] add-on: browser source %s", [manifest[@"version"] description].UTF8String);
+    }
+}
