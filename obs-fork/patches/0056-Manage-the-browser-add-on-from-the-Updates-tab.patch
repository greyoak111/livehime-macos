+import XCTest
+@testable import LiveHimeCore
+
+final class AddonManagerTests: XCTestCase {
+    private var saved: URL!
+    private var root: URL!
+
+    override func setUpWithError() throws {
+        saved = AddonManager.configDirectory
+        root = FileManager.default.temporaryDirectory.appendingPathComponent("addons-\(UUID().uuidString)")
+        try FileManager.default.createDirectory(at: root, withIntermediateDirectories: true)
+        AddonManager.configDirectory = root
+    }
+
+    override func tearDownWithError() throws {
+        AddonManager.configDirectory = saved
+        try? FileManager.default.removeItem(at: root)
+    }
+
+    /// A bare (unsigned) add-on bundle with a manifest.
+    private func bundle(at url: URL, version: String = "1.0.0", obs: String = "32.2", arch: String = "arm64") throws -> URL {
+        let resources = url.appendingPathComponent("Contents/Resources", isDirectory: true)
+        try FileManager.default.createDirectory(at: resources, withIntermediateDirectories: true)
+        let manifest = #"{"id":"browser-source","version":"\#(version)","obs":"\#(obs)","arch":"\#(arch)","cef":"6533"}"#
+        try Data(manifest.utf8).write(to: resources.appendingPathComponent("addon.json"))
+        return url
+    }
+
+    private let list = #"""
+    {"schema":1,"addons":[{"id":"browser-source","version":"1.2.0","obs":"32.2","cef":"6533","assets":{
+      "arm64":{"name":"a.zip","url":"https://example.invalid/a.zip","size":100,"sha256":"ABC"},
+      "x86_64":{"name":"x.zip","url":"https://example.invalid/x.zip","size":200,"sha256":"def"}}}]}
+    """#
+
+    func testOBSBaseIsMajorAndMinor() {
+        XCTAssertEqual(AddonManager.obsBase("32.2.2"), "32.2")
+        XCTAssertEqual(AddonManager.obsBase("33.0"), "33.0")
+        XCTAssertNil(AddonManager.obsBase("32"))
+        XCTAssertNil(AddonManager.obsBase(nil))
+    }
+
+    func testReadsTheOfferForEachArchitecture() throws {
+        let arm = try AddonManager.offers(from: Data(list.utf8), architecture: "arm64")
+        XCTAssertEqual(arm, [AddonOffer(id: "browser-source", version: "1.2.0", obs: "32.2",
+                                        archive: URL(string: "https://example.invalid/a.zip")!, size: 100, sha256: "abc")])
+        XCTAssertEqual(try AddonManager.offers(from: Data(list.utf8), architecture: "x86_64").first?.size, 200)
+        XCTAssertTrue(try AddonManager.offers(from: Data(list.utf8), architecture: "riscv").isEmpty)
+    }
+
+    func testOnlyAnAddOnForThisOBSBaseIsOffered() throws {
+        let offers = try AddonManager.offers(from: Data(list.utf8), architecture: "arm64")
+        XCTAssertEqual(try AddonManager.offer(in: offers, obs: "32.2").version, "1.2.0")
+        XCTAssertThrowsError(try AddonManager.offer(in: offers, obs: "33.0")) {
+            XCTAssertEqual($0 as? AppUpdateError, .noArchive)
+        }
+    }
+
+    func testReleaseCarriesItsAddOnList() throws {
+        let json = #"""
+        {"tag_name":"v0.3.0","assets":[
+          {"name":"LiveHimeMacApp-v0.3.0-arm64.zip","browser_download_url":"https://e.invalid/a.zip","digest":"sha256:aa"},
+          {"name":"addons.json","browser_download_url":"https://e.invalid/addons.json","digest":"sha256:BB"}]}
+        """#
+        let release = try AppUpdater.release(from: Data(json.utf8))
+        XCTAssertEqual(release.addons?.absoluteString, "https://e.invalid/addons.json")
+        XCTAssertEqual(release.addonsSha256, "bb")
+        let without = try AppUpdater.release(from: Data(#"{"tag_name":"v0.2.10","assets":[{"name":"LiveHimeMacApp-v0.2.10-arm64.zip","browser_download_url":"https://e.invalid/a.zip"}]}"#.utf8))
+        XCTAssertNil(without.addons)
+    }
+
+    func testStates() throws {
+        XCTAssertEqual(AddonManager.status(obs: "32.2", arch: "arm64").state, .notInstalled)
+
+        try FileManager.default.createDirectory(at: AddonManager.pluginsDirectory, withIntermediateDirectories: true)
+        _ = try bundle(at: AddonManager.installedBundle, obs: "31.1")
+        var status = AddonManager.status(obs: "32.2", arch: "arm64")
+        XCTAssertEqual(status.state, .updateNeeded)
+        XCTAssertEqual(status.installed, "1.0.0")
+
+        // Right OBS base and architecture, but not signed like the app.
+        try FileManager.default.removeItem(at: AddonManager.installedBundle)
+        _ = try bundle(at: AddonManager.installedBundle)
+        XCTAssertEqual(AddonManager.status(obs: "32.2", arch: "arm64").state, .damaged)
+        XCTAssertEqual(AddonManager.status(obs: "32.2", arch: "x86_64").state, .updateNeeded)
+
+        try FileManager.default.removeItem(at: AddonManager.installedBundle.appendingPathComponent("Contents/Resources/addon.json"))
+        XCTAssertEqual(AddonManager.status(obs: "32.2", arch: "arm64").state, .damaged)
+
+        let staged = try bundle(at: root.appendingPathComponent("staging/unpacked/obs-browser.plugin"), version: "1.1.0")
+        try AddonManager.stage(staged)
+        status = AddonManager.status(obs: "32.2", arch: "arm64")
+        XCTAssertEqual(status.state, .pendingInstall)
+        XCTAssertEqual(status.pending, "1.1.0")
+        XCTAssertFalse(FileManager.default.fileExists(atPath: root.appendingPathComponent("staging").path))
+
+        try AddonManager.scheduleRemoval()
+        XCTAssertEqual(AddonManager.status(obs: "32.2", arch: "arm64").state, .pendingRemoval)
+        XCTAssertFalse(FileManager.default.fileExists(atPath: AddonManager.pendingBundle.path))
+
+        AddonManager.cancelPending()
+        XCTAssertEqual(AddonManager.status(obs: "32.2", arch: "arm64").state, .damaged)
+    }
+
+    func testOnlyTheOfferedAddOnIsAccepted() throws {
+        let offer = AddonOffer(id: "browser-source", version: "1.0.0", obs: "32.2",
+                               archive: URL(string: "https://e.invalid/a.zip")!, size: 1, sha256: "aa")
+        let wrongVersion = try bundle(at: root.appendingPathComponent("v/obs-browser.plugin"), version: "0.9.0")
+        XCTAssertThrowsError(try AddonManager.verify(bundle: wrongVersion, offer: offer, arch: "arm64"))
+        let wrongArch = try bundle(at: root.appendingPathComponent("a/obs-browser.plugin"), arch: "x86_64")
+        XCTAssertThrowsError(try AddonManager.verify(bundle: wrongArch, offer: offer, arch: "arm64"))
+        let unsigned = try bundle(at: root.appendingPathComponent("u/obs-browser.plugin"))
+        XCTAssertThrowsError(try AddonManager.verify(bundle: unsigned, offer: offer, arch: "arm64")) {
+            XCTAssertEqual($0 as? AppUpdateError, .invalidApp("not signed like the app"))
+        }
+    }
+}
