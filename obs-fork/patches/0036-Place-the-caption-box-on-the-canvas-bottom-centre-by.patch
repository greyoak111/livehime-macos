 4 files changed, 184 insertions(+)

diff --git a/build-aux/livehime/tests/e2e-captions.mjs b/build-aux/livehime/tests/e2e-captions.mjs
index 0665be376..84a21bca8 100644
--- a/build-aux/livehime/tests/e2e-captions.mjs
+++ b/build-aux/livehime/tests/e2e-captions.mjs
@@ -104,6 +104,30 @@ ws.onmessage = async (ev) => {
     tf = await transform();
     check('width and height in properties move the box', tf.boundsWidth === 1000 && tf.boundsHeight === 200, `bounds ${tf.boundsWidth}x${tf.boundsHeight}`);
 
+    // Placement on the canvas: bottom centre by default, kept on resize.
+    const video = (await req('GetVideoSettings')).responseData;
+    const W = video.baseWidth, H = video.baseHeight, M = 40;
+    const at = (t) => `pos ${t.positionX},${t.positionY} box ${t.width}x${t.height} canvas ${W}x${H}`;
+    const near = (a, b) => Math.abs(a - b) <= 1;
+    tf = await transform();
+    check('box sits at the bottom centre of the canvas', near(tf.positionX + tf.width / 2, W / 2) && near(tf.positionY + tf.height, H - M), at(tf));
+    await req('SetSceneItemTransform', { sceneName: scene, sceneItemId: itemId, sceneItemTransform: { boundsWidth: 1400, boundsHeight: 180 } });
+    await sleep(500);
+    tf = await transform();
+    check('resizing keeps it centred on the bottom', tf.width === 1400 && near(tf.positionX + tf.width / 2, W / 2) && near(tf.positionY + tf.height, H - M), at(tf));
+    await req('SetInputSettings', { inputName: CAPTIONS, inputSettings: { placement: 4 } });
+    await sleep(500);
+    tf = await transform();
+    check('bottom-right placement', near(tf.positionX + tf.width, W - M) && near(tf.positionY + tf.height, H - M), at(tf));
+    await req('SetInputSettings', { inputName: CAPTIONS, inputSettings: { placement: 0 } });
+    await sleep(500);
+    tf = await transform();
+    await req('SetSceneItemTransform', { sceneName: scene, sceneItemId: itemId, sceneItemTransform: { positionX: tf.positionX - 150, positionY: tf.positionY - 90 } });
+    await sleep(500);
+    const placement = (await req('GetInputSettings', { inputName: CAPTIONS })).responseData.inputSettings.placement;
+    const moved = await transform();
+    check('moving it by hand switches to free placement and stays', placement === 7 && near(moved.positionX, tf.positionX - 150), `placement ${placement} ${at(moved)}`);
+
     // Layout: one long line, bottom centre, in a 1920 x 160 box.
     await req('SetInputSettings', { inputName: CAPTIONS, inputSettings: { width: 1920, height: 160, lines: 1, h_align: 1, v_align: 2, padding: 16, linger: 30 } });
     await sleep(600);
