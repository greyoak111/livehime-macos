+final class FaceAuthParsingTests: XCTestCase {
+    private func parse(_ object: [String: Any]) -> Error? {
+        do { _ = try BilibiliLiveClient.parseStreamConfig(from: try JSONSerialization.data(withJSONObject: object)); return nil }
+        catch { return error }
+    }
+
+    func testNeedFaceAuthWithQRIsNativeQR() {
+        let error = parse(["code": 0, "data": ["need_face_auth": true, "qr": "https://www.bilibili.com/h5/face?x=1"]])
+        XCTAssertEqual(error as? BilibiliLiveError, .faceAuthQR(url: "https://www.bilibili.com/h5/face?x=1"))
+    }
+
+    func testFaceAuthCodeWithVoucherUsesRiskPage() {
+        let error = parse(["code": 60024, "data": ["risk_extra": ["v_voucher": "v"]]])
+        XCTAssertEqual(error as? BilibiliLiveError, .faceAuthRequired(voucher: "v"))
+    }
+
+    func testFaceAuthCodeWithQRPrefersQR() {
+        let error = parse(["code": 60024, "data": ["qr": "https://q", "risk_extra": ["v_voucher": "v"]]])
+        XCTAssertEqual(error as? BilibiliLiveError, .faceAuthQR(url: "https://q"))
+    }
+
+    func testNormalPayloadIsNotFaceAuth() {
+        XCTAssertNil(parse(["code": 0, "data": ["need_face_auth": false, "rtmp": ["addr": "rtmp://a/live/", "code": "k"]]]))
+    }
+
+    func testIdentifiedFlagParsing() {
+        XCTAssertTrue(BilibiliLiveClient.identified(["is_identified": true]))
+        XCTAssertTrue(BilibiliLiveClient.identified(["is_face_auth": 1]))
+        XCTAssertFalse(BilibiliLiveClient.identified(["is_identified": false]))
+        XCTAssertFalse(BilibiliLiveClient.identified(["other": 1]))
+    }
+}
