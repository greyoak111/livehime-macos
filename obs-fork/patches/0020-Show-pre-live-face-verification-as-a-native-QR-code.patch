+    /// Whether the account has passed pre-live face verification. The response
+    /// shape is not documented; any truthy "identified"/"is_face"/"status"
+    /// style field counts, anything else reads as "not yet".
+    public func isIdentifiedByFaceAuth(roomID: Int64, cookieHeader: String) async throws -> Bool {
+        let root = try await requestJSON(
+            url: withQuery(URL(string: "https://api.live.bilibili.com/xlive/app-blink/v1/preLive/IsUserIdentifiedByFaceAuth")!,
+                           [URLQueryItem(name: "room_id", value: String(roomID))]),
+            cookieHeader: cookieHeader, body: nil)
+        return Self.identified(root["data"])
+    }
+
+    static func identified(_ value: Any?) -> Bool {
+        guard let data = value as? [String: Any] else { return (value as? Bool) ?? false }
+        for (key, raw) in data {
+            let name = key.lowercased()
+            guard name.contains("identif") || name.contains("is_face") || name == "is_auth" || name == "face_auth" else { continue }
+            if let flag = raw as? Bool, flag { return true }
+            if let number = raw as? NSNumber, number.intValue == 1 { return true }
+        }
+        return false
+    }
