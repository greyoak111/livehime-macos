+
+/// Native pre-live face verification, as the Windows client's FaceAuthView:
+/// show Bilibili's QR code for the phone app, poll whether the account has
+/// been verified and retry Go live once it has. The verification itself
+/// happens in the Bilibili app; nothing here completes or bypasses it.
+@MainActor
+final class FaceAuthQRWindow: NSObject, NSWindowDelegate {
+    private static var current: FaceAuthQRWindow?
+
+    private let window: NSWindow
+    private let status: NSTextField
+    private let onVerified: () -> Void
+    private var poll: Task<Void, Never>?
+
+    static func present(url: String, isVerified: @escaping () async -> Bool, onVerified: @escaping () -> Void) {
+        current?.window.close()
+        current = FaceAuthQRWindow(url: url, isVerified: isVerified, onVerified: onVerified)
+    }
+
+    private init(url: String, isVerified: @escaping () async -> Bool, onVerified: @escaping () -> Void) {
+        self.onVerified = onVerified
+        window = NSWindow(contentRect: NSRect(x: 0, y: 0, width: 360, height: 460),
+                          styleMask: [.titled, .closable], backing: .buffered, defer: false)
+        status = NSTextField(wrappingLabelWithString: "请用哔哩哔哩 App 扫码，按提示完成人脸认证。")
+        super.init()
+
+        let image = NSImageView()
+        if let png = QRImage.png(for: url, pixels: 560) { image.image = NSImage(data: png) }
+        image.imageScaling = .scaleProportionallyUpOrDown
+        image.translatesAutoresizingMaskIntoConstraints = false
+        image.widthAnchor.constraint(equalToConstant: 280).isActive = true
+        image.heightAnchor.constraint(equalToConstant: 280).isActive = true
+        status.alignment = .center
+        let retry = NSButton(title: "验证完成，重试开播", target: self, action: #selector(retryTapped))
+        retry.keyEquivalent = "\r"
+        let close = NSButton(title: "关闭", target: self, action: #selector(closeTapped))
+        let buttons = NSStackView(views: [close, retry])
+        let root = NSStackView(views: [image, status, buttons])
+        root.orientation = .vertical
+        root.alignment = .centerX
+        root.spacing = 14
+        root.edgeInsets = NSEdgeInsets(top: 20, left: 20, bottom: 20, right: 20)
+
+        window.title = "开播人脸认证"
+        window.contentView = root
+        window.isReleasedWhenClosed = false
+        window.delegate = self
+        window.center()
+        window.makeKeyAndOrderFront(nil)
+        NSApp.activate(ignoringOtherApps: true)
+
+        poll = Task { [weak self] in
+            while !Task.isCancelled {
+                try? await Task.sleep(for: .seconds(2))
+                guard !Task.isCancelled else { return }
+                if await isVerified() {
+                    self?.status.stringValue = "认证已通过，正在重试开播…"
+                    self?.finish()
+                    return
+                }
+            }
+        }
+    }
+
+    private func finish() {
+        let verified = onVerified
+        window.close()
+        verified()
+    }
+
+    @objc private func retryTapped() { finish() }
+    @objc private func closeTapped() { window.close() }
+
+    func windowWillClose(_ notification: Notification) {
+        poll?.cancel()
+        if Self.current === self { Self.current = nil }
+    }
+}
+
+/// Shows the native face verification QR code for the ready account and
+/// emits {"event":"faceAuthRetry"} once it is verified (or confirmed).
+@_cdecl("livehime_core_open_face_auth_qr")
+public func livehime_core_open_face_auth_qr(_ url: UnsafePointer<CChar>?) {
+    guard let url = url.map({ String(cString: $0) }), !url.isEmpty else { return }
+    DispatchQueue.main.async {
+        MainActor.assumeIsolated {
+            guard CoreBridge.shared != nil else { return }
+            FaceAuthQRWindow.present(url: url, isVerified: {
+                (try? await CoreBridge.shared?.coordinator.isIdentifiedByFaceAuth()) ?? false
+            }, onVerified: { CoreBridge.shared?.emit(["event": "faceAuthRetry"]) })
+        }
+    }
+}
