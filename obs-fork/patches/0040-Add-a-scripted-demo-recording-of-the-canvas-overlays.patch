@@ -0,0 +1,76 @@
+#!/bin/zsh
+# Records the LiveHime demo montage with a test instance of the dev build.
+# Usage: record.sh <ws password> <output dir>
+# Renders the assets (and a TTS narration unless <output dir>/assets has
+# narration.aiff), writes the demo profile, launches LiveHime with an
+# isolated Keychain item and the websocket on, runs director.mjs, quits,
+# and restores the user's profile, captions settings and websocket setting.
+# Refuses to run while LiveHime is open.
+set -euo pipefail
+
+password=$1 out=${2:A}
+here=${0:A:h}
+root=${here:h:h:h}
+app="$root/build_macos/frontend/RelWithDebInfo/LiveHime.app"
+config="$HOME/Library/Application Support/LiveHime/obs-studio"
+backup=$(mktemp -d)
+
+if pgrep -f 'LiveHime.app/Contents/MacOS/LiveHime' >/dev/null; then
+  print "Quit LiveHime first."; exit 1
+fi
+mkdir -p "$out/assets"
+swift "$here/assets.swift" "$out/assets" "$app/Contents/Resources/AppIcon.icns"
+[[ -f "$out/assets/narration.aiff" ]] || say -v Tingting -r 190 -o "$out/assets/narration.aiff" \
+  "大家好，这是苹果电脑上的直播姬。你现在看到的字幕，是在这台电脑上实时识别出来的，不需要联网。"
+
+profile="$config/basic/profiles/LiveHime_演示"
+mkdir -p "$profile"
+cat > "$profile/basic.ini" <<INI
+[General]
+Name=LiveHime 演示
+
+[Video]
+BaseCX=1920
+BaseCY=1080
+OutputCX=1920
+OutputCY=1080
+FPSType=0
+FPSCommon=60
+ScaleType=bicubic
+ColorFormat=NV12
+ColorSpace=709
+ColorRange=Partial
+
+[Output]
+Mode=Simple
+
+[SimpleOutput]
+FilePath=$out
+RecFormat2=mp4
+RecQuality=HQ
+RecEncoder=apple_h264
+INI
+
+cp "$config/user.ini" "$backup/user.ini"
+cp "$config/plugin_config/livehime/features.json" "$backup/features.json" 2>/dev/null || true
+cp "$config/plugin_config/obs-websocket/config.json" "$backup/ws.json"
+restore() {
+  pkill -f 'LiveHime.app/Contents/MacOS/LiveHime' 2>/dev/null || true
+  cp "$backup/user.ini" "$config/user.ini"
+  [[ -f "$backup/features.json" ]] && cp "$backup/features.json" "$config/plugin_config/livehime/features.json"
+  cp "$backup/ws.json" "$config/plugin_config/obs-websocket/config.json"
+  rm -rf "$backup"
+}
+trap restore EXIT
+
+python3 - "$config/plugin_config/obs-websocket/config.json" <<'PY'
+import json, sys
+p = sys.argv[1]; d = json.load(open(p)); d['server_enabled'] = True; json.dump(d, open(p, 'w'), indent=2)
+PY
+open --env LIVEHIME_KEYCHAIN_SERVICE=local.livehime.macos.e2e-test "$app"
+for i in {1..40}; do nc -z 127.0.0.1 4466 2>/dev/null && break; sleep 1; done
+sleep 4
+node "$here/director.mjs" "$password" "$out/assets" "$out"
+sleep 2   # let the websocket client disconnect before quitting
+osascript -e 'tell application id "local.livehime.macos.dev" to quit' >/dev/null 2>&1 || true
+for i in {1..15}; do pgrep -f 'LiveHime.app/Contents/MacOS/LiveHime' >/dev/null || break; sleep 1; done
