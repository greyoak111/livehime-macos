+// Renders the demo recording's images (1920 x 1080 canvas).
+// Usage: swift assets.swift <out dir> <app icon .icns>
+import AppKit
+
+let out = CommandLine.arguments[1]
+let icon = NSImage(contentsOfFile: CommandLine.arguments[2])
+let pink = NSColor(srgbRed: 0.984, green: 0.447, blue: 0.600, alpha: 1)   // #FB7299
+let blue = NSColor(srgbRed: 0.000, green: 0.682, blue: 0.925, alpha: 1)   // #00AEEC
+let ink = NSColor(srgbRed: 0.10, green: 0.11, blue: 0.14, alpha: 1)
+
+func image(_ size: NSSize, _ draw: (NSSize) -> Void) -> NSBitmapImageRep {
+    let rep = NSBitmapImageRep(bitmapDataPlanes: nil, pixelsWide: Int(size.width), pixelsHigh: Int(size.height),
+                               bitsPerSample: 8, samplesPerPixel: 4, hasAlpha: true, isPlanar: false,
+                               colorSpaceName: .deviceRGB, bytesPerRow: 0, bitsPerPixel: 0)!
+    rep.size = size
+    NSGraphicsContext.saveGraphicsState()
+    let bitmap = NSGraphicsContext(bitmapImageRep: rep)!
+    NSGraphicsContext.current = NSGraphicsContext(cgContext: bitmap.cgContext, flipped: true)
+    let flip = NSAffineTransform(); flip.translateX(by: 0, yBy: size.height); flip.scaleX(by: 1, yBy: -1); flip.concat()
+    draw(size)
+    NSGraphicsContext.restoreGraphicsState()
+    return rep
+}
+func save(_ rep: NSBitmapImageRep, _ name: String) {
+    try! rep.representation(using: .png, properties: [:])!.write(to: URL(fileURLWithPath: "\(out)/\(name)"))
+}
+func text(_ s: String, _ size: CGFloat, _ weight: NSFont.Weight, _ color: NSColor) -> NSAttributedString {
+    NSAttributedString(string: s, attributes: [.font: NSFont.systemFont(ofSize: size, weight: weight), .foregroundColor: color])
+}
+func centered(_ t: NSAttributedString, x: CGFloat, y: CGFloat) {
+    t.draw(at: NSPoint(x: x - t.size().width / 2, y: y))
+}
+func drawIcon(_ rect: NSRect) {
+    icon?.draw(in: rect, from: .zero, operation: .sourceOver, fraction: 1, respectFlipped: true, hints: nil)
+}
+let canvas = NSSize(width: 1920, height: 1080)
+
+// Background: a stand-in for stream content — dark gradient, soft brand glows, a faint grid.
+save(image(canvas) { size in
+    NSGradient(colors: [NSColor(srgbRed: 0.07, green: 0.08, blue: 0.13, alpha: 1),
+                        NSColor(srgbRed: 0.13, green: 0.10, blue: 0.20, alpha: 1)])!.draw(in: NSRect(origin: .zero, size: size), angle: -60)
+    for (color, center, radius) in [(pink, NSPoint(x: 1450, y: 300), 520.0), (blue, NSPoint(x: 520, y: 760), 600.0),
+                                    (pink, NSPoint(x: 1700, y: 900), 300.0)] {
+        NSGradient(colors: [color.withAlphaComponent(0.28), color.withAlphaComponent(0)])!
+            .draw(fromCenter: center, radius: 0, toCenter: center, radius: radius, options: [])
+    }
+    NSColor(white: 1, alpha: 0.035).setStroke()
+    for x in stride(from: 0, through: size.width, by: 80) {
+        let p = NSBezierPath(); p.move(to: NSPoint(x: x, y: 0)); p.line(to: NSPoint(x: x, y: size.height)); p.stroke()
+    }
+    for y in stride(from: 0, through: size.height, by: 80) {
+        let p = NSBezierPath(); p.move(to: NSPoint(x: 0, y: y)); p.line(to: NSPoint(x: size.width, y: y)); p.stroke()
+    }
+    drawIcon(NSRect(x: 40, y: 34, width: 56, height: 56))
+    text("LiveHime", 30, .semibold, .white).draw(at: NSPoint(x: 110, y: 36))
+    text("Mac 上的哔哩哔哩直播姬", 16, .regular, NSColor(white: 1, alpha: 0.6)).draw(at: NSPoint(x: 112, y: 72))
+}, "background.png")
+
+// "Demo data" tag, top right.
+save(image(NSSize(width: 300, height: 56)) { size in
+    let r = NSRect(origin: .zero, size: size).insetBy(dx: 2, dy: 2)
+    NSColor(white: 0, alpha: 0.45).setFill(); NSBezierPath(roundedRect: r, xRadius: 26, yRadius: 26).fill()
+    centered(text("演示数据 · Demo data", 20, .medium, NSColor(white: 1, alpha: 0.85)), x: size.width / 2, y: 14)
+}, "demo-tag.png")
+
+// Section chips.
+for (name, title, sub) in [("chip-danmaku", "弹幕发言列表", "Chat list overlay"),
+                           ("chip-captions", "语音字幕 · 本机识别", "On-device live captions"),
+                           ("chip-layout", "画面位置 · 拖边框不拉伸", "Place & resize freely")] {
+    let t = text(title, 34, .bold, .white), s = text(sub, 18, .medium, NSColor(white: 1, alpha: 0.75))
+    let width = max(t.size().width, s.size().width) + 96
+    save(image(NSSize(width: width, height: 112)) { size in
+        let r = NSRect(origin: .zero, size: size).insetBy(dx: 2, dy: 2)
+        NSGradient(colors: [pink, NSColor(srgbRed: 0.93, green: 0.30, blue: 0.45, alpha: 1)])!
+            .draw(in: NSBezierPath(roundedRect: r, xRadius: 22, yRadius: 22), angle: 0)
+        t.draw(at: NSPoint(x: 48, y: 16)); s.draw(at: NSPoint(x: 50, y: 64))
+    }, "\(name).png")
+}
+
+// Intro and outro cards (full canvas, translucent).
+func card(_ name: String, _ lines: [(String, CGFloat, NSFont.Weight, NSColor)], iconSize: CGFloat) {
+    save(image(canvas) { size in
+        NSColor(srgbRed: 0.05, green: 0.06, blue: 0.09, alpha: 0.86).setFill(); NSRect(origin: .zero, size: size).fill()
+        var y: CGFloat = 300
+        drawIcon(NSRect(x: size.width / 2 - iconSize / 2, y: y, width: iconSize, height: iconSize))
+        y += iconSize + 36
+        for (s, sz, w, c) in lines { let t = text(s, sz, w, c); centered(t, x: size.width / 2, y: y); y += t.size().height + 14 }
+    }, name)
+}
+card("intro.png", [("LiveHime for Mac", 72, .bold, .white),
+                   ("在 Mac 上用直播姬的方式开播", 36, .medium, NSColor(white: 1, alpha: 0.85)),
+                   ("扫码登录 · 一键开播 · 弹幕 · 语音字幕", 26, .regular, pink)], iconSize: 180)
+card("outro.png", [("github.com/greyoak111/livehime-macos", 44, .semibold, .white),
+                   ("免费开源 · Apple Silicon · macOS 13+（语音字幕需 macOS 26）", 26, .regular, NSColor(white: 1, alpha: 0.8)),
+                   ("第三方社区项目，与哔哩哔哩官方无关", 22, .regular, NSColor(white: 1, alpha: 0.6))], iconSize: 140)
+print("assets written to \(out)")
diff --git a/build-aux/livehime/demo/director.mjs b/build-aux/livehime/demo/director.mjs
new file mode 100644
index 000000000..4ec77b4e7
--- /dev/null
+++ b/build-aux/livehime/demo/director.mjs
@@ -0,0 +1,170 @@
+// Records a ~40 s feature montage of LiveHime's canvas overlays with OBS
+// itself: chat list, live captions (recognized live from a narration file),
+// placement and resizing. Everything shown is demo data and is labelled so.
+//
+// Runs in its own scene collection and profile ("LiveHime 演示", 1920x1080,
+// 60 fps, MP4) and switches back to the user's afterwards. Audio devices in
+// the demo collection are muted; only the narration is heard.
+//
+// Use record.sh, which prepares the profile and a test instance:
+//   node director.mjs <ws password> <assets dir> <output dir>
+// Assets: assets.swift output plus narration.aiff (any speech file).
+import { createHash } from 'node:crypto';
+
+const [password, assets, outDir] = process.argv.slice(2);
+const NAME = 'LiveHime 演示';
+const sha = (s) => createHash('sha256').update(s).digest('base64');
+const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
+const ws = new WebSocket('ws://127.0.0.1:4466');
+let id = 1; const pend = new Map();
+const req = async (t, d = {}) => {
+  const r = await new Promise((res) => { const k = String(id++); pend.set(k, res); ws.send(JSON.stringify({ op: 6, d: { requestType: t, requestId: k, requestData: d } })); });
+  if (!r.requestStatus.result && !t.startsWith('Get')) console.log(`  ! ${t}: ${r.requestStatus.comment}`);
+  return r.responseData || {};
+};
+const vendor = async (t, d = {}) => (await req('CallVendorRequest', { vendorName: 'livehime', requestType: t, requestData: d })).responseData;
+const log = (msg) => console.log(`${((Date.now() - (globalThis.t0 || Date.now())) / 1000).toFixed(1).padStart(5)}s  ${msg}`);
+
+const W = 1920, H = 1080;
+let scene;
+const itemIds = {};
+const add = async (name, kind, settings, enabled = true) => {
+  const r = await req('CreateInput', { sceneName: scene, inputName: name, inputKind: kind, inputSettings: settings, sceneItemEnabled: enabled });
+  itemIds[name] = r.sceneItemId;
+  return r.sceneItemId;
+};
+const show = (name, on) => req('SetSceneItemEnabled', { sceneName: scene, sceneItemId: itemIds[name], sceneItemEnabled: on });
+const place = (name, t) => req('SetSceneItemTransform', { sceneName: scene, sceneItemId: itemIds[name], sceneItemTransform: t });
+const size = async (name) => (await req('GetSceneItemTransform', { sceneName: scene, sceneItemId: itemIds[name] })).sceneItemTransform;
+const chat = (user, text) => vendor('InjectOverlayEvent', { kind: 'chat', user, text, uid: 1 });
+
+async function setup() {
+  const profiles = await req('GetProfileList');
+  const collections = await req('GetSceneCollectionList');
+  const original = { profile: profiles.currentProfileName, collection: collections.currentSceneCollectionName };
+  // The profile (1920x1080, 60 fps, MP4) is written by record.sh before
+  // launch: changing video settings over obs-websocket resets video off
+  // the UI thread, which can crash OBS. Switching profiles is safe.
+  if (!profiles.profiles.includes(NAME)) throw new Error(`profile "${NAME}" missing; run record.sh`);
+  await req('SetCurrentProfile', { profileName: NAME });
+  for (let i = 0; i < 40 && (await req('GetProfileList')).currentProfileName !== NAME; i++) await sleep(250);
+  await sleep(800);
+  await req('SetRecordDirectory', { recordDirectory: outDir });
+
+  if (collections.sceneCollections.includes(NAME)) await req('SetCurrentSceneCollection', { sceneCollectionName: NAME });
+  else await req('CreateSceneCollection', { sceneCollectionName: NAME });
+  for (let i = 0; i < 40 && (await req('GetSceneCollectionList')).currentSceneCollectionName !== NAME; i++) await sleep(250);
+  await sleep(800);
+
+  // A fresh scene for this take; older takes' scenes are removed.
+  scene = `演示 ${new Date().toISOString().slice(11, 19)}`;
+  await req('CreateScene', { sceneName: scene });
+  await req('SetCurrentProgramScene', { sceneName: scene });
+  for (const s of (await req('GetSceneList')).scenes) if (s.sceneName !== scene) await req('RemoveScene', { sceneName: s.sceneName });
+  for (const input of (await req('GetInputList')).inputs) {
+    if (/audio|input_capture|output_capture/.test(input.inputKind)) await req('SetInputMute', { inputName: input.inputName, inputMuted: true });
+  }
+  for (const n of ['demo-bg', 'demo-danmaku', 'demo-captions', 'demo-narration', 'demo-tag', 'chip-danmaku', 'chip-captions', 'chip-layout', 'intro', 'outro'])
+    await req('RemoveInput', { inputName: n });
+  await sleep(500);
+
+  await add('demo-bg', 'image_source', { file: `${assets}/background.png` });
+  // Chat list on the left, clear of the captions at the bottom centre.
+  await add('demo-danmaku', 'livehime_danmaku_overlay', { width: 600, height: 620, placement: 7, lifetime: 0,
+    font: { face: 'Hiragino Sans GB', style: 'W3', size: 30, flags: 0 } });
+  await sleep(300);
+  await place('demo-danmaku', { positionX: 60, positionY: 170 });
+  await add('demo-captions', 'livehime_captions', { width: 1100, height: 150, lines: 2, placement: 0, margin: 50, linger: 3,
+    background: true, font: { face: 'Hiragino Sans GB', style: 'W6', size: 46, flags: 0 } });
+  await add('demo-narration', 'ffmpeg_source', { local_file: `${assets}/narration.aiff`, is_local_file: true, restart_on_activate: false, close_when_inactive: false });
+  await add('demo-tag', 'image_source', { file: `${assets}/demo-tag.png` });
+  await place('demo-tag', { positionX: W - 40 - 300, positionY: 34 });
+  for (const chip of ['chip-danmaku', 'chip-captions', 'chip-layout']) {
+    await add(chip, 'image_source', { file: `${assets}/${chip}.png` }, false);
+    await sleep(150);
+    const t = await size(chip);
+    await place(chip, { positionX: Math.round((W - t.sourceWidth) / 2), positionY: 120 });
+  }
+  await add('intro', 'image_source', { file: `${assets}/intro.png` }, false);
+  await add('outro', 'image_source', { file: `${assets}/outro.png` }, false);
+  await req('TriggerMediaInputAction', { inputName: 'demo-narration', mediaAction: 'OBS_WEBSOCKET_MEDIA_INPUT_ACTION_STOP' });
+
+  let st = await vendor('Captions', { enabled: true, source: 'demo-narration', locale: 'zh-CN' });
+  for (let i = 0; i < 40 && !/正在识别|Listening/.test(st?.status); i++) { await sleep(250); st = await vendor('Captions'); }
+  console.log('captions:', st?.status);
+  return original;
+}
+
+async function animateBounds(name, from, to, ms) {
+  const steps = Math.round(ms / 33);
+  for (let i = 1; i <= steps; i++) {
+    const k = i / steps, e = k < 0.5 ? 2 * k * k : 1 - Math.pow(-2 * k + 2, 2) / 2; // ease in-out
+    await place(name, { boundsWidth: Math.round(from[0] + (to[0] - from[0]) * e), boundsHeight: Math.round(from[1] + (to[1] - from[1]) * e) });
+    await sleep(33);
+  }
+}
+
+async function take() {
+  await req('StartRecord');
+  globalThis.t0 = Date.now();
+  const at = async (s) => { const wait = globalThis.t0 + s * 1000 - Date.now(); if (wait > 0) await sleep(wait); };
+
+  log('intro'); await show('intro', true);
+  await at(3.2); await show('intro', false);
+
+  log('chat list'); await show('chip-danmaku', true);
+  const messages = [
+    () => chat('小明同学', '晚上好！'), () => chat('路过的猫', 'Mac 也能开播了？'), () => chat('追更党', '这个弹幕列表好清爽'),
+    () => vendor('InjectOverlayEvent', { kind: 'gift', user: '阿杰', name: '小心心', count: 5 }),
+    () => chat('电池君', '主播加油！'), () => chat('夜猫子', '字体描边还能调'),
+    () => vendor('InjectOverlayEvent', { kind: 'superChat', user: '小雨', text: '第一次在 Mac 上看你直播！', price: 30, seconds: 60 }),
+    () => chat('摸鱼中', '催更催更'), () => vendor('InjectOverlayEvent', { kind: 'guard', user: '老粉丝', name: '舰长' }),
+    () => chat('新来的', '怎么下载？'), () => chat('路过的猫', '开源的，在 GitHub 上'),
+  ];
+  for (let i = 0; i < messages.length; i++) { await at(4.0 + i * 0.85); await messages[i](); }
+  await at(14.5); await show('chip-danmaku', false);
+
+  log('captions'); await show('chip-captions', true);
+  await at(15.3); await req('TriggerMediaInputAction', { inputName: 'demo-narration', mediaAction: 'OBS_WEBSOCKET_MEDIA_INPUT_ACTION_RESTART' });
+  await at(26.5); await show('chip-captions', false);
+
+  log('placement'); await show('chip-layout', true);
+  await at(28.0); await req('SetInputSettings', { inputName: 'demo-danmaku', inputSettings: { placement: 4, margin: 60 } }); // bottom right
+  await at(29.8); await animateBounds('demo-danmaku', [600, 620], [860, 800], 1200);
+  await at(32.4); await req('SetInputSettings', { inputName: 'demo-danmaku', inputSettings: { placement: 0 } }); // bottom centre
+  await at(34.0); await animateBounds('demo-danmaku', [860, 800], [600, 620], 900);
+  await at(35.4); await req('SetInputSettings', { inputName: 'demo-danmaku', inputSettings: { placement: 7 } });
+  await place('demo-danmaku', { positionX: 60, positionY: 170 });
+  await at(36.8); await show('chip-layout', false);
+
+  log('outro'); await show('outro', true);
+  await at(40.5);
+  const stop = await req('StopRecord');
+  log('recorded ' + stop.outputPath);
+  return stop.outputPath;
+}
+
+ws.onmessage = async (ev) => {
+  const m = JSON.parse(ev.data);
+  if (m.op === 0) { const { challenge, salt } = m.d.authentication; ws.send(JSON.stringify({ op: 1, d: { rpcVersion: 1, authentication: sha(sha(password + salt) + challenge), eventSubscriptions: 0 } })); return; }
+  if (m.op === 7) { pend.get(m.d.requestId)?.(m.d); return; }
+  if (m.op !== 2) return;
+  let original;
+  try {
+    for (let i = 0; i < 40 && !(await req('GetVersion')).obsVersion; i++) await sleep(500);
+    original = await setup();
+    await sleep(1500);
+    const path = await take();
+    console.log('OUTPUT ' + path);
+  } catch (e) { console.log('ERROR', e.stack); }
+  finally {
+    await vendor('Captions', { enabled: false, source: '', locale: '' });
+    if (original) {
+      await req('SetCurrentSceneCollection', { sceneCollectionName: original.collection });
+      await sleep(1000);
+      await req('SetCurrentProfile', { profileName: original.profile });
+    }
+    await sleep(500);
+    process.exit(0);
+  }
+};
