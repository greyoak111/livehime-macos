diff --git a/plugins/livehime/core/Sources/LiveHimeCore/BilibiliLiveClient.swift b/plugins/livehime/core/Sources/LiveHimeCore/BilibiliLiveClient.swift
index b452453ed..fbb871f55 100644
--- a/plugins/livehime/core/Sources/LiveHimeCore/BilibiliLiveClient.swift
+++ b/plugins/livehime/core/Sources/LiveHimeCore/BilibiliLiveClient.swift
@@ -309,20 +309,41 @@ public struct BilibiliLiveClient: Sendable {
         return try parseStreamConfig(root)
     }
 
+    /// Picks the RTMP endpoint from a startLive/GetUpStreamRtmp payload.
+    /// The payload can list several protocols (for example rtmp and srt), so
+    /// look at the known RTMP locations first, then collect every candidate
+    /// in a stable order and take the first rtmp/rtmps one. Dictionary
+    /// iteration order is random, so "first match wins" must never decide.
     private static func parseStreamConfig(_ root: [String: Any]) throws -> BilibiliStreamConfig {
-        func scan(_ value: Any?) -> (String, String)? {
+        func pair(_ d: [String: Any]) -> (String, String)? {
+            let a = d["addr"] as? String ?? d["server"] as? String ?? d["rtmp_addr"] as? String
+            let k = d["code"] as? String ?? d["key"] as? String ?? d["stream_code"] as? String
+            guard let a, let k, !a.isEmpty, !k.isEmpty else { return nil }
+            return (a, k)
+        }
+        func collect(_ value: Any?, into out: inout [(String, String)]) {
             if let d = value as? [String: Any] {
-                let a = d["addr"] as? String ?? d["server"] as? String ?? d["rtmp_addr"] as? String
-                let k = d["code"] as? String ?? d["key"] as? String ?? d["stream_code"] as? String
-                if let a, let k, !a.isEmpty, !k.isEmpty { return (a, k) }
-                for v in d.values { if let x = scan(v) { return x } }
-            } else if let a = value as? [Any] { for v in a { if let x = scan(v) { return x } } }
-            return nil
+                if let p = pair(d) { out.append(p) }
+                for key in d.keys.sorted() { collect(d[key], into: &out) }
+            } else if let a = value as? [Any] {
+                for v in a { collect(v, into: &out) }
+            }
+        }
+        func usable(_ p: (String, String)) -> BilibiliStreamConfig? {
+            guard let url = URL(string: p.0), ["rtmp", "rtmps"].contains(url.scheme?.lowercased() ?? ""),
+                  let host = url.host, !host.isEmpty else { return nil }
+            return BilibiliStreamConfig(server: url, key: p.1)
+        }
+        let data = root["data"] as? [String: Any] ?? [:]
+        var candidates: [(String, String)] = []
+        if let rtmp = data["rtmp"] as? [String: Any], let p = pair(rtmp) { candidates.append(p) }
+        for entry in data["protocols"] as? [[String: Any]] ?? []
+        where (entry["protocol"] as? String)?.lowercased() == "rtmp" {
+            if let p = pair(entry) { candidates.append(p) }
         }
-        guard let pair = scan(root["data"]), let server = URL(string: pair.0),
-              ["rtmp", "rtmps"].contains(server.scheme?.lowercased() ?? ""),
-              let host = server.host, !host.isEmpty else { throw BilibiliLiveError.missingStreamConfig }
-        return BilibiliStreamConfig(server: server, key: pair.1)
+        collect(root["data"], into: &candidates)
+        for candidate in candidates { if let config = usable(candidate) { return config } }
+        throw BilibiliLiveError.missingStreamConfig
     }
 
     private func parseStreamConfig(_ root: [String: Any], stage: BilibiliDiagnosticStage) throws -> BilibiliStreamConfig {
