+
+/// Regression: startLive payloads can list several protocols. The parser once
+/// took whichever dictionary value it met first (random order) and failed
+/// whenever that happened to be the SRT entry.
+final class StreamConfigParsingTests: XCTestCase {
+    private func payload(_ data: [String: Any]) -> Data {
+        try! JSONSerialization.data(withJSONObject: ["code": 0, "data": data])
+    }
+
+    func testPrefersRTMPWhenSRTIsAlsoListed() throws {
+        let data: [String: Any] = [
+            "change": 1,
+            "a_srt": ["addr": "srt://live-push.example:1937", "code": "srtkey"],
+            "protocols": [["protocol": "srt", "addr": "srt://live-push.example:1937", "code": "srtkey"],
+                          ["protocol": "rtmp", "addr": "rtmp://live-push.example/live-bvc/", "code": "?streamname=k"]],
+            "z_other": ["addr": "https://example.com", "code": "x"]
+        ]
+        for _ in 0..<50 {
+            let config = try BilibiliLiveClient.parseStreamConfig(from: payload(data))
+            XCTAssertEqual(config.address, "rtmp://live-push.example/live-bvc/")
+            XCTAssertEqual(config.key, "?streamname=k")
+        }
+    }
+
+    func testRTMPObjectWins() throws {
+        let data: [String: Any] = ["rtmp": ["addr": "rtmp://a.example/live/", "code": "k1"],
+                                   "srt": ["addr": "srt://b.example", "code": "k2"]]
+        XCTAssertEqual(try BilibiliLiveClient.parseStreamConfig(from: payload(data)).key, "k1")
+    }
+
+    func testOnlyNonRTMPIsMissing() {
+        let data: [String: Any] = ["srt": ["addr": "srt://b.example", "code": "k2"]]
+        XCTAssertThrowsError(try BilibiliLiveClient.parseStreamConfig(from: payload(data))) {
+            XCTAssertEqual($0 as? BilibiliLiveError, .missingStreamConfig)
+        }
+    }
+}
