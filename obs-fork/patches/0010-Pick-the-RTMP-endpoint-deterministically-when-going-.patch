     func updateTitle(roomID: Int64, title: String, cookieHeader: String) async throws
 }
@@ -131,8 +132,17 @@ public final class SessionCoordinator {
     /// record is refreshed afterwards so the dock shows Bilibili's view.
     public func startLive(area: BilibiliLiveArea) async throws -> BilibiliStreamConfig {
         let (saved, account) = try readyAccount()
-        let endpoint = try await guarded {
-            try await self.api.startLive(roomID: account.room.roomID, area: area, cookieHeader: saved.cookieHeader)
+        let endpoint: BilibiliStreamConfig
+        do {
+            endpoint = try await guarded {
+                try await self.api.startLive(roomID: account.room.roomID, area: area, cookieHeader: saved.cookieHeader)
+            }
+        } catch BilibiliLiveError.missingStreamConfig {
+            // startLive succeeded (the room is open) but its payload had no
+            // usable RTMP endpoint; ask for the upstream address directly.
+            endpoint = try await guarded {
+                try await self.api.upstream(roomID: account.room.roomID, cookieHeader: saved.cookieHeader)
+            }
         }
         await refreshRoom()
         return endpoint
@@ -338,6 +348,10 @@ public struct LiveBilibiliAccountAPI: BilibiliAccountAPI {
         try await live(cookieHeader).stopLive(roomID: roomID, cookieHeader: cookieHeader)
     }
 
+    public func upstream(roomID: Int64, cookieHeader: String) async throws -> BilibiliStreamConfig {
+        try await live(cookieHeader).fetchUpstream(roomID: roomID)
+    }
+
     public func sendDanmaku(roomID: Int64, text: String, cookieHeader: String) async throws {
         try await live(cookieHeader).sendDanmaku(roomID: roomID, text: text, cookieHeader: cookieHeader)
     }
