index 1512972b6..ea70c85a6 100644
--- a/plugins/livehime/core/Tests/LiveHimeCoreTests/DanmakuProtocolTests.swift
+++ b/plugins/livehime/core/Tests/LiveHimeCoreTests/DanmakuProtocolTests.swift
@@ -66,3 +66,40 @@ final class DanmakuProtocolTests: XCTestCase {
         XCTAssertEqual(items.last, URLQueryItem(name: "w_rid", value: "6a7b397a3b98a73cebbca7b826767240"))
