diff --git a/plugins/livehime/src/window-native.hpp b/plugins/livehime/src/window-native.hpp
index be8e9cd24..593d3dd66 100644
--- a/plugins/livehime/src/window-native.hpp
+++ b/plugins/livehime/src/window-native.hpp
@@ -8,6 +8,12 @@ class QWidget;
  * record the window (NSWindow sharingType). */
 void ApplyNativeWindowOptions(QWidget *window, bool floating, bool capturable);
 
+/* Lets `menu` (and its submenus) open over another app's full-screen Space,
+ * where the floating chat can sit: each popup window becomes a
+ * non-activating panel that may join any Space. Call once after creating it. */
+class QMenu;
+void AllowMenuOverFullScreen(QMenu *menu);
+
 /* The window-server id (CGWindowID) of a shown window, or 0. */
 unsigned int NativeWindowNumber(QWidget *window);
 
diff --git a/plugins/livehime/src/window-native.mm b/plugins/livehime/src/window-native.mm
index ec6201faf..dac92093d 100644
--- a/plugins/livehime/src/window-native.mm
+++ b/plugins/livehime/src/window-native.mm
@@ -2,6 +2,7 @@
 
 #import <AppKit/AppKit.h>
 #import <objc/runtime.h>
+#include <QMenu>
 #include <QWidget>
 
 #include <obs.h>
@@ -73,6 +74,37 @@ void ApplyNativeWindowOptions(QWidget *window, bool floating, bool capturable)
 	nswindow.sharingType = capturable ? NSWindowSharingReadOnly : NSWindowSharingNone;
 }
 
+void AllowMenuOverFullScreen(QMenu *menu)
+{
+	QObject::connect(menu, &QMenu::aboutToShow, menu, [menu] {
+		NSView *view = (__bridge NSView *)reinterpret_cast<void *>(menu->winId());
+		NSWindow *nswindow = view.window;
+		if (!nswindow)
+			return;
+		/* Replace the members of each mutually exclusive group Qt may have
+		 * set (AppKit throws on conflicting combinations); if AppKit still
+		 * refuses, the menu just stays out of full-screen Spaces. */
+		NSWindowCollectionBehavior behavior = nswindow.collectionBehavior;
+		behavior &= ~(NSWindowCollectionBehaviorMoveToActiveSpace | NSWindowCollectionBehaviorFullScreenPrimary |
+			      NSWindowCollectionBehaviorFullScreenNone | NSWindowCollectionBehaviorFullScreenAllowsTiling);
+		behavior |= NSWindowCollectionBehaviorCanJoinAllSpaces | NSWindowCollectionBehaviorFullScreenAuxiliary;
+		@try {
+			nswindow.collectionBehavior = behavior;
+			if ([nswindow isKindOfClass:[NSPanel class]])
+				nswindow.styleMask |= NSWindowStyleMaskNonactivatingPanel;
+		} @catch (NSException *exception) {
+			blog(LOG_WARNING, "[livehime] menu window behaviour: %s", exception.reason.UTF8String);
+		}
+		for (QAction *action : menu->actions()) {
+			QMenu *sub = QMenu::menuInAction(action);
+			if (sub && !sub->property("livehime.fullScreenMenu").toBool()) {
+				sub->setProperty("livehime.fullScreenMenu", true);
+				AllowMenuOverFullScreen(sub);
+			}
+		}
+	});
+}
+
 unsigned int NativeWindowNumber(QWidget *window)
 {
 	NSView *view = (__bridge NSView *)reinterpret_cast<void *>(window->winId());
