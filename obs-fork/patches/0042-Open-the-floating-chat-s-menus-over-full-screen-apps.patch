 plugins/livehime/src/automation.cpp           | 11 ++++++-
 plugins/livehime/src/danmaku-feed.cpp         |  3 ++
 plugins/livehime/src/floating-chat.cpp        |  2 ++
 plugins/livehime/src/floating-chat.hpp        |  4 +++
 plugins/livehime/src/window-native.hpp        |  6 ++++
 plugins/livehime/src/window-native.mm         | 32 +++++++++++++++++++
 7 files changed, 77 insertions(+), 2 deletions(-)

diff --git a/build-aux/livehime/tests/e2e-float-fullscreen.mjs b/build-aux/livehime/tests/e2e-float-fullscreen.mjs
index cda42bfee..df355bc1f 100644
--- a/build-aux/livehime/tests/e2e-float-fullscreen.mjs
+++ b/build-aux/livehime/tests/e2e-float-fullscreen.mjs
@@ -3,9 +3,10 @@
 // another app's normal window while LiveHime is inactive.
 // Usage: swiftc -O fullscreen-probe.swift -o /tmp/fullscreen-probe
 //        node e2e-float-fullscreen.mjs <ws password> <LiveHime pid> /tmp/fullscreen-probe
+// The "⋯" menu must also open over the full-screen window.
 // The probe takes over the screen for a few seconds per case.
 import { createHash } from 'node:crypto';
-import { execFileSync } from 'node:child_process';
+import { execFile, execFileSync } from 'node:child_process';
 const [password, pid, helper] = process.argv.slice(2);
 const sha = (s) => createHash('sha256').update(s).digest('base64');
 const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
@@ -53,6 +54,24 @@ for (const onTop of [true, false]) {
   if (!ok) fails++;
   console.log(`${ok ? 'PASS' : 'FAIL'}  on_top=true, LiveHime inactive: chat in front of the other app's window (layer ${layer})`);
 }
+{
+  // The "⋯" menu opened while another app is full screen.
+  await vendor('FloatingChat', { visible: true, on_top: true, x: 120, y: 160, w: 340, h: 460 });
+  await sleep(800);
+  const probe = new Promise((ok) => execFile(helper, [pid, '4'], { encoding: 'utf8' }, (_, out) => ok(out)));
+  await sleep(2500);
+  const st = await vendor('FloatingChat', { menu: true });
+  const out = await probe;
+  await vendor('FloatingChat', { menu: false });
+  const targets = out.split('\n').filter((l) => / target /.test(l));
+  const menu = targets.find((l) => !/340x460/.test(l));
+  const z = (l) => Number((l?.match(/z=(\d+)/) || [])[1] ?? 99);
+  const helperZ = Number((out.match(/z=(\d+) helper/) || [])[1] ?? -1);
+  const ok = /fullscreen=true/.test(out) && st?.menu_visible && menu && z(menu) < helperZ;
+  if (!ok) fails++;
+  console.log(`${ok ? 'PASS' : 'FAIL'}  "⋯" menu over a full-screen app: menu_visible=${st?.menu_visible}, menu window ${menu ? menu.trim() : 'not on screen'}`);
+  await sleep(1500);
+}
 await vendor('FloatingChat', { visible: false, on_top: true });
 ws.close();
 await sleep(1500);
