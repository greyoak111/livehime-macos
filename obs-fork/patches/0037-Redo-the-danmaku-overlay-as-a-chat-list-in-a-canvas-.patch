+
+/* One message wrapped to the box: each entry is (start, length) in name+body. */
+std::vector<std::pair<int, int>> wrap(const QString &full, const QFont &font, double width)
+{
+	std::vector<std::pair<int, int>> lines;
+	QTextLayout layout(full, font);
+	QTextOption option;
+	option.setWrapMode(QTextOption::WrapAtWordBoundaryOrAnywhere);
+	layout.setTextOption(option);
+	layout.beginLayout();
+	for (QTextLine line = layout.createLine(); line.isValid(); line = layout.createLine()) {
+		line.setLineWidth(width);
+		lines.emplace_back(line.textStart(), line.textLength());
+	}
+	layout.endLayout();
+	return lines;
+}
+
+/* Newest message at the bottom, older ones above until the box is full. */
+QImage render(const std::deque<Message> &messages, const Style &style, QString *shown)
+{
+	QImage image(style.width, style.height, QImage::Format_ARGB32_Premultiplied);
+	image.fill(Qt::transparent);
+	shown->clear();
+	if (messages.empty())
+		return image;
+
+	const QFontMetricsF metrics(style.font);
+	const double pad = style.padding;
+	const double lineHeight = metrics.height() * 1.18;
+	const double gap = lineHeight * 0.25;
+	const double textWidth = std::max(40.0, style.width - pad * 2 - (style.background ? pad : 0));
+	const double inset = style.background ? pad * 1.5 : pad;
+
+	struct Block {
+		const Message *message;
+		std::vector<std::pair<int, int>> lines;
+		double top;
+	};
+	std::vector<Block> blocks;
+	double bottom = style.height - pad;
+	for (auto it = messages.rbegin(); it != messages.rend(); ++it) {
+		auto lines = wrap(it->name + it->body, style.font, textWidth);
+		const double blockHeight = lineHeight * lines.size();
+		const double top = bottom - blockHeight;
+		if (top < pad && !blocks.empty())
+			break;
+		blocks.push_back({&*it, std::move(lines), top});
+		bottom = top - gap;
+	}
+	std::reverse(blocks.begin(), blocks.end());
+
+	QPainter painter(&image);
+	painter.setRenderHint(QPainter::Antialiasing);
+	painter.setClipRect(QRectF(0, 0, style.width, style.height));
+	if (style.background) {
+		const double top = std::max(0.0, blocks.front().top - pad * 0.75);
+		painter.setPen(Qt::NoPen);
+		painter.setBrush(style.backgroundColor);
+		painter.drawRoundedRect(QRectF(pad / 2, top, style.width - pad, style.height - pad / 2 - top), 14, 14);
+	}
+
+	QStringList rows;
+	for (const Block &block : blocks) {
+		const Message &message = *block.message;
+		const QString full = message.name + message.body;
+		rows << full;
+		if (message.kind == "superChat") {
+			painter.setPen(Qt::NoPen);
+			painter.setBrush(QColor(0xE5, 0x48, 0x4D, 215));
+			painter.drawRoundedRect(QRectF(inset - pad * 0.4, block.top - lineHeight * 0.08, textWidth + pad * 0.8,
+						       lineHeight * block.lines.size() + lineHeight * 0.16),
+						8, 8);
+		}
+		const QColor bodyColor = message.kind == "superChat" ? QColor(Qt::white) : kindColor(message.kind, style);
+		for (size_t i = 0; i < block.lines.size(); i++) {
+			const auto [start, length] = block.lines[i];
+			const double baseline = block.top + lineHeight * i + (lineHeight - metrics.height()) / 2 + metrics.ascent();
+			double x = inset;
+			/* The part of this line inside the name gets the name colour. */
+			const int nameEnd = std::clamp(static_cast<int>(message.name.size()) - start, 0, length);
+			if (nameEnd > 0) {
+				const QString part = full.mid(start, nameEnd);
+				PaintText(painter, QPointF(x, baseline), style.font, part, style.nameColor, style.outline,
+					  style.outlineWidth, style.outlineColor, style.shadow);
+				x += metrics.horizontalAdvance(part);
+			}
+			const QString rest = full.mid(start + nameEnd, length - nameEnd);
+			if (!rest.isEmpty())
+				PaintText(painter, QPointF(x, baseline), style.font, rest, bodyColor, style.outline,
+					  style.outlineWidth, style.outlineColor, style.shadow);
+		}
+	}
+	*shown = rows.join(QChar('\n'));
+	return image;
+}
