--- /dev/null
+++ b/plugins/livehime/src/canvas-box.hpp
@@ -0,0 +1,35 @@
+#pragma once
+
+#include <obs.hpp>
+
+/* A LiveHime overlay (captions, danmaku) on the canvas is a box of the size
+ * the user sets, placed where the user chooses, and OBS's own transform
+ * controls size that box instead of scaling the text:
+ * - scene items of these sources use a bounding box (max size only) and the
+ *   source takes it as its "width" and "height";
+ * - "placement" anchors the box (bottom centre, a corner, ...) at "margin"
+ *   pixels from the canvas edge; resizing keeps the anchor, moving the box
+ *   by hand switches the source to Free;
+ * - width/height/placement changed in the source's properties are pushed
+ *   to its items (Tracker). */
+namespace CanvasBox {
+enum Placement { BottomCenter = 0, TopCenter, Center, BottomLeft, BottomRight, TopLeft, TopRight, Free };
+
+/* Attach at module load (scenes created later); AttachExisting once the
+ * scene collection has loaded or changed. */
+void Attach();
+void AttachExisting();
+void Detach();
+
+void PushSize(obs_source_t *source, int width, int height);
+void Place(obs_source_t *source);
+
+void SetDefaults(obs_data_t *settings, int width, int height, Placement placement, int margin = 40);
+void AddProperties(obs_properties_t *props);
+
+/* Call from a source's update(): pushes size / placement changes. */
+struct Tracker {
+	int width = -1, height = -1, placement = -1, margin = -1;
+	void update(obs_source_t *source, obs_data_t *settings);
+};
+} // namespace CanvasBox
