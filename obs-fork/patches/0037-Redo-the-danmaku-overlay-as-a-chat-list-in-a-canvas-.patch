diff --git a/plugins/livehime/src/canvas-box.cpp b/plugins/livehime/src/canvas-box.cpp
new file mode 100644
index 000000000..0bcb74637
--- /dev/null
+++ b/plugins/livehime/src/canvas-box.cpp
@@ -0,0 +1,327 @@
+#include "canvas-box.hpp"
+
+#include <obs-module.h>
+
+#include <QCoreApplication>
+#include <QMetaObject>
+#include <QString>
+
+#include <cmath>
+#include <cstring>
+#include <functional>
+#include <map>
+
+using namespace CanvasBox;
+
+
+namespace {
+/* Sources whose scene items are boxes. */
+bool isBoxItem(obs_sceneitem_t *item)
+{
+	obs_source_t *source = obs_sceneitem_get_source(item);
+	if (!source)
+		return false;
+	const char *id = obs_source_get_unversioned_id(source);
+	return strcmp(id, "livehime_captions") == 0 || strcmp(id, "livehime_danmaku_overlay") == 0;
+}
+
+/* Runs on the UI thread: item_transform arrives from the video thread. */
+template<typename Fn> void onUi(Fn &&fn)
+{
+	if (QCoreApplication *app = QCoreApplication::instance())
+		QMetaObject::invokeMethod(app, std::forward<Fn>(fn), Qt::QueuedConnection);
+}
+
+void setSourceSize(obs_source_t *source, int width, int height)
+{
+	OBSDataAutoRelease settings = obs_source_get_settings(source);
+	if (obs_data_get_int(settings, "width") == width && obs_data_get_int(settings, "height") == height)
+		return;
+	OBSDataAutoRelease changes = obs_data_create();
+	obs_data_set_int(changes, "width", width);
+	obs_data_set_int(changes, "height", height);
+	obs_source_update(source, changes);
+}
+
+/* Last position and box we gave each item (UI thread), to tell a resize
+ * (keep the anchor) from the user moving the box (stop anchoring). */
+struct Placed {
+	vec2 pos;
+	vec2 bounds;
+};
+std::map<QString, Placed> placedItems;
+
+QString itemKey(obs_sceneitem_t *item)
+{
+	obs_source_t *scene = obs_scene_get_source(obs_sceneitem_get_scene(item));
+	return QString::fromUtf8(obs_source_get_uuid(scene)) + QChar(':') + QString::number(obs_sceneitem_get_id(item));
+}
+
+bool near(float a, float b)
+{
+	return std::fabs(a - b) < 0.5f;
+}
+
+/* Puts the box where the source's "placement" says (bottom centre by
+ * default). Moving the box by hand switches the source to free placement;
+ * resizing keeps it anchored. `force` re-applies after a settings change. */
+void placeItem(obs_sceneitem_t *item, bool force)
+{
+	obs_source_t *source = obs_sceneitem_get_source(item);
+	OBSDataAutoRelease settings = obs_source_get_settings(source);
+	const int placement = static_cast<int>(obs_data_get_int(settings, "placement"));
+	const QString key = itemKey(item);
+	if (placement == Free || obs_sceneitem_get_rot(item) != 0.0f) {
+		placedItems.erase(key);
+		return;
+	}
+	vec2 bounds, pos;
+	obs_sceneitem_get_bounds(item, &bounds);
+	obs_sceneitem_get_pos(item, &pos);
+	auto previous = placedItems.find(key);
+	if (!force && previous != placedItems.end() && near(bounds.x, previous->second.bounds.x) &&
+	    near(bounds.y, previous->second.bounds.y) &&
+	    (!near(pos.x, previous->second.pos.x) || !near(pos.y, previous->second.pos.y))) {
+		/* Same size, new place: the user moved it. */
+		placedItems.erase(previous);
+		OBSDataAutoRelease changes = obs_data_create();
+		obs_data_set_int(changes, "placement", Free);
+		obs_source_update(source, changes);
+		return;
+	}
+
+	obs_video_info video;
+	if (!obs_get_video_info(&video))
+		return;
+	const float canvasWidth = float(video.base_width), canvasHeight = float(video.base_height);
+	const float margin = float(obs_data_get_int(settings, "margin"));
+	float left = (canvasWidth - bounds.x) / 2, top = canvasHeight - margin - bounds.y;
+	switch (placement) {
+	case TopCenter:
+		top = margin;
+		break;
+	case Center:
+		top = (canvasHeight - bounds.y) / 2;
+		break;
+	case BottomLeft:
+		left = margin;
+		break;
+	case BottomRight:
+		left = canvasWidth - margin - bounds.x;
+		break;
+	case TopLeft:
+		left = margin;
+		top = margin;
+		break;
+	case TopRight:
+		left = canvasWidth - margin - bounds.x;
+		top = margin;
+		break;
+	default:
+		break;
+	}
+	/* The item's position is its alignment point, not always the corner. */
+	const uint32_t align = obs_sceneitem_get_alignment(item);
+	vec2 target;
+	target.x = left + ((align & OBS_ALIGN_LEFT) ? 0 : (align & OBS_ALIGN_RIGHT) ? bounds.x : bounds.x / 2);
+	target.y = top + ((align & OBS_ALIGN_TOP) ? 0 : (align & OBS_ALIGN_BOTTOM) ? bounds.y : bounds.y / 2);
+	placedItems[key] = {target, bounds};
+	if (!near(pos.x, target.x) || !near(pos.y, target.y))
+		obs_sceneitem_set_pos(item, &target);
+}
+
+/* The item's box is the caption box: take it as the source size, or turn a
+ * plain (scaled) item into a bounding-box item of the same visible size. */
+void syncItem(obs_sceneitem_t *item)
+{
+	if (!isBoxItem(item))
+		return;
+	obs_source_t *source = obs_sceneitem_get_source(item);
+	const int width = static_cast<int>(obs_source_get_width(source));
+	const int height = static_cast<int>(obs_source_get_height(source));
+	if (obs_sceneitem_get_bounds_type(item) == OBS_BOUNDS_NONE) {
+		vec2 scale;
+		obs_sceneitem_get_scale(item, &scale);
+		const int boxWidth = std::max(16, static_cast<int>(std::lround(width * std::fabs(scale.x))));
+		const int boxHeight = std::max(16, static_cast<int>(std::lround(height * std::fabs(scale.y))));
+		vec2 bounds;
+		vec2_set(&bounds, float(boxWidth), float(boxHeight));
+		vec2 one;
+		vec2_set(&one, scale.x < 0 ? -1.0f : 1.0f, scale.y < 0 ? -1.0f : 1.0f);
+		obs_sceneitem_defer_update_begin(item);
+		obs_sceneitem_set_scale(item, &one);
+		obs_sceneitem_set_bounds_type(item, OBS_BOUNDS_MAX_ONLY);
+		obs_sceneitem_set_bounds_alignment(item, OBS_ALIGN_CENTER);
+		obs_sceneitem_set_bounds(item, &bounds);
+		obs_sceneitem_defer_update_end(item);
+		setSourceSize(source, boxWidth, boxHeight);
+		return;
+	}
+	vec2 bounds;
+	obs_sceneitem_get_bounds(item, &bounds);
+	const int boxWidth = std::max(16, static_cast<int>(std::lround(bounds.x)));
+	const int boxHeight = std::max(16, static_cast<int>(std::lround(bounds.y)));
+	if (boxWidth != width || boxHeight != height)
+		setSourceSize(source, boxWidth, boxHeight);
+	placeItem(item, false);
+}
+
+void itemTransformed(void *, calldata_t *data)
+{
+	OBSSceneItem item = static_cast<obs_sceneitem_t *>(calldata_ptr(data, "item"));
+	if (!item || !isBoxItem(item))
+		return;
+	onUi([item] { syncItem(item); });
+}
+
+void itemAdded(void *, calldata_t *data)
+{
+	itemTransformed(nullptr, data);
+}
+
+void attachScene(obs_source_t *sceneSource)
+{
+	signal_handler_t *handler = obs_source_get_signal_handler(sceneSource);
+	signal_handler_disconnect(handler, "item_add", itemAdded, nullptr);
+	signal_handler_disconnect(handler, "item_transform", itemTransformed, nullptr);
+	signal_handler_connect(handler, "item_add", itemAdded, nullptr);
+	signal_handler_connect(handler, "item_transform", itemTransformed, nullptr);
+}
+
+void sourceCreated(void *, calldata_t *data)
+{
+	auto *source = static_cast<obs_source_t *>(calldata_ptr(data, "source"));
+	if (source && obs_group_or_scene_from_source(source))
+		attachScene(source);
+}
+
+/* Items of every scene (and group) that show `source`. */
+void forEachItemOf(obs_source_t *source, const std::function<void(obs_sceneitem_t *)> &fn)
+{
+	struct Context {
+		obs_source_t *source;
+		const std::function<void(obs_sceneitem_t *)> *fn;
+	} context{source, &fn};
+	obs_enum_scenes(
+		[](void *param, obs_source_t *sceneSource) {
+			if (obs_scene_t *scene = obs_group_or_scene_from_source(sceneSource))
+				obs_scene_enum_items(
+					scene,
+					[](obs_scene_t *, obs_sceneitem_t *item, void *p) {
+						auto *ctx = static_cast<Context *>(p);
+						if (obs_sceneitem_get_source(item) == ctx->source)
+							(*ctx->fn)(item);
+						return true;
+					},
+					param);
+			return true;
+		},
+		&context);
+}
+} // namespace
+
+void CanvasBox::PushSize(obs_source_t *source, int width, int height)
+{
+	OBSWeakSource weak = OBSGetWeakRef(source);
+	onUi([weak, width, height] {
+		OBSSourceAutoRelease strong = obs_weak_source_get_source(weak);
+		if (!strong)
+			return;
+		forEachItemOf(strong, [width, height](obs_sceneitem_t *item) {
+			if (obs_sceneitem_get_bounds_type(item) == OBS_BOUNDS_NONE)
+				return; /* syncItem converts it on its next transform */
+			vec2 bounds;
+			obs_sceneitem_get_bounds(item, &bounds);
+			if (std::lround(bounds.x) == width && std::lround(bounds.y) == height)
+				return;
+			vec2_set(&bounds, float(width), float(height));
+			obs_sceneitem_set_bounds(item, &bounds);
+		});
+	});
+}
+
+void CanvasBox::Place(obs_source_t *source)
+{
+	OBSWeakSource weak = OBSGetWeakRef(source);
+	onUi([weak] {
+		OBSSourceAutoRelease strong = obs_weak_source_get_source(weak);
+		if (strong)
+			forEachItemOf(strong, [](obs_sceneitem_t *item) { placeItem(item, true); });
+	});
+}
+
+void CanvasBox::Attach()
+{
+	signal_handler_connect(obs_get_signal_handler(), "source_create", sourceCreated, nullptr);
+}
+
+void CanvasBox::AttachExisting()
+{
+	obs_enum_scenes(
+		[](void *, obs_source_t *sceneSource) {
+			attachScene(sceneSource);
+			if (obs_scene_t *scene = obs_group_or_scene_from_source(sceneSource))
+				obs_scene_enum_items(scene, [](obs_scene_t *, obs_sceneitem_t *item, void *) {
+					if (isBoxItem(item))
+						syncItem(item);
+					return true;
+				}, nullptr);
+			return true;
+		},
+		nullptr);
+}
+
+void CanvasBox::Detach()
+{
+	signal_handler_disconnect(obs_get_signal_handler(), "source_create", sourceCreated, nullptr);
+}
+
+void CanvasBox::Tracker::update(obs_source_t *source, obs_data_t *settings)
+{
+	const int w = static_cast<int>(obs_data_get_int(settings, "width"));
+	const int h = static_cast<int>(obs_data_get_int(settings, "height"));
+	const int p = static_cast<int>(obs_data_get_int(settings, "placement"));
+	const int m = static_cast<int>(obs_data_get_int(settings, "margin"));
+	if (!source)
+		return;
+	if ((w != width || h != height) && width >= 0)
+		PushSize(source, w, h);
+	if ((p != placement || m != margin) && placement >= 0)
+		Place(source);
+	width = w;
+	height = h;
+	placement = p;
+	margin = m;
+}
+
+void CanvasBox::SetDefaults(obs_data_t *settings, int width, int height, Placement placement, int margin)
+{
+	obs_data_set_default_int(settings, "width", width);
+	obs_data_set_default_int(settings, "height", height);
+	obs_data_set_default_int(settings, "placement", placement);
+	obs_data_set_default_int(settings, "margin", margin);
+}
+
+void CanvasBox::AddProperties(obs_properties_t *props)
+{
+	auto t = [](const char *key) { return obs_module_text(key); };
+	obs_property_t *place = obs_properties_add_list(props, "placement", t("LiveHime.Box.Placement"),
+							OBS_COMBO_TYPE_LIST, OBS_COMBO_FORMAT_INT);
+	for (const auto &[key, value] : {std::pair{"LiveHime.Box.Place.BottomCenter", BottomCenter},
+					 std::pair{"LiveHime.Box.Place.TopCenter", TopCenter},
+					 std::pair{"LiveHime.Box.Place.Center", Center},
+					 std::pair{"LiveHime.Box.Place.BottomLeft", BottomLeft},
+					 std::pair{"LiveHime.Box.Place.BottomRight", BottomRight},
+					 std::pair{"LiveHime.Box.Place.TopLeft", TopLeft},
+					 std::pair{"LiveHime.Box.Place.TopRight", TopRight},
+					 std::pair{"LiveHime.Box.Place.Free", Free}})
+		obs_property_list_add_int(place, t(key), value);
+	obs_property_set_long_description(place, t("LiveHime.Box.PlacementHint"));
+	obs_property_t *margin = obs_properties_add_int(props, "margin", t("LiveHime.Box.Margin"), 0, 1000, 5);
+	obs_property_int_set_suffix(margin, " px");
+	obs_property_t *width = obs_properties_add_int(props, "width", t("LiveHime.Box.Width"), 16, 7680, 10);
+	obs_property_int_set_suffix(width, " px");
+	obs_property_t *height = obs_properties_add_int(props, "height", t("LiveHime.Box.Height"), 16, 4320, 10);
+	obs_property_int_set_suffix(height, " px");
+	obs_property_set_long_description(height, t("LiveHime.Box.SizeHint"));
+}
