diff --git a/plugins/livehime/src/overlay-frame.cpp b/plugins/livehime/src/overlay-frame.cpp
new file mode 100644
index 000000000..842b30df4
--- /dev/null
+++ b/plugins/livehime/src/overlay-frame.cpp
@@ -0,0 +1,98 @@
+#include "overlay-frame.hpp"
+
+#include <obs-module.h>
+
+#include <QPainter>
+#include <QPainterPath>
+
+void OverlayFrame::post(QImage image)
+{
+	std::lock_guard lock(mutex_);
+	pending_ = std::move(image);
+	hasPending_ = true;
+}
+
+void OverlayFrame::render()
+{
+	{
+		std::lock_guard lock(mutex_);
+		if (hasPending_) {
+			hasPending_ = false;
+			if (texture_ && (gs_texture_get_width(texture_) != uint32_t(pending_.width()) ||
+					 gs_texture_get_height(texture_) != uint32_t(pending_.height()))) {
+				gs_texture_destroy(texture_);
+				texture_ = nullptr;
+			}
+			if (!pending_.isNull()) {
+				if (!texture_) {
+					const uint8_t *bits = pending_.constBits();
+					texture_ = gs_texture_create(pending_.width(), pending_.height(), GS_BGRA, 1, &bits,
+								     GS_DYNAMIC);
+				} else {
+					gs_texture_set_image(texture_, pending_.constBits(),
+							     static_cast<uint32_t>(pending_.bytesPerLine()), false);
+				}
+			}
+		}
+	}
+	if (!texture_)
+		return;
+	/* QImage ARGB32_Premultiplied is BGRA in memory, premultiplied. */
+	gs_blend_state_push();
+	gs_blend_function(GS_BLEND_ONE, GS_BLEND_INVSRCALPHA);
+	gs_effect_t *effect = obs_get_base_effect(OBS_EFFECT_PREMULTIPLIED_ALPHA);
+	gs_effect_set_texture(gs_effect_get_param_by_name(effect, "image"), texture_);
+	while (gs_effect_loop(effect, "Draw"))
+		gs_draw_sprite(texture_, 0, 0, 0);
+	gs_blend_state_pop();
+}
+
+void OverlayFrame::release()
+{
+	if (!texture_)
+		return;
+	obs_enter_graphics();
+	gs_texture_destroy(texture_);
+	obs_leave_graphics();
+	texture_ = nullptr;
+}
+
+QColor ObsColor(long long value)
+{
+	const auto v = static_cast<uint32_t>(value);
+	return QColor(v & 0xFF, (v >> 8) & 0xFF, (v >> 16) & 0xFF, (v >> 24) & 0xFF);
+}
+
+QFont ObsFont(obs_data_t *font, const char *defaultFace, int defaultSize)
+{
+	const int size = font ? static_cast<int>(obs_data_get_int(font, "size")) : defaultSize;
+	const long long flags = font ? obs_data_get_int(font, "flags") : 0;
+	QFont result(QString::fromUtf8(font ? obs_data_get_string(font, "face") : defaultFace));
+	result.setPixelSize(size > 0 ? size : defaultSize);
+	const QString style = QString::fromUtf8(font ? obs_data_get_string(font, "style") : "");
+	if (!style.isEmpty())
+		result.setStyleName(style);
+	result.setBold(flags & OBS_FONT_BOLD);
+	result.setItalic(flags & OBS_FONT_ITALIC);
+	return result;
+}
+
+void PaintText(QPainter &painter, const QPointF &baseline, const QFont &font, const QString &text, const QColor &fill,
+	       bool outline, int outlineWidth, const QColor &outlineColor, bool shadow)
+{
+	QPainterPath path;
+	path.addText(baseline, font, text);
+	if (shadow) {
+		painter.setPen(Qt::NoPen);
+		painter.setBrush(QColor(0, 0, 0, 140));
+		painter.drawPath(path.translated(2.5, 3));
+	}
+	if (outline && outlineWidth > 0) {
+		painter.setPen(QPen(outlineColor, outlineWidth * 2.0, Qt::SolidLine, Qt::RoundCap, Qt::RoundJoin));
+		painter.setBrush(Qt::NoBrush);
+		painter.drawPath(path);
+	}
+	painter.setPen(Qt::NoPen);
+	painter.setBrush(fill);
+	painter.drawPath(path);
+}
