+QColor kindColor(const QString &kind, const Style &style)
+{
+	if (kind == "gift")
+		return QColor(0xFF, 0xC5, 0x3D);
+	if (kind == "guard")
+		return QColor(0xB1, 0x8C, 0xFF);
