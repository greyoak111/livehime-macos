+#pragma once
+
+#include <obs.hpp>
+
+#include <QColor>
+#include <QFont>
+#include <QImage>
+
+#include <mutex>
+
+class QPainter;
+class QPointF;
+
+/* A frame drawn with Qt on the UI thread and shown by a source's
+ * video_render on the graphics thread (premultiplied BGRA texture). */
+class OverlayFrame {
+public:
+	void post(QImage image);
+	void render();
+	void release();
+
+private:
+	std::mutex mutex_;
+	QImage pending_;
+	bool hasPending_ = false;
+	gs_texture_t *texture_ = nullptr;
+};
+
+/* OBS colours are 0xAABBGGRR. */
+QColor ObsColor(long long value);
+/* An OBS font property as a QFont sized in pixels. */
+QFont ObsFont(obs_data_t *font, const char *defaultFace, int defaultSize);
+/* Text with an optional soft shadow and outline under the fill. */
