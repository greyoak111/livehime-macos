+/* Makes OBS's own transform controls size the caption box instead of
+ * scaling the text: scene items showing a captions source use a bounding
+ * box, and the source takes that box as its width and height (so the text
+ * re-wraps at its font size). Width and height set in the source's
+ * properties are pushed back to the items' bounding boxes. Call Attach at
+ * load (global source creation) and AttachExisting once scenes exist. */
+namespace CaptionItemSync {
+void Attach();
+void AttachExisting();
+void Detach();
+} // namespace CaptionItemSync
