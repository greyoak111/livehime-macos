 	style.backgroundColor = obsColor(obs_data_get_int(settings, "background_color"));
 	style.padding = static_cast<int>(obs_data_get_int(settings, "padding"));
 
+	const bool resized = overlay->width != style.width || overlay->height != style.height;
 	overlay->width = style.width;
 	overlay->height = style.height;
+	if (resized && overlay->self)
+		CaptionItemSync_PushSize(overlay->self, style.width, style.height);
 	if (CaptionOverlayHub *hub = CaptionOverlayHub::instance()) {
 		hub->remove(overlay);
 		overlay->style = style;
